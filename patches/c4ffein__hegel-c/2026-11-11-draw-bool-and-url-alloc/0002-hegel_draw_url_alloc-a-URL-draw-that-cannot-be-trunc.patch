 }
 
+char * hegel_draw_url_alloc (hegel_testcase * tc)
+{
+  if (!tc->silent) tc->draw_count++;
+  hegel_buf r;
+  hegel__buf_init (&r);
+  hegel__call (tc, HEGEL_OP_DRAW_URL, NULL, 0, &r, 0);
+  char * s = hegel_alloc (tc, r.len + 1);   /* zeroed: the NUL is there */
+  if (r.len) memcpy (s, r.data, r.len);
+  hegel__buf_free (&r);
+  trace (tc, "\"%s\"", s);
+  return s;
+}
