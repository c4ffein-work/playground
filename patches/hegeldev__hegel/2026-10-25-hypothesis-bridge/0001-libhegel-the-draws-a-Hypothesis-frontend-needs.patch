+//! In-process exercise of the draws added for the Hypothesis frontend:
+//! weighted integers, NaN alongside finite float bounds, text generators
+//! built from explicit codepoint ranges, a case's choices as a blob, and
+//! forced integer draws.
+mod common;
+
+use common::{last_error, make_settings_no_db, next_case, ok, start};
+use hegel_c::hegel_result_t::*;
+use hegel_c::{
+    HegelContext, HegelStringGenerator, HegelTestCase, hegel_context_free, hegel_context_new,
+    hegel_generate_float, hegel_generate_integer, hegel_generate_integer_forced,
+    hegel_generate_integer_weighted, hegel_generate_string, hegel_mark_complete,
+    hegel_owned_string_free, hegel_owned_string_t, hegel_run_free, hegel_settings_free,
+    hegel_settings_set_seed, hegel_settings_set_test_cases, hegel_status_t,
+    hegel_string_generator_free, hegel_string_generator_text_ranges, hegel_test_case_choices,
+    hegel_test_case_from_blob,
+};
+use std::ptr;
+
+unsafe fn complete_valid(ctx: *mut HegelContext, tc: *mut HegelTestCase) {
+    unsafe {
+        ok(hegel_mark_complete(
+            ctx,
+            tc,
+            hegel_status_t::HEGEL_STATUS_VALID as u32,
+            ptr::null(),
+        ));
+        ok(hegel_c::hegel_test_case_free(ctx, tc));
+    }
+}
+
+#[test]
+fn weighted_integers_honour_keys_and_validate_arguments() {
+    let ctx = hegel_context_new();
+    unsafe {
+        let s = make_settings_no_db(ctx);
+        ok(hegel_settings_set_test_cases(ctx, s, 400));
+        ok(hegel_settings_set_seed(ctx, s, 7, true));
+        let run = start(ctx, s);
+        let keys = [7i64, 42];
+        let weights = [0.3f64, 0.2];
+        let (mut sevens, mut forty_twos, mut others) = (0, 0, 0);
+        loop {
+            let tc = next_case(ctx, run);
+            if tc.is_null() {
+                break;
+            }
+            let mut out = 0i64;
+            // keys outside the bounds, weights summing to >= 1, and mismatched
+            // lengths are usage errors
+            assert_eq!(
+                hegel_generate_integer_weighted(
+                    ctx,
+                    tc,
+                    0,
+                    5,
+                    0,
+                    keys.as_ptr(),
+                    weights.as_ptr(),
+                    2,
+                    &mut out
+                ),
+                HEGEL_E_INVALID_ARG
+            );
+            assert!(last_error(ctx).contains("outside"));
+            let heavy = [0.6f64, 0.5];
+            assert_eq!(
+                hegel_generate_integer_weighted(
+                    ctx,
+                    tc,
+                    0,
+                    100,
+                    0,
+                    keys.as_ptr(),
+                    heavy.as_ptr(),
+                    2,
+                    &mut out
+                ),
+                HEGEL_E_INVALID_ARG
+            );
+            assert_eq!(
+                hegel_generate_integer_weighted(
+                    ctx,
+                    tc,
+                    0,
+                    100,
+                    0,
+                    keys.as_ptr(),
+                    weights.as_ptr(),
+                    2,
+                    ptr::null_mut()
+                ),
+                HEGEL_E_INVALID_ARG
+            );
+            ok(hegel_generate_integer_weighted(
+                ctx,
+                tc,
+                0,
+                100,
+                0,
+                keys.as_ptr(),
+                weights.as_ptr(),
+                2,
+                &mut out,
+            ));
+            assert!((0..=100).contains(&out));
+            match out {
+                7 => sevens += 1,
+                42 => forty_twos += 1,
+                _ => others += 1,
+            }
+            // no keys at all is just an ordinary draw
+            ok(hegel_generate_integer_weighted(
+                ctx,
+                tc,
+                -3,
+                3,
+                0,
+                ptr::null(),
+                ptr::null(),
+                0,
+                &mut out,
+            ));
+            assert!((-3..=3).contains(&out));
+            complete_valid(ctx, tc);
+        }
+        // The weights steer fresh draws only: a good share of a run's cases
+        // are mutations and replays of earlier ones, so over the whole run
+        // the keys show up well below 30% / 20% but far above the ~1% a
+        // plain draw over [0, 100] would give them.
+        assert!(sevens >= 40, "7 drawn {sevens} times");
+        assert!(forty_twos >= 25, "42 drawn {forty_twos} times");
+        assert!(others >= 60, "other values drawn {others} times");
+        ok(hegel_run_free(ctx, run));
+        ok(hegel_settings_free(ctx, s));
+        ok(hegel_context_free(ctx));
+    }
+}
+
+#[test]
+fn nan_is_allowed_alongside_finite_bounds() {
+    let ctx = hegel_context_new();
+    unsafe {
+        let s = make_settings_no_db(ctx);
+        ok(hegel_settings_set_test_cases(ctx, s, 600));
+        // the NaN share is a per-case drawn parameter: pin the run
+        ok(hegel_settings_set_seed(ctx, s, 7, true));
+        let run = start(ctx, s);
+        let mut nans = 0;
+        loop {
+            let tc = next_case(ctx, run);
+            if tc.is_null() {
+                break;
+            }
+            let mut out = 0f64;
+            ok(hegel_generate_float(
+                ctx, tc, 64, 0.0, 1.0, true, false, false, false, 5e-324, &mut out,
+            ));
+            assert!(out.is_nan() || (0.0..=1.0).contains(&out), "{out}");
+            nans += usize::from(out.is_nan());
+            ok(hegel_generate_float(
+                ctx, tc, 64, -2.0, 2.0, false, false, false, false, 5e-324, &mut out,
+            ));
+            assert!((-2.0..=2.0).contains(&out), "{out}");
+            complete_valid(ctx, tc);
+        }
+        assert!(
+            nans > 0,
+            "NaN never drawn from a bounded draw that allows it"
+        );
+        ok(hegel_run_free(ctx, run));
+        ok(hegel_settings_free(ctx, s));
+        ok(hegel_context_free(ctx));
+    }
+}
