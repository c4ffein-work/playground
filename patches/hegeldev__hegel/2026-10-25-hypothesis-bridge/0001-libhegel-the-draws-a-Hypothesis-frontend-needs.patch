+#[test]
+fn forced_integers_take_a_choice_position_and_replay() {
+    let ctx = hegel_context_new();
+    unsafe {
+        let s = make_settings_no_db(ctx);
+        ok(hegel_settings_set_test_cases(ctx, s, 20));
+        let run = start(ctx, s);
+        loop {
+            let tc = next_case(ctx, run);
+            if tc.is_null() {
+                break;
+            }
+            let (mut a, mut b) = (0i64, 0i64);
+            ok(hegel_generate_integer(ctx, tc, 0, 1000, &mut a));
+            assert_eq!(
+                hegel_generate_integer_forced(ctx, tc, 0, 2, 3),
+                HEGEL_E_INVALID_ARG
+            );
+            assert!(last_error(ctx).contains("outside"));
+            ok(hegel_generate_integer_forced(ctx, tc, 0, 2, 1));
+            ok(hegel_generate_integer(ctx, tc, 0, 1000, &mut b));
+            let mut res = hegel_owned_string_t {
+                data: ptr::null_mut(),
+                len: 0,
+            };
+            ok(hegel_test_case_choices(ctx, tc, &mut res));
+            let bytes = std::slice::from_raw_parts(res.data as *const u8, res.len);
+            let blob = bytes.to_vec();
+            ok(hegel_owned_string_free(ctx, &mut res));
+            complete_valid(ctx, tc);
+            // the blob holds three choices; the forced one is re-forced on
+            // replay (whatever the caller forces then) and the draws around
+            // it come back as recorded
+            let mut replay: *mut HegelTestCase = ptr::null_mut();
+            ok(hegel_test_case_from_blob(
+                ctx,
+                s,
+                hegel_c::hegel_string_t {
+                    data: blob.as_ptr() as *const std::ffi::c_char,
+                    len: blob.len(),
+                },
+                None,
+                ptr::null_mut(),
+                &mut replay,
+            ));
+            let (mut ra, mut rb) = (0i64, 0i64);
+            ok(hegel_generate_integer(ctx, replay, 0, 1000, &mut ra));
+            ok(hegel_generate_integer_forced(ctx, replay, 0, 2, 2));
+            ok(hegel_generate_integer(ctx, replay, 0, 1000, &mut rb));
+            assert_eq!((ra, rb), (a, b));
+            complete_valid(ctx, replay);
+        }
+        ok(hegel_run_free(ctx, run));
+        ok(hegel_settings_free(ctx, s));
+        ok(hegel_context_free(ctx));
+    }
