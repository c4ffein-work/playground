+/// Parameters:
+/// `min_size` / `max_size`: Inclusive length bounds, in characters.
+/// `ranges`: `ranges_len` pairs of inclusive codepoint bounds (so
+///   `2 * ranges_len` `uint32_t`s), sorted, disjoint and ascending: the
+///   alphabet exactly as the caller computed it. Surrogates are always
+///   removed.
+///
+/// Returns `HEGEL_OK`, or `HEGEL_E_INVALID_ARG` for malformed ranges or
+/// ranges that leave no characters while `max_size > 0`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn hegel_string_generator_text_ranges(
+    ctx: *mut HegelContext,
+    min_size: u64,
+    max_size: u64,
+    ranges: *const u32,
+    ranges_len: usize,
+    out_generator: *mut *mut HegelStringGenerator,
+) -> hegel_result_t {
+    const FN: &str = "hegel_string_generator_text_ranges";
+    clear_last_error(ctx);
+    if out_generator.is_null() {
+        set_last_error(ctx, &format!("{FN}: out parameter is null"));
+        return HEGEL_E_INVALID_ARG;
+    }
+    if ranges_len > 0 && ranges.is_null() {
+        set_last_error(ctx, &format!("{FN}: ranges pointer is null"));
+        return HEGEL_E_INVALID_ARG;
+    }
+    let pairs: Vec<(u32, u32)> = if ranges_len == 0 {
+        Vec::new()
+    } else {
+        // SAFETY: the caller promises `2 * ranges_len` readable u32s.
+        let flat = unsafe { core::slice::from_raw_parts(ranges, ranges_len * 2) };
+        flat.chunks_exact(2).map(|p| (p[0], p[1])).collect()
+    };
+    match crate::native::draws::StringSpec::text_ranges(
+        &pairs,
+        size_arg(min_size),
+        size_arg(max_size),
+    ) {
+        Ok(spec) => unsafe { write_string_generator(out_generator, spec) },
+        Err(e) => translate_construct_error(ctx, e),
+    }
+}
