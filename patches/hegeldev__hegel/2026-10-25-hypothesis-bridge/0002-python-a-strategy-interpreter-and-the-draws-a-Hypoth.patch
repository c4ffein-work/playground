diff --git a/frontends/python/src/interpret.rs b/frontends/python/src/interpret.rs
new file mode 100644
index 00000000..78416e22
--- /dev/null
+++ b/frontends/python/src/interpret.rs
@@ -0,0 +1,737 @@
+use crate::{InvalidArgument, StringGenerator, TestCase, check, with_ctx};
+use hegel_c as c;
+use num_bigint::BigInt;
+use pyo3::prelude::*;
+use pyo3::types::{PyBytes, PyDict, PyList, PyString, PyTuple, PyType};
+use std::ptr;
+
+struct IntNode {
+    lo: BigInt,
+    hi: BigInt,
+    shrink_towards: BigInt,
+    keys: Vec<i64>,
+    weights: Vec<f64>,
+}
+
+enum Node {
+    Int(IntNode, u64),
+    Float {
+        min: f64,
+        max: f64,
+        allow_nan: bool,
+        snm: f64,
+        label: u64,
+    },
+    Bool {
+        p: f64,
+        label: u64,
+    },
+    Bytes {
+        min: u64,
+        max: u64,
+        label: u64,
+    },
+    Text {
+        generator: Py<StringGenerator>,
+        label: u64,
+    },
+    TextList {
+        elem: Box<Node>,
+        min: u64,
+        max: u64,
+        p_continue: f64,
+        label: u64,
+    },
+    EmptyList {
+        label: u64,
+    },
+    List {
+        elem: Box<Node>,
+        min: u64,
+        max: u64,
+        p_continue: f64,
+        label: u64,
+    },
+    Tuple {
+        children: Vec<Node>,
+        label: u64,
+    },
+    FixedDict {
+        keys: Vec<Py<PyAny>>,
+        children: Vec<Node>,
+        dict_type: Py<PyAny>,
+        label: u64,
+    },
+    OneOf {
+        children: Vec<Node>,
+        inner_label: u64,
+        label: u64,
+    },
+    Sampled {
+        elements: Py<PyAny>,
+        n: i64,
+        maps: Vec<Py<PyAny>>,
+        label: u64,
+    },
+    Just {
+        value: Py<PyAny>,
+        maps: Vec<Py<PyAny>>,
+        label: u64,
+    },
+    Map {
+        inner: Box<Node>,
+        pack: Py<PyAny>,
+        label: u64,
+    },
+    Builds {
+        target: Py<PyAny>,
+        args: Vec<Node>,
+        names: Vec<Py<PyAny>>,
+        kwargs: Vec<Node>,
+        label: u64,
+    },
+    Filter {
+        inner: Box<Node>,
+        conditions: Vec<Py<PyAny>>,
+        repr: String,
+        label: u64,
+    },
+    Opaque(Py<PyAny>),
+}
+
+fn item<'py>(t: &Bound<'py, PyTuple>, i: usize) -> PyResult<Bound<'py, PyAny>> {
+    t.get_item(i)
+}
+
+fn objects(obj: &Bound<'_, PyAny>) -> PyResult<Vec<Py<PyAny>>> {
+    obj.try_iter()?.map(|c| Ok(c?.unbind())).collect()
+}
+
+fn children(obj: &Bound<'_, PyAny>) -> PyResult<Vec<Node>> {
+    obj.try_iter()?.map(|c| Node::from_py(&c?)).collect()
+}
+
+impl Node {
+    fn from_py(obj: &Bound<'_, PyAny>) -> PyResult<Node> {
+        let t = obj.cast::<PyTuple>()?;
+        let tag: String = item(t, 0)?.extract()?;
+        Ok(match tag.as_str() {
+            "int" => Node::Int(
+                IntNode {
+                    lo: item(t, 1)?.extract()?,
+                    hi: item(t, 2)?.extract()?,
+                    shrink_towards: item(t, 3)?.extract()?,
+                    keys: item(t, 4)?.extract()?,
+                    weights: item(t, 5)?.extract()?,
+                },
+                item(t, 6)?.extract()?,
+            ),
+            "float" => Node::Float {
+                min: item(t, 1)?.extract()?,
+                max: item(t, 2)?.extract()?,
+                allow_nan: item(t, 3)?.extract()?,
+                snm: item(t, 4)?.extract()?,
+                label: item(t, 5)?.extract()?,
+            },
+            "bool" => Node::Bool {
+                p: item(t, 1)?.extract()?,
+                label: item(t, 2)?.extract()?,
+            },
+            "bytes" => Node::Bytes {
+                min: item(t, 1)?.extract()?,
+                max: item(t, 2)?.extract()?,
+                label: item(t, 3)?.extract()?,
+            },
+            "text" => Node::Text {
+                generator: item(t, 1)?.extract()?,
+                label: item(t, 2)?.extract()?,
+            },
+            "text_list" => Node::TextList {
+                elem: Box::new(Node::from_py(&item(t, 1)?)?),
+                min: item(t, 2)?.extract()?,
+                max: item(t, 3)?.extract()?,
+                p_continue: item(t, 4)?.extract()?,
+                label: item(t, 5)?.extract()?,
+            },
+            "empty_list" => Node::EmptyList {
+                label: item(t, 1)?.extract()?,
+            },
+            "list" => Node::List {
+                elem: Box::new(Node::from_py(&item(t, 1)?)?),
+                min: item(t, 2)?.extract()?,
+                max: item(t, 3)?.extract()?,
+                p_continue: item(t, 4)?.extract()?,
+                label: item(t, 5)?.extract()?,
+            },
+            "tuple" => Node::Tuple {
+                children: children(&item(t, 1)?)?,
+                label: item(t, 2)?.extract()?,
+            },
+            "fixeddict" => Node::FixedDict {
+                keys: objects(&item(t, 1)?)?,
+                children: children(&item(t, 2)?)?,
+                dict_type: item(t, 3)?.unbind(),
+                label: item(t, 4)?.extract()?,
+            },
+            "one_of" => Node::OneOf {
+                children: children(&item(t, 1)?)?,
+                inner_label: item(t, 2)?.extract()?,
+                label: item(t, 3)?.extract()?,
+            },
+            "sampled" => {
+                let elements = item(t, 1)?;
+                Node::Sampled {
+                    n: elements.len()? as i64,
+                    elements: elements.unbind(),
+                    maps: objects(&item(t, 2)?)?,
+                    label: item(t, 3)?.extract()?,
+                }
+            }
+            "just" => Node::Just {
+                value: item(t, 1)?.unbind(),
+                maps: objects(&item(t, 2)?)?,
+                label: item(t, 3)?.extract()?,
+            },
+            "map" => Node::Map {
+                inner: Box::new(Node::from_py(&item(t, 1)?)?),
+                pack: item(t, 2)?.unbind(),
+                label: item(t, 3)?.extract()?,
+            },
+            "builds" => Node::Builds {
+                target: item(t, 1)?.unbind(),
+                args: children(&item(t, 2)?)?,
+                names: objects(&item(t, 3)?)?,
+                kwargs: children(&item(t, 4)?)?,
+                label: item(t, 5)?.extract()?,
+            },
+            "filter" => Node::Filter {
+                inner: Box::new(Node::from_py(&item(t, 1)?)?),
+                conditions: objects(&item(t, 2)?)?,
+                repr: item(t, 3)?.extract()?,
+                label: item(t, 4)?.extract()?,
+            },
+            "opaque" => Node::Opaque(item(t, 1)?.unbind()),
+            other => {
+                return Err(InvalidArgument::new_err(format!(
+                    "unknown strategy node {other:?}"
+                )));
+            }
+        })
+    }
+}
+
+/// A strategy compiled by its frontend into a tree the engine walks in one
+/// call (`TestCase.generate`): primitive draws, collections built with the
+/// frontend's own continuation protocol, choices between alternatives,
+/// mapped, built and filtered values, and opaque leaves the frontend draws
+/// itself. `one_from_many`, `filtered` and `mapped` are the span labels the
+/// frontend uses for those draws; `retry_exception` is what a map raises to
+/// ask for another attempt.
+#[pyclass(frozen, name = "CompiledStrategy", module = "hegel._native")]
+pub(crate) struct CompiledStrategy {
+    root: Node,
+    one_from_many: u64,
+    filtered: u64,
+    mapped: u64,
+    retry_exception: Py<PyType>,
+}
+
+#[pymethods]
+impl CompiledStrategy {
+    #[new]
+    fn new(
+        desc: &Bound<'_, PyAny>,
+        one_from_many: u64,
+        filtered: u64,
+        mapped: u64,
+        retry_exception: Py<PyType>,
+    ) -> PyResult<Self> {
+        Ok(CompiledStrategy {
+            root: Node::from_py(desc)?,
+            one_from_many,
+            filtered,
+            mapped,
+            retry_exception,
+        })
+    }
+}
+
+pub(crate) struct Callbacks<'py> {
+    pub(crate) draw: Bound<'py, PyAny>,
+    pub(crate) record: Bound<'py, PyAny>,
+    pub(crate) invalid: Bound<'py, PyAny>,
+}
+
+struct Gen<'a, 'py> {
+    py: Python<'py>,
+    tc: *mut c::HegelTestCase,
+    compiled: &'a CompiledStrategy,
+    callbacks: Callbacks<'py>,
+    recorded: Vec<(&'static str, Py<PyAny>)>,
+}
+
+impl<'a, 'py> Gen<'a, 'py> {
+    fn flush(&mut self) -> PyResult<()> {
+        if self.recorded.is_empty() {
+            return Ok(());
+        }
+        let items: Vec<Bound<'py, PyAny>> = self
+            .recorded
+            .drain(..)
+            .map(|(kind, v)| {
+                PyTuple::new(
+                    self.py,
+                    [
+                        PyString::new(self.py, kind).into_any(),
+                        v.into_bound(self.py),
+                    ],
+                )
+                .map(|t| t.into_any())
+            })
+            .collect::<PyResult<_>>()?;
+        self.callbacks
+            .record
+            .call1((PyList::new(self.py, items)?,))?;
+        Ok(())
+    }
+
+    fn record(&mut self, kind: &'static str, v: &Bound<'py, PyAny>) {
+        self.recorded.push((kind, v.clone().unbind()));
+    }
+
+    fn start_span(&self, label: u64) -> PyResult<()> {
+        with_ctx(|ctx| check(unsafe { c::hegel_start_span(ctx, self.tc, label) }))
+    }
+
+    fn stop_span(&self, discard: bool) {
+        with_ctx(|ctx| {
+            let _ = unsafe { c::hegel_stop_span(ctx, self.tc, discard) };
+        });
+    }
+
+    fn spanned<T>(&mut self, label: u64, f: impl FnOnce(&mut Self) -> PyResult<T>) -> PyResult<T> {
+        self.start_span(label)?;
+        let out = f(self);
+        self.stop_span(false);
+        out
+    }
+
+    fn draw_bool(&mut self, p: f64, forced: Option<bool>) -> PyResult<bool> {
+        let mut out = false;
+        with_ctx(|ctx| {
+            check(unsafe {
+                c::hegel_generate_boolean(
+                    ctx,
+                    self.tc,
+                    p,
+                    forced.unwrap_or(false),
+                    forced.is_some(),
+                    &mut out,
+                )
+            })
+        })?;
+        let v = out.into_pyobject(self.py)?.to_owned().into_any();
+        self.record("boolean", &v);
+        Ok(out)
+    }
+
+    fn draw_index(&mut self, lo: i64, hi: i64) -> PyResult<i64> {
+        self.draw_int(&IntNode {
+            lo: BigInt::from(lo),
+            hi: BigInt::from(hi),
+            shrink_towards: BigInt::from(0),
+            keys: vec![],
+            weights: vec![],
+        })?
+        .extract()
+    }
+
+    fn draw_int(&mut self, n: &IntNode) -> PyResult<Bound<'py, PyAny>> {
+        let v = integer_weighted(
+            self.tc,
+            &n.lo,
+            &n.hi,
+            &n.shrink_towards,
+            &n.keys,
+            &n.weights,
+        )?
+        .into_pyobject(self.py)?
+        .into_any();
+        self.record("integer", &v);
+        Ok(v)
+    }
+
+    fn draw_float(
+        &mut self,
+        min: f64,
+        max: f64,
+        allow_nan: bool,
+        snm: f64,
+    ) -> PyResult<Bound<'py, PyAny>> {
+        let mut out = 0.0f64;
+        with_ctx(|ctx| {
+            check(unsafe {
+                c::hegel_generate_float(
+                    ctx,
+                    self.tc,
+                    64,
+                    min,
+                    max,
+                    allow_nan,
+                    min.is_infinite() || max.is_infinite(),
+                    false,
+                    false,
+                    snm,
+                    &mut out,
+                )
+            })
+        })?;
+        let v = out.into_pyobject(self.py)?.into_any();
+        self.record("float", &v);
+        Ok(v)
+    }
+
+    fn draw_bytes(&mut self, min: u64, max: u64) -> PyResult<Bound<'py, PyAny>> {
+        let mut result = c::hegel_generate_bytes_result_t {
+            data: ptr::null_mut(),
+            len: 0,
+        };
+        let bytes = with_ctx(|ctx| {
+            check(unsafe { c::hegel_generate_bytes(ctx, self.tc, min, max, &mut result) })?;
+            let bytes = unsafe { std::slice::from_raw_parts(result.data, result.len) }.to_vec();
+            let _ = unsafe { c::hegel_generate_bytes_result_free(ctx, &mut result) };
+            Ok::<_, PyErr>(bytes)
+        })?;
+        let v = PyBytes::new(self.py, &bytes).into_any();
+        self.record("bytes", &v);
+        Ok(v)
+    }
+
+    fn draw_text(&mut self, generator: &Py<StringGenerator>) -> PyResult<Bound<'py, PyAny>> {
+        let raw = generator.get().raw();
+        let bytes = generate_string(self.tc, raw)?;
+        let v = PyString::new(self.py, &String::from_utf8_lossy(&bytes)).into_any();
+        self.record("string", &v);
+        Ok(v)
+    }
+
+    fn many(
+        &mut self,
+        min: u64,
+        max: u64,
+        p_continue: f64,
+        mut body: impl FnMut(&mut Self) -> PyResult<Bound<'py, PyAny>>,
+    ) -> PyResult<Vec<Bound<'py, PyAny>>> {
+        let mut out = Vec::new();
+        let mut count: u64 = 0;
+        let label = self.compiled.one_from_many;
+        loop {
+            self.start_span(label)?;
+            let more = if min == max {
+                count < min
+            } else {
+                let forced = if count < min {
+                    Some(true)
+                } else if count >= max {
+                    Some(false)
+                } else {
+                    None
+                };
+                self.draw_bool(p_continue, forced)?
+            };
+            if !more {
+                self.stop_span(false);
+                return Ok(out);
+            }
+            count += 1;
+            let v = body(self);
+            self.stop_span(false);
+            out.push(v?);
+        }
+    }
+
+    fn apply_maps(
+        &mut self,
+        mut v: Bound<'py, PyAny>,
+        maps: &[Py<PyAny>],
+    ) -> PyResult<Bound<'py, PyAny>> {
+        for m in maps {
+            v = m.bind(self.py).call1((v,))?;
+        }
+        Ok(v)
+    }
+
+    fn generate(&mut self, node: &Node) -> PyResult<Bound<'py, PyAny>> {
+        match node {
+            Node::Int(n, label) => self.spanned(*label, |g| g.draw_int(n)),
+            Node::Float {
+                min,
+                max,
+                allow_nan,
+                snm,
+                label,
+            } => self.spanned(*label, |g| g.draw_float(*min, *max, *allow_nan, *snm)),
+            Node::Bool { p, label } => self.spanned(*label, |g| {
+                Ok(g.draw_bool(*p, None)?
+                    .into_pyobject(g.py)?
+                    .to_owned()
+                    .into_any())
+            }),
+            Node::Bytes { min, max, label } => self.spanned(*label, |g| g.draw_bytes(*min, *max)),
+            Node::Text { generator, label } => self.spanned(*label, |g| g.draw_text(generator)),
+            Node::TextList {
+                elem,
+                min,
+                max,
+                p_continue,
+                label,
+            } => self.spanned(*label, |g| {
+                let parts = g.many(*min, *max, *p_continue, |g| g.generate(elem))?;
+                let mut s = String::new();
+                for p in parts {
+                    s.push_str(&p.extract::<String>()?);
+                }
+                Ok(PyString::new(g.py, &s).into_any())
+            }),
+            Node::EmptyList { label } => {
+                self.spanned(*label, |g| Ok(PyList::empty(g.py).into_any()))
+            }
+            Node::List {
+                elem,
+                min,
+                max,
+                p_continue,
+                label,
+            } => self.spanned(*label, |g| {
+                let items = g.many(*min, *max, *p_continue, |g| g.generate(elem))?;
+                Ok(PyList::new(g.py, items)?.into_any())
+            }),
+            Node::Tuple { children, label } => self.spanned(*label, |g| {
+                let items: Vec<_> = children
+                    .iter()
+                    .map(|c| g.generate(c))
+                    .collect::<PyResult<_>>()?;
+                Ok(PyTuple::new(g.py, items)?.into_any())
+            }),
+            Node::FixedDict {
+                keys,
+                children,
+                dict_type,
+                label,
+            } => self.spanned(*label, |g| {
+                let mut pairs: Vec<Bound<'py, PyAny>> = keys
+                    .iter()
+                    .zip(children)
+                    .map(|(k, c)| {
+                        let v = g.generate(c)?;
+                        Ok(PyTuple::new(g.py, [k.bind(g.py).clone(), v])?.into_any())
+                    })
+                    .collect::<PyResult<_>>()?;
+                let n = pairs.len();
+                for i in 0..n.saturating_sub(1) {
+                    let j = g.draw_index(i as i64, (n - 1) as i64)?;
+                    pairs.swap(i, j as usize);
+                }
+                dict_type.bind(g.py).call1((PyList::new(g.py, pairs)?,))
+            }),
+            Node::OneOf {
+                children,
+                inner_label,
+                label,
+            } => self.spanned(*label, |g| {
+                if children.len() == 1 {
+                    return g.generate(&children[0]);
+                }
+                let n = children.len() as i64;
+                let i = g.spanned(*inner_label, |g| g.draw_index(0, n - 1))?;
+                g.generate(&children[i as usize])
+            }),
+            Node::Sampled {
+                elements,
+                n,
+                maps,
+                label,
+            } => self.spanned(*label, |g| {
+                let i = g.draw_index(0, n - 1)?;
+                let v = elements.bind(g.py).get_item(i)?;
+                g.apply_maps(v, maps)
+            }),
+            Node::Just { value, maps, label } => {
+                self.spanned(*label, |g| g.apply_maps(value.bind(g.py).clone(), maps))
+            }
+            Node::Map { inner, pack, label } => self.spanned(*label, |g| {
+                let mapped = g.compiled.mapped;
+                let retry = g.compiled.retry_exception.bind(g.py).clone();
+                let mut last_err = None;
+                for _ in 0..3 {
+                    g.start_span(mapped)?;
+                    let x = g.generate(inner)?;
+                    match pack.bind(g.py).call1((x,)) {
+                        Ok(v) => {
+                            g.stop_span(false);
+                            return Ok(v);
+                        }
+                        Err(e) if e.is_instance(g.py, &retry) => {
+                            g.stop_span(true);
+                            last_err = Some(e);
+                        }
+                        Err(e) => {
+                            g.stop_span(false);
+                            return Err(e);
+                        }
+                    }
+                }
+                Err(last_err.unwrap())
+            }),
+            Node::Builds {
+                target,
+                args,
+                names,
+                kwargs,
+                label,
+            } => self.spanned(*label, |g| {
+                let a: Vec<_> = args
+                    .iter()
+                    .map(|c| g.generate(c))
+                    .collect::<PyResult<_>>()?;
+                let kw = PyDict::new(g.py);
+                for (name, c) in names.iter().zip(kwargs) {
+                    let v = g.generate(c)?;
+                    kw.set_item(name.bind(g.py), v)?;
+                }
+                target.bind(g.py).call(PyTuple::new(g.py, a)?, Some(&kw))
+            }),
+            Node::Filter {
+                inner,
+                conditions,
+                repr,
+                label,
+            } => self.spanned(*label, |g| {
+                let filtered = g.compiled.filtered;
+                for _ in 0..3 {
+                    g.start_span(filtered)?;
+                    let v = g.generate(inner)?;
+                    let mut ok = true;
+                    for cond in conditions {
+                        if !cond.bind(g.py).call1((v.clone(),))?.is_truthy()? {
+                            ok = false;
+                            break;
+                        }
+                    }
+                    if ok {
+                        g.stop_span(false);
+                        return Ok(v);
+                    }
+                    g.stop_span(true);
+                }
+                g.flush()?;
+                g.callbacks.invalid.call1((repr.as_str(),))?;
+                Err(InvalidArgument::new_err(
+                    "the invalid callback returned instead of ending the test case",
+                ))
+            }),
+            Node::Opaque(strategy) => {
+                self.flush()?;
+                self.callbacks.draw.call1((strategy.bind(self.py),))
+            }
+        }
+    }
+}
+
+pub(crate) fn generate<'py>(
+    py: Python<'py>,
+    tc: &TestCase,
+    compiled: &CompiledStrategy,
+    callbacks: Callbacks<'py>,
+) -> PyResult<Bound<'py, PyAny>> {
+    let mut g = Gen {
+        py,
+        tc: tc.tc(),
+        compiled,
+        callbacks,
+        recorded: Vec::new(),
+    };
+    let out = g.generate(&compiled.root);
+    let flushed = g.flush();
+    let v = out?;
+    flushed?;
+    Ok(v)
+}
+
+pub(crate) fn integer_weighted(
+    tc: *mut c::HegelTestCase,
+    lo: &BigInt,
+    hi: &BigInt,
+    shrink_towards: &BigInt,
+    keys: &[i64],
+    weights: &[f64],
+) -> PyResult<BigInt> {
+    if let (Ok(lo), Ok(hi), Ok(st)) = (
+        i64::try_from(lo),
+        i64::try_from(hi),
+        i64::try_from(shrink_towards),
+    ) {
+        let mut out = 0i64;
+        with_ctx(|ctx| {
+            check(unsafe {
+                c::hegel_generate_integer_weighted(
+                    ctx,
+                    tc,
+                    lo,
+                    hi,
+                    st,
+                    keys.as_ptr(),
+                    weights.as_ptr(),
+                    keys.len(),
+                    &mut out,
+                )
+            })
+        })?;
+        return Ok(BigInt::from(out));
+    }
+    let lo_b = lo.to_signed_bytes_le();
+    let hi_b = hi.to_signed_bytes_le();
+    let mut out = vec![0u8; lo_b.len().max(hi_b.len()) + 1];
+    let mut out_len = 0usize;
+    with_ctx(|ctx| {
+        check(unsafe {
+            c::hegel_generate_integer_big(
+                ctx,
+                tc,
+                lo_b.as_ptr(),
+                lo_b.len(),
+                hi_b.as_ptr(),
+                hi_b.len(),
+                out.as_mut_ptr(),
+                out.len(),
+                &mut out_len,
+            )
+        })
+    })?;
+    Ok(BigInt::from_signed_bytes_le(&out[..out_len.min(out.len())]))
+}
+
+pub(crate) fn generate_string(
+    tc: *mut c::HegelTestCase,
+    generator: *const c::HegelStringGenerator,
+) -> PyResult<Vec<u8>> {
+    let mut result = c::hegel_owned_string_t::default();
+    with_ctx(|ctx| {
+        check(unsafe { c::hegel_generate_string(ctx, tc, generator, &mut result) })?;
+        let bytes =
+            unsafe { std::slice::from_raw_parts(result.data as *const u8, result.len) }.to_vec();
+        let _ = unsafe { c::hegel_owned_string_free(ctx, &mut result) };
+        Ok(bytes)
+    })
+}
+
+pub(crate) fn choices_blob(tc: *mut c::HegelTestCase) -> PyResult<String> {
+    let mut result = c::hegel_owned_string_t::default();
+    with_ctx(|ctx| {
+        check(unsafe { c::hegel_test_case_choices(ctx, tc, &mut result) })?;
+        let bytes =
+            unsafe { std::slice::from_raw_parts(result.data as *const u8, result.len) }.to_vec();
+        let _ = unsafe { c::hegel_owned_string_free(ctx, &mut result) };
+        Ok(String::from_utf8_lossy(&bytes).into_owned())
+    })
+}
