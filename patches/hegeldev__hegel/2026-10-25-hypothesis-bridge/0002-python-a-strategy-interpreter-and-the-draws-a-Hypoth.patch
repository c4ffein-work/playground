index 00000000..1697d5ee
--- /dev/null
+++ b/frontends/python/tests/test_native_bridge.py
@@ -0,0 +1,171 @@
+"""The ``hegel._native`` entry points a frontend built on another API uses
+(the Hypothesis-on-libhegel experiment): weighted and forced integer draws,
+explicit-range text generators, a case's choices as a blob, replaying one,
+and the strategy interpreter."""
+
+from __future__ import annotations
+
+import pytest
+
+from hegel import _native
+
+
+def _settings(test_cases: int = 20, seed: int = 7) -> _native.Settings:
+    s = _native.Settings.new()
+    s.set_test_cases(test_cases)
+    s.set_database("")
+    s.set_phases(_native.PHASE_GENERATE)
+    s.set_seed(seed)
+    return s
+
+
+def _cases(test_cases: int = 20):
+    run = _native.Run.start(_settings(test_cases))
+    while (tc := run.next_test_case()) is not None:
+        yield tc
+        tc.mark_complete(_native.STATUS_VALID, None)
+
+
+def test_weighted_integers_take_their_keys_and_stay_in_range():
+    seen = {7: 0, 42: 0, "other": 0}
+    for tc in _cases(400):
+        v = tc.generate_integer_weighted(0, 1000, [7, 42], [0.3, 0.2], 0)
+        assert 0 <= v <= 1000
+        seen[v if v in (7, 42) else "other"] += 1
+    assert seen[7] > 40 and seen[42] > 20 and seen["other"] > 60
+
+
+def test_weighted_integers_validate_their_arguments():
+    for tc in _cases(1):
+        with pytest.raises(_native.InvalidArgument):
+            tc.generate_integer_weighted(0, 5, [7], [0.3], 0)
+        with pytest.raises(_native.InvalidArgument):
+            tc.generate_integer_weighted(0, 5, [1, 2], [0.3], 0)
+        with pytest.raises(_native.InvalidArgument):
+            tc.generate_integer_weighted(0, 5, [1], [1.5], 0)
+
+
+def test_forced_integers_take_a_choice_position_and_replay():
+    for tc in _cases(5):
+        a = tc.generate_integer(0, 1000)
+        assert tc.generate_integer(0, 2, forced=1) == 1
+        with pytest.raises(_native.InvalidArgument):
+            tc.generate_integer(0, 2, forced=3)
+        with pytest.raises(_native.InvalidArgument):
+            tc.generate_integer(0, 2**70, forced=1)
+        b = tc.generate_integer(0, 1000)
+        replay = _native.TestCase.from_blob(_settings(), tc.choices_blob())
+        assert replay.generate_integer(0, 1000) == a
+        assert replay.generate_integer(0, 2, forced=2) == 2
+        assert replay.generate_integer(0, 1000) == b
+        replay.mark_complete(_native.STATUS_VALID, None)
+
+
+def test_text_ranges_draw_only_from_the_ranges():
+    gen = _native.StringGenerator.text_ranges(1, 4, [(97, 99), (0x1F600, 0x1F601)])
+    seen = set()
+    for tc in _cases(200):
+        text = tc.generate_string(gen).decode("utf-8", "surrogatepass")
+        assert 1 <= len(text) <= 4
+        for c in text:
+            assert c in "abc\U0001f600\U0001f601"
+            seen.add(c)
+    assert len(seen) >= 3
+    for bad in ([(99, 97)], [(97, 99), (98, 100)], [(0, 0x110000)]):
+        with pytest.raises(_native.InvalidArgument):
+            _native.StringGenerator.text_ranges(0, 5, bad)
+    with pytest.raises(_native.InvalidArgument):
+        _native.StringGenerator.text_ranges(1, 5, [(0xD800, 0xDFFF)])
+
+
+class _Retry(Exception):
+    pass
+
+
+def _compiled(desc: tuple) -> _native.CompiledStrategy:
+    return _native.CompiledStrategy(desc, 11, 12, 13, _Retry)
+
+
+def _generate(tc: _native.TestCase, desc: tuple, draw=None):
+    recorded: list = []
+    value = tc.generate(
+        _compiled(desc),
+        draw or (lambda s: s),
+        recorded.extend,
+        lambda reason: (_ for _ in ()).throw(_native.AssumeFailed(reason)),
+    )
+    return value, recorded
+
+
+def test_the_interpreter_builds_values_and_records_their_choices():
+    gen = _native.StringGenerator.text_ranges(0, 3, [(97, 98)])
+    desc = (
+        "tuple",
+        [
+            ("int", -(2**70), 2**70, 0, [], [], 1),
+            ("float", 0.0, 1.0, False, 5e-324, 2),
+            ("bool", 0.5, 3),
+            ("bytes", 0, 2, 4),
+            ("text", gen, 5),
+            ("list", ("int", 0, 3, 0, [], [], 6), 1, 3, 0.5, 7),
+            ("one_of", [("just", "x", [], 8), ("sampled", [10, 20], [str], 9)], 14, 10),
+            ("fixeddict", ["a", "b"], [("bool", 0.5, 15), ("bool", 0.5, 16)], dict, 17),
+            ("map", ("int", 0, 9, 0, [], [], 18), lambda x: x * 2, 19),
+            (
+                "builds",
+                lambda *a, **k: (a, k),
+                [("int", 0, 1, 0, [], [], 20)],
+                ["k"],
+                [("just", 5, [], 21)],
+                22,
+            ),
+            ("filter", ("int", 0, 100, 0, [], [], 23), [lambda x: True], "integers()", 24),
+            ("opaque", "handled by the frontend"),
+        ],
+        0,
+    )
+    for tc in _cases(30):
+        value, recorded = _generate(tc, desc, draw=lambda s: s.upper())
+        n, f, b, bs, text, xs, alt, d, m, built, flt, opaque = value
+        assert -(2**70) <= n <= 2**70 and 0.0 <= f <= 1.0 and isinstance(b, bool)
+        assert isinstance(bs, bytes) and len(bs) <= 2
+        assert set(text) <= {"a", "b"} and len(text) <= 3
+        assert 1 <= len(xs) <= 3 and all(0 <= x <= 3 for x in xs)
+        assert alt in ("x", "10", "20")
+        assert set(d) == {"a", "b"} and m % 2 == 0
+        assert built == ((0,), {"k": 5}) or built == ((1,), {"k": 5})
+        assert 0 <= flt <= 100 and opaque == "HANDLED BY THE FRONTEND"
+        kinds = [k for k, _ in recorded]
+        assert kinds[:5] == ["integer", "float", "boolean", "bytes", "string"]
+        assert all(k in ("integer", "float", "boolean", "bytes", "string") for k in kinds)
+        replay = _native.TestCase.from_blob(_settings(), tc.choices_blob())
+        again, _ = _generate(replay, desc, draw=lambda s: s.upper())
+        assert again == value
+        replay.mark_complete(_native.STATUS_VALID, None)
+
+
+def test_a_filter_that_never_passes_hands_the_case_to_the_invalid_callback():
+    desc = ("filter", ("int", 0, 100, 0, [], [], 1), [lambda x: False], "never", 2)
+    for tc in _cases(3):
+        with pytest.raises(_native.AssumeFailed):
+            _generate(tc, desc)
+
+
+def test_a_map_retries_on_its_retry_exception_then_gives_up():
+    calls = []
+
+    def pack(x):
+        calls.append(x)
+        raise _Retry
+
+    desc = ("map", ("int", 0, 9, 0, [], [], 1), pack, 2)
+    for tc in _cases(2):
+        calls.clear()
+        with pytest.raises(_Retry):
+            _generate(tc, desc)
+        assert len(calls) == 3
+
+
+def test_unknown_nodes_are_rejected_when_compiled():
+    with pytest.raises(_native.InvalidArgument):
+        _compiled(("nope", 1))
