diff --git a/libhegel/RELEASE/float-signed-zero-bounds.md b/libhegel/RELEASE/float-signed-zero-bounds.md
new file mode 100644
index 000000000..da77546c8
--- /dev/null
+++ b/libhegel/RELEASE/float-signed-zero-bounds.md
@@ -0,0 +1,3 @@
+RELEASE_TYPE: patch
+
+This patch makes `hegel_generate_float` reject `min_value=0.0, max_value=-0.0` with `HEGEL_E_INVALID_ARG`. The bounds check compared them with `>`, which treats the two zeros as equal, so the draw went ahead on a range with no valid float and failed with an internal error. Bounds are now compared as the rest of the engine compares floats, with `-0.0` below `0.0`.
diff --git a/libhegel/src/native/draws/mod.rs b/libhegel/src/native/draws/mod.rs
index 885a3accd..6aca01d76 100644
--- a/libhegel/src/native/draws/mod.rs
+++ b/libhegel/src/native/draws/mod.rs
@@ -12,6 +12,7 @@ use crate::native::core::{
     EngineError, FloatChoice, FloatWidth, ManyState, NativeTestCase, RecursionState, Status,
     float_restrict_and_redraw,
 };
+use crate::native::floats::sign_aware_lte;
 use crate::native::intervalsets::IntervalSet;
 use crate::unicodedata::UnicodeVersion;
 use alloc::boxed::Box;
@@ -132,7 +133,7 @@ pub fn generate_float(ntc: &mut NativeTestCase, spec: &FloatSpec) -> Result<f64,
         min_value = min_value.max(f64::from(f32::MIN));
         max_value = max_value.min(f64::from(f32::MAX));
     }
-    if min_value > max_value {
+    if !sign_aware_lte(min_value, max_value) {
         return Err(EngineError::InvalidArgument(format!(
             "min_value ({min_value}) must be <= max_value ({max_value}) \
              after exclusive-bound adjustment"
