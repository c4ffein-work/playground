     else:
         die("Error: the password store is not a git repository. Try \"pass git init\".")
 
+# pass sync: trade the store with other devices through a drop zone.
+#
+# A drop zone is a directory that every device can reach and that nobody has to trust: a local
+# path, or sftp://user@host[:port][/dir]. Each device publishes one file there,
+# <device>.bundle.gpg: a git bundle of its whole history under the single reference
+# refs/pass-sync/<device>, signed with the device's key and encrypted to every device.
+# This computer is the owner of the store: it takes the other devices' commits only as a
+# fast-forward, only when they are signed by a device, and only when they change entries.
+
+SYNC_MAX_FILE_SIZE = 256 * 1024 * 1024
+SYNC_DEVICE_NAME = re.compile(r'[a-z0-9][a-z0-9-]{0,31}')
+# What a device that is not the owner may change: entries, and nothing hidden (.gpg-id, .extensions/...).
+SYNC_ENTRY_PATH = re.compile(r'(?:[^./][^/]*/)*[^./][^/]*\.gpg')
+
+def sync_git(*args, check=True, text=True, extra_env=None):
+    """Run git on the store. Returns the completed process; dies on failure when check is set."""
+    env = dict(os.environ, **extra_env) if extra_env else None
+    result = subprocess.run(['git', '-C', PASSWORD_STORE_DIR] + list(args),
+                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=text, env=env)
+    if check and result.returncode != 0:
+        stderr = result.stderr if text else result.stderr.decode(errors='replace')
+        die(f"git {args[0]} failed: {stderr.strip()}")
+    return result
+
+def sync_fingerprint(text):
+    """A key fingerprint as 40 uppercase hex digits, however it was typed."""
+    fingerprint = re.sub(r'[\s:]', '', text).upper()
+    if fingerprint.startswith('0X'):
+        fingerprint = fingerprint[2:]
+    if not re.fullmatch(r'[0-9A-F]{40}', fingerprint):
+        die(f"Not a full key fingerprint (40 hex digits): {text}")
+    return fingerprint
+
+def sync_check_device_name(name):
+    if not SYNC_DEVICE_NAME.fullmatch(name):
+        die(f"Not a device name (a-z, 0-9 and -, at most 32, not starting with -): {name}")
+    return name
+
+def sync_check_key(fingerprint, secret=False):
+    """Die unless gpg has this key: as a primary key, by its full fingerprint."""
+    listing = subprocess.run([GPG, '--batch', '--with-colons', '--list-secret-keys' if secret else '--list-keys',
+                              fingerprint], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+    kind = None
+    for line in listing.stdout.splitlines():
+        fields = line.split(':')
+        if fields[0] in ('pub', 'sec', 'sub', 'ssb'):
+            kind = fields[0]
+        elif fields[0] == 'fpr' and kind in ('pub', 'sec') and fields[9] == fingerprint:
+            return
+    die(f"gpg has no {'secret' if secret else 'public'} key with the fingerprint {fingerprint}")
+
+def sync_config():
+    """The sync settings of this store, from its git configuration."""
+    if not is_git_repository(PASSWORD_STORE_DIR):
+        die("The password store is not a git repository. Try \"pass git init\".")
+    def get(key):
+        return sync_git('config', '--local', '--get', f'pass-sync.{key}', check=False).stdout.strip()
+    config = {'device': get('device'), 'url': get('url'), 'key': get('key'), 'peers': {}}
+    if not (config['device'] and config['url'] and config['key']):
+        die(f"Sync is not set up. Try \"{EXECUTABLE_NAME} sync setup device-name drop-zone own-key-fingerprint\".")
+    sync_check_device_name(config['device'])
+    for value in sync_git('config', '--local', '--get-all', 'pass-sync.peer', check=False).stdout.splitlines():
+        name, _, fingerprint = value.partition(' ')
+        config['peers'][sync_check_device_name(name)] = sync_fingerprint(fingerprint)
+    config['sftp-options'] = get('sftp-options').split()
+    return config
+
+def sync_peer(config, name):
+    if name not in config['peers']:
+        known = ', '.join(sorted(config['peers'])) or 'none'
+        die(f"No device named {name} (known: {known}). Try \"{EXECUTABLE_NAME} sync peer name key-fingerprint\".")
+    return config['peers'][name]
+
+def sync_ref(device):
+    return f'refs/pass-sync/{device}'
+
+def sync_tip(device):
+    """The commit held for a device, or None."""
+    result = sync_git('rev-parse', '--verify', '--quiet', sync_ref(device) + '^{commit}', check=False)
+    return result.stdout.strip() or None
+
+def sync_tmpdir():
+    return tempfile.mkdtemp(prefix=f"{os.path.basename(sys.argv[0])}.sync.",
+                            dir='/dev/shm' if os.path.isdir('/dev/shm') else None)
+
+def sync_sftp(config, commands):
+    """Run sftp commands in the drop zone. Returns whether all of them worked."""
+    match = re.fullmatch(r'sftp://(?:([^@/:]+)@)?(\[[0-9A-Fa-f:.]+\]|[^@/:\[\]]+)(?::(\d+))?(/.*)?', config['url'])
+    if not match:
+        die(f"Not a drop zone address (sftp://user@host[:port][/dir], or a local directory): {config['url']}")
+    user, host, port, directory = match.groups()
+    if host.startswith('-') or (user or '').startswith('-'):
+        die(f"Not a drop zone address: {config['url']}")
+    command = ['sftp', '-q', '-b', '-'] + (['-P', port] if port else []) + config['sftp-options']
+    command.append(f'{user}@{host}' if user else host)
+    batch = ''.join(f'{line}\n' for line in ([f'cd "{directory}"'] if directory and directory != '/' else []) + commands)
+    try:
+        result = subprocess.run(command, input=batch, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+    except FileNotFoundError:
+        die("sftp is not installed.")
+    return result.returncode == 0, result.stderr.strip()
+
+def sync_upload(config, local_path, name):
+    """Put a file in the drop zone under a name: beside it first, then renamed over it."""
+    if config['url'].startswith('sftp://'):
+        ok, error = sync_sftp(config, [f'put "{local_path}" "{name}.part"', f'rename "{name}.part" "{name}"'])
+        if not ok:
+            die(f"Could not publish to {config['url']}: {error}")
+        return
+    if not os.path.isdir(config['url']):
+        die(f"The drop zone {config['url']} is not a directory.")
+    part = os.path.join(config['url'], f'{name}.part')
+    shutil.copyfile(local_path, part)
+    os.replace(part, os.path.join(config['url'], name))
+
+def sync_download(config, name, local_path):
+    """Get a file from the drop zone. Returns False when it is not there."""
+    if config['url'].startswith('sftp://'):
+        ok, error = sync_sftp(config, [f'get "{name}" "{local_path}"'])
+        if not ok and not re.search(r'not found|no such file', error, re.IGNORECASE):
+            die(f"Could not read {config['url']}: {error}")
+        return ok and os.path.isfile(local_path)
+    source = os.path.join(config['url'], name)
+    if not os.path.isfile(source):
+        return False
+    if os.path.getsize(source) > SYNC_MAX_FILE_SIZE:
+        return True  # the caller measures the copy: an empty one says "too big" as well as a full one
+    shutil.copyfile(source, local_path)
+    return True
+
+def sync_bundle_references(path):
+    """What a bundle says it holds: (references as (commit, name), prerequisite commits)."""
+    references, prerequisites = [], []
+    with open(path, 'rb') as bundle:
+        if bundle.readline() != b'# v2 git bundle\n':
+            return None, None
+        for line in iter(bundle.readline, b''):
+            if line == b'\n':
+                return references, prerequisites
+            line = line.decode('utf-8', errors='replace').rstrip('\n')
+            if line.startswith('-'):
+                prerequisites.append(line[1:].split(' ')[0])
+            else:
+                commit, _, name = line.partition(' ')
+                references.append((commit, name))
+    return None, None  # no end of header: not a bundle
+
+def sync_changes(base, tip):
+    """The files that differ between two commits: (status, mode after, path). No rename detection."""
+    raw = sync_git('diff', '--raw', '-z', '--no-renames', '--no-abbrev', base, tip).stdout
+    fields = raw.split('\0')
+    return [(meta.split(' ')[4], meta.split(' ')[1], path) for meta, path in zip(fields[0::2], fields[1::2])]
+
+def sync_outstanding(config, name):
+    """How a device's tip stands against the store: (tip, commits it has more, commits it lacks)."""
+    tip = sync_tip(name)
+    if not tip:
+        return None, 0, 0
+    ahead, behind = sync_git('rev-list', '--left-right', '--count', f'{tip}...HEAD').stdout.split()
+    return tip, int(ahead), int(behind)
+
+def sync_describe(config, name):
+    tip, ahead, behind = sync_outstanding(config, name)
+    if not tip:
+        return f"{name}: nothing received yet"
+    if ahead == 0:
+        return f"{name}: has nothing this store lacks" + (f", is {behind} commit(s) behind" if behind else "")
+    text = f"{name}: {ahead} commit(s) to take"
+    if behind:
+        text += f", but {behind} behind: publish with \"{EXECUTABLE_NAME} sync push\" and let it merge first"
+    return text
+
+def cmd_sync_setup(argv):
+    if len(argv) != 3:
+        die(f"Usage: {EXECUTABLE_NAME} sync setup device-name drop-zone own-key-fingerprint")
+    if not is_git_repository(PASSWORD_STORE_DIR):
+        die("The password store is not a git repository. Try \"pass git init\".")
+    name, url, fingerprint = sync_check_device_name(argv[0]), argv[1], sync_fingerprint(argv[2])
+    sync_check_key(fingerprint, secret=True)
+    if not url.startswith('sftp://'):
+        url = os.path.abspath(url)
+        if not os.path.isdir(url):
+            die(f"The drop zone {url} is not a directory (for a server: sftp://user@host[:port][/dir]).")
+    for key, value in (('device', name), ('url', url), ('key', fingerprint)):
+        sync_git('config', '--local', f'pass-sync.{key}', value)
+    print(f"This store is {name}, published to {url}, signed with {fingerprint}.")
+
+def cmd_sync_peer(argv):
+    remove = argv[:1] == ['--remove']
+    if len(argv) != 2:
+        die(f"Usage: {EXECUTABLE_NAME} sync peer [--remove] device-name [key-fingerprint]")
+    config = sync_config()
+    name = sync_check_device_name(argv[1] if remove else argv[0])
+    if name == config['device']:
+        die(f"{name} is this device.")
+    if not remove:
+        fingerprint = sync_fingerprint(argv[1])
+        sync_check_key(fingerprint)
+        config['peers'][name] = fingerprint
+    elif config['peers'].pop(name, None) is None:
+        die(f"No device named {name}.")
+    sync_git('config', '--local', '--unset-all', 'pass-sync.peer', check=False)
+    for peer, fingerprint in sorted(config['peers'].items()):
+        sync_git('config', '--local', '--add', 'pass-sync.peer', f'{peer} {fingerprint}')
+    if remove:
+        sync_git('update-ref', '-d', sync_ref(name))
+        print(f"{name} is no longer a device of this store. It can still read what it could read: "
+              "remove its key from the .gpg-id files with \"pass init\", and change those passwords.")
+    else:
+        print(f"{name} is a device of this store, with the key {fingerprint}.")
+
+def cmd_sync_status(argv):
+    config = sync_config()
+    print(f"This device: {config['device']} ({config['key']})")
+    print(f"Drop zone: {config['url']}")
+    published = sync_tip(config['device'])
+    head = sync_git('rev-parse', 'HEAD').stdout.strip()
+    print("Published: " + ("the current state" if published == head else
+                           "not yet" if not published else "an earlier state: \"sync push\" to publish"))
+    for name in sorted(config['peers']):
+        print(sync_describe(config, name))
+    if not config['peers']:
+        print(f"No other device. Try \"{EXECUTABLE_NAME} sync peer name key-fingerprint\".")
+
+def cmd_sync_push(argv):
+    config = sync_config()
+    name = config['device']
+    sync_check_key(config['key'], secret=True)
+    if sync_git('status', '--porcelain').stdout.strip():
+        print("Note: the store has changes that are not committed. They are not published.", file=sys.stderr)
+    sync_git('update-ref', sync_ref(name), 'HEAD')
+    tmpdir = sync_tmpdir()
+    try:
+        bundle, message = os.path.join(tmpdir, 'bundle'), os.path.join(tmpdir, 'message')
+        sync_git('bundle', 'create', '--version=2', bundle, sync_ref(name))
+        # SHA-512 said out loud: left to itself gpg can fall back to SHA-1 for a recipient key that
+        # states no preference, and a careful reader refuses that.
+        command = [GPG] + PASSWORD_STORE_GPG_OPTS + [
+            '--batch', '--yes', '--quiet', '--no-encrypt-to', '--compress-algo', 'none', '--digest-algo', 'SHA512',
+            '--trust-model', 'always', '--local-user', config['key'] + '!', '--sign', '--encrypt',
+            '--recipient', config['key']]
+        for fingerprint in config['peers'].values():
+            command += ['--recipient', fingerprint]
+        result = subprocess.run(command + ['--output', message, bundle], stderr=subprocess.PIPE, text=True)
+        if result.returncode != 0:
+            die(f"gpg could not sign and encrypt the bundle: {result.stderr.strip()}")
+        sync_upload(config, message, f'{name}.bundle.gpg')
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
+    readers = ', '.join(sorted(config['peers'])) or 'no other device yet'
+    print(f"Published {sync_git('rev-parse', '--short', 'HEAD').stdout.strip()} for: {readers}.")
+
+def sync_receive(config, name, tmpdir):
+    """Take the file a device published. Returns a one-line account of what happened."""
+    fingerprint = sync_peer(config, name)
+    message, bundle = os.path.join(tmpdir, f'{name}.message'), os.path.join(tmpdir, f'{name}.bundle')
+    if not sync_download(config, f'{name}.bundle.gpg', message):
+        return f"{name}: has published nothing"
+    if not os.path.isfile(message) or os.path.getsize(message) > SYNC_MAX_FILE_SIZE:
+        return f"{name}: REFUSED, its file is larger than {SYNC_MAX_FILE_SIZE // (1024 * 1024)} MiB"
+    # --status-fd is the only thing to believe: one valid signature, made by this device's key.
+    # --max-output: anyone can encrypt to our key, so what comes out is bounded before any signature counts.
+    result = subprocess.run([GPG] + PASSWORD_STORE_GPG_OPTS + [
+        '--batch', '--yes', '--quiet', '--status-fd', '1', '--max-output', str(SYNC_MAX_FILE_SIZE),
+        '--output', bundle, '--decrypt', message], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+    status = [line.split(' ')[1:] for line in result.stdout.splitlines() if line.startswith('[GNUPG:] ')]
+    valid = [fields for fields in status if fields[0] == 'VALIDSIG']
+    bad = [fields[0] for fields in status if fields[0] in ('BADSIG', 'ERRSIG', 'EXPSIG', 'EXPKEYSIG', 'REVKEYSIG')]
+    if result.returncode != 0 or not any(fields[0] == 'DECRYPTION_OKAY' for fields in status):
+        return f"{name}: REFUSED, its file does not decrypt"
+    if bad or len(valid) != 1 or valid[0][-1] != fingerprint:
+        signer = valid[0][-1] if len(valid) == 1 and not bad else 'nobody we can check'
+        return f"{name}: REFUSED, its file is signed by {signer}, not by its key {fingerprint}"
+    if valid[0][8] not in ('8', '9', '10'):  # SHA-256, SHA-384, SHA-512
+        return f"{name}: REFUSED, its file is signed with a weak digest (algorithm {valid[0][8]})"
+    published = time.strftime('%Y-%m-%d %H:%M', time.localtime(int(valid[0][3])))
+
+    references, prerequisites = sync_bundle_references(bundle)
+    if references is None:
+        return f"{name}: REFUSED, its file is not a git bundle"
+    if prerequisites or len(references) != 1 or references[0][1] != sync_ref(name):
+        return f"{name}: REFUSED, its bundle must hold {sync_ref(name)} alone, with its whole history"
+    tip = references[0][0]
+    if not re.fullmatch(r'[0-9a-f]{40}', tip):
+        return f"{name}: REFUSED, its bundle names no commit"
+    held = sync_tip(name)
+    if held == tip:
+        return f"{sync_describe(config, name)} (nothing new since {published})"
+    if held and sync_git('merge-base', '--is-ancestor', tip, held, check=False).returncode == 0:
+        return f"{name}: IGNORED, an old file was served again (published {published})"
+    fetched = sync_git('fetch', '--quiet', '--no-tags', bundle, f'+{sync_ref(name)}:{sync_ref(name)}', check=False)
+    if fetched.returncode != 0:
+        return f"{name}: REFUSED, its bundle is not complete: {fetched.stderr.strip()}"
+    return f"{sync_describe(config, name)} (published {published})"
+
+def cmd_sync_fetch(argv):
+    config = sync_config()
+    names = argv or sorted(config['peers'])
+    if not names:
+        die(f"No other device. Try \"{EXECUTABLE_NAME} sync peer name key-fingerprint\".")
+    tmpdir = sync_tmpdir()
+    try:
+        accounts = [sync_receive(config, name, tmpdir) for name in names]
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
+    print('\n'.join(accounts))
+    if any('REFUSED' in account for account in accounts):
+        sys.exit(1)
+
+def sync_signers(config, name, tip):
+    """The commits a device has more than the store: (commit, subject, who signed it or None)."""
+    devices = {config['key']: config['device'], sync_peer(config, name): name}
+    log = sync_git('log', '--reverse', '--format=%H%x1f%G?%x1f%GP%x1f%s', f'HEAD..{tip}').stdout
+    commits = []
+    for line in log.splitlines():
+        commit, state, fingerprint, subject = line.split('\x1f', 3)
+        # G: good, from a key gpg trusts. U: good, from a key it has no opinion on. The key is ours to judge.
+        commits.append((commit, subject, devices.get(fingerprint) if state in ('G', 'U') else None))
+    return commits
+
+def cmd_sync_log(argv):
+    if len(argv) != 1:
+        die(f"Usage: {EXECUTABLE_NAME} sync log device-name")
+    config = sync_config()
+    name = argv[0]
+    tip, ahead, _ = sync_outstanding(config, name) if sync_peer(config, name) else (None, 0, 0)
+    if not ahead:
+        print(sync_describe(config, name))
+        return
+    for commit, subject, signer in sync_signers(config, name, tip):
+        print(f"{commit[:10]}  {('signed by ' + signer) if signer else 'NOT SIGNED BY A DEVICE':24}  {subject}")
+    print()
+    letters = {'A': 'added', 'M': 'changed', 'D': 'removed', 'T': 'changed type'}
+    for status, _, path in sync_changes('HEAD', tip):
+        print(f"  {letters.get(status, status):8} {path[:-4] if path.endswith('.gpg') else path}")
+    print()
+    print(sync_describe(config, name))
+
+def cmd_sync_diff(argv):
+    if len(argv) != 1:
+        die(f"Usage: {EXECUTABLE_NAME} sync diff device-name")
+    config = sync_config()
+    sync_peer(config, argv[0])
+    tip = sync_tip(argv[0])
+    if not tip:
+        die(f"Nothing received from {argv[0]} yet. Try \"{EXECUTABLE_NAME} sync fetch\".")
+    # Decrypted, whatever the store's own git configuration says.
+    tmpdir = sync_tmpdir()
+    try:
+        attributes = os.path.join(tmpdir, 'attributes')
+        with open(attributes, 'w') as f:
+            f.write('*.gpg diff=pass-sync\n')
+        subprocess.run(['git', '-C', PASSWORD_STORE_DIR, '-c', f'core.attributesFile={attributes}',
+                        '-c', 'diff.pass-sync.binary=true',
+                        '-c', 'diff.pass-sync.textconv=' + ' '.join(
+                            [GPG] + PASSWORD_STORE_GPG_OPTS + ['--decrypt', '--quiet', '--yes', '--batch']),
+                        'diff', '--no-renames', 'HEAD', tip], check=False)
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
+
+def cmd_sync_merge(argv):
+    if len(argv) != 1:
+        die(f"Usage: {EXECUTABLE_NAME} sync merge device-name")
+    config = sync_config()
+    name = argv[0]
+    sync_peer(config, name)
+    tip, ahead, behind = sync_outstanding(config, name)
+    if not tip:
+        die(f"Nothing received from {name} yet. Try \"{EXECUTABLE_NAME} sync fetch\".")
+    if ahead == 0:
+        print(sync_describe(config, name))
+        return
