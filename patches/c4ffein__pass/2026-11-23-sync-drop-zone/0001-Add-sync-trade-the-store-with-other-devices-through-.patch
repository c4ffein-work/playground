     else:
         die("Error: the password store is not a git repository. Try \"pass git init\".")
 
+# pass sync: trade the store with other devices through a drop zone.
+#
+# A drop zone is a directory that every device can reach and that nobody has to trust: a local
+# path, or sftp://user@host[:port][/dir]. Each device publishes one file there,
+# <device>.bundle.gpg: a git bundle of its whole history under the single reference
+# refs/pass-sync/<device>, signed with the device's key and encrypted to every device.
+# Devices are equals: each takes another's changes when its user has looked at them, and merges.
+# Entries are followed through moves; who reads a folder (.gpg-id) can be changed by any device,
+# but a reader is always a device, and nothing but entries and .gpg-id files travels.
+
+SYNC_MAX_FILE_SIZE = 256 * 1024 * 1024
+SYNC_DEVICE_NAME = re.compile(r'[a-z0-9][a-z0-9-]{0,31}')
+# What a synced store holds: entries, readers files, and the .gitattributes of "pass git init".
+SYNC_ENTRY_PATH = re.compile(r'(?:[^./][^/]*/)*[^./][^/]*\.gpg')
+SYNC_READERS_PATH = re.compile(r'(?:[^./][^/]*/)*\.gpg-id')
+
+def sync_git(*args, check=True, text=True, extra_env=None):
+    """Run git on the store. Returns the completed process; dies on failure when check is set."""
+    env = dict(os.environ, **extra_env) if extra_env else None
+    result = subprocess.run(['git', '-C', PASSWORD_STORE_DIR] + list(args),
+                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=text, env=env)
+    if check and result.returncode != 0:
+        stderr = result.stderr if text else result.stderr.decode(errors='replace')
+        die(f"git {args[0]} failed: {stderr.strip()}")
+    return result
+
+def sync_fingerprint(text):
+    """A key fingerprint as 40 uppercase hex digits, however it was typed."""
+    fingerprint = re.sub(r'[\s:]', '', text).upper()
+    if fingerprint.startswith('0X'):
+        fingerprint = fingerprint[2:]
+    if not re.fullmatch(r'[0-9A-F]{40}', fingerprint):
+        die(f"Not a full key fingerprint (40 hex digits): {text}")
+    return fingerprint
+
+def sync_check_device_name(name):
+    if not SYNC_DEVICE_NAME.fullmatch(name):
+        die(f"Not a device name (a-z, 0-9 and -, at most 32, not starting with -): {name}")
+    return name
+
+def sync_check_key(fingerprint, secret=False):
+    """Die unless gpg has this key: as a primary key, by its full fingerprint."""
+    listing = subprocess.run([GPG, '--batch', '--with-colons', '--list-secret-keys' if secret else '--list-keys',
+                              fingerprint], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+    kind = None
+    for line in listing.stdout.splitlines():
+        fields = line.split(':')
+        if fields[0] in ('pub', 'sec', 'sub', 'ssb'):
+            kind = fields[0]
+        elif fields[0] == 'fpr' and kind in ('pub', 'sec') and fields[9] == fingerprint:
+            return
+    die(f"gpg has no {'secret' if secret else 'public'} key with the fingerprint {fingerprint}")
+
+def sync_config():
+    """The sync settings of this store, from its git configuration."""
+    if not is_git_repository(PASSWORD_STORE_DIR):
+        die("The password store is not a git repository. Try \"pass git init\".")
+    def get(key):
+        return sync_git('config', '--local', '--get', f'pass-sync.{key}', check=False).stdout.strip()
+    config = {'device': get('device'), 'url': get('url'), 'key': get('key'), 'peers': {}}
+    if not (config['device'] and config['url'] and config['key']):
+        die(f"Sync is not set up. Try \"{EXECUTABLE_NAME} sync setup device-name drop-zone own-key-fingerprint\".")
+    sync_check_device_name(config['device'])
+    for value in sync_git('config', '--local', '--get-all', 'pass-sync.peer', check=False).stdout.splitlines():
+        name, _, fingerprint = value.partition(' ')
+        config['peers'][sync_check_device_name(name)] = sync_fingerprint(fingerprint)
+    config['sftp-options'] = get('sftp-options').split()
+    return config
+
+def sync_peer(config, name):
+    if name not in config['peers']:
+        known = ', '.join(sorted(config['peers'])) or 'none'
+        die(f"No device named {name} (known: {known}). Try \"{EXECUTABLE_NAME} sync peer name key-fingerprint\".")
+    return config['peers'][name]
+
+def sync_tree(commit):
+    """The files of a commit: path -> (mode, blob). Empty for no commit."""
+    if not commit:
+        return {}
+    files = {}
+    for line in sync_git('ls-tree', '-r', '-z', commit).stdout.split('\0'):
+        if line:
+            meta, path = line.split('\t', 1)
+            mode, _, blob = meta.split(' ')
+            files[path] = (mode, blob)
+    return files
+
+SYNC_BLOBS = {}
+
+def sync_blob(blob):
+    """The bytes of a git blob."""
+    if blob not in SYNC_BLOBS:
+        SYNC_BLOBS[blob] = sync_git('cat-file', 'blob', blob, text=False).stdout
+    return SYNC_BLOBS[blob]
+
+def sync_key_ids(data):
+    """The key ids an OpenPGP message is encrypted to, read from its first packets.
+    None when it is not something we can vouch for (not a message, or a packet version we do not know)."""
+    ids, at = [], 0
+    while at < len(data):
+        first = data[at]
+        if not first & 0x80:
+            return None
+        if first & 0x40:  # new format
+            tag = first & 0x3f
+            if at + 1 >= len(data):
+                return None
+            length = data[at + 1]
+            if length < 192:
+                start = at + 2
+            elif length < 224:
+                if at + 2 >= len(data):
+                    return None
+                length, start = ((length - 192) << 8) + data[at + 2] + 192, at + 3
+            elif length == 255:
+                length, start = int.from_bytes(data[at + 2:at + 6], 'big'), at + 6
+            else:  # partial lengths: only data packets have them, and those end the search
+                return ids if ids and tag in (18, 20) else None
+        else:  # old format
+            tag, kind = (first >> 2) & 0x0f, first & 0x03
+            if kind == 3:
+                return ids if ids and tag in (18, 20) else None
+            size = (1, 2, 4)[kind]
+            length, start = int.from_bytes(data[at + 1:at + 1 + size], 'big'), at + 1 + size
+        if tag in (18, 20):  # the encrypted data: every recipient has been seen
+            return ids or None
+        if tag != 1 or start + 9 > len(data) or data[start] != 3:
+            return None
+        ids.append(data[start + 1:start + 9].hex().upper())
+        at = start + length
+    return None
+
+def sync_devices(config):
+    """Everything about the devices' keys: {'names': fingerprint -> name, 'ids': encryption key id -> name}."""
+    if 'devices' not in config:
+        names = {config['key']: config['device']}
+        names.update({fingerprint: name for name, fingerprint in config['peers'].items()})
+        ids = {}
+        for fingerprint, name in names.items():
+            listing = subprocess.run([GPG, '--batch', '--with-colons', '--list-keys', fingerprint],
+                                     stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True).stdout
+            for line in listing.splitlines():
+                fields = line.split(':')
+                if fields[0] in ('pub', 'sub'):
+                    ids[fields[4]] = name
+        config['devices'] = {'names': names, 'ids': ids, 'lines': {}}
+    return config['devices']
+
+def sync_reader(config, line):
+    """The device a .gpg-id line names, or None when it names no key, several, or one that is no device's."""
+    devices = sync_devices(config)
+    if line not in devices['lines']:
+        listing = subprocess.run([GPG, '--batch', '--with-colons', '--list-keys', '--', line],
+                                 stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True).stdout
+        found, primary = [], False
+        for row in listing.splitlines():
+            fields = row.split(':')
+            if fields[0] in ('pub', 'sub'):
+                primary = fields[0] == 'pub'
+            elif fields[0] == 'fpr' and primary:
+                found.append(fields[9])
+                primary = False
+        devices['lines'][line] = devices['names'].get(found[0]) if len(found) == 1 else None
+    return devices['lines'][line]
+
+def sync_readers_of(config, files, path):
+    """Who should read what is at this path in these files: (sorted device names or None for a bad file, directory)."""
+    directory = os.path.dirname(path)
+    while True:
+        readers_file = f'{directory}/.gpg-id' if directory else '.gpg-id'
+        if readers_file in files:
+            lines = [line.split('#')[0].strip() for line in
+                     sync_blob(files[readers_file][1]).decode('utf-8', errors='replace').splitlines()]
+            names = [sync_reader(config, line) for line in lines if line]
+            return (None if None in names or not names else sorted(set(names))), directory
+        if not directory:
+            return None, ''
+        directory = os.path.dirname(directory)
+
+def sync_encrypted_to(config, blob):
+    """The devices an entry's file is encrypted to: sorted names, or None when one is no device (or it is no entry)."""
+    ids = sync_key_ids(sync_blob(blob))
+    devices = sync_devices(config)
+    if not ids or any(key_id not in devices['ids'] for key_id in ids):
+        return None
+    return sorted({devices['ids'][key_id] for key_id in ids})
+
+def sync_problems(config, files):
+    """Why these files cannot be a synced store: a list of sentences, empty when they can."""
+    problems = []
+    for path, (mode, blob) in sorted(files.items()):
+        if path == '.gitattributes' and mode == '100644':
+            # What "pass git init" writes, and nothing else: attributes can name filters.
+            if sync_blob(blob) != b'*.gpg diff=gpg\n':
+                problems.append(".gitattributes is not the one line of \"pass git init\"")
+        elif mode != '100644' or not (SYNC_ENTRY_PATH.fullmatch(path) or SYNC_READERS_PATH.fullmatch(path)):
+            problems.append(f"{path} is neither an entry nor a .gpg-id")
+        elif path.endswith('/.gpg-id') or path == '.gpg-id':
+            if sync_readers_of(config, files, os.path.join(os.path.dirname(path), 'x'))[0] is None:
+                problems.append(f"{path} names a reader that is not a device")
+        elif sync_encrypted_to(config, blob) is None:
+            problems.append(f"{path} is encrypted to a key that is no device's")
+    if files and '.gpg-id' not in files:
+        problems.append("there is no .gpg-id at the root")
+    return problems
+
+def sync_stale(config, files):
+    """The entries whose file is not encrypted to the readers their .gpg-id says: path -> (readers, directory)."""
+    stale = {}
+    for path, (_, blob) in files.items():
+        if SYNC_ENTRY_PATH.fullmatch(path):
+            readers, directory = sync_readers_of(config, files, path)
+            if readers is not None and sync_encrypted_to(config, blob) != readers:
+                stale[path] = (readers, directory)
+    return stale
+
+SYNC_PLAINTEXTS = {}
+
+def sync_plaintext(blob):
+    """What an entry's file says, or None when this device cannot read it."""
+    if blob not in SYNC_PLAINTEXTS:
+        result = subprocess.run([GPG] + PASSWORD_STORE_GPG_OPTS + ['--batch', '--quiet', '--yes', '--decrypt'],
+                                input=sync_blob(blob), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        SYNC_PLAINTEXTS[blob] = result.stdout if result.returncode == 0 else None
+    return SYNC_PLAINTEXTS[blob]
+
+def sync_same(one, other):
+    """Two versions of an entry are the same: the same bytes, or the same text for a device that reads both."""
+    if one == other:
+        return True
+    if one is None or other is None:
+        return False
+    text = sync_plaintext(one)
+    return text is not None and text == sync_plaintext(other)
+
+def sync_entry_name(path):
+    return path[:-4]
+
+def sync_moves(base, side):
+    """Entries of base that side has under another name: old path -> new path. One to one, in name order."""
+    gone = sorted(path for path in base if path not in side)
+    new = sorted(path for path in side if path not in base)
+    moves = {}
+    for old in gone:
+        for candidate in new:
+            if candidate not in moves.values() and sync_same(base[old], side[candidate]):
+                moves[old] = candidate
+                break
+    return moves
+
+def sync_plan(config, base_commit, mine_commit, theirs_commit, choices=None):
+    """What taking theirs into mine gives, both grown from base.
+    Returns (files: path -> blob, lines for the user, names that need a choice)."""
+    choices = choices or {}
+    trees = [sync_tree(commit) for commit in (base_commit, mine_commit, theirs_commit)]
+    entries = [{path: blob for path, (_, blob) in tree.items() if SYNC_ENTRY_PATH.fullmatch(path)} for tree in trees]
+    readers = [{path: blob for path, (_, blob) in tree.items() if SYNC_READERS_PATH.fullmatch(path)} for tree in trees]
+    base, mine, theirs = entries
+    moved_mine, moved_theirs = sync_moves(base, mine), sync_moves(base, theirs)
+    lines, conflicts = [], []
+    # path -> the versions that want to be there: (blob, what each side made of that entry).
+    # "What a side made of an entry" is (path, blob), or None when it has it no more (or never had it).
+    landing = {}
+
+    def land(path, blob, of_mine, of_theirs):
+        landing.setdefault(path, []).append((blob, {'mine': of_mine, 'theirs': of_theirs}))
+
+    def choose(name, of_mine, of_theirs):
+        """Lands what the chosen side made of the entry, or records that a choice is missing."""
+        conflicts.append(name)
+        chosen = {'mine': of_mine, 'theirs': of_theirs}.get(choices.get(name), of_mine)
+        if chosen:
+            land(chosen[0], chosen[1], chosen if chosen is of_mine else None, chosen if chosen is of_theirs else None)
+
+    # Entries that were there before.
+    for path, blob in base.items():
+        state = []
+        for side, moved in ((mine, moved_mine), (theirs, moved_theirs)):
+            now = moved.get(path, path)
+            state.append((now, side[now]) if now in side else None)
+        of_mine, of_theirs = state
+        touched_mine = of_mine is None or of_mine[0] != path or not sync_same(of_mine[1], blob)
+        touched_theirs = of_theirs is None or of_theirs[0] != path or not sync_same(of_theirs[1], blob)
+        if of_theirs is None:
+            lines.append(f"removed {sync_entry_name(path)}")
+        else:
+            if of_theirs[0] != path:
+                lines.append(f"moved {sync_entry_name(path)} -> {sync_entry_name(of_theirs[0])}")
+            if not sync_same(of_theirs[1], blob):
+                lines.append(f"changed {sync_entry_name(of_theirs[0])}")
+        name = sync_entry_name((of_mine or of_theirs or (path,))[0])
+        if not touched_theirs:
+            if of_mine:
+                land(of_mine[0], of_mine[1], of_mine, of_theirs)
+        elif not touched_mine:
+            if of_theirs:
+                land(of_theirs[0], of_theirs[1], of_mine, of_theirs)
+        elif of_mine is None and of_theirs is None:
+            pass
+        elif of_mine is None or of_theirs is None:
+            choose(name, of_mine, of_theirs)
+        else:
+            names = {of_mine[0], of_theirs[0]} - {path}
+            new_mine, new_theirs = not sync_same(of_mine[1], blob), not sync_same(of_theirs[1], blob)
+            if len(names) > 1 or (new_mine and new_theirs and not sync_same(of_mine[1], of_theirs[1])):
+                choose(name, of_mine, of_theirs)
+            else:
+                land(names.pop() if names else path, of_theirs[1] if new_theirs and not new_mine else of_mine[1],
+                     of_mine, of_theirs)
+
+    # Entries that are new.
+    new_mine = {path: blob for path, blob in mine.items() if path not in base and path not in moved_mine.values()}
+    new_theirs = {path: blob for path, blob in theirs.items() if path not in base and path not in moved_theirs.values()}
+    for path in sorted(new_theirs):
+        lines.append(f"added {sync_entry_name(path)}")
+    for path in sorted(set(new_mine) | set(new_theirs)):
+        if path in new_mine and path in new_theirs and sync_same(new_mine[path], new_theirs[path]):
+            land(path, new_mine[path], (path, new_mine[path]), (path, new_theirs[path]))
+        else:
+            if path in new_mine:
+                land(path, new_mine[path], (path, new_mine[path]), None)
+            if path in new_theirs:
+                land(path, new_theirs[path], None, (path, new_theirs[path]))
+
+    # Two different entries under one name: the chosen side's state of each, so that neither is lost
+    # (theirs moved nothing and added y, mine moved x to y: "theirs" is x back at x, and their y).
+    files, contested = {}, []
+    for path, wanting in landing.items():
+        if all(sync_same(blob, wanting[0][0]) for blob, _ in wanting):
+            files[path] = wanting[0][0]
+        else:
+            contested.append(path)
+    for path in contested:
+        name = sync_entry_name(path)
+        if name not in conflicts:
+            conflicts.append(name)
+        for _, made in landing[path]:
+            kept = made[choices.get(name, 'mine')]
+            if kept:
+                files[kept[0]] = kept[1]
+
+    # Readers files, whole.
+    readers_base, readers_mine, readers_theirs = readers
+    for path in sorted(set(readers_base) | set(readers_mine) | set(readers_theirs)):
+        was, of_mine, of_theirs = readers_base.get(path), readers_mine.get(path), readers_theirs.get(path)
+        directory = os.path.dirname(path) + '/'
+        if of_theirs != was:
+            names = sync_readers_of(config, trees[2], os.path.join(os.path.dirname(path), 'x'))[0] if of_theirs else None
+            lines.append(f"readers {directory}: {' '.join(names) if names else 'inherited' if not of_theirs else '?'}")
+        if of_mine == of_theirs or of_theirs == was:
+            kept = of_mine
+        elif of_mine == was:
+            kept = of_theirs
+        else:
+            conflicts.append(directory)
+            kept = of_theirs if choices.get(directory) == 'theirs' else of_mine
+        if kept:
+            files[path] = kept
+    if '.gitattributes' in trees[1] or '.gitattributes' in trees[2]:
+        files['.gitattributes'] = (trees[1].get('.gitattributes') or trees[2]['.gitattributes'])[1]
+
+    for path in sorted(sync_stale(config, trees[2])):
+        lines.append(f"stale {sync_entry_name(path)}")
+    lines += [f"conflict {name}" for name in conflicts]
+    return files, lines, conflicts
+
+def sync_base(tip):
+    """The last commit this store and a tip have in common, or None."""
+    if sync_git('rev-parse', '--verify', '--quiet', 'HEAD^{commit}', check=False).returncode != 0:
+        return None
+    return sync_git('merge-base', 'HEAD', tip, check=False).stdout.strip() or None
+
+def sync_head():
+    return sync_git('rev-parse', '--verify', '--quiet', 'HEAD^{commit}', check=False).stdout.strip() or None
+
+def sync_ref(device):
+    return f'refs/pass-sync/{device}'
+
+def sync_tip(device):
+    """The commit held for a device, or None."""
+    result = sync_git('rev-parse', '--verify', '--quiet', sync_ref(device) + '^{commit}', check=False)
+    return result.stdout.strip() or None
+
+def sync_tmpdir():
+    return tempfile.mkdtemp(prefix=f"{os.path.basename(sys.argv[0])}.sync.",
+                            dir='/dev/shm' if os.path.isdir('/dev/shm') else None)
+
+def sync_sftp(config, commands):
+    """Run sftp commands in the drop zone. Returns whether all of them worked."""
+    match = re.fullmatch(r'sftp://(?:([^@/:]+)@)?(\[[0-9A-Fa-f:.]+\]|[^@/:\[\]]+)(?::(\d+))?(/.*)?', config['url'])
+    if not match:
+        die(f"Not a drop zone address (sftp://user@host[:port][/dir], or a local directory): {config['url']}")
+    user, host, port, directory = match.groups()
+    if host.startswith('-') or (user or '').startswith('-'):
+        die(f"Not a drop zone address: {config['url']}")
+    command = ['sftp', '-q', '-b', '-'] + (['-P', port] if port else []) + config['sftp-options']
+    command.append(f'{user}@{host}' if user else host)
+    batch = ''.join(f'{line}\n' for line in ([f'cd "{directory}"'] if directory and directory != '/' else []) + commands)
+    try:
+        result = subprocess.run(command, input=batch, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+    except FileNotFoundError:
+        die("sftp is not installed.")
+    return result.returncode == 0, result.stderr.strip()
+
+def sync_upload(config, local_path, name):
+    """Put a file in the drop zone under a name: beside it first, then renamed over it."""
+    if config['url'].startswith('sftp://'):
+        ok, error = sync_sftp(config, [f'put "{local_path}" "{name}.part"', f'rename "{name}.part" "{name}"'])
+        if not ok:
+            die(f"Could not publish to {config['url']}: {error}")
+        return
+    if not os.path.isdir(config['url']):
+        die(f"The drop zone {config['url']} is not a directory.")
+    part = os.path.join(config['url'], f'{name}.part')
+    shutil.copyfile(local_path, part)
+    os.replace(part, os.path.join(config['url'], name))
+
+def sync_download(config, name, local_path):
+    """Get a file from the drop zone. Returns False when it is not there."""
+    if config['url'].startswith('sftp://'):
+        ok, error = sync_sftp(config, [f'get "{name}" "{local_path}"'])
+        if not ok and not re.search(r'not found|no such file', error, re.IGNORECASE):
+            die(f"Could not read {config['url']}: {error}")
+        return ok and os.path.isfile(local_path)
+    source = os.path.join(config['url'], name)
+    if not os.path.isfile(source):
+        return False
+    if os.path.getsize(source) > SYNC_MAX_FILE_SIZE:
+        return True  # the caller measures the copy: an empty one says "too big" as well as a full one
+    shutil.copyfile(source, local_path)
+    return True
+
+def sync_bundle_references(path):
+    """What a bundle says it holds: (references as (commit, name), prerequisite commits)."""
+    references, prerequisites = [], []
+    with open(path, 'rb') as bundle:
+        if bundle.readline() != b'# v2 git bundle\n':
+            return None, None
+        for line in iter(bundle.readline, b''):
+            if line == b'\n':
+                return references, prerequisites
+            line = line.decode('utf-8', errors='replace').rstrip('\n')
+            if line.startswith('-'):
+                prerequisites.append(line[1:].split(' ')[0])
+            else:
+                commit, _, name = line.partition(' ')
+                references.append((commit, name))
+    return None, None  # no end of header: not a bundle
+
+def sync_outstanding(config, name):
+    """How a device's tip stands against the store: (tip, commits it has more, commits it lacks)."""
+    tip = sync_tip(name)
+    if not tip:
+        return None, 0, 0
+    if not sync_head():
+        return tip, int(sync_git('rev-list', '--count', tip).stdout), 0
+    ahead, behind = sync_git('rev-list', '--left-right', '--count', f'{tip}...HEAD').stdout.split()
+    return tip, int(ahead), int(behind)
+
+def sync_describe(config, name):
+    tip, ahead, behind = sync_outstanding(config, name)
+    if not tip:
+        return f"{name}: nothing received yet"
+    if ahead == 0:
+        return f"{name}: nothing to take" + (f" (it lacks {behind} commit(s) of this store)" if behind else "")
+    return f"{name}: {ahead} commit(s) to take"
+
+def cmd_sync_setup(argv):
+    if len(argv) != 3:
+        die(f"Usage: {EXECUTABLE_NAME} sync setup device-name drop-zone own-key-fingerprint")
+    if not is_git_repository(PASSWORD_STORE_DIR):
+        # A device that is about to adopt another's store starts from nothing.
+        if os.path.isdir(PASSWORD_STORE_DIR) and os.listdir(PASSWORD_STORE_DIR):
+            die("The password store is not a git repository. Try \"pass git init\".")
+        os.makedirs(PASSWORD_STORE_DIR, exist_ok=True)
+        subprocess.run(['git', '-C', PASSWORD_STORE_DIR, 'init', '--quiet'], check=True)
+    name, url, fingerprint = sync_check_device_name(argv[0]), argv[1], sync_fingerprint(argv[2])
+    sync_check_key(fingerprint, secret=True)
+    if not url.startswith('sftp://'):
+        url = os.path.abspath(url)
+        if not os.path.isdir(url):
+            die(f"The drop zone {url} is not a directory (for a server: sftp://user@host[:port][/dir]).")
+    for key, value in (('device', name), ('url', url), ('key', fingerprint)):
+        sync_git('config', '--local', f'pass-sync.{key}', value)
+    # This device's commits say whose they are.
+    for key, value in (('user.signingkey', fingerprint), ('gpg.format', 'openpgp'), ('pass.signcommits', 'true')):
+        sync_git('config', '--local', key, value)
+    print(f"This store is {name}, published to {url}, signed with {fingerprint}.")
+
+def cmd_sync_peer(argv):
+    remove = argv[:1] == ['--remove']
+    if len(argv) != 2:
+        die(f"Usage: {EXECUTABLE_NAME} sync peer [--remove] device-name [key-fingerprint]")
+    config = sync_config()
+    name = sync_check_device_name(argv[1] if remove else argv[0])
+    if name == config['device']:
+        die(f"{name} is this device.")
+    if not remove:
+        fingerprint = sync_fingerprint(argv[1])
+        sync_check_key(fingerprint)
+        config['peers'][name] = fingerprint
+    elif config['peers'].pop(name, None) is None:
+        die(f"No device named {name}.")
+    sync_git('config', '--local', '--unset-all', 'pass-sync.peer', check=False)
+    for peer, fingerprint in sorted(config['peers'].items()):
+        sync_git('config', '--local', '--add', 'pass-sync.peer', f'{peer} {fingerprint}')
+    if remove:
+        sync_git('update-ref', '-d', sync_ref(name))
+        print(f"{name} is no longer a device of this store. It can still read what it could read: "
+              "remove its key from the .gpg-id files with \"pass init\", and change those passwords.")
+    else:
+        print(f"{name} is a device of this store, with the key {fingerprint}.")
+
+def cmd_sync_status(argv):
+    config = sync_config()
+    print(f"This device: {config['device']} ({config['key']})")
+    print(f"Drop zone: {config['url']}")
+    published = sync_tip(config['device'])
+    head = sync_head()
+    print("Published: " + ("the current state" if published and published == head else
+                           "not yet" if not published else "an earlier state: \"sync push\" to publish"))
+    for name in sorted(config['peers']):
+        print(sync_describe(config, name))
+    for path in sorted(sync_stale(config, sync_tree(head))):
+        print(f"stale {sync_entry_name(path)}")
+    if not config['peers']:
+        print(f"No other device. Try \"{EXECUTABLE_NAME} sync peer name key-fingerprint\".")
+
+def cmd_sync_push(argv):
+    config = sync_config()
+    name = config['device']
+    sync_check_key(config['key'], secret=True)
+    if not sync_head():
+        die("The store is empty: nothing to publish.")
+    problems = sync_problems(config, sync_tree('HEAD'))
+    if problems:
+        die("This cannot be published, a synced store holds entries and .gpg-id files of devices only:\n  "
+            + "\n  ".join(problems))
+    if sync_git('status', '--porcelain').stdout.strip():
+        print("Note: the store has changes that are not committed. They are not published.", file=sys.stderr)
+    sync_git('update-ref', sync_ref(name), 'HEAD')
+    tmpdir = sync_tmpdir()
+    try:
+        bundle, message = os.path.join(tmpdir, 'bundle'), os.path.join(tmpdir, 'message')
+        sync_git('bundle', 'create', '--version=2', bundle, sync_ref(name))
+        # SHA-512 said out loud: left to itself gpg can fall back to SHA-1 for a recipient key that
+        # states no preference, and a careful reader refuses that.
+        command = [GPG] + PASSWORD_STORE_GPG_OPTS + [
+            '--batch', '--yes', '--quiet', '--no-encrypt-to', '--compress-algo', 'none', '--digest-algo', 'SHA512',
+            '--trust-model', 'always', '--local-user', config['key'] + '!', '--sign', '--encrypt',
+            '--recipient', config['key']]
+        for fingerprint in config['peers'].values():
+            command += ['--recipient', fingerprint]
+        result = subprocess.run(command + ['--output', message, bundle], stderr=subprocess.PIPE, text=True)
+        if result.returncode != 0:
+            die(f"gpg could not sign and encrypt the bundle: {result.stderr.strip()}")
+        sync_upload(config, message, f'{name}.bundle.gpg')
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
+    readers = ', '.join(sorted(config['peers'])) or 'no other device yet'
+    print(f"Published {sync_git('rev-parse', '--short', 'HEAD').stdout.strip()} for: {readers}.")
+
+def sync_receive(config, name, tmpdir):
+    """Take the file a device published. Returns a one-line account of what happened."""
+    fingerprint = sync_peer(config, name)
+    message, bundle = os.path.join(tmpdir, f'{name}.message'), os.path.join(tmpdir, f'{name}.bundle')
+    if not sync_download(config, f'{name}.bundle.gpg', message):
+        return f"{name}: has published nothing"
+    if not os.path.isfile(message) or os.path.getsize(message) > SYNC_MAX_FILE_SIZE:
+        return f"{name}: REFUSED, its file is larger than {SYNC_MAX_FILE_SIZE // (1024 * 1024)} MiB"
+    # --status-fd is the only thing to believe: one valid signature, made by this device's key.
+    # --max-output: anyone can encrypt to our key, so what comes out is bounded before any signature counts.
+    result = subprocess.run([GPG] + PASSWORD_STORE_GPG_OPTS + [
+        '--batch', '--yes', '--quiet', '--status-fd', '1', '--max-output', str(SYNC_MAX_FILE_SIZE),
+        '--output', bundle, '--decrypt', message], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+    status = [line.split(' ')[1:] for line in result.stdout.splitlines() if line.startswith('[GNUPG:] ')]
+    valid = [fields for fields in status if fields[0] == 'VALIDSIG']
+    bad = [fields[0] for fields in status if fields[0] in ('BADSIG', 'ERRSIG', 'EXPSIG', 'EXPKEYSIG', 'REVKEYSIG')]
+    if result.returncode != 0 or not any(fields[0] == 'DECRYPTION_OKAY' for fields in status):
+        return f"{name}: REFUSED, its file does not decrypt"
+    if bad or len(valid) != 1 or valid[0][-1] != fingerprint:
+        signer = valid[0][-1] if len(valid) == 1 and not bad else 'nobody we can check'
+        return f"{name}: REFUSED, its file is signed by {signer}, not by its key {fingerprint}"
+    if valid[0][8] not in ('8', '9', '10'):  # SHA-256, SHA-384, SHA-512
+        return f"{name}: REFUSED, its file is signed with a weak digest (algorithm {valid[0][8]})"
+    published = time.strftime('%Y-%m-%d %H:%M', time.localtime(int(valid[0][3])))
+
+    references, prerequisites = sync_bundle_references(bundle)
+    if references is None:
+        return f"{name}: REFUSED, its file is not a git bundle"
+    if prerequisites or len(references) != 1 or references[0][1] != sync_ref(name):
+        return f"{name}: REFUSED, its bundle must hold {sync_ref(name)} alone, with its whole history"
+    tip = references[0][0]
+    if not re.fullmatch(r'[0-9a-f]{40}', tip):
+        return f"{name}: REFUSED, its bundle names no commit"
+    held = sync_tip(name)
+    if held == tip:
+        return f"{sync_describe(config, name)} (nothing new since {published})"
+    if held and sync_git('merge-base', '--is-ancestor', tip, held, check=False).returncode == 0:
+        return f"{name}: IGNORED, an old file was served again (published {published})"
+    fetched = sync_git('fetch', '--quiet', '--no-tags', bundle, f'+{sync_ref(name)}:refs/pass-sync-incoming/{name}',
+                       check=False)
+    if fetched.returncode != 0:
+        return f"{name}: REFUSED, its bundle is not complete: {fetched.stderr.strip()}"
+    sync_git('update-ref', '-d', f'refs/pass-sync-incoming/{name}')
+    problems = sync_problems(config, sync_tree(tip))
+    if problems:
+        return f"{name}: REFUSED, {'; '.join(problems)}"
+    sync_git('update-ref', sync_ref(name), tip)
+    return f"{sync_describe(config, name)} (published {published})"
+
+def cmd_sync_fetch(argv):
+    config = sync_config()
+    names = argv or sorted(config['peers'])
+    if not names:
+        die(f"No other device. Try \"{EXECUTABLE_NAME} sync peer name key-fingerprint\".")
+    tmpdir = sync_tmpdir()
+    try:
+        accounts = [sync_receive(config, name, tmpdir) for name in names]
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
+    print('\n'.join(accounts))
+    if any('REFUSED' in account for account in accounts):
+        sys.exit(1)
+
+def sync_signers(config, tip):
+    """The commits of a tip that the store lacks: (commit, subject, the device that signed it or None)."""
+    devices = sync_devices(config)['names']
+    since = [f'HEAD..{tip}'] if sync_head() else [tip]
+    log = sync_git('log', '--reverse', '--format=%H%x1f%G?%x1f%GP%x1f%s', *since).stdout
+    commits = []
+    for line in log.splitlines():
+        commit, state, fingerprint, subject = line.split('\x1f', 3)
+        # G: good, from a key gpg trusts. U: good, from a key it has no opinion on. The key is ours to judge.
+        commits.append((commit, subject, devices.get(fingerprint) if state in ('G', 'U') else None))
+    return commits
+
+def cmd_sync_log(argv):
+    if len(argv) != 1:
+        die(f"Usage: {EXECUTABLE_NAME} sync log device-name")
+    config = sync_config()
+    name = argv[0]
+    sync_peer(config, name)
+    tip, ahead, _ = sync_outstanding(config, name)
+    if not ahead:
+        print(sync_describe(config, name))
+        return
+    for commit, subject, signer in sync_signers(config, tip):
+        print(f"{commit[:10]}  {('signed by ' + signer) if signer else 'not signed':18}  {subject}")
+    print()
+    _, lines, _ = sync_plan(config, sync_base(tip), sync_head(), tip)
+    print('\n'.join(lines))
+
+def cmd_sync_diff(argv):
+    if len(argv) != 1:
+        die(f"Usage: {EXECUTABLE_NAME} sync diff device-name")
+    config = sync_config()
+    sync_peer(config, argv[0])
+    tip = sync_tip(argv[0])
+    if not tip:
+        die(f"Nothing received from {argv[0]} yet. Try \"{EXECUTABLE_NAME} sync fetch\".")
+    # Decrypted, whatever the store's own git configuration says.
+    tmpdir = sync_tmpdir()
+    try:
+        attributes = os.path.join(tmpdir, 'attributes')
+        with open(attributes, 'w') as f:
+            f.write('*.gpg diff=pass-sync\n')
+        subprocess.run(['git', '-C', PASSWORD_STORE_DIR, '-c', f'core.attributesFile={attributes}',
+                        '-c', 'diff.pass-sync.binary=true',
+                        '-c', 'diff.pass-sync.textconv=' + ' '.join(
+                            [GPG] + PASSWORD_STORE_GPG_OPTS + ['--decrypt', '--quiet', '--yes', '--batch']),
+                        'diff', '--no-renames', sync_base(tip) or '4b825dc642cb6eb9a060e54bf8d69288fbee4904', tip],
+                       check=False)
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
+
+def sync_reencrypt(config):
+    """Re-encrypt, for the readers their .gpg-id names, the stale entries this device reads. Commits that."""
+    devices = sync_devices(config)
+    fingerprints = {name: fingerprint for fingerprint, name in devices['names'].items()}
+    files = sync_tree('HEAD')
+    done = set()
+    for path, (readers, directory) in sorted(sync_stale(config, files).items()):
+        text = sync_plaintext(files[path][1])
+        if text is None:
+            continue
+        command = [GPG] + PASSWORD_STORE_GPG_OPTS + ['--batch', '--yes', '--quiet', '--no-encrypt-to',
+                                                     '--compress-algo', 'none', '--trust-model', 'always', '--encrypt']
+        for reader in readers:
+            command += ['--recipient', fingerprints[reader]]
+        target = os.path.join(PASSWORD_STORE_DIR, path)
+        result = subprocess.run(command + ['--output', target], input=text, stderr=subprocess.PIPE)
+        if result.returncode != 0:
+            die(f"gpg could not re-encrypt {path}: {result.stderr.decode(errors='replace').strip()}")
+        sync_git('add', '--', path)
+        done.add(directory + '/')
+    if done:
+        sync_git('-c', 'gpg.format=openpgp', 'commit', '--quiet', f"-S{config['key']}", '-m',
+                 f"Reencrypt for the readers of {', '.join(sorted(done))}.")
+    return len(done)
+
+def cmd_sync_merge(argv):
+    choices, names = {}, []
+    while argv:
+        argument = argv.pop(0)
+        if argument in ('--mine', '--theirs') and argv:
+            choices[argv.pop(0)] = argument[2:]
+        else:
+            names.append(argument)
+    if len(names) != 1:
+        die(f"Usage: {EXECUTABLE_NAME} sync merge device-name [--mine name | --theirs name]...")
+    config = sync_config()
+    name = names[0]
+    sync_peer(config, name)
+    sync_check_key(config['key'], secret=True)
+    tip, ahead, _ = sync_outstanding(config, name)
+    if not tip:
+        die(f"Nothing received from {name} yet. Try \"{EXECUTABLE_NAME} sync fetch\".")
+    if ahead == 0:
+        print(sync_describe(config, name))
+        return
+    if sync_git('status', '--porcelain', '--untracked-files=no').stdout.strip():
+        die("The store has changes that are not committed.")
+    head, base = sync_head(), sync_base(tip)
+    problems = sync_problems(config, sync_tree(tip))
+    if problems:
+        die(f"{name}'s store is not one to take:\n  " + "\n  ".join(problems))
+    if head and not base:
+        die(f"{name}'s store and this one have nothing in common. Only an empty store adopts another.")
+
+    if not head:
+        if [entry for entry in os.listdir(PASSWORD_STORE_DIR) if entry != '.git']:
+            die("The store has no history but is not empty.")
+        sync_git('reset', '--quiet', '--hard', tip)
+        print(f"Adopted {name}'s store.")
+    elif base == head:
+        sync_git('merge', '--quiet', '--ff-only', tip)
+        print(f"Took {ahead} commit(s) from {name}.")
+    else:
+        files, _, conflicts = sync_plan(config, base, head, tip, choices)
+        missing = [conflict for conflict in conflicts if choices.get(conflict) not in ('mine', 'theirs')]
+        if missing:
+            die("Both sides changed these, differently. Nothing was taken. Say which to keep, for each, with "
+                "--mine name or --theirs name:\n  " + "\n  ".join(missing))
+        # The merged tree, written without touching the working tree; then moving to it is a fast-forward.
+        tmpdir = sync_tmpdir()
+        try:
+            index = {'GIT_INDEX_FILE': os.path.join(tmpdir, 'index')}
+            sync_git('read-tree', '--empty', extra_env=index)
+            listing = ''.join(f'100644 blob {blob}\t{path}\0' for path, blob in sorted(files.items()))
+            result = subprocess.run(['git', '-C', PASSWORD_STORE_DIR, 'update-index', '-z', '--index-info'],
+                                    input=listing.encode(), env=dict(os.environ, **index), stderr=subprocess.PIPE)
+            if result.returncode != 0:
