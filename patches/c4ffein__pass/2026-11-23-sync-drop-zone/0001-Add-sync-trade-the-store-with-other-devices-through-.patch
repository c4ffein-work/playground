+    for status, mode, path in sync_changes('HEAD', tip):
+        if not SYNC_ENTRY_PATH.fullmatch(path) or (status != 'D' and mode != '100644'):
+            die(f"{name} changes {path}, which is not an entry: only this device does that. Nothing was taken.")
+    sync_git('merge', '--quiet', '--ff-only', tip)
+    print(f"Took {ahead} commit(s) from {name}.")
+    cmd_sync_push([])
+
+def cmd_sync(argv):
+    """Trade the store with other devices through a drop zone."""
+    commands = {'setup': cmd_sync_setup, 'peer': cmd_sync_peer, 'status': cmd_sync_status, 'push': cmd_sync_push,
+                'fetch': cmd_sync_fetch, 'log': cmd_sync_log, 'diff': cmd_sync_diff, 'merge': cmd_sync_merge}
