diff --git a/test_tricks/additional-tests/u0008-sync-tests.sh b/test_tricks/additional-tests/u0008-sync-tests.sh
new file mode 100755
index 0000000..dda2e62
--- /dev/null
+++ b/test_tricks/additional-tests/u0008-sync-tests.sh
@@ -0,0 +1,310 @@
+#!/usr/bin/env bash
+
+test_description='Test sync: two devices trading a store through a drop zone'
+cd "$(dirname "$0")"
+. ./setup.sh
+
+# Two stores, "pc" (KEY1) and "laptop" (KEY2), and a directory between them as the drop zone.
+# Both keys are in the one test keyring, so each device reads everything: what a device that is
+# not a reader sees is played in the scenarios of c4ffein-work/playground, with a keyring each.
+STORES="$SHARNESS_TRASH_DIRECTORY"
+DROP="$STORES/drop"
+
+on() {
+	local device="$1"
+	shift
+	PASSWORD_STORE_DIR="$STORES/$device" GIT_DIR="$STORES/$device/.git" GIT_WORK_TREE="$STORES/$device" "$@"
+}
+pc() { on pc "$PASS" "$@"; }
+laptop() { on laptop "$PASS" "$@"; }
+
+# trade: each publishes, each receives.
+trade() {
+	pc sync push >/dev/null && laptop sync push >/dev/null && pc sync fetch >/dev/null && laptop sync fetch >/dev/null
+}
+
+# raw_publish device key [reference...]: what a device gone wrong would publish, past its own checks.
+raw_publish() {
+	local device="$1" key="$2"
+	shift 2
+	on "$device" git update-ref "refs/pass-sync/$device" HEAD &&
+	on "$device" git bundle create --version=2 "$STORES/raw.bundle" "${@:-refs/pass-sync/$device}" &&
+	$GPG --batch --yes --quiet --trust-model always --compress-algo none --digest-algo SHA512 --local-user "$key" \
+		--sign --encrypt --recipient $KEY1 --recipient $KEY2 --output "$DROP/$device.bundle.gpg" "$STORES/raw.bundle"
+}
+
+test_expect_success 'Setup: a store on pc, nothing yet on laptop' '
+	mkdir "$DROP" "$STORES/pc" &&
+	pc init $KEY1 $KEY2 &&
+	pc git init &&
+	pc generate first 20
+'
+
+test_expect_success 'Sync says what is missing before it is set up' '
+	test_must_fail pc sync push 2>err &&
+	grep -q "sync setup" err &&
+	test_must_fail pc sync setup Pc "$DROP" $KEY1 &&
+	test_must_fail pc sync setup pc "$DROP" 0123 &&
+	test_must_fail pc sync setup pc "$DROP/missing" $KEY1 &&
+	pc sync setup pc "$DROP" $KEY1 &&
+	test_must_fail pc sync peer laptop 0000000000000000000000000000000000000000 &&
+	test_must_fail pc sync peer pc $KEY1 &&
+	test_must_fail pc sync log laptop &&
+	pc sync peer laptop "$(echo $KEY2 | tr A-F a-f | sed "s/..../& /g")" &&
+	pc sync status >out &&
+	grep -q "Published: not yet" out &&
+	grep -q "laptop: nothing received yet" out &&
+	laptop sync setup laptop "$DROP" $KEY2 &&
+	laptop sync peer pc $KEY1 &&
+	test_must_fail laptop sync push
+'
+
+test_expect_success 'Push publishes one signed file, and an empty store adopts it' '
+	pc sync push &&
+	test "$(ls "$DROP")" = "pc.bundle.gpg" &&
+	$GPG --batch --yes --quiet --status-fd 3 --output pc.bundle --decrypt "$DROP/pc.bundle.gpg" 3>status &&
+	grep -q "VALIDSIG .* $KEY1\$" status &&
+	grep -q "VALIDSIG [0-9A-F]* [-0-9]* [0-9]* [0-9]* [0-9]* [0-9]* [0-9]* 10 " status &&
+	test "$(grep -c "ENC_TO" status)" = 2 &&
+	test "$(git bundle list-heads pc.bundle | cut -d" " -f2)" = "refs/pass-sync/pc" &&
+	laptop sync fetch >out &&
+	grep -q "pc: [0-9]* commit(s) to take" out &&
+	laptop sync log pc >out &&
+	grep -q "^added first\$" out &&
+	grep -q "^readers /: laptop pc\$" out &&
+	laptop sync merge pc | grep -q "Adopted" &&
+	test "$(laptop show first)" = "$(pc show first)" &&
+	laptop sync merge pc | grep -q "nothing to take"
+'
+
+test_expect_success 'One side changed: the other moves forward' '
+	echo "typed on the laptop" | laptop insert -e from-laptop &&
+	trade &&
+	pc sync log laptop >out &&
+	grep -q "signed by laptop" out &&
+	grep -q "^added from-laptop\$" out &&
+	pc sync diff laptop | grep -q "^+typed on the laptop" &&
+	pc sync merge laptop | grep -q "Took 1 commit" &&
+	test "$(pc show from-laptop)" = "typed on the laptop"
+'
+
+test_expect_success 'Both sides changed different entries: a merge, and no question' '
+	echo one | pc insert -e only-pc &&
+	echo two | laptop insert -e only-laptop &&
+	trade &&
+	pc sync merge laptop | grep -q "Merged 1 commit" &&
+	trade &&
+	laptop sync merge pc | grep -q "Took" &&
+	test "$(laptop show only-pc)" = one &&
+	test "$(pc show only-laptop)" = two &&
+	test "$(on pc git rev-parse HEAD)" = "$(on laptop git rev-parse HEAD)"
+'
+
+test_expect_success 'Both sides changed the same entry: nothing is taken without a choice' '
+	echo "says pc" | pc insert -e -f first &&
+	echo "says laptop" | laptop insert -e -f first &&
+	trade &&
+	pc sync log laptop | grep -q "^conflict first\$" &&
+	before=$(on pc git rev-parse HEAD) &&
+	test_must_fail pc sync merge laptop 2>err &&
+	grep -q -- "--mine name or --theirs name" err &&
+	grep -q "^  first\$" err &&
+	test "$(on pc git rev-parse HEAD)" = "$before" &&
+	pc sync merge laptop --theirs first &&
+	test "$(pc show first)" = "says laptop" &&
+	trade &&
+	laptop sync merge pc &&
+	echo "pc again" | pc insert -e -f first &&
+	echo "laptop again" | laptop insert -e -f first &&
+	trade &&
+	pc sync merge laptop --mine first &&
+	trade &&
+	laptop sync merge pc &&
+	test "$(laptop show first)" = "pc again"
+'
+
+test_expect_success 'The same change made on both sides is no conflict' '
+	echo "agreed" | pc insert -e -f first &&
+	echo "agreed" | laptop insert -e -f first &&
+	trade &&
+	pc sync merge laptop &&
+	trade &&
+	laptop sync merge pc &&
+	test "$(laptop show first)" = agreed
+'
+
+test_expect_success 'An entry moved on one side and changed on the other is both' '
+	pc mv first moved/first &&
+	echo "changed where it was" | laptop insert -e -f first &&
+	trade &&
+	laptop sync log pc | grep -q "^moved first -> moved/first\$" &&
+	laptop sync merge pc &&
+	test "$(laptop show moved/first)" = "changed where it was" &&
+	test_must_fail laptop show first &&
+	trade &&
+	pc sync merge laptop &&
+	test "$(pc show moved/first)" = "changed where it was"
+'
+
+test_expect_success 'Two entries wanting one name: the chosen side keeps both as it has them' '
+	pc mv only-pc contested &&
+	echo "laptop put this here" | laptop insert -e contested &&
+	trade &&
+	pc sync log laptop | grep -q "^conflict contested\$" &&
+	test_must_fail pc sync merge laptop &&
+	pc sync merge laptop --theirs contested &&
+	test "$(pc show contested)" = "laptop put this here" &&
+	test "$(pc show only-pc)" = one &&
+	trade &&
+	laptop sync merge pc
+'
+
+test_expect_success 'Readers changed by a device that did not re-encrypt: taking it does' '
+	echo "work secret" | pc insert -e work/w1 &&
+	pc init -p work $KEY1 &&
+	trade &&
+	laptop sync merge pc &&
+	printf "%s\n%s\n" $KEY1 $KEY2 >"$STORES/laptop/work/.gpg-id" &&
+	on laptop git commit --quiet -am "Ask to read work." &&
+	laptop sync status | grep -q "^stale work/w1\$" &&
+	trade &&
+	pc sync log laptop >out &&
+	grep -q "^readers work/: laptop pc\$" out &&
+	grep -q "^stale work/w1\$" out &&
+	pc sync merge laptop | grep -q "Re-encrypted" &&
+	pc sync status >out &&
+	! grep -q "^stale" out &&
+	$GPG --batch --list-packets --list-only "$STORES/pc/work/w1.gpg" 2>&1 | grep -c "pubkey enc packet" >count &&
+	test "$(cat count)" = 2 &&
+	trade &&
+	laptop sync merge pc &&
+	test "$(laptop show work/w1)" = "work secret"
+'
+
+test_expect_success 'Readers changed on both sides, differently: a choice named by the folder' '
+	pc init -p work $KEY1 &&
+	printf "%s\n%s\n" $KEY2 $KEY1 >"$STORES/laptop/work/.gpg-id" &&
+	on laptop git commit --quiet -am "The same readers, the other way round." &&
+	trade &&
+	pc sync log laptop | grep -q "^conflict work/\$" &&
+	test_must_fail pc sync merge laptop &&
+	pc sync merge laptop --mine work/ &&
+	test "$(cat "$STORES/pc/work/.gpg-id")" = $KEY1 &&
+	trade &&
+	laptop sync merge pc &&
+	test "$(cat "$STORES/laptop/work/.gpg-id")" = $KEY1
+'
+
+test_expect_success 'A reader that is no device is neither published nor taken' '
+	held=$(on pc git rev-parse refs/pass-sync/laptop) &&
+	echo $KEY3 >>"$STORES/laptop/.gpg-id" &&
+	on laptop git commit --quiet -am "Let a stranger read everything." &&
+	test_must_fail laptop sync push 2>err &&
+	grep -q ".gpg-id names a reader that is not a device" err &&
+	raw_publish laptop $KEY2 &&
+	test_must_fail pc sync fetch >out &&
+	grep -q "laptop: REFUSED, .gpg-id names a reader that is not a device" out &&
+	test "$(on pc git rev-parse refs/pass-sync/laptop)" = "$held" &&
+	on laptop git reset --quiet --hard HEAD~1 &&
+	echo leak | $GPG --batch --yes --quiet --trust-model always --encrypt --recipient $KEY1 --recipient $KEY3 \
+		--output "$STORES/laptop/leak.gpg" &&
+	on laptop git add leak.gpg &&
+	on laptop git commit --quiet -m "An entry a stranger reads." &&
+	test_must_fail laptop sync push &&
+	raw_publish laptop $KEY2 &&
+	test_must_fail pc sync fetch >out &&
+	grep -q "leak.gpg is encrypted to a key that is no device" out &&
+	on laptop git reset --quiet --hard HEAD~1
+'
+
+test_expect_success 'What is not an entry is neither published nor taken' '
+	held=$(on pc git rev-parse refs/pass-sync/laptop) &&
+	for wrong in extension link note attributes; do
+		case $wrong in
+		extension) mkdir -p "$STORES/laptop/.extensions" && echo "#!/bin/sh" >"$STORES/laptop/.extensions/x.bash" &&
+			on laptop git add -f .extensions ;;
+		link) ln -s /etc/passwd "$STORES/laptop/link.gpg" && on laptop git add link.gpg ;;
+		note) echo text >"$STORES/laptop/README" && on laptop git add README ;;
+		attributes) echo "*.gpg diff=gpg filter=evil" >"$STORES/laptop/.gitattributes" &&
+			on laptop git add .gitattributes ;;
+		esac &&
+		on laptop git commit --quiet -m "Something that is no entry." &&
+		test_must_fail laptop sync push &&
+		raw_publish laptop $KEY2 &&
+		test_must_fail pc sync fetch >out &&
+		grep -q "laptop: REFUSED" out &&
+		on laptop git reset --quiet --hard HEAD~1 || return 1
+	done &&
+	test "$(on pc git rev-parse refs/pass-sync/laptop)" = "$held"
+'
+
+test_expect_success 'A file is refused unless its device signed it and it holds its reference alone' '
+	held=$(on pc git rev-parse refs/pass-sync/laptop) &&
+	echo more | laptop insert -e more &&
+	raw_publish laptop $KEY3 &&
+	test_must_fail pc sync fetch >out &&
+	grep -q "REFUSED, its file is signed by $KEY3" out &&
+	on laptop git branch -f second HEAD &&
+	raw_publish laptop $KEY2 refs/pass-sync/laptop refs/heads/second &&
+	test_must_fail pc sync fetch >out &&
+	grep -q "REFUSED, its bundle must hold refs/pass-sync/laptop alone" out &&
+	on laptop git bundle create --version=2 "$STORES/partial.bundle" HEAD~1..refs/pass-sync/laptop &&
+	$GPG --batch --yes --quiet --trust-model always --local-user $KEY2 --digest-algo SHA512 --sign --encrypt \
+		--recipient $KEY1 --output "$DROP/laptop.bundle.gpg" "$STORES/partial.bundle" &&
+	test_must_fail pc sync fetch >out &&
+	grep -q "REFUSED" out &&
+	on laptop git bundle create --version=2 "$STORES/whole.bundle" refs/pass-sync/laptop &&
+	$GPG --batch --yes --quiet --trust-model always --local-user $KEY2 --digest-algo SHA1 --sign --encrypt \
+		--recipient $KEY1 --output "$DROP/laptop.bundle.gpg" "$STORES/whole.bundle" &&
+	test_must_fail pc sync fetch >out &&
+	grep -q "REFUSED" out &&
+	echo "not a bundle" | $GPG --batch --yes --quiet --trust-model always --local-user $KEY2 --digest-algo SHA512 \
+		--sign --encrypt --recipient $KEY1 --output "$DROP/laptop.bundle.gpg" &&
+	test_must_fail pc sync fetch >out &&
+	grep -q "REFUSED, its file is not a git bundle" out &&
+	echo "not a bundle" | $GPG --batch --yes --quiet --trust-model always --encrypt --recipient $KEY1 \
+		--output "$DROP/laptop.bundle.gpg" &&
+	test_must_fail pc sync fetch >out &&
+	grep -q "REFUSED, its file is signed by nobody" out &&
+	echo "noise" >"$DROP/laptop.bundle.gpg" &&
+	test_must_fail pc sync fetch >out &&
+	grep -q "REFUSED, its file does not decrypt" out &&
+	test "$(on pc git rev-parse refs/pass-sync/laptop)" = "$held"
+'
+
+test_expect_success 'An old file served again is ignored, a missing one is not an error' '
+	laptop sync push &&
+	pc sync fetch &&
+	held=$(on pc git rev-parse refs/pass-sync/laptop) &&
+	cp "$DROP/laptop.bundle.gpg" newest &&
+	on laptop git reset --quiet --hard HEAD~1 &&
+	laptop sync push &&
+	pc sync fetch >out &&
+	grep -q "IGNORED, an old file was served again" out &&
+	test "$(on pc git rev-parse refs/pass-sync/laptop)" = "$held" &&
+	rm "$DROP/laptop.bundle.gpg" &&
+	pc sync fetch >out &&
+	grep -q "laptop: has published nothing" out
+'
+
+test_expect_success 'Two stores with nothing in common do not merge' '
+	mkdir "$STORES/other" &&
+	on other "$PASS" init $KEY1 $KEY2 &&
+	on other "$PASS" git init &&
+	on other "$PASS" sync setup laptop "$DROP" $KEY2 &&
+	on other "$PASS" sync peer pc $KEY1 &&
+	on other "$PASS" sync push &&
+	pc sync fetch &&
+	test_must_fail pc sync merge laptop 2>err &&
+	grep -q "nothing in common" err
+'
+
+test_expect_success 'A removed device is no longer published to, nor listened to' '
+	pc sync peer --remove laptop &&
+	test_must_fail on pc git rev-parse --verify --quiet refs/pass-sync/laptop &&
+	test_must_fail pc sync fetch laptop &&
+	test_must_fail pc sync push 2>err &&
+	grep -q "names a reader that is not a device" err
+'
+
+test_done
