diff --git a/test_tricks/additional-tests/u0008-sync-tests.sh b/test_tricks/additional-tests/u0008-sync-tests.sh
new file mode 100755
index 0000000..a29b3a3
--- /dev/null
+++ b/test_tricks/additional-tests/u0008-sync-tests.sh
@@ -0,0 +1,232 @@
+#!/usr/bin/env bash
+
+test_description='Test sync: trading the store with another device through a drop zone'
+cd "$(dirname "$0")"
+. ./setup.sh
+
+# This store is the device "pc", with KEY1. The other device, "phone", has KEY2 and is played
+# here with git and gpg alone: what it publishes is what any implementation of it must publish.
+DROP="$SHARNESS_TRASH_DIRECTORY/drop"
+PHONE="$SHARNESS_TRASH_DIRECTORY/phone"
+
+phone_git() {
+	env -u GIT_DIR -u GIT_WORK_TREE git -C "$PHONE" "$@"
+}
+
+# phone_publish [signing key [reference [recipient...]]]
+phone_publish() {
+	local key="${1:-$KEY2}" ref="${2:-refs/pass-sync/phone}"
+	phone_git update-ref "$ref" HEAD &&
+	phone_git bundle create --version=2 "$SHARNESS_TRASH_DIRECTORY/phone.bundle" "$ref" &&
+	$GPG --batch --yes --quiet --trust-model always --compress-algo none --local-user "$key" \
+		--sign --encrypt --recipient $KEY1 --recipient $KEY2 \
+		--output "$DROP/phone.bundle.gpg" "$SHARNESS_TRASH_DIRECTORY/phone.bundle"
+}
+
+# phone_take: start again from what pc published.
+phone_take() {
+	$GPG --batch --yes --quiet --output "$SHARNESS_TRASH_DIRECTORY/pc.bundle" --decrypt "$DROP/pc.bundle.gpg" &&
+	phone_git fetch --quiet "$SHARNESS_TRASH_DIRECTORY/pc.bundle" "+refs/pass-sync/pc:refs/pass-sync/pc" &&
+	phone_git checkout --quiet -B work refs/pass-sync/pc
+}
+
+# phone_insert name content [commit options...]: an entry encrypted to KEY1, as the .gpg-id says.
+phone_insert() {
+	local name="$1" content="$2"
+	shift 2
+	echo "$content" | $GPG --batch --yes --quiet --trust-model always --encrypt --recipient $KEY1 \
+		--output "$PHONE/$name.gpg" &&
+	phone_git add "$name.gpg" &&
+	phone_git commit --quiet "${@:--S}" -m "Add given password for $name to store."
+}
+
+head_of() {
+	git rev-parse "${1:-HEAD}"
+}
+
+test_expect_success 'Setup: a store in git, a drop zone, a phone' '
+	"$PASS" init $KEY1 &&
+	"$PASS" git init &&
+	"$PASS" generate first 20 &&
+	mkdir "$DROP" &&
+	env -u GIT_DIR -u GIT_WORK_TREE git init --quiet "$PHONE" &&
+	phone_git config user.signingkey $KEY2 &&
+	phone_git config gpg.program $GPG
+'
+
+test_expect_success 'Sync says what is missing before it is set up' '
+	test_must_fail "$PASS" sync push 2>err &&
+	grep -q "sync setup" err &&
+	test_must_fail "$PASS" sync setup Pc "$DROP" $KEY1 &&
+	test_must_fail "$PASS" sync setup pc "$DROP" 0123 &&
+	test_must_fail "$PASS" sync setup pc "$DROP/missing" $KEY1 &&
+	"$PASS" sync setup pc "$DROP" $KEY1 &&
+	test_must_fail "$PASS" sync peer phone 0000000000000000000000000000000000000000 &&
+	test_must_fail "$PASS" sync peer pc $KEY1 &&
+	test_must_fail "$PASS" sync log phone &&
+	"$PASS" sync peer phone "$(echo $KEY2 | tr A-F a-f | sed "s/..../& /g")" &&
+	"$PASS" sync status >out &&
+	grep -q "Published: not yet" out &&
+	grep -q "phone: nothing received yet" out
+'
+
+test_expect_success 'Push publishes one signed file that holds one reference' '
+	"$PASS" sync push &&
+	test "$(ls "$DROP")" = "pc.bundle.gpg" &&
+	$GPG --batch --yes --quiet --status-fd 3 --output pc.bundle --decrypt "$DROP/pc.bundle.gpg" 3>status &&
+	grep -q "VALIDSIG .* $KEY1\$" status &&
+	grep -q "VALIDSIG [0-9A-F]* [-0-9]* [0-9]* [0-9]* [0-9]* [0-9]* [0-9]* 10 " status &&
+	test "$(grep -c "ENC_TO" status)" = 2 &&
+	test "$(env -u GIT_DIR -u GIT_WORK_TREE git bundle list-heads pc.bundle)" = "$(head_of) refs/pass-sync/pc" &&
+	"$PASS" sync status | grep -q "Published: the current state"
+'
+
+test_expect_success 'Fetch, log, diff and merge take what the phone signed' '
+	phone_take &&
+	phone_insert from-phone "typed on the phone" &&
+	phone_publish &&
+	"$PASS" sync fetch >out &&
+	grep -q "phone: 1 commit(s) to take" out &&
+	test_must_fail "$PASS" show from-phone &&
+	"$PASS" sync log phone >out &&
+	grep -q "signed by phone .*Add given password for from-phone" out &&
+	grep -q "added *from-phone\$" out &&
+	"$PASS" sync diff phone | grep -q "^+typed on the phone" &&
+	"$PASS" sync merge phone >out &&
+	grep -q "Took 1 commit(s) from phone" out &&
+	test "$("$PASS" show from-phone)" = "typed on the phone" &&
+	test "$(head_of)" = "$(phone_git rev-parse HEAD)" &&
+	test "$(head_of refs/pass-sync/pc)" = "$(head_of)" &&
+	"$PASS" sync merge phone | grep -q "has nothing this store lacks"
+'
+
+test_expect_success 'A commit that no device signed is not taken' '
+	before=$(head_of) &&
+	phone_insert unsigned "nobody vouches for this" --no-gpg-sign &&
+	phone_publish &&
+	"$PASS" sync fetch &&
+	"$PASS" sync log phone | grep -q "NOT SIGNED BY A DEVICE" &&
+	test_must_fail "$PASS" sync merge phone 2>err &&
+	grep -q "Not signed by phone" err &&
+	test "$(head_of)" = "$before" &&
+	phone_take &&
+	phone_insert signed-by-another "a key that is not a device" -S$KEY3 &&
+	phone_publish &&
+	"$PASS" sync fetch &&
+	test_must_fail "$PASS" sync merge phone 2>err &&
+	grep -q "Not signed by phone" err &&
+	test "$(head_of)" = "$before"
+'
+
+test_expect_success 'A commit that changes who can read is not taken' '
+	before=$(head_of) &&
+	phone_take &&
+	echo $KEY2 >>"$PHONE/.gpg-id" &&
+	phone_git commit --quiet -S -am "Let the phone read everything." &&
+	phone_publish &&
+	"$PASS" sync fetch &&
+	test_must_fail "$PASS" sync merge phone 2>err &&
+	grep -q ".gpg-id, which is not an entry" err &&
+	test "$(head_of)" = "$before" &&
+	phone_take &&
+	mkdir -p "$PHONE/.extensions" &&
+	echo "#!/bin/sh" >"$PHONE/.extensions/x.bash" &&
+	phone_git add .extensions &&
+	phone_git commit --quiet -S -m "An extension." &&
+	phone_publish &&
+	"$PASS" sync fetch &&
+	test_must_fail "$PASS" sync merge phone &&
+	phone_take &&
+	ln -s /etc/passwd "$PHONE/link.gpg" &&
+	phone_git add link.gpg &&
+	phone_git commit --quiet -S -m "A link dressed as an entry." &&
+	phone_publish &&
+	"$PASS" sync fetch &&
+	test_must_fail "$PASS" sync merge phone &&
+	test "$(head_of)" = "$before"
+'
+
+test_expect_success 'Only a fast-forward is taken, and removing an entry is one' '
+	phone_take &&
+	phone_insert early "written before the store moved" &&
+	phone_publish &&
+	"$PASS" generate later 20 &&
+	before=$(head_of) &&
+	"$PASS" sync fetch >out &&
+	grep -q "1 commit(s) to take, but 1 behind" out &&
+	test_must_fail "$PASS" sync merge phone 2>err &&
+	grep -q "not a fast-forward" err &&
+	test "$(head_of)" = "$before" &&
+	"$PASS" sync push &&
+	old=$(phone_git rev-parse HEAD) &&
+	phone_take &&
+	phone_git merge --quiet -S --no-edit $old &&
+	phone_git rm --quiet from-phone.gpg &&
+	phone_git commit --quiet -S -m "Remove from-phone from store." &&
+	phone_publish &&
+	"$PASS" sync fetch &&
+	"$PASS" sync merge phone &&
+	test "$("$PASS" show early)" = "written before the store moved" &&
+	test_must_fail "$PASS" show from-phone &&
+	"$PASS" show later
+'
+
+test_expect_success 'A file is refused unless the phone signed it and it holds its reference alone' '
+	held=$(head_of refs/pass-sync/phone) &&
+	phone_insert more "one more" &&
+	phone_publish $KEY3 &&
+	test_must_fail "$PASS" sync fetch >out &&
+	grep -q "REFUSED, its file is signed by $KEY3" out &&
+	phone_publish $KEY2 refs/pass-sync/pc &&
+	test_must_fail "$PASS" sync fetch >out &&
+	grep -q "REFUSED, its bundle must hold refs/pass-sync/phone alone" out &&
+	phone_git bundle create --version=2 "$SHARNESS_TRASH_DIRECTORY/partial.bundle" HEAD~1..work &&
+	$GPG --batch --yes --quiet --trust-model always --local-user $KEY2 --sign --encrypt --recipient $KEY1 \
+		--output "$DROP/phone.bundle.gpg" "$SHARNESS_TRASH_DIRECTORY/partial.bundle" &&
+	test_must_fail "$PASS" sync fetch >out &&
+	grep -q "REFUSED" out &&
+	echo "not a bundle" | $GPG --batch --yes --quiet --trust-model always --local-user $KEY2 --sign --encrypt \
+		--recipient $KEY1 --output "$DROP/phone.bundle.gpg" &&
+	test_must_fail "$PASS" sync fetch >out &&
+	grep -q "REFUSED, its file is not a git bundle" out &&
+	echo "not a bundle" | $GPG --batch --yes --quiet --trust-model always --encrypt --recipient $KEY1 \
+		--output "$DROP/phone.bundle.gpg" &&
+	test_must_fail "$PASS" sync fetch >out &&
+	grep -q "REFUSED, its file is signed by nobody" out &&
+	phone_git bundle create --version=2 "$SHARNESS_TRASH_DIRECTORY/whole.bundle" refs/pass-sync/phone &&
+	$GPG --batch --yes --quiet --trust-model always --local-user $KEY2 --digest-algo SHA1 --sign --encrypt \
+		--recipient $KEY1 --output "$DROP/phone.bundle.gpg" "$SHARNESS_TRASH_DIRECTORY/whole.bundle" &&
+	test_must_fail "$PASS" sync fetch >out &&
+	grep -q "REFUSED" out &&
+	echo "noise" >"$DROP/phone.bundle.gpg" &&
+	test_must_fail "$PASS" sync fetch >out &&
+	grep -q "REFUSED, its file does not decrypt" out &&
+	test "$(head_of refs/pass-sync/phone)" = "$held"
+'
+
+test_expect_success 'An old file served again is ignored, a missing one is not an error' '
+	phone_publish &&
+	"$PASS" sync fetch &&
+	held=$(head_of refs/pass-sync/phone) &&
+	cp "$DROP/phone.bundle.gpg" newest &&
+	phone_git reset --quiet --hard HEAD~1 &&
+	phone_publish &&
+	"$PASS" sync fetch >out &&
+	grep -q "IGNORED, an old file was served again" out &&
+	test "$(head_of refs/pass-sync/phone)" = "$held" &&
+	rm "$DROP/phone.bundle.gpg" &&
+	"$PASS" sync fetch >out &&
+	grep -q "phone: has published nothing" out
+'
+
+test_expect_success 'A removed device is no longer published to, nor listened to' '
+	cp newest "$DROP/phone.bundle.gpg" &&
+	"$PASS" sync peer --remove phone &&
+	test_must_fail git rev-parse --verify --quiet refs/pass-sync/phone &&
+	test_must_fail "$PASS" sync fetch phone &&
+	"$PASS" sync push &&
+	$GPG --batch --yes --quiet --status-fd 3 --output /dev/null --decrypt "$DROP/pc.bundle.gpg" 3>status &&
+	test "$(grep -c "ENC_TO" status)" = 1
+'
+
+test_done
