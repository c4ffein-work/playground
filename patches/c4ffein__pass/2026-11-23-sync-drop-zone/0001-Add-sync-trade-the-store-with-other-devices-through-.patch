+            tree = sync_git('write-tree', extra_env=index).stdout.strip()
+        finally:
+            shutil.rmtree(tmpdir, ignore_errors=True)
+        merged = sync_git('-c', 'gpg.format=openpgp', 'commit-tree', tree, '-p', head, '-p', tip,
+                          f"-S{config['key']}", '-m', f"Merge the changes of {name}.").stdout.strip()
+        sync_git('merge', '--quiet', '--ff-only', merged)
+        print(f"Merged {ahead} commit(s) from {name}.")
+    count = sync_reencrypt(config)
+    if count:
+        print("Re-encrypted what was not encrypted for its readers.")
+    cmd_sync_push([])
+
+def cmd_sync(argv):
+    """Trade the store with other devices through a drop zone."""
+    commands = {'setup': cmd_sync_setup, 'peer': cmd_sync_peer, 'status': cmd_sync_status, 'push': cmd_sync_push,
+                'fetch': cmd_sync_fetch, 'log': cmd_sync_log, 'diff': cmd_sync_diff, 'merge': cmd_sync_merge}
+    command = argv[0] if argv else 'status'
