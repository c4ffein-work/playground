++#endif /* BGRAPHBIPARTGGNOTHREAD */
++
+   if (memAllocGroup ((void **) (void *)           /* Allocate shared data */
+                      &passdat.thrdtab, (size_t) (thrdnbr            * sizeof (BgraphBipartGgThread)),
