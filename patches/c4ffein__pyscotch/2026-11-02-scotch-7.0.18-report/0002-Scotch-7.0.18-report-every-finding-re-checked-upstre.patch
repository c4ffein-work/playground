++  for (helmbas = helmsiz - 1; helmtab[helmbas].velmnum != ~0; helmbas --) ; /* Find start index of last block   */
++  helmnnd = helmsiz;                              /* First segment to reconsider ends at the end of the old array */
++
++  while (helmnnd != helmbas) {                    /* For each of the two segments to consider                */
++    for (helmnum = helmbas; helmnum < helmnnd; helmnum ++) { /* Re-compute position of elements in new table */
