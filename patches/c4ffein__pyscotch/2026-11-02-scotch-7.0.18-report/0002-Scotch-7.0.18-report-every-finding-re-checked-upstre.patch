++check_scotch_dgraph_build	:	test_scotch_dgraph_build
++					$(EXECP3) ./test_scotch_dgraph_build
++
++test_scotch_dgraph_build	:	test_scotch_dgraph_build.c	\
++					$(SCOTCHLIBDIR)/libptscotch$(LIB)
++
