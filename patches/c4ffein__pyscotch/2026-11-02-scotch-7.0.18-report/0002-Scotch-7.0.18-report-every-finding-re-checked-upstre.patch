+/*
+**  The defines.
+*/
+
+#define DGRAPHBANDGROWNAMECOLL      REPLACE (DGRAPHBANDGROWNAMECOLL2 (REPLACE (DGRAPHBANDGROWNAME)))
+#define DGRAPHBANDGROWNAMECOLL2(s)  GLUE (s,Coll)
+
+#define DGRAPHBANDGROWNAMEPTOP      REPLACE (DGRAPHBANDGROWNAMEPTOP2 (REPLACE (DGRAPHBANDGROWNAME)))
+#define DGRAPHBANDGROWNAMEPTOP2(s)  GLUE (s,Ptop)
+
+/*
+** The function prototypes.
+*/
+
