diff --git a/upstream/reports/7.0.18/patches/G24-hdgraph/0002-Bugfix-free-folded-graphs-on-error-in-distributed-ne.patch b/upstream/reports/7.0.18/patches/G24-hdgraph/0002-Bugfix-free-folded-graphs-on-error-in-distributed-ne.patch
new file mode 100644
index 0000000..8bf4847
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G24-hdgraph/0002-Bugfix-free-folded-graphs-on-error-in-distributed-ne.patch
@@ -0,0 +1,98 @@
+From 1106fc770b2f57ba414f09ac4bcc0b3a14afdbc2 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 16:16:44 +0000
+Subject: [PATCH 2/7] Bugfix: free folded graphs on error in distributed nested
+ dissection [report R. Perry]
+
+When the induction and folding of the second part failed after the
+one of the first part had succeeded, the processes of the first part
+never freed the folded graph they had received. When a column block
+could not be created after a successful folding, the folded graph
+was leaked as well.
+
+Record the status of each part so that processes free their folded
+graph when the other part fails, and free the folded graph when its
+column block cannot be created.
+
+Refs: DMO-16
+---
+ src/libscotch/hdgraph_order_nd.c | 32 +++++++++++++++++++++++---------
+ 1 file changed, 23 insertions(+), 9 deletions(-)
+
+diff --git a/src/libscotch/hdgraph_order_nd.c b/src/libscotch/hdgraph_order_nd.c
+index df0f0dd8..d6b78e69 100644
+--- a/src/libscotch/hdgraph_order_nd.c
++++ b/src/libscotch/hdgraph_order_nd.c
+@@ -152,7 +152,6 @@ HdgraphOrderNdGraph * restrict const  fldgrafptr)
+   int                 fldprocnum;
+   int                 fldproccol;
+   int                 fldpartval;
+-  int                 o;
+ 
+ #ifdef SCOTCH_DEBUG_HDGRAPH2
+   if ((orggrafptr->s.flagval & DGRAPHHASEDGEGST) == 0) { /* Ghost edge array must have been already computed */
+@@ -219,20 +218,31 @@ HdgraphOrderNdGraph * restrict const  fldgrafptr)
+     contextThreadLaunch (orggrafptr->contptr, (ThreadFunc) hdgraphOrderNdFold3, (void *) fldthrdtab); /* Only threads 0 and 1 will work */
+ 
+     MPI_Comm_free (&orggrafdat.s.proccomm);
+-
+-    o = ((fldthrdtab[0].orggrafptr == NULL) ||    /* See if an error occured */
+-         (fldthrdtab[1].orggrafptr == NULL));
+   }
+   else
+ #endif /* SCOTCH_PTHREAD_MPI */
+   {
+     fldthrdtab[1].orggrafptr = orggrafptr;
+ 
+-    o = hdgraphOrderNdFold2 (&fldthrdtab[0]) ||   /* Perform inductions in sequence */
+-        hdgraphOrderNdFold2 (&fldthrdtab[1]);
++    if (hdgraphOrderNdFold2 (&fldthrdtab[0]) != 0) /* Perform inductions in sequence */
++      fldthrdtab[0].orggrafptr =                  /* Indicate an error                 */
++      fldthrdtab[1].orggrafptr = NULL;            /* Second induction is not performed */
++    else if (hdgraphOrderNdFold2 (&fldthrdtab[1]) != 0)
++      fldthrdtab[1].orggrafptr = NULL;
+   }
+ 
+-  return (o);
++  if ((fldthrdtab[0].orggrafptr == NULL) ||       /* If an error occured in some part */
++      (fldthrdtab[1].orggrafptr == NULL)) {
++    if (fldthrdtab[fldpartval].orggrafptr != NULL) { /* If our folded graph had been built, free it */
++      if (fldgrafptr->typeval == HDGRAPHORDERNDTYPECENT)
++        hgraphExit (&fldgrafptr->data.cgrfdat);
++      else
++        hdgraphExit (&fldgrafptr->data.dgrfdat);
++    }
++    return (1);
++  }
++
++  return (0);
+ }
+ 
+ /* This routine performs the ordering.
+@@ -405,8 +415,10 @@ const HdgraphOrderNdParam * restrict const  paraptr)
+ 
+   switch (indgrafdat01.typeval) {
+     case HDGRAPHORDERNDTYPECENT :
+-      if ((cblkptr01 = dorderNewSequ (cblkptr)) == NULL)
++      if ((cblkptr01 = dorderNewSequ (cblkptr)) == NULL) {
++        hgraphExit (&indgrafdat01.data.cgrfdat);  /* Free folded graph */
+         goto fail;
++      }
+       if (grafptr->levlnum > 0) {                 /* If intermediate level nested dissection graph */
+         hdgraphExit   (grafptr);                  /* Free graph before going to next level         */
+         dorderDispose (cblkptr);                  /* Dispose of column block node too              */
+@@ -422,8 +434,10 @@ const HdgraphOrderNdParam * restrict const  paraptr)
+ #else /* SCOTCH_DEBUG_HDGRAPH2 */
+     default :
+ #endif /* SCOTCH_DEBUG_HDGRAPH2 */
+-      if ((cblkptr01 = dorderNew (cblkptr, indgrafdat01.data.dgrfdat.s.proccomm)) == NULL)
++      if ((cblkptr01 = dorderNew (cblkptr, indgrafdat01.data.dgrfdat.s.proccomm)) == NULL) {
++        hdgraphExit (&indgrafdat01.data.dgrfdat); /* Free folded graph */
+         goto fail;
++      }
+       if (grafptr->levlnum > 0) {                 /* If intermediate level nested dissection graph */
+         hdgraphExit   (grafptr);                  /* Free graph before going to next level         */
+         dorderDispose (cblkptr);                  /* Dispose of column block node too              */
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G24-hdgraph/0003-Bugfix-free-graphs-on-error-in-parallel-recursive-bi.patch b/upstream/reports/7.0.18/patches/G24-hdgraph/0003-Bugfix-free-graphs-on-error-in-parallel-recursive-bi.patch
new file mode 100644
index 0000000..79f73e5
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G24-hdgraph/0003-Bugfix-free-graphs-on-error-in-parallel-recursive-bi.patch
@@ -0,0 +1,116 @@
+From fa3ea32adf6ec4253350673ee36cad8947bbedf9 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 16:17:20 +0000
+Subject: [PATCH] Bugfix: free graphs on error in parallel recursive
+ bipartitioning [report R. Perry]
+
+`kdgraphMapRbPart2()` returned from three failure points without
+freeing the folded graph it owns, `kdgraphMapRbPartSequ()` leaked
+the centralized graph when the mapping graph could not be
+initialized, and, as in distributed nested dissection, the processes
+of a part whose folding succeeded never freed their folded graph
+when the folding of the other part failed.
+
+Route the failures of `kdgraphMapRbPart2()` through a common label,
+free the centralized graph, and record the status of each part so
+that processes free their folded graph when the other part fails.
+
+Refs: DMO-16
+---
+ src/libscotch/kdgraph_map_rb_part.c | 37 +++++++++++++++++++++--------
+ 1 file changed, 27 insertions(+), 10 deletions(-)
+
+diff --git a/src/libscotch/kdgraph_map_rb_part.c b/src/libscotch/kdgraph_map_rb_part.c
+index 4e1b7533..bd284fe1 100644
+--- a/src/libscotch/kdgraph_map_rb_part.c
++++ b/src/libscotch/kdgraph_map_rb_part.c
+@@ -108,6 +108,7 @@ const KdgraphMapRbPartData * restrict const dataptr)
+   cgrfptr = &grafptr->data.cgrfdat;
+   if (kgraphInit (&kgrfdat, cgrfptr, &mappptr->archdat, &grafptr->domnorg, 0, NULL, 1, 1, NULL) != 0) {
+     errorPrint ("kdgraphMapRbPartSequ: cannot initialize centralized graph");
++    graphExit  (cgrfptr);
+     return (1);
+   }
+   kgrfdat.s.flagval   = (kgrfdat.s.flagval & ~GRAPHBITSUSED) | cgrfptr->flagval; /* Free sequential graph along with mapping data */
+@@ -239,7 +240,6 @@ KdgraphMapRbPartGraph * restrict const  fldgrafptr)
+   Gnum                    indvertlocmax;          /* Local number of vertices in biggest subgraph */
+   Gnum                    indflagtab[2];          /* Array of subjob continuation flags           */
+   GraphPart               indpartmax;             /* Induced part having most vertices            */
+-  int                       o;
+ 
+   indflagtab[0] =                                 /* Assume both jobs will not continue */
+   indflagtab[1] = 0;
+@@ -333,16 +333,29 @@ KdgraphMapRbPartGraph * restrict const  fldgrafptr)
+     contextThreadLaunch (actgrafptr->contptr, (ThreadFunc) kdgraphMapRbPartFold3, (void *) fldthrdtab); /* Only threads 0 and 1 will work */
+ 
+     MPI_Comm_free (&orggrafdat.proccomm);
+-
+-    o = ((fldthrdtab[0].orggrafptr == NULL) ||    /* See if an error occured */
+-         (fldthrdtab[1].orggrafptr == NULL));
+   }
+   else
+ #endif /* SCOTCH_PTHREAD_MPI */
+-    o = kdgraphMapRbPartFold2 (&fldthrdtab[0]) || /* Perform inductions in sequence */
+-        kdgraphMapRbPartFold2 (&fldthrdtab[1]);
++  {
++    if (kdgraphMapRbPartFold2 (&fldthrdtab[0]) != 0) /* Perform inductions in sequence */
++      fldthrdtab[0].orggrafptr =                  /* Indicate an error                 */
++      fldthrdtab[1].orggrafptr = NULL;            /* Second induction is not performed */
++    else if (kdgraphMapRbPartFold2 (&fldthrdtab[1]) != 0)
++      fldthrdtab[1].orggrafptr = NULL;
++  }
+ 
+-  return (o);
++  if ((fldthrdtab[0].orggrafptr == NULL) ||       /* If an error occured in some part */
++      (fldthrdtab[1].orggrafptr == NULL)) {
++    if (fldthrdtab[fldpartval].orggrafptr != NULL) { /* If our folded graph had been built, free it */
++      if (fldgrafptr->procnbr == 1)
++        graphExit (&fldgrafptr->data.cgrfdat);
++      else if (fldgrafptr->procnbr > 1)
++        dgraphExit (&fldgrafptr->data.dgrfdat);
++    }
++    return (1);
++  }
++
++  return (0);
+ }
+ 
+ /* This routine performs the Dual Recursive
+@@ -379,12 +392,12 @@ const KdgraphMapRbPartData * restrict const dataptr)
+       return (o);
+     case 2 :                                      /* On error */
+       errorPrint ("kdgraphMapRbPart2: cannot bipartition domain");
+-      return (1);
++      goto fail;
+   }
+ 
+   if (dgraphGhst (&grafptr->data.dgrfdat) != 0) { /* Compute ghost edge array if not already present, to have vertgstnbr (and procsidtab) */
+     errorPrint ("kdgraphMapRbPart2: cannot compute ghost edge array");
+-    return (1);
++    goto fail;
+   }
+ 
+   o = bdgraphInit (&actgrafdat, &grafptr->data.dgrfdat, NULL, &mappptr->archdat, domnsubtab); /* Create active graph */
+@@ -401,7 +414,7 @@ const KdgraphMapRbPartData * restrict const dataptr)
+ 
+   if ((o != 0) || (bdgraphBipartSt (&actgrafdat, dataptr->paraptr->stratsep) != 0)) { /* Bipartition edge-separation graph   */
+     bdgraphExit (&actgrafdat);
+-    return (1);
++    goto fail;
+   }
+ 
+   o = kdgraphMapRbPartFold (&actgrafdat, mappptr, domnsubtab, &indgrafdat);
+@@ -416,6 +429,10 @@ const KdgraphMapRbPartData * restrict const dataptr)
+       o = kdgraphMapRbPart2 (&indgrafdat, dataptr);
+   }
+   return (o);
++
++fail:
++  dgraphExit (&grafptr->data.dgrfdat);            /* Free graph before returning */
