++			check_scotch_mesh_order			\
+ 			check_libmetis_v3			\
+ 			check_libmetis_v5			\
+ 			check_libmetis_dual_v3			\
+@@ -605,6 +607,14 @@ test_scotch_mesh_graph		:	test_scotch_mesh_graph.c	\
+ 
+ ##
+ 
++check_scotch_mesh_order		:	test_scotch_mesh_order
