diff --git a/upstream/reports/7.0.18/series/0147-Bugfix-do-not-base-the-part-array-of-bdgraphBipartSq.patch b/upstream/reports/7.0.18/series/0147-Bugfix-do-not-base-the-part-array-of-bdgraphBipartSq.patch
new file mode 100644
index 0000000..41d597a
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0147-Bugfix-do-not-base-the-part-array-of-bdgraphBipartSq.patch
@@ -0,0 +1,43 @@
+From 6b0588d6ef0762a6b8a2f3533a06e81044fd45fd Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 08:14:34 +0000
+Subject: [PATCH 147/232] Bugfix: do not base the part array of
+ `bdgraphBipartSq()` when it could not be allocated [report R. Perry]
+
+When the allocation of the part array of the distributed graph failed,
+the NULL pointer was still offset by the base value, so that, for
+graphs based at 1, the distributed graph held a non-NULL invalid part
+array pointer, which `bdgraphExit()` and any later method took as
+allocated. Base the array only when it has been allocated.
+
+Refs: DMO-03
+---
+ src/libscotch/bdgraph_bipart_sq.c | 5 +++--
+ 1 file changed, 3 insertions(+), 2 deletions(-)
+
+diff --git a/src/libscotch/bdgraph_bipart_sq.c b/src/libscotch/bdgraph_bipart_sq.c
+index 0cf6669a..a490fd23 100644
+--- a/src/libscotch/bdgraph_bipart_sq.c
++++ b/src/libscotch/bdgraph_bipart_sq.c
+@@ -49,7 +49,7 @@
+ /**                # Version 6.0  : from : 27 dec 2007     **/
+ /**                                 to   : 31 aug 2014     **/
+ /**                # Version 7.0  : from : 17 jan 2023     **/
+-/**                                 to   : 31 oct 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -192,7 +192,8 @@ const BdgraphBipartSqParam * const  paraptr)      /*+ Method parameters +*/
+         errorPrint ("bdgraphBipartSq: out of memory (1)");
+         reduloctab[5] = 1;                        /* Allocated data will be freed along with graph structure */
+       }
+-      dgrfptr->partgsttax -= dgrfptr->s.baseval;
++      else
++        dgrfptr->partgsttax -= dgrfptr->s.baseval;
+     }
+     if ((dgrfptr->fronloctab = (Gnum *) memAlloc (dgrfptr->s.vertlocnbr * sizeof (Gnum))) == NULL) {
+       errorPrint ("bdgraphBipartSq: out of memory (2)");
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0148-Bugfix-agree-on-allocation-failures-in-bdgraphGather.patch b/upstream/reports/7.0.18/series/0148-Bugfix-agree-on-allocation-failures-in-bdgraphGather.patch
new file mode 100644
index 0000000..77e3d93
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0148-Bugfix-agree-on-allocation-failures-in-bdgraphGather.patch
@@ -0,0 +1,135 @@
+From 935d0f7925e4913360e939e5b189bcc497adf79c Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 16:16:19 +0000
+Subject: [PATCH 148/232] Bugfix: agree on allocation failures in
+ `bdgraphGatherAll()` before gathering [report PyScotch]
+
+In non-debug builds, a process which could not allocate the arrays of
+the centralized graph returned alone, while the other processes entered
+the gather operations and waited forever or aborted. Structure the
+allocation phase as in `hdgraphGather()`: assume an error, jump to a
+common label, always agree on the error before any collective operation,
+and only free what was allocated.
+
+Refs: PS2-G22-1
+---
+ src/libscotch/bdgraph_gather_all.c | 71 +++++++++---------------------
+ 1 file changed, 22 insertions(+), 49 deletions(-)
+
+diff --git a/src/libscotch/bdgraph_gather_all.c b/src/libscotch/bdgraph_gather_all.c
+index 07f7fbc8..3cd69568 100644
+--- a/src/libscotch/bdgraph_gather_all.c
++++ b/src/libscotch/bdgraph_gather_all.c
+@@ -46,7 +46,7 @@
+ /**                # Version 6.0  : from : 29 aug 2014     **/
+ /**                                 to   : 07 jun 2018     **/
+ /**                # Version 7.0  : from : 27 aug 2019     **/
+-/**                                 to   : 31 oct 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /**   NOTES      : # The definitions of MPI_Gather and     **/
+ /**                  MPI_Gatherv indicate that elements in **/
+@@ -89,10 +89,8 @@ Bgraph * restrict              cgrfptr)            /* Centralized graph */
+   int * restrict     froncnttab;                   /* Count array for gather operations        */
+   int * restrict     fronvrttab;                   /* Displacement array for gather operations */
+   int                fronlocnbr;                   /* Also int to enforce MPI standard         */
+-#ifdef SCOTCH_DEBUG_BDGRAPH1
+   int                cheklocval;
+   int                chekglbval;
+-#endif /* SCOTCH_DEBUG_BDGRAPH1 */
+   int                procnum;
+ 
+ #ifdef SCOTCH_DEBUG_BDGRAPH1
+@@ -118,60 +116,36 @@ Bgraph * restrict              cgrfptr)            /* Centralized graph */
+   cgrfptr->veextax = NULL;                        /* In case of error */
+   cgrfptr->parttax = NULL;
+   cgrfptr->frontab = NULL;
++  froncnttab       = NULL;
++
++  cheklocval = 1;                                 /* Assume an error */
+   if ((cgrfptr->frontab = (Gnum *) memAlloc (cgrfptr->s.vertnbr * sizeof (Gnum))) == NULL) {
+     errorPrint ("bdgraphGatherAll: out of memory (1)");
+-#ifndef SCOTCH_DEBUG_BDGRAPH1
+-    bgraphExit (cgrfptr);
+-    return     (1);
+-#else /* SCOTCH_DEBUG_BDGRAPH1 */
+-    cheklocval = 1;
+-#endif /* SCOTCH_DEBUG_BDGRAPH1 */
++    goto fail;
+   }
+-  else if ((cgrfptr->parttax = (GraphPart *) memAlloc (cgrfptr->s.vertnbr * sizeof (GraphPart))) == NULL) {
++  if ((cgrfptr->parttax = (GraphPart *) memAlloc (cgrfptr->s.vertnbr * sizeof (GraphPart))) == NULL) {
+     errorPrint ("bdgraphGatherAll: out of memory (2)");
+-#ifndef SCOTCH_DEBUG_BDGRAPH1
+-    bgraphExit (cgrfptr);
+-    return     (1);
+-#else /* SCOTCH_DEBUG_BDGRAPH1 */
+-    cheklocval = 1;
+-#endif /* SCOTCH_DEBUG_BDGRAPH1 */
++    goto fail;
+   }
+-  else {
+-    cgrfptr->parttax -= cgrfptr->s.baseval;
+-
+-    if (dgrfptr->veexloctax != NULL) {
+-      if ((cgrfptr->veextax = (Gnum *) memAlloc (cgrfptr->s.vertnbr * sizeof (Gnum))) == NULL) {
+-        errorPrint ("bdgraphGatherAll: out of memory (3)");
+-#ifndef SCOTCH_DEBUG_BDGRAPH1
+-        bgraphExit (cgrfptr);
+-        return     (1);
+-#else /* SCOTCH_DEBUG_BDGRAPH1 */
+-        cheklocval = 1;
+-#endif /* SCOTCH_DEBUG_BDGRAPH1 */
+-      }
+-      else
+-        cgrfptr->veextax -= cgrfptr->s.baseval;
++  cgrfptr->parttax -= cgrfptr->s.baseval;
++  if (dgrfptr->veexloctax != NULL) {
++    if ((cgrfptr->veextax = (Gnum *) memAlloc (cgrfptr->s.vertnbr * sizeof (Gnum))) == NULL) {
++      errorPrint ("bdgraphGatherAll: out of memory (3)");
++      goto fail;
+     }
++    cgrfptr->veextax -= cgrfptr->s.baseval;
+   }
+-
+-#ifdef SCOTCH_DEBUG_BDGRAPH1
+-  if (cheklocval == 0) {
+-#endif /* SCOTCH_DEBUG_BDGRAPH1 */
+-    if (memAllocGroup ((void **) (void *)           /* Allocate tempory arrays to gather frontiers */
+-                       &froncnttab, (size_t) (dgrfptr->s.procglbnbr * sizeof (int)),
+-                       &fronvrttab, (size_t) (dgrfptr->s.procglbnbr * sizeof (int)), NULL) == NULL) {
+-      errorPrint ("bdgraphGatherAll: out of memory (4)");
+-#ifndef SCOTCH_DEBUG_BDGRAPH1
+-      bgraphExit (cgrfptr);
+-      return     (1);
+-    }
+-#else /* SCOTCH_DEBUG_BDGRAPH1 */
+-      cheklocval = 1;
+-    }
++  if (memAllocGroup ((void **) (void *)           /* Allocate temporary arrays to gather frontiers */
++                     &froncnttab, (size_t) (dgrfptr->s.procglbnbr * sizeof (int)),
++                     &fronvrttab, (size_t) (dgrfptr->s.procglbnbr * sizeof (int)), NULL) == NULL) {
++    errorPrint ("bdgraphGatherAll: out of memory (4)");
++    goto fail;
+   }
+-  if (MPI_Allreduce (&cheklocval, &chekglbval, 1, MPI_INT, MPI_MAX, dgrfptr->s.proccomm) != MPI_SUCCESS) {
++  cheklocval = 0;                                 /* Everything went well */
++fail:
++  if (MPI_Allreduce (&cheklocval, &chekglbval, 1, MPI_INT, MPI_MAX, dgrfptr->s.proccomm) != MPI_SUCCESS) { /* All processes must agree before performing gather operations */
+     errorPrint ("bdgraphGatherAll: communication error (2)");
+-    return     (1);
++    chekglbval = 1;
+   }
+   if (chekglbval != 0) {
+     if (froncnttab != NULL)
+@@ -179,7 +153,6 @@ Bgraph * restrict              cgrfptr)            /* Centralized graph */
+     bgraphExit (cgrfptr);
+     return     (1);
+   }
+-#endif /* SCOTCH_DEBUG_BDGRAPH1 */
+ 
+   cgrfptr->compload0min  = dgrfptr->compglbload0min; /* Set constant fields of the centralized graph as those of the distibuted graph */
+   cgrfptr->compload0max  = dgrfptr->compglbload0max;
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0149-Bugfix-do-not-hide-allocation-failures-in-the-anchor.patch b/upstream/reports/7.0.18/series/0149-Bugfix-do-not-hide-allocation-failures-in-the-anchor.patch
new file mode 100644
index 0000000..13b83e8
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0149-Bugfix-do-not-hide-allocation-failures-in-the-anchor.patch
@@ -0,0 +1,78 @@
+From e2c64c1e28bacf96a8613fd2eb3380d8b294ef0b Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 16:16:19 +0000
+Subject: [PATCH 149/232] Bugfix: do not hide allocation failures in the anchor
+ degree sums of `bdgraphBipartDf()` [report R. Perry]
+
+On allocation failure, `bdgraphBipartDf()` set the local anchor degree
+to -1 before the sum reduction, so that the failure was masked by the
+positive degrees of the other processes, and the failing process then
+wrote through NULL pointers. Reduce a separate allocation failure flag
+in the same operation and return on it, and only base the work arrays
+when they have been allocated. The same layout of the reduction array
+is to be used by `vdgraphSeparateDf()`.
+
+Refs: DMO-04
+---
+ src/libscotch/bdgraph_bipart_df.c | 21 ++++++++++++---------
+ 1 file changed, 12 insertions(+), 9 deletions(-)
+
+diff --git a/src/libscotch/bdgraph_bipart_df.c b/src/libscotch/bdgraph_bipart_df.c
+index 8ee0aaa1..22890d36 100644
+--- a/src/libscotch/bdgraph_bipart_df.c
++++ b/src/libscotch/bdgraph_bipart_df.c
+@@ -1,4 +1,4 @@
+-/* Copyright 2007,2008,2011,2014,2023,2024 IPB, Universite de Bordeaux, INRIA & CNRS
++/* Copyright 2007,2008,2011,2014,2023,2024,2026 IPB, Universite de Bordeaux, INRIA & CNRS
+ **
+ ** This file is part of the Scotch software package for static mapping,
+ ** graph partitioning and sparse matrix ordering.
+@@ -46,7 +46,7 @@
+ /**                # Version 6.0  : from : 11 sep 2011     **/
+ /**                                 to   : 31 aug 2014     **/
+ /**                # Version 7.0  : from : 17 jan 2023     **/
+-/**                                 to   : 09 aug 2024     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -120,6 +120,7 @@ const BdgraphBipartDfParam * const  paraptr)      /*+ Method parameters +*/
+     reduloctab[2] = grafptr->s.veloloctax[grafptr->s.vertlocnnd - 2];
+     reduloctab[3] = grafptr->s.veloloctax[grafptr->s.vertlocnnd - 1];
+   }
++  reduloctab[4] = 0;                              /* Assume memory allocation is all right */
+ 
+   veexlocnbr = (grafptr->veexloctax != NULL) ? grafptr->s.vertlocnbr : 0;
+   if (memAllocGroup ((void **) (void *)
+@@ -128,19 +129,21 @@ const BdgraphBipartDfParam * const  paraptr)      /*+ Method parameters +*/
+                      &difogsttax, (size_t) (grafptr->s.vertgstnbr * sizeof (float)),
+                      &difngsttax, (size_t) (grafptr->s.vertgstnbr * sizeof (float)), NULL) == NULL) {
+     errorPrint ("bdgraphBipartDf: out of memory");
+-    reduloctab[0] = -1;
++    reduloctab[4] = 1;
++  }
++  else {
++    ielsloctax -= grafptr->s.baseval;
++    difogsttax -= grafptr->s.baseval;
++    difngsttax -= grafptr->s.baseval;
++    veexloctax  = (grafptr->veexloctax != NULL) ? (veexloctax - grafptr->s.baseval) : NULL;
+   }
+-  ielsloctax -= grafptr->s.baseval;
+-  difogsttax -= grafptr->s.baseval;
+-  difngsttax -= grafptr->s.baseval;
+-  veexloctax  = (grafptr->veexloctax != NULL) ? (veexloctax - grafptr->s.baseval) : NULL;
+ 
+-  if (MPI_Allreduce (reduloctab, reduglbtab, 4, GNUM_MPI, MPI_SUM, grafptr->s.proccomm) != MPI_SUCCESS) {
++  if (MPI_Allreduce (reduloctab, reduglbtab, 5, GNUM_MPI, MPI_SUM, grafptr->s.proccomm) != MPI_SUCCESS) {
+     errorPrint ("bdgraphBipartDf: communication error (1)");
+     return     (1);
+   }
+ 
+-  if (reduglbtab[0] < 0) {
++  if (reduglbtab[4] != 0) {                       /* If some process could not allocate its arrays */
+     if (ielsloctax != NULL)
+       memFree (ielsloctax + grafptr->s.baseval);  /* Free group leader */
+     return (1);
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0150-Bugfix-always-compile-the-invalid-folding-parameter-.patch b/upstream/reports/7.0.18/series/0150-Bugfix-always-compile-the-invalid-folding-parameter-.patch
