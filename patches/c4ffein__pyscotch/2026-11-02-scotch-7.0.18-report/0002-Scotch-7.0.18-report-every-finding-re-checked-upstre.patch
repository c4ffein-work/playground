index 0000000..c320610
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G26-metis-dual-esmumps/0005-Bugfix-return-the-ordering-status-from-ParMETIS_V3_N.patch
@@ -0,0 +1,195 @@
+From 1404f42fdf9542fc4c8ff79ce36ff12ecea4ac1f Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 19:41:39 +0000
+Subject: [PATCH] Bugfix: return the ordering status from
+ `ParMETIS_V3_NodeND()` [report R. Perry]
+
+`ParMETIS_V3_NodeND()` returned `METIS_OK` only when the separator
+tree could be turned into the ParMETIS `sizes` array, that is, when
+the number of processes is a power of two and a `sizes` array is
+provided, although the ordering had been computed in all cases, as
+documented. Conversely, the return values of
+`SCOTCH_dgraphOrderCompute()` and `SCOTCH_dgraphOrderPerm()` were
+ignored, so that a failed ordering was reported as a success.
+
+The status now reflects the computation of the ordering only, and the
+`sizes` array is filled on a best-effort basis, keeping its documented
+-1 values when the number of processes is not a power of two. The test
+program is run on three processes as well, and checks the `sizes`
+array.
+
+Refs: CLI-09
+---
+ src/check/CMakeLists.txt                   |  1 +
+ src/check/Makefile                         |  1 +
+ src/check/test_libparmetis.c               | 43 ++++++++++++++++++++++
+ src/libscotchmetis/parmetis_dgraph_order.c | 22 +++++------
+ 4 files changed, 56 insertions(+), 11 deletions(-)
+
+diff --git a/src/check/CMakeLists.txt b/src/check/CMakeLists.txt
+index 726e6f27..2d63dc42 100644
+--- a/src/check/CMakeLists.txt
++++ b/src/check/CMakeLists.txt
+@@ -482,6 +482,7 @@ if(BUILD_PTSCOTCH)
+     target_include_directories(test_libparmetisv${version} PRIVATE ${GENERATED_INCLUDE_DIR})
+     target_link_libraries(test_libparmetisv${version} ptscotchparmetisv${version} ptscotch ptscotcherr)
+ 
++    add_test(NAME test_libparmetisv${version}_0 COMMAND ${MPIEXEC_EXECUTABLE} ${MPIEXEC_PREFLAGS} ${MPIEXEC_NUMPROC_FLAG} 3 $<TARGET_FILE:test_libparmetisv${version}> ${dat}/bump.grf)
+     add_test(NAME test_libparmetisv${version}_1 COMMAND ${MPIEXEC_EXECUTABLE} ${MPIEXEC_PREFLAGS} ${MPIEXEC_NUMPROC_FLAG} 4 $<TARGET_FILE:test_libparmetisv${version}> ${dat}/bump.grf)
+     add_test(NAME test_libparmetisv${version}_2 COMMAND ${MPIEXEC_EXECUTABLE} ${MPIEXEC_PREFLAGS} ${MPIEXEC_NUMPROC_FLAG} 4 $<TARGET_FILE:test_libparmetisv${version}> ${dat}/bump_b1.grf)
+     add_test(NAME test_libparmetisv${version}_3 COMMAND ${MPIEXEC_EXECUTABLE} ${MPIEXEC_PREFLAGS} ${MPIEXEC_NUMPROC_FLAG} 4 $<TARGET_FILE:test_libparmetisv${version}> ${dat}/bump_imbal_32.grf)
+diff --git a/src/check/Makefile b/src/check/Makefile
