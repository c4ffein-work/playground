diff --git a/upstream/reports/7.0.18/series/0130-Bugfix-check-edge-ends-and-edge-loads-of-distributed.patch b/upstream/reports/7.0.18/series/0130-Bugfix-check-edge-ends-and-edge-loads-of-distributed.patch
