diff --git a/upstream/reports/7.0.18/series/0213-Bugfix-fix-C-standard-flag-in-x86-64-FreeBSD-Makefil.patch b/upstream/reports/7.0.18/series/0213-Bugfix-fix-C-standard-flag-in-x86-64-FreeBSD-Makefil.patch
new file mode 100644
index 0000000..ea1970b
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0213-Bugfix-fix-C-standard-flag-in-x86-64-FreeBSD-Makefil.patch
@@ -0,0 +1,29 @@
+From 27f63c544b987eb45be5ca9f1855cb7163e2d371 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 16:10:04 +0000
+Subject: [PATCH 213/232] Bugfix: fix C standard flag in x86-64 FreeBSD
+ Makefile.inc [report PyScotch]
+
+"-std" without a value is rejected by gcc and clang ("unrecognized
+command-line option '-std'"), so the x86-64 FreeBSD template could not
+compile anything. Use "-std=c99", as the i686 FreeBSD template does.
+---
+ src/Make.inc/Makefile.inc.x86-64_pc_freebsd | 2 +-
+ 1 file changed, 1 insertion(+), 1 deletion(-)
+
+diff --git a/src/Make.inc/Makefile.inc.x86-64_pc_freebsd b/src/Make.inc/Makefile.inc.x86-64_pc_freebsd
+index e90980ff..2d87376c 100644
+--- a/src/Make.inc/Makefile.inc.x86-64_pc_freebsd
++++ b/src/Make.inc/Makefile.inc.x86-64_pc_freebsd
+@@ -15,7 +15,7 @@ CCS		= cc
+ CCP		= mpicc
+ CCD		= cc
+ FCS		= gfortran
+-CFLAGS		+= -std -fPIC -DCOMMON_FILE_COMPRESS_GZ -DCOMMON_PTHREAD -DCOMMON_RANDOM_FIXED_SEED -DSCOTCH_MPI_ASYNC_COLL -DSCOTCH_PTHREAD -DSCOTCH_PTHREAD_MPI -DSCOTCH_RENAME -DIDXSIZE64 -Dcpu_set_t=cpuset_t -D__BSD_VISIBLE
++CFLAGS		+= -std=c99 -fPIC -DCOMMON_FILE_COMPRESS_GZ -DCOMMON_PTHREAD -DCOMMON_RANDOM_FIXED_SEED -DSCOTCH_MPI_ASYNC_COLL -DSCOTCH_PTHREAD -DSCOTCH_PTHREAD_MPI -DSCOTCH_RENAME -DIDXSIZE64 -Dcpu_set_t=cpuset_t -D__BSD_VISIBLE
+ CLIBFLAGS	=
+ LDFLAGS		+= -lz -lm -lthread
+ CP		= cp
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0214-Bugfix-make-generated-Fortran-headers-depend-on-thei.patch b/upstream/reports/7.0.18/series/0214-Bugfix-make-generated-Fortran-headers-depend-on-thei.patch
new file mode 100644
index 0000000..63988d1
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0214-Bugfix-make-generated-Fortran-headers-depend-on-thei.patch
@@ -0,0 +1,41 @@
+From ad532a1b0d490436a117c59cf58d7ab0b8e89d4b Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 16:11:12 +0000
+Subject: [PATCH 214/232] Bugfix: make generated Fortran headers depend on
+ their templates in CMake [report R. Perry]
+
+The custom commands that generate "scotchf.h" and "ptscotchf.h" from
+"library_f.h" and "library_pt_f.h" declared a dependency on
+"library.h" instead, so that editing a Fortran template did not
+regenerate the corresponding header.
+
+Refs: BLD-09
+---
+ src/libscotch/CMakeLists.txt | 4 ++--
+ 1 file changed, 2 insertions(+), 2 deletions(-)
+
+diff --git a/src/libscotch/CMakeLists.txt b/src/libscotch/CMakeLists.txt
+index a80be8fb..286d9e87 100644
+--- a/src/libscotch/CMakeLists.txt
++++ b/src/libscotch/CMakeLists.txt
+@@ -74,7 +74,7 @@ add_custom_command(OUTPUT ${GENERATED_INCLUDE_DIR}/scotch.h
+ add_custom_command(OUTPUT ${GENERATED_INCLUDE_DIR}/scotchf.h
+   COMMAND $<TARGET_FILE:dummysizes>  "-s${SCOTCH_NAME_SUFFIX}"
+   ${CMAKE_CURRENT_SOURCE_DIR}/library_f.h ${GENERATED_INCLUDE_DIR}/scotchf.h DEPENDS dummysizes
+-  DEPENDS library.h
++  DEPENDS library_f.h
+   COMMENT "Generate scotchf.h")
+ 
+ ################
+@@ -95,7 +95,7 @@ if(BUILD_PTSCOTCH)
+   add_custom_command(OUTPUT ${GENERATED_INCLUDE_DIR}/ptscotchf.h
+     COMMAND $<TARGET_FILE:ptdummysizes> "-s${SCOTCH_NAME_SUFFIX}"
+     ${CMAKE_CURRENT_SOURCE_DIR}/library_pt_f.h ${GENERATED_INCLUDE_DIR}/ptscotchf.h DEPENDS ptdummysizes
+-    DEPENDS library.h
++    DEPENDS library_pt_f.h
+     COMMENT "Generate ptscotchf.h")
+ endif()
+ 
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0215-Bugfix-track-Fortran-test-templates-in-CMake-report-.patch b/upstream/reports/7.0.18/series/0215-Bugfix-track-Fortran-test-templates-in-CMake-report-.patch
new file mode 100644
index 0000000..8c0a359
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0215-Bugfix-track-Fortran-test-templates-in-CMake-report-.patch
@@ -0,0 +1,58 @@
+From eb88c9e7dd5157d4c58bdc285d809961bbf2853b Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 16:11:12 +0000
+Subject: [PATCH 215/232] Bugfix: track Fortran test templates in CMake [report
+ R. Perry]
+
+In `suffix_fortran_file()`, the command that runs "dummysizes" on a
+"*.f90.in" template depended on "${file}", an undefined variable, and
+not on the template itself, and the command that then suffixes the
+MeTiS routine names depended on the "*_tmp" target rather than on the
+intermediate file. Hence, editing a template after the first build
+never regenerated the Fortran test source. Make both commands depend
+on their input files, and remove the "*_tmp" target, which no longer
+serves any purpose.
+
+Refs: BLD-10
+---
+ src/check/CMakeLists.txt | 14 +++++---------
+ 1 file changed, 5 insertions(+), 9 deletions(-)
+
+diff --git a/src/check/CMakeLists.txt b/src/check/CMakeLists.txt
+index c6b5de85..918c3e03 100644
+--- a/src/check/CMakeLists.txt
