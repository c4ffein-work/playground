+-  for (helmold = 0; helmold < (hashold * 4); helmold ++) { /* For all old allocated elements */
+-    Gnum                helmnew;
++  locktab =                                       /* Rebuild lists    */
++  sepatab = NULL;
+ 
+-    if (helmtab[helmold].velmnum == ~0)           /* If unallocated slot */
