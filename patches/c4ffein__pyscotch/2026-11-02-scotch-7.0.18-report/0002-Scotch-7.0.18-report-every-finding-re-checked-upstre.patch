+ /**                # Version 7.0  : from : 27 aug 2019     **/
+-/**                                 to   : 08 feb 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -304,8 +304,12 @@ const double                kbalval)              /*+ Desired imbalance ratio
+   char *              exasptr;
+   char *              muceptr;
+ 
+-  sprintf (kbaltab, "%lf", kbalval);
+-  sprintf (bbaltab, "%lf", kbalval);
++  if ((! isfinite (kbalval)) || (kbalval < 0.0) || /* Reject non-finite or negative ratios that would not parse or overflow */
++      (snprintf (kbaltab, sizeof (kbaltab), "%lf", kbalval) >= (int) sizeof (kbaltab)) ||
++      (snprintf (bbaltab, sizeof (bbaltab), "%lf", kbalval) >= (int) sizeof (bbaltab))) {
++    errorPrint (STRINGIFY (SCOTCH_stratDgraphMapBuild) ": invalid imbalance ratio");
++    return (1);
++  }
+ 
+   vertnbr = MAX (2000 * procnbr, 10000);
+   vertnbr = MIN (vertnbr, 100000);
+@@ -378,8 +382,13 @@ const double                bbalval)              /*+ Maximum imbalance ratio
+   char *              exasptr;
+   char *              muceptr;
+ 
+-  sprintf (bbaltab, "%lf", bbalval);
+-  sprintf (denstab, "%lf", densval);
++  if ((! isfinite (bbalval)) || (bbalval < 0.0) || /* Reject non-finite or negative ratios that would not parse or overflow */
++      (! isfinite (densval)) || (densval < 0.0) ||
++      (snprintf (bbaltab, sizeof (bbaltab), "%lf", bbalval) >= (int) sizeof (bbaltab)) ||
++      (snprintf (denstab, sizeof (denstab), "%lf", densval) >= (int) sizeof (denstab))) {
++    errorPrint (STRINGIFY (SCOTCH_stratDgraphClusterBuild) ": invalid imbalance or density ratio");
++    return (1);
++  }
+   sprintf (pwgttab, GNUMSTRING, pwgtval);
+ 
