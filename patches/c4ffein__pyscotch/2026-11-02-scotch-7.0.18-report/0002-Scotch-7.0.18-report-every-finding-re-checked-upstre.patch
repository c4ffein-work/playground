diff --git a/upstream/reports/7.0.18/series/0184-Bugfix-detect-unterminated-option-arguments-in-gout-.patch b/upstream/reports/7.0.18/series/0184-Bugfix-detect-unterminated-option-arguments-in-gout-.patch
