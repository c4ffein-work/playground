++        cbitval &= ~(1 + 8 + 64);
++    }
++    if (d[1] <= 2) {
++      cbitval &= ~(64 + 128 + 256);
++      if (d[1] <= 1)
++        cbitval &= ~(1 + 2 + 4);
++    }
++    edgenbr = (d[0] * d[1]) * C_edgeCount (cbitval); /* Compute number of arcs as they will be written */
+ 
+     fprintf (C_filepntrsrcout, "0\n" SCOTCH_NUMSTRING "\t" SCOTCH_NUMSTRING "\n" SCOTCH_NUMSTRING "\t000\n",
+              (SCOTCH_Num) (d[0] * d[1]),          /* Print number of vertices */
+@@ -205,23 +216,8 @@ char *                      argv[])
