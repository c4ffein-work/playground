diff --git a/upstream/reports/7.0.18/patches/G29-cmake-sources-config/0005-Add-script-checking-that-Makefile-and-CMake-source-l.patch b/upstream/reports/7.0.18/patches/G29-cmake-sources-config/0005-Add-script-checking-that-Makefile-and-CMake-source-l.patch
new file mode 100644
index 0000000..4b03adf
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G29-cmake-sources-config/0005-Add-script-checking-that-Makefile-and-CMake-source-l.patch
@@ -0,0 +1,89 @@
+From 740f5b2a02f19ebfb4d615d138484c7ec5e9cf37 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 16:07:13 +0000
+Subject: [PATCH 05/10] Add script checking that Makefile and CMake source
+ lists agree
+
+"ci/check_sources.sh" extracts the C source files compiled by the
+Makefile and by the CMake file of each library (libScotch,
+libPTScotch, libEsMUMPS, libScotchMeTiS and libPTScotchParMeTiS) and
+reports any file that is built by only one of them. Run it in the
+CMake build job of the continuous integration, before configuring.
+
+Refs: BLD-01
+---
+ ci/build_cmake.sh   |  1 +
+ ci/check_sources.sh | 49 +++++++++++++++++++++++++++++++++++++++++++++
+ 2 files changed, 50 insertions(+)
+ create mode 100755 ci/check_sources.sh
+
+diff --git a/ci/build_cmake.sh b/ci/build_cmake.sh
+index 47a06304..cc9eedfa 100755
+--- a/ci/build_cmake.sh
++++ b/ci/build_cmake.sh
+@@ -6,6 +6,7 @@ fatal() {
+ }
+ 
+ source ci/env_cmake.sh
++./ci/check_sources.sh || fatal
+ mkdir -p build
+ cd build
+ cmake -DCMAKE_BUILD_TYPE=RelWithDebInfo -DBUILD_SHARED_LIBS=ON .. || fatal
+diff --git a/ci/check_sources.sh b/ci/check_sources.sh
+new file mode 100755
+index 00000000..e72e26ef
+--- /dev/null
++++ b/ci/check_sources.sh
+@@ -0,0 +1,49 @@
++#!/bin/sh
++## Check that the Makefiles and the CMake files of the Scotch libraries
++## compile the same C source files. The status is non-zero when some
++## source file is listed in only one of the two build systems.
++##
++## Usage: ci/check_sources.sh [path to "src" directory]
++
++srcdir="${1:-src}"
++tmpdir="${TMPDIR:-/tmp}/check_sources_$$"
++status=0
++
++## makesrcs <Makefile> <first line pattern>
++## Print the C source files of a Makefile object list, be it a variable
++## definition or the dependency list of a library rule, one per line.
++makesrcs () {
++  sed -n "/^$2/,/[^\\\\]\$/p" "$1" | \
++  sed -n 's/^.*[ 	=]\([a-z0-9_]*\)\(_\$(V)\)*\$(OBJ).*$/\1.c/p' | sort -u
++}
++
++## cmakesrcs <CMakeLists.txt> <first line pattern>
++## Print the C source files of a CMake list, be it a set() or an
++## add_library() command, one per line, without their directory part.
++cmakesrcs () {
++  sed -n "/^[ 	]*$2\$/,/)/p" "$1" | \
++  sed -n 's/^[ 	]*\([^ 	#]*\/\)*\([a-z0-9_]*\.c\)[ 	)]*$/\2/p' | sort -u
++}
++
++## compare <library> <Makefile> <pattern> <CMakeLists.txt> <pattern>
++compare () {
++  makesrcs  "$2" "$3" > "$tmpdir/make"
++  cmakesrcs "$4" "$5" > "$tmpdir/cmake"
++  if ! diff "$tmpdir/make" "$tmpdir/cmake" > "$tmpdir/diff" ; then
++    echo "$1: source lists differ ('<': Makefile only, '>': CMake only)"
++    grep '^[<>]' "$tmpdir/diff"
++    status=1
++  fi
++}
++
++mkdir -p "$tmpdir"
++
++compare libscotch           "$srcdir/libscotch/Makefile"      'LIBSCOTCHDEPS[ 	]*='             "$srcdir/libscotch/CMakeLists.txt"      'set(SCOTCH_C_SOURCES'
++compare libptscotch         "$srcdir/libscotch/Makefile"      'LIBPTSCOTCHDEPS[ 	]*='           "$srcdir/libscotch/CMakeLists.txt"      'set(PTSCOTCH_C_SOURCES'
++compare libesmumps          "$srcdir/esmumps/Makefile"        'LIBESMUMPSDEPS[ 	]*='            "$srcdir/esmumps/CMakeLists.txt"        'set(esmumps_src'
++compare libscotchmetis      "$srcdir/libscotchmetis/Makefile" 'libscotchmetis\$(V)\$(LIB)'       "$srcdir/libscotchmetis/CMakeLists.txt" 'add_library(scotchmetisv\${version}'
++compare libptscotchparmetis "$srcdir/libscotchmetis/Makefile" 'libptscotchparmetis\$(V)\$(LIB)'  "$srcdir/libscotchmetis/CMakeLists.txt" 'add_library(ptscotchparmetisv\${version}'
++
++rm -r "$tmpdir"
++
++exit $status
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G29-cmake-sources-config/0006-Bugfix-do-not-reference-EsMUMPS-targets-in-the-CMake.patch b/upstream/reports/7.0.18/patches/G29-cmake-sources-config/0006-Bugfix-do-not-reference-EsMUMPS-targets-in-the-CMake.patch
new file mode 100644
index 0000000..5025293
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G29-cmake-sources-config/0006-Bugfix-do-not-reference-EsMUMPS-targets-in-the-CMake.patch
@@ -0,0 +1,78 @@
+From 3381abf943ff74421bffc448605964fe9b5365e0 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 16:08:34 +0000
+Subject: [PATCH 06/10] Bugfix: do not reference EsMUMPS targets in the CMake
+ package config when they are not built [report R. Perry]
+
+When SCOTCH_NAME_SUFFIX is set, "src/CMakeLists.txt" skips the
+"esmumps" directory, hence neither "esmumpsTargets.cmake" nor
+"ptesmumpsTargets.cmake" are installed. Yet, BUILD_LIBESMUMPS stayed
+ON, so that the installed "SCOTCHConfig.cmake" still included both
+files, and `find_package(SCOTCH)` failed for every user of a suffixed
+installation.
+
+Decide once, in the top-level CMake file, that EsMUMPS is not built
+when symbols are suffixed, by turning BUILD_LIBESMUMPS off with a
+status message. The package config file then follows.
+
+Refs: BLD-02
+---
+ CMakeLists.txt     | 8 ++++++--
+ src/CMakeLists.txt | 6 +++---
+ 2 files changed, 9 insertions(+), 5 deletions(-)
+
+diff --git a/CMakeLists.txt b/CMakeLists.txt
+index 8a6ed1e1..e4962baa 100644
+--- a/CMakeLists.txt
++++ b/CMakeLists.txt
+@@ -37,7 +37,7 @@
+ ##   FUNCTION   : Top-level CMake configuration file      ##
+ ##                                                        ##
+ ##   DATES      : # Version 7.0  : from : 18 jan 2022     ##
+-##                                 to     03 oct 2026     ##
++##                                 to     02 nov 2026     ##
+ ##                                                        ##
+ ############################################################
+ 
+@@ -95,8 +95,12 @@ option(MPI_THREAD_MULTIPLE "Use multi-threading with MPI in PT-Scotch" ON)
+ # Build PT-Scotch
+ option(BUILD_PTSCOTCH "Build PT-Scotch" ON)
+ 
+-# Build libESMUMPS
++# Build libESMUMPS: not possible when symbols are suffixed
+ option(BUILD_LIBESMUMPS "Build EsMUMPS library" ON)
++if(BUILD_LIBESMUMPS AND USE_SUFFIX)
++  message(STATUS "EsMUMPS library not built because SCOTCH_NAME_SUFFIX is set")
++  set(BUILD_LIBESMUMPS OFF)
++endif()
+ 
+ # Build libScotchMeTiS
+ option(BUILD_LIBSCOTCHMETIS "Build ScotchMeTiS library" ON)
+diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
+index 19d753d6..323d8bf3 100644
+--- a/src/CMakeLists.txt
++++ b/src/CMakeLists.txt
+@@ -42,7 +42,7 @@
+ ##   DATES      : # Version 6.0  : from : 01 sep 2014     ##
+ ##                                 to     01 sep 2021     ##
+ ##                # Version 7.0  : from : 01 sep 2021     ##
+-##                                 to     14 oct 2026     ##
++##                                 to     02 nov 2026     ##
+ ##                                                        ##
+ ############################################################
+ 
+@@ -221,9 +221,9 @@ add_subdirectory(libscotch)
+ add_subdirectory(scotch)
+ 
+ # Build EsMUMPS library
+-if(BUILD_LIBESMUMPS AND NOT USE_SUFFIX)
++if(BUILD_LIBESMUMPS)
+   add_subdirectory(esmumps)
+-endif(BUILD_LIBESMUMPS AND NOT USE_SUFFIX)
++endif(BUILD_LIBESMUMPS)
+ 
+ # Build ScotchMeTiS library
+ if(BUILD_LIBSCOTCHMETIS)
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G29-cmake-sources-config/0007-Bugfix-generate-the-headers-shared-by-two-libraries-.patch b/upstream/reports/7.0.18/patches/G29-cmake-sources-config/0007-Bugfix-generate-the-headers-shared-by-two-libraries-.patch
new file mode 100644
index 0000000..dd9844f
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G29-cmake-sources-config/0007-Bugfix-generate-the-headers-shared-by-two-libraries-.patch
@@ -0,0 +1,91 @@
+From e3bd39685b5839e1f566234f58357bd78fa22eae Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 08:37:28 +0000
+Subject: [PATCH 07/10] Bugfix: generate the headers shared by two libraries
+ once in CMake [report R. Perry]
+
+"metis.h" and "metisf.h" are source files of both "scotchmetisv3"
+and "scotchmetisv5", and "esmumps.h" of both "esmumps" and
+"ptesmumps". With the Makefile generator, each of these libraries
+carries its own copy of the generation rule and, since nothing
+orders the two libraries of a pair, a parallel build runs the same
+command twice, concurrently, on the same output file. Since the
+removal of the "metisf_h" target, this also happens for "metisf.h".
+
+Drive the generation of these headers by one custom target per
+directory, on which both libraries of the pair depend, as CMake
+requires for custom command outputs used by several targets.
+
+Refs: BLD-12
+---
+ src/esmumps/CMakeLists.txt        | 8 ++++++++
+ src/libscotchmetis/CMakeLists.txt | 6 +++++-
+ 2 files changed, 13 insertions(+), 1 deletion(-)
+
+diff --git a/src/esmumps/CMakeLists.txt b/src/esmumps/CMakeLists.txt
+index 87ef2c78..afacd5cd 100644
+--- a/src/esmumps/CMakeLists.txt
++++ b/src/esmumps/CMakeLists.txt
+@@ -60,6 +60,10 @@ add_custom_command(OUTPUT ${GENERATED_INCLUDE_DIR}/esmumps.h
+   DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/library.h
+   COMMENT "Copy esmumps.h to include directory")
+ 
++# Copy esmumps.h once for both libraries
++add_custom_target(esmumps_h
++  DEPENDS "${GENERATED_INCLUDE_DIR}/esmumps.h")
++
+ # libEsMUMPS
+ set(esmumps_src
+   dof.c
