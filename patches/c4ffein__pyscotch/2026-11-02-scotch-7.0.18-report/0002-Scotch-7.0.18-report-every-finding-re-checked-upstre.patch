-out=$(timeout 20 mpirun --oversubscribe -np $NP -x LD_PRELOAD=$here/fishim2.so -x FI_RANK=$FR -x FI_FUNC=$FUNC -x FI_NTH=$NTH -x UBSAN_OPTIONS -x LD_LIBRARY_PATH $BIN "$@" 2>&1); rc=$?
+out=$(timeout -k 5 20 mpirun --oversubscribe -np $NP -x LD_PRELOAD=$here/fishim2.so -x FI_RANK=$FR -x FI_FUNC=$FUNC -x FI_NTH=$NTH -x UBSAN_OPTIONS -x LD_LIBRARY_PATH $BIN "$@" 2>&1); rc=$?
