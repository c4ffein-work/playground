++      '${CMAKE_COMMAND}' -E compare_files ${cur}/bump_b1_from_${ext}.grf ${dat}/bump_b1.grf && \
++      '$<TARGET_FILE:test_common_file_compress>' ${dat}/bump_b1.grf ${cur}/bump_b1_1.grf.${ext} ${cur}/bump_b1_2.grf.${ext} && \
++      '$<TARGET_FILE:test_common_file_compress>' ${cur}/bump_b1_1.grf.${ext} ${cur}/bump_b1_from_${ext}.grf && \
