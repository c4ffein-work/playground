+@@ -1,4 +1,4 @@
+-/* Copyright 2007-2010,2012,2018,2019,2023,2024 IPB, Universite de Bordeaux, INRIA & CNRS
++/* Copyright 2007-2010,2012,2018,2019,2023,2024,2026 IPB, Universite de Bordeaux, INRIA & CNRS
+ **
+ ** This file is part of the Scotch software package for static mapping,
+ ** graph partitioning and sparse matrix ordering.
+@@ -46,7 +46,7 @@
+ /**                # Version 6.0  : from : 13 sep 2012     **/
+ /**                                 to   : 18 may 2019     **/
+ /**                # Version 7.0  : from : 21 jan 2023     **/
+-/**                                 to   : 11 aug 2024     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -103,9 +103,9 @@ const SCOTCH_Num * const    vtxdist,
+ SCOTCH_Num * const          xadj,
+ SCOTCH_Num * const          adjncy,
+ const SCOTCH_Num * const    numflag,
+-const SCOTCH_Num * const    options,              /* Not used */
++const SCOTCH_Num * const    options,              /* Not used                                             */
+ SCOTCH_Num * const          order,
+-SCOTCH_Num * const          sizes,                /* Of size twice the number of processors ; not used */
++SCOTCH_Num * const          sizes,                /* Of size twice the number of processes, or NULL      */
+ MPI_Comm *                  commptr)
+ {
+   MPI_Comm            proccomm;
+@@ -147,14 +147,15 @@ MPI_Comm *                  commptr)
+         SCOTCH_Num          bitsnbr;
