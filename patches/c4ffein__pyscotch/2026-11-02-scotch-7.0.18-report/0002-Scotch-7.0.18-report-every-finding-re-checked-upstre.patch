+    "diff_file": "/tmp/claude-0/-home-user-playground/925301e5-494b-5a33-b598-8eaa63dd5c1d/scratchpad/work18/G07-common-misc/patches/0002-Bugfix-avoid-deadlocks-and-duplicate-output-of-forke.patch",
