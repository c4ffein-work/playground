++
++  add_test(NAME test_scotch_dgraph_build COMMAND ${MPIEXEC_EXECUTABLE} ${MPIEXEC_PREFLAGS} ${MPIEXEC_NUMPROC_FLAG} 3 $<TARGET_FILE:test_scotch_dgraph_build>)
++
+   # test_scotch_dgraph_grow
+ 
+   add_exec_ptscotch(test_scotch_dgraph_grow)
+diff --git a/src/check/Makefile b/src/check/Makefile
+index 1755a1dc..04f0332a 100644
+--- a/src/check/Makefile
++++ b/src/check/Makefile
+@@ -257,6 +257,7 @@ endif
+ 
+ CHECKPTSCOTCH = 	check_strat_par				\
