++					$(EXECP3) ./test_libparmetis_v3 data/bump.grf
+ 					$(EXECP4) ./test_libparmetis_v3 data/bump.grf
+ 					$(EXECP4) ./test_libparmetis_v3 data/bump_b1.grf
+ 					$(EXECP4) ./test_libparmetis_v3 data/bump_imbal_32.grf
+diff --git a/src/check/test_libparmetis.c b/src/check/test_libparmetis.c
+index 52105f0e..5f6320b3 100644
+--- a/src/check/test_libparmetis.c
++++ b/src/check/test_libparmetis.c
+@@ -194,6 +194,48 @@ const SCOTCH_Num            partnbr)
+   }
