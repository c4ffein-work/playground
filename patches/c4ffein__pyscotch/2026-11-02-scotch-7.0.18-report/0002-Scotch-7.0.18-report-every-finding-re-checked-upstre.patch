+-        &movetab, (size_t) (hashmax * sizeof (VmeshSeparateFmSave)), NULL) == NULL) {
++        &movetab, (size_t) (2 * hashmax * sizeof (VmeshSeparateFmSave)), NULL) == NULL) {
