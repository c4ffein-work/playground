diff --git a/upstream/reports/7.0.18/patches/G30-cmake-tests-make-ci/0009-Bugfix-do-not-store-the-Sonar-token-in-a-CI-artifact.patch b/upstream/reports/7.0.18/patches/G30-cmake-tests-make-ci/0009-Bugfix-do-not-store-the-Sonar-token-in-a-CI-artifact.patch
new file mode 100644
index 0000000..82d4cd0
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G30-cmake-tests-make-ci/0009-Bugfix-do-not-store-the-Sonar-token-in-a-CI-artifact.patch
@@ -0,0 +1,59 @@
+From b7b143ea6ee2a14bcf5816be8b11ffd951325d9f Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 16:11:49 +0000
+Subject: [PATCH 09/15] Bugfix: do not store the Sonar token in a CI artifact
+ [report R. Perry]
+
+"ci/analysis.sh" expanded the SONARQUBE_LOGIN variable into
+"sonar-project.properties", a file that the "scotch_sonar" job then
+kept as a downloadable artifact for 15 days, along with the debug log
+of "sonar-scanner -X" redirected into "sonar.log". Pass the token to
+the scanner through the SONAR_TOKEN environment variable instead, let
+the scanner output go to the job log, where GitLab masks it, and stop
+archiving the properties file and the logs.
+
+Refs: BLD-03
+---
+ .gitlab-ci.yml | 6 +++---
+ ci/analysis.sh | 1 -
+ 2 files changed, 3 insertions(+), 4 deletions(-)
+
+diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
+index 9719836a..07166773 100644
+--- a/.gitlab-ci.yml
++++ b/.gitlab-ci.yml
+@@ -124,16 +124,16 @@ scotch_sonar:
+     - if: $CI_PIPELINE_SOURCE == "schedule"
+   stage: sonar
+   tags: ['sonar']
++  variables:
++    SONAR_TOKEN: $SONARQUBE_LOGIN
+   script:
+     - ci/analysis.sh
+-    - sonar-scanner -X > sonar.log
++    - sonar-scanner
+   allow_failure: true
+   coverage: /^\s*lines:\s*\d+.\d+\%/
+   artifacts:
+     paths:
+       - analyzer_reports
+-      - sonar-project.properties
+-      - ./*.log
+       - ./*.cov
+       - ./*.xml
+     reports:
+diff --git a/ci/analysis.sh b/ci/analysis.sh
+index b763a171..c643db60 100755
+--- a/ci/analysis.sh
++++ b/ci/analysis.sh
+@@ -25,7 +25,6 @@ rats -w 3 --xml `cat filelist.txt` > scotch-rats.xml
+ # "sonar.lang.patterns.c++=**/*.cpp,**/*.hpp" : needed so that C files are not considered as C++ files
+ cat > sonar-project.properties << EOF
+ sonar.host.url=https://sonarqube.inria.fr/sonarqube
+-sonar.login=$SONARQUBE_LOGIN
+ 
+ sonar.links.homepage=$CI_PROJECT_URL
+ sonar.links.scm=$CI_REPOSITORY_URL
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G30-cmake-tests-make-ci/0010-Bugfix-make-CI-build-failures-fatal-and-test-64-bit-.patch b/upstream/reports/7.0.18/patches/G30-cmake-tests-make-ci/0010-Bugfix-make-CI-build-failures-fatal-and-test-64-bit-.patch
new file mode 100644
index 0000000..7e3bbcc
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G30-cmake-tests-make-ci/0010-Bugfix-make-CI-build-failures-fatal-and-test-64-bit-.patch
@@ -0,0 +1,138 @@
+From 441fb2768da251c1ac825df2399897dd7ed0aa8c Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 16:11:49 +0000
+Subject: [PATCH] Bugfix: make CI build failures fatal and test 64-bit integers
+ on 64-bit hosts [report R. Perry]
+
+"ci/build_makefile.sh" piped the output of "make" into "tee" without
+"pipefail", so that the exit status of the build step was always that
+of "tee": a compilation error did not fail the build jobs, and only
+surfaced in the test stage. Set "pipefail".
+
+The JOB_INT=64 rows of the Makefile matrix did not add any flag, so
+that 64-bit SCOTCH_Num was only tested on 32-bit hosts (JOB_INT=32-64)
+and never with 64-bit pointers. Add JOB_INT=64-64 rows, and let CMake
+jobs receive configuration options through JOB_CMAKE_FLAGS, with a job
+that builds and tests with INTSIZE=64, IDXSIZE=64, a name suffix and
+full determinism, none of which were exercised before.
+
+Refs: BLD-07, BLD-14
+---
+ .gitlab-ci.yml       | 27 +++++++++++++++++++++++++--
+ ci/build_cmake.sh    |  2 +-
+ ci/build_makefile.sh |  2 ++
+ ci/env_makefile.sh   |  2 ++
+ 4 files changed, 30 insertions(+), 3 deletions(-)
+
+diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
+index 07166773..62914d92 100644
+--- a/.gitlab-ci.yml
++++ b/.gitlab-ci.yml
+@@ -4,7 +4,7 @@ stages:
+   - test
+   - sonar
+ 
+-# JOB_INT: [ 32 | 64 | 32-64 ]
++# JOB_INT: [ 32 | 64 | 32-64 | 64-64 ]
+ # JOB_THREAD: [ n | c | k | s | m ]
+ # JOB_DETERMINISTIC: [ n | d ]
+ # JOB_DEBUG: [ n | a | f ]
+@@ -31,7 +31,7 @@ stages:
+ .matrix_64: &matrix_64
+   parallel:
+     matrix:
+-      - JOB_INT: [64]
++      - JOB_INT: [64, 64-64]
+         JOB_THREAD: [n]
+         JOB_DETERMINISTIC: [n]
+         JOB_DEBUG: [n]
+@@ -41,6 +41,11 @@ stages:
+         JOB_DETERMINISTIC: [d]
+         JOB_DEBUG: [a]
+         JOB_RENAME: [n]
++      - JOB_INT: [64-64]
++        JOB_THREAD: [m]
++        JOB_DETERMINISTIC: [d]
++        JOB_DEBUG: [a]
++        JOB_RENAME: [n]
+       - JOB_INT: [64]
+         JOB_THREAD: [m]
+         JOB_DETERMINISTIC: [n]
+@@ -153,6 +158,7 @@ scotch_sonar:
+ ## Build
+ ## Use a custom build directory setting GIT_CLONE_PATH
+ ## because CMake uses absolute paths and needs a stable directory between builds and tests
++## JOB_CMAKE_FLAGS: extra configuration options, to test non-default settings
+ 
+ .build_cmake: &build_cmake
+   <<: *rule_noschedule
+@@ -175,6 +181,14 @@ build_cmake_gcc:
+     FC: "gfortran"
+     GIT_CLONE_PATH: $CI_BUILDS_DIR/$CI_RUNNER_SHORT_TOKEN/cmake_gcc
+ 
++build_cmake_gcc_64:
++  <<: *build_cmake
++  variables:
++    CC: "gcc"
++    FC: "gfortran"
++    JOB_CMAKE_FLAGS: "-DINTSIZE=64 -DIDXSIZE=64 -DSCOTCH_NAME_SUFFIX=_64 -DSCOTCH_DETERMINISTIC=FULL"
++    GIT_CLONE_PATH: $CI_BUILDS_DIR/$CI_RUNNER_SHORT_TOKEN/cmake_gcc_64
++
+ build_cmake_clang:
+   <<: *build_cmake
+   variables:
+@@ -223,6 +237,15 @@ test_cmake_gcc:
+     FC: "gfortran"
+     GIT_CLONE_PATH: $CI_BUILDS_DIR/$CI_RUNNER_SHORT_TOKEN/cmake_gcc
+ 
++test_cmake_gcc_64:
++  <<: *test_cmake
++  needs:
++    - build_cmake_gcc_64
++  variables:
++    CC: "gcc"
++    FC: "gfortran"
++    GIT_CLONE_PATH: $CI_BUILDS_DIR/$CI_RUNNER_SHORT_TOKEN/cmake_gcc_64
++
+ test_cmake_clang:
+   <<: *test_cmake
+   needs:
+diff --git a/ci/build_cmake.sh b/ci/build_cmake.sh
+index cc9eedfa..38545ead 100755
+--- a/ci/build_cmake.sh
++++ b/ci/build_cmake.sh
+@@ -9,5 +9,5 @@ source ci/env_cmake.sh
+ ./ci/check_sources.sh || fatal
+ mkdir -p build
+ cd build
+-cmake -DCMAKE_BUILD_TYPE=RelWithDebInfo -DBUILD_SHARED_LIBS=ON .. || fatal
++cmake -DCMAKE_BUILD_TYPE=RelWithDebInfo -DBUILD_SHARED_LIBS=ON ${JOB_CMAKE_FLAGS} .. || fatal
+ make -j16 || fatal
+diff --git a/ci/build_makefile.sh b/ci/build_makefile.sh
+index 74dd8603..1008fb50 100755
+--- a/ci/build_makefile.sh
++++ b/ci/build_makefile.sh
+@@ -1,5 +1,7 @@
+ #!/bin/bash
+ 
++set -o pipefail
++
+ fatal() {
+     echo "$0: error occurred, exit"
+     exit 1
+diff --git a/ci/env_makefile.sh b/ci/env_makefile.sh
+index cd6ac3e1..d9d3579b 100755
+--- a/ci/env_makefile.sh
++++ b/ci/env_makefile.sh
+@@ -11,6 +11,8 @@ case "${JOB_INT}" in
+        export JOBBUILDFLAGS="${JOBBUILDFLAGS} -DINTSIZE64 -DIDXSIZE64" ;;
+      64 )
+        export JOBBUILDFLAGS="${JOBBUILDFLAGS}" ;;
++     64-64 )
++       export JOBBUILDFLAGS="${JOBBUILDFLAGS} -DINTSIZE64 -DIDXSIZE64" ;;
+ esac
+ 
+ case "${JOB_THREAD}" in
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G30-cmake-tests-make-ci/0011-Bugfix-suffix-Scotch-routine-names-in-Fortran-test-t.patch b/upstream/reports/7.0.18/patches/G30-cmake-tests-make-ci/0011-Bugfix-suffix-Scotch-routine-names-in-Fortran-test-t.patch
new file mode 100644
index 0000000..6c80ed0
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G30-cmake-tests-make-ci/0011-Bugfix-suffix-Scotch-routine-names-in-Fortran-test-t.patch
@@ -0,0 +1,41 @@
+From 86d3b41a1894287e5cb8c520996d466baf9f18dc Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 16:21:43 +0000
+Subject: [PATCH] Bugfix: suffix Scotch routine names in Fortran test template
+ [report PyScotch]
+
+When SCOTCH_NAME_SUFFIX is set, the Fortran wrappers of the library
+are suffixed too, but "test_scotch_mesh_build_f.f90.in" called
+`scotchfmeshinit()` and `scotchfmeshbuild()` by their plain names, so
+that the test program could not be linked, with both the Makefile and
+CMake build chains. Use the "##SCOTCH_NAME_SUFFIX" placeholder that
+"dummysizes" substitutes when it processes the template.
+---
+ src/check/test_scotch_mesh_build_f.f90.in | 4 ++--
+ 1 file changed, 2 insertions(+), 2 deletions(-)
+
+diff --git a/src/check/test_scotch_mesh_build_f.f90.in b/src/check/test_scotch_mesh_build_f.f90.in
+index f8df62eb..5b7591d0 100644
+--- a/src/check/test_scotch_mesh_build_f.f90.in
++++ b/src/check/test_scotch_mesh_build_f.f90.in
+@@ -68,7 +68,7 @@ program test_scotch_mesh_build
+ 
+   ierr = 0
+ 
+-  call scotchfmeshinit(meshdat, ierr)
++  call scotchfmeshinit##SCOTCH_NAME_SUFFIX(meshdat, ierr)
+ 
+   velmbas=1
+   vnodbas=4
+@@ -80,7 +80,7 @@ program test_scotch_mesh_build
+   verttab = [1,5,9,13,14,16,18,20,21,22,23,25]
+   edgetab = [5,11,7,6,10,5,11,4,8,9,6,7,2,2,1,1,3,1,3,3,3,2,2,1]
+ 
+-  call scotchfmeshbuild(meshdat, & ! doubleprecision (*) meshdat
++  call scotchfmeshbuild##SCOTCH_NAME_SUFFIX(meshdat, & ! doubleprecision (*) meshdat
+   velmbas, & ! integer*num velmbas,
+   vnodbas, & ! integer*num vnodbas,
+   velmnbr, & ! integer*num velmnbr,
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G30-cmake-tests-make-ci/0012-Bugfix-include-renaming-headers-in-test_scotch_arch_.patch b/upstream/reports/7.0.18/patches/G30-cmake-tests-make-ci/0012-Bugfix-include-renaming-headers-in-test_scotch_arch_.patch
new file mode 100644
index 0000000..5593431
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G30-cmake-tests-make-ci/0012-Bugfix-include-renaming-headers-in-test_scotch_arch_.patch
@@ -0,0 +1,41 @@
+From 71d9a2da977741b99adc7904d112fb56b888ccc0 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 19:41:06 +0000
+Subject: [PATCH 12/15] Bugfix: include renaming headers in
+ `test_scotch_arch_build.c` [report PyScotch]
+
+Unlike all other test programs, "test_scotch_arch_build.c" did not
+include "module.h" and "common.h" before "scotch.h", so that, when
+SCOTCH_NAME_SUFFIX is set, the suffixed type names of the generated
+"scotch.h" were not mapped back to their plain names and the program
+did not compile, with both the Makefile and CMake build chains.
+---
+ src/check/test_scotch_arch_build.c | 5 ++++-
+ 1 file changed, 4 insertions(+), 1 deletion(-)
+
+diff --git a/src/check/test_scotch_arch_build.c b/src/check/test_scotch_arch_build.c
+index 8801ef2a..2845c072 100644
+--- a/src/check/test_scotch_arch_build.c
++++ b/src/check/test_scotch_arch_build.c
+@@ -42,7 +42,7 @@
+ /**                SCOTCH_archBuild0().                    **/
+ /**                                                        **/
+ /**   DATES      : # Version 7.0  : from : 04 jul 2026     **/
+-/**                                 to   : 21 sep 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /**   NOTES      : # This test builds a "deco 0"           **/
+ /**                  architecture a from weighted path     **/
+@@ -87,6 +87,9 @@
+ #include <stdlib.h>
+ #include <string.h>
+ 
++#include "../libscotch/module.h"
++#include "../libscotch/common.h"
++
+ #include "scotch.h"
+ 
+ #define PATHMAX                     16            /* Maximum path graph size            */
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G30-cmake-tests-make-ci/0013-Bugfix-free-strategy-and-architecture-in-test_scotch.patch b/upstream/reports/7.0.18/patches/G30-cmake-tests-make-ci/0013-Bugfix-free-strategy-and-architecture-in-test_scotch.patch
new file mode 100644
index 0000000..6a23829
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G30-cmake-tests-make-ci/0013-Bugfix-free-strategy-and-architecture-in-test_scotch.patch
@@ -0,0 +1,38 @@
+From 8e44583cb098c44d1d41802f91c978c093e7c362 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 19:42:04 +0000
+Subject: [PATCH 13/15] Bugfix: free strategy and architecture in
+ `test_scotch_arch_build.c` [report PyScotch]
+
+The strategy that `SCOTCH_archBuild0()` creates in the caller's
+`SCOTCH_Strat` object and the built architectures were never freed,
+so that the test failed under AddressSanitizer's leak detection
+(26544 bytes in 240 allocations).
+---
+ src/check/test_scotch_arch_build.c | 3 +++
+ 1 file changed, 3 insertions(+)
+
+diff --git a/src/check/test_scotch_arch_build.c b/src/check/test_scotch_arch_build.c
+index 2845c072..6109566e 100644
+--- a/src/check/test_scotch_arch_build.c
++++ b/src/check/test_scotch_arch_build.c
+@@ -211,6 +211,7 @@ const SCOTCH_Num            vertnbr)              /* Number of path vertices */
+     return (1);
+   }
+ 
++  SCOTCH_stratExit (&stradat);
+   SCOTCH_graphExit (&grafdat);
+ 
+   return (0);
+@@ -463,6 +464,8 @@ char *                      argv[])
+         SCOTCH_errorPrint ("main: invalid architecture (2)");
+         exit (EXIT_FAILURE);
+       }
++
++      SCOTCH_archExit (&archdat);
+     }
+   }
+ 
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G30-cmake-tests-make-ci/0014-Bugfix-release-the-mesh-and-its-arrays-in-the-Fortra.patch b/upstream/reports/7.0.18/patches/G30-cmake-tests-make-ci/0014-Bugfix-release-the-mesh-and-its-arrays-in-the-Fortra.patch
