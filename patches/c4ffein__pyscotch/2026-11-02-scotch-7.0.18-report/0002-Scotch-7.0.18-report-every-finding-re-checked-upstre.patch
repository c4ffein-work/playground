++					$(EXECS) $(SCOTCHBINDIR)/gmk_m2 -e -t 2 1 | $(SCOTCHBINDIR)/gtst
++					$(EXECS) $(SCOTCHBINDIR)/gmk_m2 -e -t 1 1 | $(SCOTCHBINDIR)/gtst
