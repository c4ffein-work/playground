diff --git a/upstream/repro/G01-arch-sub-dist/alloc/sweep.sh b/upstream/repro/G01-arch-sub-dist/alloc/sweep.sh
new file mode 100755
index 0000000..3625b05
--- /dev/null
+++ b/upstream/repro/G01-arch-sub-dist/alloc/sweep.sh
@@ -0,0 +1,11 @@
+#!/bin/sh
+# Usage: sweep.sh <libdir> <tgt> [max] : fail the n-th malloc of an archload run for n = 1..max (ASan build, LSan on);
+# prints the n values for which a sanitizer report appeared.
+L=$1; F=$2; M=${3:-120}; D=$(dirname "$0")
+bad=""; n=1
+while [ $n -le $M ]; do
+  r=$(FAIL_AT=$n LD_PRELOAD=$D/failmalloc.so LD_LIBRARY_PATH=$L ASAN_OPTIONS=detect_leaks=1:verify_asan_link_order=0:allocator_may_return_null=1 $D/../common/archload $F 2>&1)
+  if echo "$r" | grep -q 'Sanitizer\|runtime error'; then bad="$bad $n"; fi
+  n=$((n + 1))
+done
+echo "$(basename $F): sanitizer reports at malloc #:${bad:- none}"
diff --git a/upstream/repro/G01-arch-sub-dist/alloc/sweep_plain.sh b/upstream/repro/G01-arch-sub-dist/alloc/sweep_plain.sh
new file mode 100755
index 0000000..816f576
--- /dev/null
+++ b/upstream/repro/G01-arch-sub-dist/alloc/sweep_plain.sh
@@ -0,0 +1,14 @@
+#!/bin/sh
+# Usage: sweep_plain.sh <plain-libdir> <tgt> [max] : runs common/archload_plain (non-sanitized build) with the n-th
+# malloc() failing (alloc/failmalloc.so), for n = 1..max, with glibc checks on (MALLOC_CHECK_=3, MALLOC_PERTURB_);
+# prints the n for which the process crashed (signal) and the number of runs in which the failure was injected.
+L=$1; F=$2; M=${3:-60}; D=$(cd "$(dirname "$0")" && pwd)
+bad=""; inj=0; n=1
+while [ $n -le $M ]; do
+  r=$(FAIL_AT=$n LD_LIBRARY_PATH=$L LD_PRELOAD=$D/failmalloc.so MALLOC_CHECK_=3 MALLOC_PERTURB_=165 $D/../common/archload_plain $F 2>&1)
+  rc=$?
+  echo "$r" | grep -q "failmalloc: failing" && inj=$((inj + 1))
+  [ $rc -ge 128 ] && bad="$bad $n"
+  n=$((n + 1))
+done
+echo "$(basename $F): injected=$inj crashes at malloc #:${bad:- none}"
diff --git a/upstream/repro/G01-arch-sub-dist/common/subapi2.c b/upstream/repro/G01-arch-sub-dist/common/subapi2.c
new file mode 100644
index 0000000..b721caf
--- /dev/null
+++ b/upstream/repro/G01-arch-sub-dist/common/subapi2.c
@@ -0,0 +1,33 @@
+/* Call SCOTCH_archSub() on "cmplt 4" with the terminal list given on
+** the command line, then ALWAYS call SCOTCH_archExit() on the
+** sub-architecture, as a caller that initialized it may do after a
+** failure. Expected: no sanitizer report, no leak, whatever the list. */
+#include <stdio.h>
+#include <stdlib.h>
+#include "scotch.h"
+
+int
+main (
+int                 argc,
+char *              argv[])
+{
+  SCOTCH_Arch         orgarchdat;
+  SCOTCH_Arch         subarchdat;
+  SCOTCH_Num          vnumtab[64];
+  SCOTCH_Num          vnumnbr;
+  int                 o;
+
+  SCOTCH_errorProg (argv[0]);
+  for (vnumnbr = 0; (vnumnbr < 64) && (vnumnbr + 1 < argc); vnumnbr ++)
+    vnumtab[vnumnbr] = (SCOTCH_Num) atol (argv[vnumnbr + 1]);
+  SCOTCH_archInit (&orgarchdat);
+  SCOTCH_archCmplt (&orgarchdat, 4);
+  SCOTCH_archInit (&subarchdat);
+  o = SCOTCH_archSub (&subarchdat, &orgarchdat, vnumnbr, vnumtab);
+  printf ("archSub ret=%d\n", o);
+  if (o == 0)
+    printf ("size=%ld\n", (long) SCOTCH_archSize (&subarchdat));
+  SCOTCH_archExit (&subarchdat);
+  SCOTCH_archExit (&orgarchdat);
+  return (o);
+}
