diff --git a/upstream/reports/7.0.18/patches/G29-cmake-sources-config/0009-Bugfix-do-not-export-internal-compile-definitions-of.patch b/upstream/reports/7.0.18/patches/G29-cmake-sources-config/0009-Bugfix-do-not-export-internal-compile-definitions-of.patch
new file mode 100644
index 0000000..7927bd8
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G29-cmake-sources-config/0009-Bugfix-do-not-export-internal-compile-definitions-of.patch
@@ -0,0 +1,54 @@
+From 4584b89c881d2bd740c2be3f32a6107378da94ed Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 16:08:34 +0000
+Subject: [PATCH 09/10] Bugfix: do not export internal compile definitions of
+ libScotch to CMake users [report R. Perry]
+
+COMMON_RANDOM_FIXED_SEED, SCOTCH_DETERMINISTIC and, on FreeBSD,
+cpu_set_t=cpuset_t and __BSD_VISIBLE were PUBLIC compile definitions
+of the "scotch" target, hence were recorded in the installed
+"scotchTargets.cmake" and added to the compilation flags of every
+program using `find_package(SCOTCH)`: a type renaming macro and a
+change of header visibility for user code.
+
+These definitions are only needed within the build tree, by the
+programs and tests that include internal header files. Restrict them
+to it with the BUILD_INTERFACE generator expression, as is already
+done for the include directories.
+
+Refs: BLD-24
+---
+ src/libscotch/CMakeLists.txt | 11 +++++++----
+ 1 file changed, 7 insertions(+), 4 deletions(-)
+
+diff --git a/src/libscotch/CMakeLists.txt b/src/libscotch/CMakeLists.txt
+index 6c13ce5f..e46ad9a8 100644
+--- a/src/libscotch/CMakeLists.txt
++++ b/src/libscotch/CMakeLists.txt
+@@ -537,16 +537,19 @@ if(APPLE)
+   set_target_properties(scotch PROPERTIES LINK_FLAGS "-undefined dynamic_lookup")
+ endif()
+ 
++# The following definitions are needed by all the targets of the build
++# tree, which include internal header files, but must not be exported
++# to the users of the installed library.
+ if(OS_IS_FREEBSD)
+-  target_compile_definitions(scotch PUBLIC cpu_set_t=cpuset_t __BSD_VISIBLE)
++  target_compile_definitions(scotch PUBLIC $<BUILD_INTERFACE:cpu_set_t=cpuset_t> $<BUILD_INTERFACE:__BSD_VISIBLE>)
+ endif()
+ 
+ if(SCOTCH_DETERMINISTIC STREQUAL FULL)
+-  target_compile_definitions(scotch PUBLIC COMMON_RANDOM_FIXED_SEED)
+-  target_compile_definitions(scotch PUBLIC SCOTCH_DETERMINISTIC)
++  target_compile_definitions(scotch PUBLIC $<BUILD_INTERFACE:COMMON_RANDOM_FIXED_SEED>)
++  target_compile_definitions(scotch PUBLIC $<BUILD_INTERFACE:SCOTCH_DETERMINISTIC>)
+   message(STATUS "Determinism: full")
+ elseif(SCOTCH_DETERMINISTIC STREQUAL FIXED_SEED)
+-  target_compile_definitions(scotch PUBLIC COMMON_RANDOM_FIXED_SEED)
++  target_compile_definitions(scotch PUBLIC $<BUILD_INTERFACE:COMMON_RANDOM_FIXED_SEED>)
+   message(STATUS "Determinism: fixed random seed")
+ else()
+   message(STATUS "Determinism: none")
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G29-cmake-sources-config/0010-Bugfix-detect-Open-MPI-when-configuring-CMake-tests-.patch b/upstream/reports/7.0.18/patches/G29-cmake-sources-config/0010-Bugfix-detect-Open-MPI-when-configuring-CMake-tests-.patch
new file mode 100644
index 0000000..a2a02be
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G29-cmake-sources-config/0010-Bugfix-detect-Open-MPI-when-configuring-CMake-tests-.patch
@@ -0,0 +1,48 @@
+From fd49efe03cc5f29231c187091aa276d5bd1b3c37 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 16:08:34 +0000
+Subject: [PATCH 10/10] Bugfix: detect Open MPI when configuring CMake tests
+ [report R. Perry]
+
+The regular expression used to detect Open MPI required a space before
+and after "Open MPI", whereas the library version string begins with
+"Open MPI v...". Hence, Open MPI was never detected, the
+"--oversubscribe" flag was never added to MPIEXEC_PREFLAGS, and the
+MPI tests failed for lack of slots on hosts with fewer cores than
+requested processes.
+
+Also, `if(NOT ${found_suite} STREQUAL "")` was expanded with an empty,
+unquoted operand when nothing matched, and `string(REGEX MATCHALL)`
+failed with a fatal error when the version string was empty. Use
+plain `if(... MATCHES ...)` tests for Open MPI and for Intel MPI.
+
+Refs: BLD-06
+Refs: PS-BLD-2
+---
+ src/CMakeLists.txt | 8 +++-----
+ 1 file changed, 3 insertions(+), 5 deletions(-)
+
+diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
+index 323d8bf3..9f17b845 100644
+--- a/src/CMakeLists.txt
++++ b/src/CMakeLists.txt
+@@ -178,13 +178,11 @@ if(BUILD_PTSCOTCH)
+   if(NOT MPI_C_FOUND)
+     message(FATAL_ERROR "MPI required to compile PT-Scotch\n Rerun cmake with -DBUILD_PTSCOTCH=OFF")
+   else()
+-    string(REGEX MATCHALL "\( Open MPI \)+" found_suite ${MPI_C_LIBRARY_VERSION_STRING})
+-    if(NOT ${found_suite} STREQUAL "")
+-      message(STATUS "Found OpenMPI: using '--oversubscribe' policy for testing")
++    if(MPI_C_LIBRARY_VERSION_STRING MATCHES "Open MPI")
++      message(STATUS "Found Open MPI: using '--oversubscribe' policy for testing")
+       set(MPIEXEC_PREFLAGS ${MPIEXEC_PREFLAGS} --oversubscribe)
+     endif()
+-    string(REGEX MATCHALL "\(Intel\)+" found_suite ${MPI_C_LIBRARY_VERSION_STRING})
+-    if(NOT ${found_suite} STREQUAL "")
++    if(MPI_C_LIBRARY_VERSION_STRING MATCHES "Intel")
+       message(STATUS "Found Intel MPI: using '-genv=I_MPI_PIN_DOMAIN=core' for testing")
+       set(MPIEXEC_PREFLAGS ${MPIEXEC_PREFLAGS} -genv=I_MPI_PIN_DOMAIN=core)
+     endif()
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G30-cmake-tests-make-ci/0001-Bugfix-link-all-object-files-into-libraries-in-Makef.patch b/upstream/reports/7.0.18/patches/G30-cmake-tests-make-ci/0001-Bugfix-link-all-object-files-into-libraries-in-Makef.patch
