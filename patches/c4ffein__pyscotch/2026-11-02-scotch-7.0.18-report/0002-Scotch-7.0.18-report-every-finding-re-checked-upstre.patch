+ ** It returns:
+ ** - METIS_OK      : if the partition has been successfully computed.
+ ** - METIS_ERROR*  : on error.
+@@ -587,6 +587,7 @@ SCOTCH_Num * const          part,
+ const SCOTCH_Num            flagval)
+ {
+   SCOTCH_Num          baseval;
++  SCOTCH_Num          objtval;
+   double              kbalval;
+ 
+   if (*ncon < 1) {
+@@ -594,6 +595,12 @@ const SCOTCH_Num            flagval)
+     return (METIS_ERROR_INPUT);
