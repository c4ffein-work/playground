diff --git a/upstream/reports/7.0.18/patches/G14-graph-loaders/0004-Bugfix-reject-duplicate-vertex-labels-in-graphCheck-.patch b/upstream/reports/7.0.18/patches/G14-graph-loaders/0004-Bugfix-reject-duplicate-vertex-labels-in-graphCheck-.patch
new file mode 100644
index 0000000..9743295
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G14-graph-loaders/0004-Bugfix-reject-duplicate-vertex-labels-in-graphCheck-.patch
@@ -0,0 +1,64 @@
+From 34722d26ed09132bf7565c264060b942f97dd5b0 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 09:18:39 +0000
+Subject: [PATCH 4/9] Bugfix: reject duplicate vertex labels in `graphCheck()`
+ [report PyScotch]
+
+Vertex labels index a relabeling table and must be unique; the file
+loaders enforce this, but a graph built through SCOTCH_graphBuild() with
+a user label array containing duplicates passed graphCheck(), and
+label consumers (e.g. SCOTCH_graphTabLoad()) then produced wrong
+results. Check label uniqueness when a label array is present.
+
+Refs: PS-API-5
+---
+ src/libscotch/graph_check.c | 23 +++++++++++++++++++++--
+ 1 file changed, 21 insertions(+), 2 deletions(-)
+
+diff --git a/src/libscotch/graph_check.c b/src/libscotch/graph_check.c
+index e6313916..731040fd 100644
+--- a/src/libscotch/graph_check.c
++++ b/src/libscotch/graph_check.c
+@@ -1,4 +1,4 @@
+-/* Copyright 2004,2007,2011,2012,2016,2018,2023 IPB, Universite de Bordeaux, INRIA & CNRS
++/* Copyright 2004,2007,2011,2012,2016,2018,2023,2026 IPB, Universite de Bordeaux, INRIA & CNRS
+ **
+ ** This file is part of the Scotch software package for static mapping,
+ ** graph partitioning and sparse matrix ordering.
+@@ -59,7 +59,7 @@
+ /**                # Version 6.0  : from : 27 jun 2011     **/
+ /**                                 to   : 23 feb 2018     **/
+ /**                # Version 7.0  : from : 19 jan 2023     **/
+-/**                                 to   : 12 mar 2023     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -203,5 +203,24 @@ const Graph * const         grafptr)
+     return (1);
+   }
+ 
++  if (grafptr->vlbltax != NULL) {                 /* If graph has vertex labels, they must be unique */
++    Gnum * restrict     sorttab;                  /* Temporary array for label sorting               */
++
++    if ((sorttab = (Gnum *) memAlloc (grafptr->vertnbr * sizeof (Gnum))) == NULL) {
++      errorPrint ("graphCheck: out of memory");
++      return (1);
++    }
++    memCpy (sorttab, grafptr->vlbltax + baseval, grafptr->vertnbr * sizeof (Gnum));
++    intSort1asc1 (sorttab, grafptr->vertnbr);     /* Sort label copy by ascending value */
++    for (vertnum = 1; vertnum < grafptr->vertnbr; vertnum ++) {
++      if (sorttab[vertnum] == sorttab[vertnum - 1]) {
++        errorPrint ("graphCheck: duplicate vertex label");
++        memFree    (sorttab);
++        return (1);
++      }
++    }
++    memFree (sorttab);
++  }
++
+   return (0);
+ }
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G14-graph-loaders/0005-Bugfix-validate-vertex-labels-and-edge-ends-read-by-.patch b/upstream/reports/7.0.18/patches/G14-graph-loaders/0005-Bugfix-validate-vertex-labels-and-edge-ends-read-by-.patch
new file mode 100644
index 0000000..b9dd264
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G14-graph-loaders/0005-Bugfix-validate-vertex-labels-and-edge-ends-read-by-.patch
@@ -0,0 +1,91 @@
+From 40fa7028808744c6d3bda365a0f8130390463d0d Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 09:14:11 +0000
+Subject: [PATCH 5/9] Bugfix: validate vertex labels and edge ends read by
+ `graphLoad()` [report R. Perry]
+
+`graphLoad()` stored file-controlled vertex labels and edge ends without
+range checking. Commit febaef7 rejected negative edge ends, but:
+
+ - negative vertex labels were still accepted and later used directly as
+   indices into indxtab[] in `graphLoad2()`, an out-of-bounds heap access
+   at a file-controlled offset (GRA-04);
+ - for unlabeled graphs no upper (or base-adjusted lower) bound was
+   enforced on edge ends, so a malformed file indexed vertex arrays out
+   of bounds once mapped or ordered; the only check lived under
+   SCOTCH_DEBUG_GRAPH2 (GRA-10).
+
+Reject negative labels at read time, as well as labels equal to the
+maximum Gnum value, which graphLoad2() would increment to size its
+index array, and, for unlabeled graphs,
+range-check each edge end against [baseval, vertnnd[ after base
+adjustment. Also reject negative vertex degrees, which 9c51d9df still
+accepts when the running arc count stays non-negative, and test the
+arc-array overflow before adding edgenum, instead of testing the sign
+of a sum that may already have overflowed.
+
+Refs: GRA-04, GRA-10, PS2-G14-1, PS2-G14-2
+---
+ src/libscotch/graph_io.c | 21 +++++++++++++++------
+ 1 file changed, 15 insertions(+), 6 deletions(-)
+
+diff --git a/src/libscotch/graph_io.c b/src/libscotch/graph_io.c
+index 2843f6f6..699eba1a 100644
+--- a/src/libscotch/graph_io.c
++++ b/src/libscotch/graph_io.c
+@@ -191,7 +191,9 @@ const GraphLoadFlag         flagval)              /* Graph loading flags
+     if (grafptr->vlbltax != NULL) {               /* If must read label               */
+       Gnum                vlblval;                /* Value where to read vertex label */
+ 
+-      if (intLoad (stream, &vlblval) != 1) {      /* Read label data */
++      if ((intLoad (stream, &vlblval) != 1) ||    /* Read label data                                    */
++          (vlblval < 0)                     ||    /* Labels are used as array indices later, and their  */
++          (vlblval >= GNUMMAX)) {                 /* maximum plus one as an array size in graphLoad2() */
+         errorPrint ("graphLoad: bad input (3)");
+         graphFree  (grafptr);
+         return (1);
+@@ -212,7 +214,8 @@ const GraphLoadFlag         flagval)              /* Graph loading flags
+         velosum                  +=
+         grafptr->velotax[vertnum] = veloval;
+     }
+-    if (intLoad (stream, &degrval) != 1) {        /* Read vertex degree */
++    if ((intLoad (stream, &degrval) != 1) ||      /* Read vertex degree */
++        (degrval < 0)) {
+       errorPrint ("graphLoad: bad input (5)");
+       graphFree  (grafptr);
+       return (1);
+@@ -221,13 +224,12 @@ const GraphLoadFlag         flagval)              /* Graph loading flags
+       degrmax = degrval;
+ 
+     grafptr->verttax[vertnum] = edgenum;          /* Set index in edge array */
+-    degrval += edgenum;
+-    if ((degrval > edgennd) ||                    /* Check if edge array overflows */
+-        (degrval < 0)) {
++    if (degrval > (edgennd - edgenum)) {          /* Check if edge array overflows, without overflowing degrval */
+       errorPrint ("graphLoad: invalid arc count (1)");
+       graphFree  (grafptr);
+       return (1);
+     }
++    degrval += edgenum;
+ 
+     for ( ; edgenum < degrval; edgenum ++) {
+       if (proptab[1] != 0) {                      /* If must read edge load        */
+@@ -249,7 +251,14 @@ const GraphLoadFlag         flagval)              /* Graph loading flags
+         graphFree  (grafptr);
+         return (1);
+       }
+-      grafptr->edgetax[edgenum] = edgeval + baseadj;
++      edgeval += baseadj;                         /* Adjust edge end to graph base (baseadj is zero for labeled graphs) */
++      if ((grafptr->vlbltax == NULL) &&           /* If edge ends are vertex indices, they must be in range           */
++          ((edgeval < grafptr->baseval) || (edgeval >= grafptr->vertnnd))) {
++        errorPrint ("graphLoad: invalid arc end number");
++        graphFree  (grafptr);
++        return (1);
++      }
++      grafptr->edgetax[edgenum] = edgeval;
+     }
+   }
+   grafptr->verttax[vertnum] = edgenum;            /* Set end of edge array             */
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G14-graph-loaders/0006-Bugfix-check-edge-array-bounds-before-storing-in-Cha.patch b/upstream/reports/7.0.18/patches/G14-graph-loaders/0006-Bugfix-check-edge-array-bounds-before-storing-in-Cha.patch
