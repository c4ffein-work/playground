+++ b/upstream/reports/7.0.18/patches/G03-arch-mesh-deco-misc/0003-Bugfix-open-one-character-file-names-in-dummysizes-r.patch
@@ -0,0 +1,48 @@
+From 6e1cd1979adb4f78f3d7b4a8aa0d4f57fb78f0cc Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 08:55:25 +0000
+Subject: [PATCH 3/4] Bugfix: open one-character file names in dummysizes
+ [report PyScotch]
+
+Since names default to "-", a file name is a standard stream if its
+first character is '-' and its second one is the terminating null
+character. The test for the opposite had been turned into a
+conjunction, so that one-character file names, e.g. "h", were taken
+for the standard input or output, and the files were not opened.
+
+Refs: PS3-G03-2
+---
+ src/libscotch/dummysizes.c | 6 +++---
+ 1 file changed, 3 insertions(+), 3 deletions(-)
+
+diff --git a/src/libscotch/dummysizes.c b/src/libscotch/dummysizes.c
+index 0a7df8e1..6520b621 100644
+--- a/src/libscotch/dummysizes.c
++++ b/src/libscotch/dummysizes.c
+@@ -1,4 +1,4 @@
+-/* Copyright 2004,2007-2010,2012,2014,2018,2019,2021,2023-2025 IPB, Universite de Bordeaux, INRIA & CNRS
++/* Copyright 2004,2007-2010,2012,2014,2018,2019,2021,2023-2026 IPB, Universite de Bordeaux, INRIA & CNRS
+ **
+ ** This file is part of the Scotch software package for static mapping,
+ ** graph partitioning and sparse matrix ordering.
+@@ -56,7 +56,7 @@
+ /**                # Version 6.1  : from : 09 feb 2021     **/
+ /**                                 to   : 22 jun 2021     **/
+ /**                # Version 7.0  : from : 25 aug 2019     **/
+-/**                                 to   : 13 aug 2025     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -228,7 +228,7 @@ char *                      argv[])
+   }
+ 
+   for (i = 0; i < C_FILENBR; i ++) {              /* For all file names     */
+-    if ((C_fileTab[i].nameptr[0] != '-') &&       /* If not standard stream */
++    if ((C_fileTab[i].nameptr[0] != '-') ||       /* If not standard stream */
+         (C_fileTab[i].nameptr[1] != '\0')) {
+       if ((C_fileTab[i].fileptr = fopen (C_fileTab[i].nameptr, ((C_fileTab[i].flagval & FILEMODE) == FILEMODER) ? "r" : "w")) == NULL) { /* Open the file */
+           fprintf (stderr, "dummysizes: ERROR: main: cannot open file (%d)\n", i);
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G03-arch-mesh-deco-misc/0004-Bugfix-fix-line-length-test-and-debug-code-of-dummys.patch b/upstream/reports/7.0.18/patches/G03-arch-mesh-deco-misc/0004-Bugfix-fix-line-length-test-and-debug-code-of-dummys.patch
new file mode 100644
index 0000000..539a541
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G03-arch-mesh-deco-misc/0004-Bugfix-fix-line-length-test-and-debug-code-of-dummys.patch
@@ -0,0 +1,46 @@
+From cc887fcc93b5e497444ee6b0b3caa86d65dd3bd1 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 08:55:36 +0000
+Subject: [PATCH 4/4] Bugfix: fix line length test and debug code of dummysizes
+ [report R. Perry]
+
+The line length test read the last character of the line buffer, which
+`fgets()` never fills, so that any line of `CHARMAX - 1` characters
+ending with a newline was reported as too long. Also, the
+`SCOTCH_DEBUG_MAIN1` file closing code referred to non-existent fields
+of the `File` structure, and did not compile.
+
+Refs: COR-20
+---
+ src/libscotch/dummysizes.c | 8 ++++----
+ 1 file changed, 4 insertions(+), 4 deletions(-)
+
+diff --git a/src/libscotch/dummysizes.c b/src/libscotch/dummysizes.c
+index 6520b621..952bc89c 100644
+--- a/src/libscotch/dummysizes.c
++++ b/src/libscotch/dummysizes.c
+@@ -365,7 +365,7 @@ char *                      argv[])
+     int                 subsnum;
+ 
+     if ((strlen (chartab)) >= (CHARMAX - 1) &&    /* If line read is at least as long as maximum size              */
+-        (chartab[CHARMAX - 1] != '\n')) {         /* And last character is not a newline, that is, some is missing */
++        (chartab[CHARMAX - 2] != '\n')) {         /* And last character is not a newline, that is, some is missing */
+       fprintf (stderr, "dummysizes: ERROR: line too long\n");
+       exit    (EXIT_FAILURE);
+     }
+@@ -407,9 +407,9 @@ char *                      argv[])
+ 
+ #ifdef SCOTCH_DEBUG_MAIN1
+   for (i = 0; i < C_FILENBR; i ++) {              /* For all file names     */
+-    if ((C_fileTab[i].name[0] != '-') ||          /* If not standard stream */
+-        (C_fileTab[i].name[1] != '\0')) {
+-      fclose (C_fileTab[i].pntr);                 /* Close the stream */
++    if ((C_fileTab[i].nameptr[0] != '-') ||       /* If not standard stream */
++        (C_fileTab[i].nameptr[1] != '\0')) {
++      fclose (C_fileTab[i].fileptr);              /* Close the stream */
+     }
+   }
+ #endif /* SCOTCH_DEBUG_MAIN1 */
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G04-strategy-parser/0001-Bugfix-reject-strategy-values-for-non-strategy-param.patch b/upstream/reports/7.0.18/patches/G04-strategy-parser/0001-Bugfix-reject-strategy-values-for-non-strategy-param.patch
new file mode 100644
index 0000000..89de066
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G04-strategy-parser/0001-Bugfix-reject-strategy-values-for-non-strategy-param.patch
@@ -0,0 +1,47 @@
+From 99db123a8dbe9c6abbb16e2dcf658a63c9b78cfe Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 09:19:59 +0000
+Subject: [PATCH 01/10] Bugfix: reject strategy values for non-strategy
+ parameters [report R. Perry]
+
+The grammar accepted a (possibly empty) strategy as the value of any
+method parameter, and stored the `Strat` pointer over the parameter
+slot whatever its type: `m{vert=}` or `m{vert=/(vert>1)?f;g}` silently
+corrupted the method data (8-byte store over an `INT` slot) and leaked
+the sub-strategy. Check the parameter type before parsing the
+sub-strategy, and report an invalid parameter value through the
+existing error rule.
+
+Refs: COR-22
+---
+ src/libscotch/parser_yy.y | 7 +++++--
+ 1 file changed, 5 insertions(+), 2 deletions(-)
+
+diff --git a/src/libscotch/parser_yy.y b/src/libscotch/parser_yy.y
+index 37994f87..0b3833c7 100644
+--- a/src/libscotch/parser_yy.y
++++ b/src/libscotch/parser_yy.y
+@@ -52,7 +52,7 @@
+ /**                # Version 6.0  : from : 30 sep 2014     **/
+ /**                                 to   : 27 apr 2018     **/
+ /**                # Version 7.0  : from : 02 mar 2018     **/
+-/**                                 to   : 25 sep 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -457,7 +457,10 @@ PARAMVAL      : VALCASE
+               }
+               |
+               {
+-                ($<SAVE>$).strat = penvptr->straptr;
++                if (penvptr->paraptr->typeval != STRATPARAMSTRAT) /* If parameter cannot hold a strategy */
++                  YYERROR;                        /* Report invalid parameter value         */
++
++                ($<SAVE>$).strat = penvptr->straptr; /* Save current method and parameter */
+                 ($<SAVE>$).param = penvptr->paraptr;
+                 penvptr->straptr = NULL;
+                 penvptr->paraptr = NULL;
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G04-strategy-parser/0002-Bugfix-restore-parser-context-before-reporting-a-syn.patch b/upstream/reports/7.0.18/patches/G04-strategy-parser/0002-Bugfix-restore-parser-context-before-reporting-a-syn.patch
new file mode 100644
index 0000000..7cade00
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G04-strategy-parser/0002-Bugfix-restore-parser-context-before-reporting-a-syn.patch
@@ -0,0 +1,68 @@
+From 46a533b8e118a11ec0990cab31181e912790213c Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 09:24:35 +0000
+Subject: [PATCH 02/10] Bugfix: restore parser context before reporting a
+ syntax error within a nested strategy [report R. Perry]
+
+A syntax error inside a strategy-valued parameter is caught by the
+`error` alternative of `PARAMVAL` after the mid-rule action that
+introduces the sub-strategy has cleared `penvptr->straptr` and
+`penvptr->paraptr`; the error message dereferences both, which crashes
+on strings such as `r{sep=m{asc=b{:width=3}}}`. The saved context
+cannot be restored by the final action, because Bison discards the
+mid-rule value when it pops the stack during error recovery.
+
+Type the mid-rule value and attach a `%destructor` to it, so that the
+saved method and parameter are restored whenever the sub-strategy is
+discarded, and the error rule always reports the right parameter.
+
+Refs: COR-01
+---
+ src/libscotch/parser_yy.y | 15 ++++++++++-----
+ 1 file changed, 10 insertions(+), 5 deletions(-)
+
+diff --git a/src/libscotch/parser_yy.y b/src/libscotch/parser_yy.y
+index 0b3833c7..fde00aa2 100644
+--- a/src/libscotch/parser_yy.y
++++ b/src/libscotch/parser_yy.y
+@@ -137,6 +137,11 @@ YY_DECL;                                          /* Definition of yylex(); Flex
+ %type <STRAT>        STRATCONCAT   STRATTEST     STRATTESTELSE STRATEMPTY
+ %type <STRAT>        STRATGROUP    STRATMETHOD   STRATSELECT
+ 
++%destructor {                                     /* Restore parser context when sub-strategy is discarded by error recovery */
++  penvptr->straptr = ($$).strat;
++  penvptr->paraptr = ($$).param;
++} <SAVE>
++
+ %start STRAT
+ 
+ %%
+@@ -455,20 +460,20 @@ PARAMVAL      : VALCASE
+                           ($1));
+                 }
+               }
+-              |
++              | <SAVE>
+               {
+                 if (penvptr->paraptr->typeval != STRATPARAMSTRAT) /* If parameter cannot hold a strategy */
+                   YYERROR;                        /* Report invalid parameter value         */
+ 
+-                ($<SAVE>$).strat = penvptr->straptr; /* Save current method and parameter */
+-                ($<SAVE>$).param = penvptr->paraptr;
++                ($$).strat = penvptr->straptr;    /* Save current method and parameter; typed value is restored by destructor on error */
++                ($$).param = penvptr->paraptr;
+                 penvptr->straptr = NULL;
+                 penvptr->paraptr = NULL;
+               }
+                 STRATSELECT
+               {
+-                penvptr->straptr = ($<SAVE>1).strat; /* Restore current method    */
+-                penvptr->paraptr = ($<SAVE>1).param; /* Restore current parameter */
++                penvptr->straptr = ($1).strat;    /* Restore current method    */
++                penvptr->paraptr = ($1).param;    /* Restore current parameter */
+ 
+                 if ((penvptr->paraptr->typeval & STRATPARAMDEPRECATED) == 0) { /* If parameter is not deprecated */
+ #ifdef SCOTCH_DEBUG_PARSER2
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G04-strategy-parser/0003-Bugfix-free-partially-built-strategy-trees-on-parsin.patch b/upstream/reports/7.0.18/patches/G04-strategy-parser/0003-Bugfix-free-partially-built-strategy-trees-on-parsin.patch
