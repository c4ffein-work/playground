index 0000000..bfe594b
--- /dev/null
+++ b/upstream/repro/G22-bdgraph/DMO-09/check.py
@@ -0,0 +1,11 @@
+import re,sys
+for f in sys.argv[1:]:
+  cur=None;bad=0;n=0;grp={}
+  for l in open(f):
+    if l.startswith('=='): cur=l.strip(); grp[cur]=set(); continue
+    m=re.search(r'ret=(\d+).*bal=(\S+) balcalc=(\S+)',l)
+    if m:
+      n+=1
+      if m.group(2)!=m.group(3): bad+=1
+      grp[cur].add(m.group(2))
+  print(f,'rank lines',n,'bal!=balcalc',bad,'diverging probes',sum(len(v)>1 for v in grp.values()))
diff --git a/upstream/repro/G22-bdgraph/DMO-09/probes.sh b/upstream/repro/G22-bdgraph/DMO-09/probes.sh
new file mode 100755
index 0000000..4014329
--- /dev/null
+++ b/upstream/repro/G22-bdgraph/DMO-09/probes.sh
@@ -0,0 +1,7 @@
+#!/bin/bash
+# probes.sh LIBDIR BIN : the DMO-09 probes (bal field vs recomputed balcalc)
+L=$1; B=$2
+for np in 2 3 4; do for s in 'q{strat=f}' 'q{strat=f}x{bal=0.001}z' 'm{asc=/(levl<0)?z;,low=q{strat=f}x{bal=0},seq=q{strat=f}x{bal=0},fold=d,dvert=100000,vert=100}' 'm{asc=/(levl<0)?z;,low=q{strat=f},seq=q{strat=f},fold=d}' 'q{strat=f}q{strat=/(bal<0)?z;}' 'q{strat=f}q{strat=/(bal>0)?z;}'; do
+  echo "== np=$np $s"
+  LD_LIBRARY_PATH=$L timeout 60 mpirun --oversubscribe -np $np -x LD_LIBRARY_PATH -x ASAN_OPTIONS $B 4elt.grf 0 "$s" 0 1 2>&1 | grep -E "rank|ERROR|runtime" | sort
+done; done
