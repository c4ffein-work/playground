+   GainEntr *                tmin;                 /*+ Non-empty entry of minimum gain        +*/
+   GainEntr *                tmax;                 /*+ Non-empty entry of maximum gain        +*/
+   GainEntr *                tend;                 /*+ Last valid gain entry                  +*/
++  GainLink                  linkdat;              /*+ Dummy link for fast list operations    +*/
