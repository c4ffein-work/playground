++  Gnum                              helmbas;      /* Start index of range of hash indices to move */
++  Gnum                              helmnnd;      /* End index of range of hash indices to move   */
++  Gnum                              helmnum;
+   Gnum                              hnodold;
+   VmeshSeparateFmSave * restrict    savetab;
+   Gnum                              savenum;
+ 
+-  hashmax = 2 * hashold;                          /* Set new number */
