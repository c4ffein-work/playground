diff --git a/upstream/reports/7.0.18/series/0070-Bugfix-account-for-existing-domains-when-sizing-fixe.patch b/upstream/reports/7.0.18/series/0070-Bugfix-account-for-existing-domains-when-sizing-fixe.patch
new file mode 100644
index 0000000..46c5312
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0070-Bugfix-account-for-existing-domains-when-sizing-fixe.patch
@@ -0,0 +1,179 @@
+From 803ea5aa5fc2ec8486267a24900ceb9e8ebd0162 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 08:25:34 +0000
+Subject: [PATCH 070/232] Bugfix: account for existing domains when sizing
+ fixed vertex merging hash table [report PyScotch]
+
+Since 22c9c42e, the hash table of `kgraphMapRbVfloMerge()` is sized
+according to the maximum number of fixed domains only. However, all the
+domains of the mapping computed on the non-fixed vertices are inserted
+into it first. When there are few fixed vertices and many parts, e.g. a
+single fixed vertex and 64 parts, the table fills up and the insertion
+loop never terminates. Size the table according to the number of
+existing domains plus the maximum number of fixed domains.
+
+Add test cases with zero-load fixed vertices on distinct terminal
+domains, and with a single fixed vertex mapped onto many domains.
+
+Refs: GRA-01, PS3-G12-1
+---
+ src/check/test_scotch_graph_map.c | 66 ++++++++++++++++++++++++++++---
+ src/libscotch/kgraph_map_rb.c     |  8 ++--
+ 2 files changed, 66 insertions(+), 8 deletions(-)
+
+diff --git a/src/check/test_scotch_graph_map.c b/src/check/test_scotch_graph_map.c
+index 04d38aef..07c2c165 100644
+--- a/src/check/test_scotch_graph_map.c
++++ b/src/check/test_scotch_graph_map.c
+@@ -41,7 +41,7 @@
+ /**   DATES      : # Version 6.0  : from : 12 aug 2014     **/
+ /**                                 to   : 17 jul 2024     **/
+ /**                # Version 7.0  : from : 04 jul 2025     **/
+-/**                                 to   : 11 apr 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -118,22 +118,30 @@ main (
+ int                 argc,
+ char *              argv[])
+ {
+-  SCOTCH_Mapping      mappdat;                    /* Mapping to compute */
+-  SCOTCH_Mapping      mapodat;                    /* Old mapping        */
++  SCOTCH_Mapping      mappdat;                    /* Mapping to compute                     */
++  SCOTCH_Mapping      mapodat;                    /* Old mapping                            */
+   FILE *              fileptr;
+   SCOTCH_Graph        grafdat;
++  SCOTCH_Graph        fixgrafdat;                 /* Graph with zero-load fixed vertices    */
+   SCOTCH_Num          xdimsiz;
+   int                 archnum;
+   SCOTCH_Arch         archtab[ARCHNBR];
++  SCOTCH_Arch         fixarchdat;                 /* Architecture for fixed vertex mapping  */
+   SCOTCH_Strat        stratab[STRANBR];
+   int                 stranum;
+   int                 typenum;
++  SCOTCH_Num          baseval;
+   SCOTCH_Num          vertnbr;
+   SCOTCH_Num          vertnum;
++  SCOTCH_Num *        verttab;
++  SCOTCH_Num *        vendtab;
++  SCOTCH_Num *        velotab;
++  SCOTCH_Num          edgenbr;
++  SCOTCH_Num *        edgetab;
+   SCOTCH_Num *        parttab;
+   SCOTCH_Num *        parotab;
+   SCOTCH_Num *        vmlotab;
+-  SCOTCH_Num *        vmloptr;                    /* vmlotab or NULL    */
++  SCOTCH_Num *        vmloptr;                    /* vmlotab or NULL                        */
+   int                 o;
+ 
+   SCOTCH_errorProg (argv[0]);
+@@ -171,7 +179,8 @@ char *              argv[])
+ 
+   if (((parttab = malloc (vertnbr * sizeof (SCOTCH_Num))) == NULL) ||
+       ((parotab = malloc (vertnbr * sizeof (SCOTCH_Num))) == NULL) ||
+-      ((vmlotab = malloc (vertnbr * sizeof (SCOTCH_Num))) == NULL)) {
++      ((vmlotab = malloc (vertnbr * sizeof (SCOTCH_Num))) == NULL) ||
++      ((velotab = malloc (vertnbr * sizeof (SCOTCH_Num))) == NULL)) {
+     SCOTCH_errorPrint ("main: out of memory");
+     exit (EXIT_FAILURE);
+   }
+@@ -291,12 +300,59 @@ char *              argv[])
+ 
+   fclose (fileptr);
+ 
++  for (vertnum = 0; vertnum < vertnbr; vertnum ++) /* All vertices but one have zero loads */
++    velotab[vertnum] = 0;
++  velotab[vertnbr / 2] = 1;
++
++  SCOTCH_graphData (&grafdat, &baseval, NULL, &verttab, &vendtab, NULL, NULL, &edgenbr, &edgetab, NULL);
++  if ((SCOTCH_graphInit  (&fixgrafdat) != 0) ||   /* Build a copy of the graph with vertex loads */
++      (SCOTCH_graphBuild (&fixgrafdat, baseval, vertnbr, verttab, vendtab, velotab, NULL, edgenbr, edgetab, NULL) != 0)) {
++    SCOTCH_errorPrint ("main: cannot build graph with vertex loads");
++    exit (EXIT_FAILURE);
++  }
++  if ((SCOTCH_archInit  (&fixarchdat) != 0) ||
++      (SCOTCH_archCmplt (&fixarchdat, vertnbr) != 0)) { /* One terminal domain per vertex */
++    SCOTCH_errorPrint ("main: cannot initialize architecture");
++    exit (EXIT_FAILURE);
++  }
++
++  for (stranum = 0; stranum < STRANBR; stranum ++) {
++    printf ("Strat %d, zero-load fixed vertices\n", stranum);
++
++    for (vertnum = 0; vertnum < vertnbr; vertnum ++) /* Fix all vertices but the one with a non-zero load */
++      parttab[vertnum] = vertnum;                 /* Each fixed vertex belongs to a distinct terminal domain */
++    parttab[vertnbr / 2] = -1;
++
++    if (SCOTCH_graphMapFixed (&fixgrafdat, &fixarchdat, &stratab[stranum], parttab) != 0) {
++      SCOTCH_errorPrint ("main: cannot compute mapping with zero-load fixed vertices");
++      exit (EXIT_FAILURE);
++    }
++
++    checkMap (vertnbr, parttab, vertnbr, 0);
++
++    printf ("Strat %d, single fixed vertex\n", stranum);
++
++    memset (parttab, ~0, vertnbr * sizeof (SCOTCH_Num)); /* Map all vertices but one onto many terminal domains */
++    parttab[0] = 0;
++
++    if (SCOTCH_graphMapFixed (&grafdat, &fixarchdat, &stratab[stranum], parttab) != 0) {
++      SCOTCH_errorPrint ("main: cannot compute mapping with single fixed vertex");
++      exit (EXIT_FAILURE);
++    }
++
++    checkMap (vertnbr, parttab, vertnbr, 0);
++  }
++
++  SCOTCH_archExit  (&fixarchdat);
++  SCOTCH_graphExit (&fixgrafdat);
++
+   for (archnum = 0; archnum < ARCHNBR; archnum ++)
+     SCOTCH_archExit (&archtab[archnum]);
+ 
+   for (stranum = 0; stranum < STRANBR; stranum ++)
+    SCOTCH_stratExit (&stratab[stranum]);
+ 
++  free (velotab);
+   free (vmlotab);
+   free (parotab);
+   free (parttab);
+diff --git a/src/libscotch/kgraph_map_rb.c b/src/libscotch/kgraph_map_rb.c
+index 542af13e..2e03c416 100644
+--- a/src/libscotch/kgraph_map_rb.c
++++ b/src/libscotch/kgraph_map_rb.c
+@@ -69,7 +69,7 @@
+ /**                # Version 6.0  : from : 03 mar 2011     **/
+ /**                                 to   : 21 jun 2019     **/
+ /**                # Version 7.0  : from : 23 aug 2019     **/
+-/**                                 to   : 19 oct 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -403,6 +403,7 @@ const Anum * restrict const pfixtax)              /*+ Array of fixed vertex term
+   Gnum                            vertnum;
+   Gnum                            vertnnd;
+   KgraphMapRbVfloHash * restrict  hashtab;        /* Hash table for merging fixed vertices */
++  Gnum                            hashnbr;        /* Prospective number of cells in table  */
+   Gnum                            hashsiz;        /* Size of hash table                    */
+   Gnum                            hashnum;
+   Gnum                            hashmsk;        /* Mask for access to hash table         */
+@@ -410,11 +411,12 @@ const Anum * restrict const pfixtax)              /*+ Array of fixed vertex term
+   const Arch * restrict const archptr = mappptr->archptr;
+   Anum * restrict const       parttax = mappptr->parttax;
+ 
+-  for (hashmsk = 1; hashmsk < dfixmax; hashmsk = 2 * hashmsk + 1) ; /* Get upper power of two */
++  hashnbr = mappptr->domnnbr + dfixmax;           /* Existing domains plus fixed domains */
++  for (hashmsk = 1; hashmsk < hashnbr; hashmsk = 2 * hashmsk + 1) ; /* Get upper power of two */
+   hashmsk = hashmsk * 4 + 3;                      /* Fill hash table at 25% maximum capacity  */
+   hashsiz = hashmsk + 1;
+ 
+-  if ((hashtab = memAlloc (hashsiz * sizeof (KgraphMapRbVfloHash))) == NULL) { /* Use fixed vertex load slots as hash slots */
++  if ((hashtab = memAlloc (hashsiz * sizeof (KgraphMapRbVfloHash))) == NULL) {
+     errorPrint ("kgraphMapRbVfloMerge: out of memory (1)");
+     return (1);
+   }
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0071-Bugfix-free-bipartition-graph-on-error-in-kgraphMapR.patch b/upstream/reports/7.0.18/series/0071-Bugfix-free-bipartition-graph-on-error-in-kgraphMapR.patch
new file mode 100644
index 0000000..d1fbf68
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0071-Bugfix-free-bipartition-graph-on-error-in-kgraphMapR.patch
@@ -0,0 +1,50 @@
+From 56163fe0abaeffb71579aedc373add368f15190e Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 09:14:28 +0000
+Subject: [PATCH 071/232] Bugfix: free bipartition graph on error in
+ `kgraphMapRbBgraph()` [report R. Perry]
+
+Once `bgraphInit()` had succeeded, the error paths of the routine
+(allocation failure of the external gain array, invalid fixed part
+array, inconsistent graph data in debug mode) returned without freeing
+the bipartition graph, and its callers did not free it either.
+
+Refs: GRA-21
+---
+ src/libscotch/kgraph_map_rb.c | 6 +++++-
+ 1 file changed, 5 insertions(+), 1 deletion(-)
+
+diff --git a/src/libscotch/kgraph_map_rb.c b/src/libscotch/kgraph_map_rb.c
+index 2e03c416..ee892c93 100644
+--- a/src/libscotch/kgraph_map_rb.c
++++ b/src/libscotch/kgraph_map_rb.c
+@@ -554,6 +554,7 @@ Context * const                         contptr)  /*+ Execution context
+ 
+   if ((veextax = (Gnum *) memAlloc (actgrafptr->s.vertnbr * sizeof (Gnum))) == NULL) {
+     errorPrint ("kgraphMapRbBgraph: out of memory");
++    bgraphExit (actgrafptr);
+     return (1);
+   }
+   veextax -= actgrafptr->s.baseval;
+@@ -675,7 +676,9 @@ Context * const                         contptr)  /*+ Execution context
+ fail:
+   if ((o != 0) || (veexmsk == 0)) {               /* If external gain array is useless */
+     memFree (veextax + actgrafptr->s.baseval);    /* Forget about it                   */
+-    return  (o);                                  /* Return error code                 */
++    if (o != 0)                                   /* On error, free bipartition graph  */
++      bgraphExit (actgrafptr);
++    return (o);                                   /* Return error code                 */
+   }
+ 
+   actgrafptr->s.flagval |= BGRAPHFREEVEEX;        /* Keep external gain array */
+@@ -689,6 +692,7 @@ fail:
+ #ifdef SCOTCH_DEBUG_KGRAPH2
+   if (bgraphCheck (actgrafptr) != 0) {
+     errorPrint ("kgraphMapRbBgraph: inconsistent graph data");
++    bgraphExit (actgrafptr);
+     return (1);
+   }
+ #endif /* SCOTCH_DEBUG_KGRAPH2 */
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0072-Bugfix-free-hash-table-on-error-in-kgraphMapRbVfloMe.patch b/upstream/reports/7.0.18/series/0072-Bugfix-free-hash-table-on-error-in-kgraphMapRbVfloMe.patch
new file mode 100644
index 0000000..4600881
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0072-Bugfix-free-hash-table-on-error-in-kgraphMapRbVfloMe.patch
@@ -0,0 +1,92 @@
+From 95a972075d0cfe3746e61eda6cc44cd3d04e846c Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 08:26:10 +0000
+Subject: [PATCH 072/232] Bugfix: free hash table on error in
+ `kgraphMapRbVfloMerge()` [report PyScotch]
+
+The error paths of `kgraphMapRbVfloMerge()`, including the one added
+for invalid terminal domain numbers in 6f734966, returned without
+freeing the hash table. Route them all through a single exit point,
+as `mapBuild3()` does, which also keeps the number of domains of the
+mapping consistent with the domains already created.
+
+Refs: GRA-23
+---
+ src/libscotch/kgraph_map_rb.c | 20 +++++++++++++-------
+ 1 file changed, 13 insertions(+), 7 deletions(-)
+
+diff --git a/src/libscotch/kgraph_map_rb.c b/src/libscotch/kgraph_map_rb.c
+index ee892c93..7dd97563 100644
+--- a/src/libscotch/kgraph_map_rb.c
++++ b/src/libscotch/kgraph_map_rb.c
+@@ -407,6 +407,7 @@ const Anum * restrict const pfixtax)              /*+ Array of fixed vertex term
+   Gnum                            hashsiz;        /* Size of hash table                    */
+   Gnum                            hashnum;
+   Gnum                            hashmsk;        /* Mask for access to hash table         */
++  int                             o;
+ 
+   const Arch * restrict const archptr = mappptr->archptr;
+   Anum * restrict const       parttax = mappptr->parttax;
+@@ -422,6 +423,8 @@ const Anum * restrict const pfixtax)              /*+ Array of fixed vertex term
+   }
+   memSet (hashtab, ~0, hashsiz * sizeof (KgraphMapRbVfloHash)); /* Set all vertex numbers to ~0 */
+ 
++  o = 1;                                          /* Assume loop will fail */
++
+   for (domnnum = 0; domnnum < mappptr->domnnbr; domnnum ++) { /* Load all existing domains into hash table */
+     Anum                termnum;
+ 
+@@ -445,7 +448,7 @@ const Anum * restrict const pfixtax)              /*+ Array of fixed vertex term
+ #ifdef SCOTCH_DEBUG_KGRAPH2
+       if (mappptr->parttax[vertnum] < 0) {        /* If vertex has not been mapped */
+         errorPrint ("kgraphMapRbVfloMerge: internal error (1)");
+-        return (1);
++        goto fail;
+       }
+ #endif /* SCOTCH_DEBUG_KGRAPH2 */
+       continue;                                   /* Skip to next vertex */
+@@ -454,7 +457,7 @@ const Anum * restrict const pfixtax)              /*+ Array of fixed vertex term
+ #ifdef SCOTCH_DEBUG_KGRAPH2
+     if (mappptr->parttax[vertnum] >= 0) {         /* If fixed vertex has been mapped */
+       errorPrint ("kgraphMapRbVfloMerge: internal error (2)");
+-      return (1);
++      goto fail;
+     }
+ #endif /* SCOTCH_DEBUG_KGRAPH2 */
+ 
+@@ -465,12 +468,12 @@ const Anum * restrict const pfixtax)              /*+ Array of fixed vertex term
+         if (domnnum >= mappptr->domnmax) {
+           if (mapResize (mappptr, mappptr->domnmax + (mappptr->domnmax >> 2) + 8) != 0) { /* Increase size by 25% */
+             errorPrint ("kgraphMapRbVfloMerge: out of memory (2)");
+-            return (1);
++            goto fail;
+           }
+         }
+         if (archDomTerm (archptr, &mappptr->domntab[domnnum], pfixval) != 0) { /* Add new domain to domain array */
+           errorPrint ("kgraphMapRbVfloMerge: invalid part array");
+-          return (1);
++          goto fail;
+         }
+ 
+         hashtab[hashnum].termnum = pfixval;       /* Create slot */
+@@ -481,11 +484,14 @@ const Anum * restrict const pfixtax)              /*+ Array of fixed vertex term
+     }
+     parttax[vertnum] = hashtab[hashnum].domnnum;  /* Assign fixed vertex to existing domain */
+   }
+-  mappptr->domnnbr = domnnum;
++  o = 0;                                          /* Success */
++
++fail:
++  mappptr->domnnbr = domnnum;                     /* Set updated number of domains */
+ 
+-  memFree (hashtab);
++  memFree (hashtab);                              /* Free hash table */
+ 
+-  return (0);
++  return (o);
+ }
+ 
+ /*****************************************/
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0073-Bugfix-do-not-compute-cost-of-mapping-after-recursiv.patch b/upstream/reports/7.0.18/series/0073-Bugfix-do-not-compute-cost-of-mapping-after-recursiv.patch
new file mode 100644
index 0000000..93d6b9a
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0073-Bugfix-do-not-compute-cost-of-mapping-after-recursiv.patch
@@ -0,0 +1,58 @@
+From 713ed9eb04078e54de9276cf7beba84bb1b2fa73 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 08:26:23 +0000
+Subject: [PATCH 073/232] Bugfix: do not compute cost of mapping after
+ recursive bipartitioning failed in `kgraphMapRb()` [report PyScotch]
+
+When `kgraphMapRbPart()` or `kgraphMapRbMap()` failed, the error value
+was only returned at the end of the routine, after fixed vertices had
+been merged into, and the frontier and cost computed from, an
+incomplete mapping whose domain array may contain uninitialized
+entries. Return as soon as the failure is known.
+
+Refs: PS2-G12-1
+---
+ src/libscotch/kgraph_map_rb.c | 19 ++++++++++++-------
+ 1 file changed, 12 insertions(+), 7 deletions(-)
+
