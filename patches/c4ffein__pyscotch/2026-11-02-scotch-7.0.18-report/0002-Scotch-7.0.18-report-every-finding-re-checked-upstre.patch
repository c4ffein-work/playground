diff --git a/upstream/reports/7.0.18/patches/G18-dgraph-fold-redist/0006-Bugfix-make-error-handling-of-dgraphRedist-collectiv.patch b/upstream/reports/7.0.18/patches/G18-dgraph-fold-redist/0006-Bugfix-make-error-handling-of-dgraphRedist-collectiv.patch
