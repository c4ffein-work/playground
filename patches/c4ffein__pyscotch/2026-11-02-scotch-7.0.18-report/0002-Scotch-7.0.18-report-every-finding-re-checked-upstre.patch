+-    cheklocval = 1;
++    goto fail1;
+   }
+-  else {
+-    bandedgeloctax -= bandgrafptr->baseval;
+-    bandedloloctax  = (grafptr->edloloctax != NULL) ? (bandedloloctax - bandgrafptr->baseval) : NULL;
