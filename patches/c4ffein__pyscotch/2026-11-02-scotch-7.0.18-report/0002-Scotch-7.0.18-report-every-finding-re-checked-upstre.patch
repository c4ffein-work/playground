+diff --git a/src/check/test_scotch_dgraph_build.c b/src/check/test_scotch_dgraph_build.c
+new file mode 100644
+index 00000000..91ee85fa
+--- /dev/null
++++ b/src/check/test_scotch_dgraph_build.c
+@@ -0,0 +1,227 @@
