+              proctmp != 0; levlmax ++, proctmp >>= 1)
+           bitsnbr += proctmp & 1;
+ 
+-        if (bitsnbr == 1) {
++        if ((o == METIS_OK) && (bitsnbr == 1)) {  /* If ordering computed and number of processes is a power of 2 */
+           SCOTCH_Num          cblkglbnbr;
+ 
+           if ((cblkglbnbr = SCOTCH_dgraphOrderCblkDist (&grafdat, &ordedat)) >= 0) {
+@@ -171,7 +172,7 @@ MPI_Comm *                  commptr)
+                 SCOTCH_Num          cblknum;
+ 
+                 memSet (sepaglbtab, ~0, cblkglbnbr * sizeof (SCOTCH_Num) * 3);
