diff --git a/upstream/reports/7.0.18/series/0069-Bugfix-initialize-old-part-array-of-all-band-graph-a.patch b/upstream/reports/7.0.18/series/0069-Bugfix-initialize-old-part-array-of-all-band-graph-a.patch
