+   size_t                      coarvelooftval;
+   size_t                      coaredgeoftval;
++  int                         o;
+ 
+ #ifdef SCOTCH_DEBUG_MESH2
+   if (coartype >= MESHCOARSENNBR) {
+@@ -132,8 +135,12 @@ Context * restrict const      contptr)            /*+ Execution context
+   }
+ #endif /* SCOTCH_DEBUG_MESH2 */
+ 
++  if (finemeshptr->vnodnbr <= coarnbr)            /* If mesh is already small enough */
++    return (1);                                   /* It is useless to go any further */
++  coarvelmmax = (Gnum) ((double) finemeshptr->velmnbr * coarrat); /* Maximum number of coarse elements */
