++
++add_test(NAME gmk_m2_e_t_1_2 COMMAND ${BASH} -c "'$<TARGET_FILE:gmk_m2>' -e -t 1 2 | '$<TARGET_FILE:gtst>'")
++
++add_test(NAME gmk_m2_e_t_2_1 COMMAND ${BASH} -c "'$<TARGET_FILE:gmk_m2>' -e -t 2 1 | '$<TARGET_FILE:gtst>'")
++
