diff --git a/upstream/reports/7.0.18/patches/G14-graph-loaders/0002-Bugfix-fix-isdigit-test-in-Harwell-Boeing-format-par.patch b/upstream/reports/7.0.18/patches/G14-graph-loaders/0002-Bugfix-fix-isdigit-test-in-Harwell-Boeing-format-par.patch
