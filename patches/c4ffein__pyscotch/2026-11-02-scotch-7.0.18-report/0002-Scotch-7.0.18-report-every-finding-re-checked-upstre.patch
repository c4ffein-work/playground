+@@ -212,9 +213,9 @@ const HmeshOrderNdParam * const   paraptr)
+     cblkptr->cblktab[2].cblktab = NULL;
+ 
+     if (meshInduceSepa (&nspmeshdat.m, nspmeshdat.parttax, nspmeshdat.fronnbr, nspmeshdat.frontab, &indmeshdat.m) != 0) {
