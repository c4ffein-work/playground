++			check_scotch_dgraph_build		\
+ 			check_scotch_dgraph_band		\
+ 			check_scotch_dgraph_coarsen		\
+ 			check_scotch_dgraph_order		\
+@@ -657,6 +658,14 @@ test_scotch_dgraph_check	:	test_scotch_dgraph_check.c	\
+ 
+ ##
