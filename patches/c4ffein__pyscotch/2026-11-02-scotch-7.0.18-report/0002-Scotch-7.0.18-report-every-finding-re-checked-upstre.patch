@@ -0,0 +1,45 @@
+From d3c0c06f1003795ba8898dd28f82f0e6a3eb4464 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 08:34:57 +0000
+Subject: [PATCH 5/5] Bugfix: make edge array extension failure collective in
+ `dmeshDgraphDual()` [report PyScotch]
+
+When the edge array of the dual graph could not be extended, the
+failing process returned on its own, leaking its work arrays, while
+the other processes waited forever in `dgraphBuild2()`.
+
+Handle this case like the failure of the edge hash table resizing:
+jump to the common exit point with a negative number of local
+vertices, so that `dgraphBuild2()` fails on all processes.
+
+Refs: DGR-20
+---
+ src/libscotch/dmesh_dgraph.c | 5 +++--
+ 1 file changed, 3 insertions(+), 2 deletions(-)
+
+diff --git a/src/libscotch/dmesh_dgraph.c b/src/libscotch/dmesh_dgraph.c
+index 79564947..f87a078b 100644
+--- a/src/libscotch/dmesh_dgraph.c
++++ b/src/libscotch/dmesh_dgraph.c
+@@ -41,7 +41,7 @@
+ /**                conversion function.                    **/
+ /**                                                        **/
+ /**   DATES      : # Version 7.0  : from : 20 jan 2023     **/
+-/**                                 to   : 30 oct 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -622,7 +622,8 @@ test:         if (nghbnbr <= 0) {                 /* If new instance allows us t
+ 
+                   if ((edgeloctmp = memRealloc (edgeloctax + baseval, edgelocmax * sizeof (Gnum))) == NULL) {
+                     errorPrint ("dmeshDgraphDual: out of memory (6)");
+-                    return (1);
++                    velmlocnbr = -1;              /* TRICK: make dgraphBuild2() fail collectively */
++                    goto abort;
+                   }
+ 
+                   edgeloctax = edgeloctmp - baseval;
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G21-dgraph-band-coarsen/0001-Bugfix-do-not-free-the-index-array-of-the-caller-in-.patch b/upstream/reports/7.0.18/patches/G21-dgraph-band-coarsen/0001-Bugfix-do-not-free-the-index-array-of-the-caller-in-.patch
new file mode 100644
index 0000000..6e6bee7
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G21-dgraph-band-coarsen/0001-Bugfix-do-not-free-the-index-array-of-the-caller-in-.patch
@@ -0,0 +1,79 @@
+From 59d05eb557e4b5fa5a44a4995fc83c32c9e8f960 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 16:03:19 +0000
+Subject: [PATCH 01/10] Bugfix: do not free the index array of the caller in
+ `dgraphBand2Ptop()` and `dgraphGrow2Ptop()` [report R. Perry]
+
+On allocation error, the point-to-point variant of the band and grow
+routines freed the index array passed by the caller, from its based
+address: `dgraphBand()` and `SCOTCH_dgraphBand()` then freed their
+array a second time, and `SCOTCH_dgraphGrow()` had the user's part
+array freed under its feet. Also, unlike the collective variant, the
+point-to-point variant did not consider a missing index array as an
+error, and dereferenced it.
+
+Make the point-to-point variant behave like the collective one: the
+index array belongs to the caller, and its absence is an error.
+
+Refs: DGR-07
+---
+ src/libscotch/dgraph_band_grow.c | 29 ++++++++++++++---------------
+ 1 file changed, 14 insertions(+), 15 deletions(-)
+
+diff --git a/src/libscotch/dgraph_band_grow.c b/src/libscotch/dgraph_band_grow.c
+index 4672f095..930ebf7f 100644
+--- a/src/libscotch/dgraph_band_grow.c
++++ b/src/libscotch/dgraph_band_grow.c
+@@ -46,7 +46,7 @@
+ /**                # Version 6.0  : from : 03 apr 2012     **/
+ /**                                 to   : 21 may 2018     **/
+ /**                # Version 7.0  : from : 01 oct 2021     **/
+-/**                                 to   : 31 oct 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /**   NOTES      : # This code derives from the code of    **/
+ /**                  vdgraph_separate_bd.c in version      **/
+@@ -366,15 +366,17 @@ Context *                         contptr)        /*+ Execution context
+ 
+   vrcvdatsiz = DGRAPHBANDGROWSMUL (grafptr->procsndnbr); /* Senders and receivers inverted because we send local, not halo vertices */
+   vsnddatsiz = DGRAPHBANDGROWSMUL (grafptr->vertgstnbr - grafptr->vertlocnbr);
+-  if (memAllocGroup ((void **) (void *)
+-                     &procvgbtab, (size_t) ((procngbnbr + 1) * sizeof (Gnum)),
+-                     &nrcvdsptab, (size_t) ((procngbnbr + 1) * sizeof (Gnum)), /* +1 to check against end of array */
+-                     &nsnddsptab, (size_t) ((procngbnbr + 1) * sizeof (Gnum)), /* +1 to check against end of array */
+-                     &nsndidxtab, (size_t) (procngbnbr       * sizeof (Gnum)), /* Here Gnum's since point-to-point */
+-                     &nrcvreqtab, (size_t) (procngbnbr       * sizeof (MPI_Request)),
+-                     &nsndreqtab, (size_t) (procngbnbr       * sizeof (MPI_Request)),
+-                     &vrcvdattab, (size_t) (vrcvdatsiz       * sizeof (Gnum)),
+-                     &vsnddattab, (size_t) (vsnddatsiz       * sizeof (Gnum)), NULL) == NULL) {
++  procvgbtab = NULL;                              /* In case of error */
++  if ((vnumgsttax == NULL) ||
++      (memAllocGroup ((void **) (void *)
++                      &procvgbtab, (size_t) ((procngbnbr + 1) * sizeof (Gnum)),
++                      &nrcvdsptab, (size_t) ((procngbnbr + 1) * sizeof (Gnum)), /* +1 to check against end of array */
++                      &nsnddsptab, (size_t) ((procngbnbr + 1) * sizeof (Gnum)), /* +1 to check against end of array */
++                      &nsndidxtab, (size_t) (procngbnbr       * sizeof (Gnum)), /* Here Gnum's since point-to-point */
++                      &nrcvreqtab, (size_t) (procngbnbr       * sizeof (MPI_Request)),
++                      &nsndreqtab, (size_t) (procngbnbr       * sizeof (MPI_Request)),
++                      &vrcvdattab, (size_t) (vrcvdatsiz       * sizeof (Gnum)),
++                      &vsnddattab, (size_t) (vsnddatsiz       * sizeof (Gnum)), NULL) == NULL)) {
+     errorPrint (DGRAPHBANDGROWNSTR "Ptop: out of memory (1)");
+     reduglbtab[0] = 1;
+   }
+@@ -392,11 +394,8 @@ Context *                         contptr)        /*+ Execution context
+   }
+ #endif /* SCOTCH_DEBUG_DGRAPH1 */
+   if (reduglbtab[0] != 0) {
+-    if (vnumgsttax != NULL) {
+-      if (procvgbtab != NULL)
+-        memFree (procvgbtab);                     /* Free group leader */
+-      memFree (vnumgsttax);
+-    }
++    if (procvgbtab != NULL)
++      memFree (procvgbtab);                       /* Free group leader */
+     return (1);
+   }
+ 
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G21-dgraph-band-coarsen/0002-Bugfix-make-error-handling-of-dgraphBand2Coll-and-dg.patch b/upstream/reports/7.0.18/patches/G21-dgraph-band-coarsen/0002-Bugfix-make-error-handling-of-dgraphBand2Coll-and-dg.patch
