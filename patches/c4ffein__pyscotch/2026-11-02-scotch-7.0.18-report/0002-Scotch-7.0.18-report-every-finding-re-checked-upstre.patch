diff --git a/upstream/repro/G07-common-misc/COR-15-twins/tabload.c b/upstream/repro/G07-common-misc/COR-15-twins/tabload.c
new file mode 100644
index 0000000..3233e34
--- /dev/null
+++ b/upstream/repro/G07-common-misc/COR-15-twins/tabload.c
@@ -0,0 +1,31 @@
+/* COR-15 twin: SCOTCH_graphTabLoad() reads its counts and labels with fscanf ("%d"/"%ld"),
+** not intLoad(): out-of-range numbers wrap (glibc) instead of being rejected.
+** usage: tabload graph.grf mapping_file */
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <scotch.h>
+
+int
+main (int argc, char * argv[])
+{
+  SCOTCH_Graph        grafdat;
+  SCOTCH_Num          vertnbr;
+  SCOTCH_Num *        parttab;
+  FILE *              stream;
+  int                 o;
+
+  SCOTCH_graphInit (&grafdat);
+  stream = fopen (argv[1], "r");
+  if (SCOTCH_graphLoad (&grafdat, stream, -1, 0) != 0) return (1);
+  fclose (stream);
+  SCOTCH_graphSize (&grafdat, &vertnbr, NULL);
+  parttab = malloc (vertnbr * sizeof (SCOTCH_Num));
+  stream = fopen (argv[2], "r");
+  o = SCOTCH_graphTabLoad (&grafdat, parttab, stream);
+  fclose (stream);
+  printf ("SCOTCH_graphTabLoad ret=%d parttab[0]=%ld parttab[1]=%ld\n", o, (long) parttab[0], (long) parttab[1]);
+  free (parttab);
+  SCOTCH_graphExit (&grafdat);
+  return (0);
+}
diff --git a/upstream/repro/G07-common-misc/COR-15/timing/intbench.c b/upstream/repro/G07-common-misc/COR-15/timing/intbench.c
new file mode 100644
index 0000000..dbab330
--- /dev/null
+++ b/upstream/repro/G07-common-misc/COR-15/timing/intbench.c
@@ -0,0 +1,34 @@
+/* COR-15 timing: CPU time of intLoad() over every integer of a graph file (best of N). */
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+#include "module.h"
+#include "common.h"
+
+int
+main (int argc, char * argv[])
+{
+  int                 i, n = (argc > 2) ? atoi (argv[2]) : 5;
+  double              best = 1e9;
+  long                cnt  = 0;
+
+  for (i = 0; i < n; i ++) {
+    FILE *              stream = fopen (argv[1], "r");
+    INT                 val;
+    long long           sum = 0;
+    clock_t             c0, c1;
+    double              d;
+
+    setvbuf (stream, NULL, _IOFBF, 1 << 20);
+    c0  = clock ();
+    for (cnt = 0; intLoad (stream, &val) == 1; cnt ++)
+      sum += val;
+    c1  = clock ();
+    fclose (stream);
+    d = (double) (c1 - c0) / CLOCKS_PER_SEC;
+    if (d < best) best = d;
+    if (i == 0) printf ("%ld integers, sum %lld\n", cnt, sum);
+  }
+  printf ("intLoad CPU best of %d: %.3f s\n", n, best);
+  return (0);
+}
