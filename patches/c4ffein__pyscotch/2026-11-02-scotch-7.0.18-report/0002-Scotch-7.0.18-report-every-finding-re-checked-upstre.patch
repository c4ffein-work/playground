index 0000000..89c0590
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G05-strategy-tables-api/0003-Bugfix-do-not-overflow-the-strategy-string-buffers-w.patch
@@ -0,0 +1,305 @@
+From f589c35a5d6426a342d8b2765e939e9809028644 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 13:02:55 +0000
+Subject: [PATCH] Bugfix: do not overflow the strategy-string buffers with
+ large ratios [report R. Perry]
+
+The predefined strategy builders formatted their imbalance and density ratios
+into small fixed stack buffers with `sprintf (buf, "%lf", val)`. A value such as
+the `1e300` that some callers use as a "no constraint" sentinel expands to more
+than three hundred characters and smashed the stack (stack-buffer-overflow
+confirmed with AddressSanitizer for the sequential and the parallel builders);
+even `1e30` overflowed the 32-byte buffers. Non-finite values silently produced
+unparsable `nan`/`inf` tokens.
+
+Reject non-finite and negative ratios up front, as the `gmap`/`dgmap` tools
+already do for their `-b` option, and bound each conversion with `snprintf()`,
+returning the documented error value `1` when the ratio does not fit. Valid
+ratios keep their exact `"%lf"` textual form. All eight sequential and parallel
+map, cluster, overlap-partitioning and ordering builders are fixed, and
+`test_strat_seq` / `test_strat_par` gain a rejection check.
+
+Refs: API-07
+---
+ src/check/test_strat_par.c             | 22 +++++++++++++++++++++-
+ src/check/test_strat_seq.c             | 21 +++++++++++++++++++++
+ src/libscotch/library_dgraph_map.c     | 19 ++++++++++++++-----
+ src/libscotch/library_dgraph_order.c   |  8 ++++++--
+ src/libscotch/library_graph_map.c      | 19 ++++++++++++++-----
+ src/libscotch/library_graph_order.c    |  8 ++++++--
+ src/libscotch/library_graph_part_ovl.c |  8 ++++++--
+ src/libscotch/library_mesh_order.c     |  8 ++++++--
+ 8 files changed, 94 insertions(+), 19 deletions(-)
+
+diff --git a/src/check/test_strat_par.c b/src/check/test_strat_par.c
+index 35dbdecc..5cfc8b51 100644
+--- a/src/check/test_strat_par.c
++++ b/src/check/test_strat_par.c
+@@ -41,7 +41,7 @@
+ /**   DATES      : # Version 6.0  : from : 08 jan 2012     **/
+ /**                                 to   : 22 may 2018     **/
+ /**                # Version 7.0  : from : 04 jul 2025     **/
+-/**                                 to   : 26 mar 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -73,6 +73,7 @@ int                 argc,
+ char *              argv[])
+ {
+   SCOTCH_Strat        stradat;
++  int                 i;
+   int                 o;
+ 
+   SCOTCH_errorProg (argv[0]);
+@@ -132,5 +133,24 @@ char *              argv[])
+   o |= SCOTCH_stratDgraphOrderBuild (&stradat, SCOTCH_STRATSEPASIMPLE, 1, 0, 0.2);
+   SCOTCH_stratExit (&stradat);
+ 
++  printf ("Parallel strategy builders, invalid ratios (error messages expected)\n");
++
++  for (i = 0; i < 3; i ++) {                      /* Non-finite, out-of-range and huge-but-finite ratios must all be rejected */
++    volatile double     zeroval;                  /* Volatile to build a NaN without a compile-time division */
++    double              balval;
++
++    zeroval = 0.0;
++    balval  = (i == 0) ? (zeroval / zeroval) : ((i == 1) ? -1.0 : 1e300); /* NaN, negative, huge finite */
++
++    SCOTCH_stratInit (&stradat);
++    if ((SCOTCH_stratDgraphMapBuild     (&stradat, SCOTCH_STRATDEFAULT, 3, 4, balval)         == 0) ||
++        (SCOTCH_stratDgraphClusterBuild (&stradat, SCOTCH_STRATDEFAULT, 3, 4, balval, balval) == 0) ||
++        (SCOTCH_stratDgraphOrderBuild   (&stradat, SCOTCH_STRATDEFAULT, 3, 0, balval)         == 0)) {
++      SCOTCH_errorPrint ("main: invalid ratio accepted");
++      o |= 1;
++    }
++    SCOTCH_stratExit (&stradat);
++  }
++
+   exit ((o == 0) ? EXIT_SUCCESS : EXIT_FAILURE);
+ }
+diff --git a/src/check/test_strat_seq.c b/src/check/test_strat_seq.c
+index a2ec938f..d2fa1614 100644
+--- a/src/check/test_strat_seq.c
++++ b/src/check/test_strat_seq.c
+@@ -234,5 +234,26 @@ char *              argv[])
+     SCOTCH_stratExit (&stradat);
+   }
+ 
++  printf ("Sequential strategy builders, invalid ratios (error messages expected)\n");
++
++  for (i = 0; i < 3; i ++) {                      /* Non-finite, out-of-range and huge-but-finite ratios must all be rejected */
++    volatile double     zeroval;                  /* Volatile to build a NaN without a compile-time division */
++    double              balval;
++
++    zeroval = 0.0;
++    balval  = (i == 0) ? (zeroval / zeroval) : ((i == 1) ? -1.0 : 1e300); /* NaN, negative, huge finite */
++
++    SCOTCH_stratInit (&stradat);
++    if ((SCOTCH_stratGraphMapBuild     (&stradat, SCOTCH_STRATDEFAULT, 4, balval)         == 0) ||
++        (SCOTCH_stratGraphClusterBuild (&stradat, SCOTCH_STRATDEFAULT, 4, balval, balval) == 0) ||
++        (SCOTCH_stratGraphPartOvlBuild (&stradat, SCOTCH_STRATDEFAULT, 4, balval)         == 0) ||
++        (SCOTCH_stratGraphOrderBuild   (&stradat, SCOTCH_STRATDEFAULT, 0, balval)         == 0) ||
++        (SCOTCH_stratMeshOrderBuild    (&stradat, SCOTCH_STRATDEFAULT, balval)            == 0)) {
++      SCOTCH_errorPrint ("main: invalid ratio accepted");
++      o |= 1;
++    }
++    SCOTCH_stratExit (&stradat);
++  }
++
+   exit ((o == 0) ? EXIT_SUCCESS : EXIT_FAILURE);
+ }
+diff --git a/src/libscotch/library_dgraph_map.c b/src/libscotch/library_dgraph_map.c
+index ff5f8539..0985cc23 100644
+--- a/src/libscotch/library_dgraph_map.c
++++ b/src/libscotch/library_dgraph_map.c
+@@ -44,7 +44,7 @@
+ /**                # Version 6.0  : from : 14 nov 2012     **/
