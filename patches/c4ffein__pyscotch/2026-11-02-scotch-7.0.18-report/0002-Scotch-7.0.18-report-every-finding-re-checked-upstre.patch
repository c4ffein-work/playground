++/* Copyright 2004,2007,2008,2010,2019,2023,2024,2026 IPB, Universite de Bordeaux, INRIA & CNRS
+ **
+ ** This file is part of the Scotch software package for static mapping,
+ ** graph partitioning and sparse matrix ordering.
+@@ -49,7 +49,7 @@
+ /**                # Version 6.0  : from : 29 sep 2019     **/
+ /**                                 to   : 29 sep 2019     **/
+ /**                # Version 7.0  : from : 20 jan 2023     **/
+-/**                                 to   : 11 jul 2024     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -80,47 +80,54 @@ Order * restrict const      ordeptr,
+ const Gnum * restrict const vlbltax,
+ FILE * restrict const       stream)
+ {
+-  Gnum * restrict     permtab;
++  Gnum                vnodnbr;
+   Gnum                vertnum;
+ 
++  const Gnum                baseval = ordeptr->baseval;
++  const Gnum                vertnnd = ordeptr->vnodnbr + baseval;
