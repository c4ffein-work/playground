+-    ver0locnum = multloctab[multlocnum].vertglbnum[0] - vertlocadj; /* Compute local value of (always local) first multinode vertex */ 
++    ver0locnum = multloctab[multlocnum].vertglbnum[0] - vertlocadj; /* Compute local value of (always local) first multinode vertex */
+ #ifdef SCOTCH_DEBUG_DGRAPH2
+     if ((ver0locnum <  finegrafptr->baseval) ||
+         (ver0locnum >= finegrafptr->vertlocnnd)) {
+diff --git a/src/libscotch/library_dgraph_band.c b/src/libscotch/library_dgraph_band.c
+index 72c8b06c..6aab7dfd 100644
+--- a/src/libscotch/library_dgraph_band.c
++++ b/src/libscotch/library_dgraph_band.c
+@@ -310,7 +310,7 @@ fail2:
+   }
+   bandvertloctax[bandvertlocnnd] = bandedgelocnum; /* Set end of vertex array */
+ 
+-  memFree (bandvnumgsttax + bandgrafptr->baseval);  /* Free useless space */
++  memFree (bandvnumgsttax + bandgrafptr->baseval); /* Free useless space */
+ 
+   if (bandedloloctax != NULL) {                   /* If graph has edge weights                             */
+     for (bandvertlocnum = bandgrafptr->baseval;   /* For all vertices that do not belong to the last level */
+-- 
+2.43.0
