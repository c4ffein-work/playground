+++ b/upstream/reports/7.0.18/patches/G26-metis-dual-esmumps/0007-Always-test-esmumpsv-in-the-esMUMPS-test-program.patch
@@ -0,0 +1,56 @@
+From dcbcef35c1bd69b45eecfc5ffae47ce3c8513495 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 19:41:39 +0000
+Subject: [PATCH 7/9] Always test `esmumpsv()` in the esMUMPS test program
+
+The weighted part of the test was guarded by the `ESMUMPS_HAS_ESMUMPSV`
+macro, which no build system defines, so that `esmumpsv()` was never
+tested. `esmumpsv()` has been part of the public interface since
+version 6.1, so the guard is removed; the weighted graph of the test
+list exercises it.
+
+Refs: BLD-19
+---
+ src/check/test_libesmumps.c | 8 +++-----
+ 1 file changed, 3 insertions(+), 5 deletions(-)
+
+diff --git a/src/check/test_libesmumps.c b/src/check/test_libesmumps.c
+index ce713ad4..d3328da5 100644
+--- a/src/check/test_libesmumps.c
++++ b/src/check/test_libesmumps.c
+@@ -1,4 +1,4 @@
+-/* Copyright 2020 IPB, Universite de Bordeaux, INRIA & CNRS
++/* Copyright 2020,2026 IPB, Universite de Bordeaux, INRIA & CNRS
+ **
+ ** This file is part of the Scotch software package for static mapping,
+ ** graph partitioning and sparse matrix ordering.
+@@ -41,7 +41,7 @@
+ /**   DATES      : # Version 6.0  : from : 19 jan 2020     **/
+ /**                                 to   : 19 jan 2020     **/
+ /**                # Version 6.1  : from : 22 feb 2020     **/
+-/**                                 to   : 12 apr 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -178,8 +178,7 @@ char *              argv[])
+ 
+   checkEsmumps (vertnbr, nvtab, petab);
+ 
+-#ifdef ESMUMPS_HAS_ESMUMPSV
+-  if (velotab != NULL) {
++  if (velotab != NULL) {                          /* If graph has vertex weights, test esmumpsv() with them */
+     memcpy (petab, verttab, vertnbr * sizeof (SCOTCH_Num)); /* Prepare graph topology arrays */
+     for (vertnum = 0; vertnum < vertnbr; vertnum ++)
+       lentab[vertnum] = verttab[vertnum + 1] - verttab[vertnum];
+@@ -193,7 +192,6 @@ char *              argv[])
+ 
+     checkEsmumps (vertnbr, nvtab, petab);
+   }
+-#endif /* ESMUMPS_HAS_ESMUMPSV */
+ 
+   free (petab);
+   free (nvtab);
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G26-metis-dual-esmumps/0008-Bugfix-build-libesmumps-once-when-making-esmumps-and.patch b/upstream/reports/7.0.18/patches/G26-metis-dual-esmumps/0008-Bugfix-build-libesmumps-once-when-making-esmumps-and.patch
new file mode 100644
index 0000000..cebb646
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G26-metis-dual-esmumps/0008-Bugfix-build-libesmumps-once-when-making-esmumps-and.patch
@@ -0,0 +1,57 @@
+From 51c26ebf39f732968b18d1b053af01874c7a6fbb Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 19:41:39 +0000
+Subject: [PATCH 8/9] Bugfix: build libesmumps once when making `esmumps` and
+ `ptesmumps` in parallel
+
+The `ptesmumps` target of the main Makefile did not depend on
+`esmumps` and ran the `scotch` goal of the esmumps directory again, so
+that `make -j esmumps ptesmumps`, as run by the CI, compiled the same
+objects and linked the same library twice, concurrently, in the same
+directory. `ptesmumps` now depends on `esmumps` and only installs the
+library under its parallel name, and `ptinstall` depends on
+`ptscotch`, as in the other directories.
+
+Refs: BLD-17
+---
+ src/Makefile         | 4 ++--
+ src/esmumps/Makefile | 4 ++--
+ 2 files changed, 4 insertions(+), 4 deletions(-)
+
+diff --git a/src/Makefile b/src/Makefile
+index 06608c08..c784396f 100644
+--- a/src/Makefile
++++ b/src/Makefile
+@@ -125,8 +125,8 @@ esmumps				:	scotch
+ escheck				:	esmumps
+ 					(cd check ; $(MAKE) escheck)
+ 
+-ptesmumps			:	scotch	ptscotch
+-					(cd esmumps ; $(MAKE) ptscotch && $(MAKE) ptinstall)
++ptesmumps			:	esmumps	ptscotch
++					(cd esmumps ; $(MAKE) ptinstall)
+ 
+ install				:	required	$(bindir)	$(includedir)	$(libdir)	$(mandir)/man1
+ 					-$(CP) -f ../bin/[agm]*$(EXE) $(bindir)
+diff --git a/src/esmumps/Makefile b/src/esmumps/Makefile
+index 883a558c..a4803d59 100644
+--- a/src/esmumps/Makefile
++++ b/src/esmumps/Makefile
+@@ -1,4 +1,4 @@
+-## Copyright 2004,2007-2010,2012,2015,2020,2022 IPB, Universite de Bordeaux, INRIA & CNRS
++## Copyright 2004,2007-2010,2012,2015,2020,2022,2026 IPB, Universite de Bordeaux, INRIA & CNRS
+ ##
+ ## This file is part of the Scotch software package for static mapping,
+ ## graph partitioning and sparse matrix ordering.
+@@ -65,7 +65,7 @@ install				:	scotch					\
+ 					-$(CP) library.h $(SCOTCHINCLUDEDIR)/esmumps.h
+ 					-$(CP) libesmumps$(LIB) $(SCOTCHLIBDIR)
+ 
+-ptinstall			:	scotch					\
++ptinstall			:	ptscotch				\
+ 					library.h
+ 					-$(CP) library.h $(SCOTCHINCLUDEDIR)/esmumps.h
+ 					-$(CP) libesmumps$(LIB) $(SCOTCHLIBDIR)/libptesmumps$(LIB)
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G27-seq-tools/0001-Bugfix-check-vertex-list-contents-in-graphInduceList.patch b/upstream/reports/7.0.18/patches/G27-seq-tools/0001-Bugfix-check-vertex-list-contents-in-graphInduceList.patch
new file mode 100644
index 0000000..ad95052
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G27-seq-tools/0001-Bugfix-check-vertex-list-contents-in-graphInduceList.patch
@@ -0,0 +1,86 @@
+From 02c6db189a03fe53ce18dd38118002ae270e5741 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 16:06:23 +0000
+Subject: [PATCH 01/11] Bugfix: check vertex list contents in
+ `graphInduceList()` [report R. Perry]
+
+The vertex list passed to `graphInduceList()` was trusted: an index
+outside the vertex range of the original graph, or listed twice, led
+to out-of-bounds accesses when filling the index array. Such lists
+can come from the user through `SCOTCH_graphInduceList()` and
+`SCOTCH_archBuild0()`, where `archDecoArchBuild()` also ignored the
+return value of `graphInduceList()`.
+
+Refs: CLI-11
+---
+ src/libscotch/arch_deco_build.c | 13 ++++++++++---
+ src/libscotch/graph_induce.c    | 11 +++++++++--
+ 2 files changed, 19 insertions(+), 5 deletions(-)
+
+diff --git a/src/libscotch/arch_deco_build.c b/src/libscotch/arch_deco_build.c
+index 58b6eda7..125e39e6 100644
+--- a/src/libscotch/arch_deco_build.c
++++ b/src/libscotch/arch_deco_build.c
+@@ -54,7 +54,7 @@
+ /**                # Version 6.0  : from : 28 jun 2011     **/
+ /**                                 to   : 15 may 2018     **/
+ /**                # Version 7.0  : from : 18 feb 2018     **/
+-/**                                 to   : 03 sep 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -192,8 +192,15 @@ Context * const             contptr)              /*+ Execution context
+   mappdat.domnnbr = 1;
+ 
+   jobtab[0].domnum = 0;                           /* All vertices mapped to first domain              */
+-  if (tgtlisttab != NULL)                         /* If vertex list given                             */
+-    graphInduceList (tgtgrafptr, tgtlistnbr, tgtlisttab, &jobtab[0].grafdat); /* Restrict initial job */
++  if (tgtlisttab != NULL) {                       /* If vertex list given */
++    if (graphInduceList (tgtgrafptr, tgtlistnbr, tgtlisttab, &jobtab[0].grafdat) != 0) { /* Restrict initial job */
++      errorPrint ("archDecoArchBuild: cannot induce graph");
++      archExit   (&archdat);
++      mapExit    (&mappdat);
++      memFree    (jobtab);
++      return     (1);
++    }
++  }
+   else {                                          /* If no vertex list given                          */
+     jobtab[0].grafdat = *tgtgrafptr;              /* Job takes whole graph                            */
+     jobtab[0].grafdat.flagval &= ~GRAPHFREETABS;  /* Graph is a clone                                 */
+diff --git a/src/libscotch/graph_induce.c b/src/libscotch/graph_induce.c
+index 14639ad2..aad47fcc 100644
+--- a/src/libscotch/graph_induce.c
++++ b/src/libscotch/graph_induce.c
+@@ -1,4 +1,4 @@
+-/* Copyright 2004,2007-2009,2011,2013-2016,2018,2023 IPB, Universite de Bordeaux, INRIA & CNRS
++/* Copyright 2004,2007-2009,2011,2013-2016,2018,2023,2026 IPB, Universite de Bordeaux, INRIA & CNRS
+ **
+ ** This file is part of the Scotch software package for static mapping,
+ ** graph partitioning and sparse matrix ordering.
+@@ -60,7 +60,7 @@
+ /**                # Version 6.0  : from : 29 mar 2011     **/
+ /**                                 to   : 05 apr 2018     **/
+ /**                # Version 7.0  : from : 19 jan 2023     **/
+-/**                                 to   : 19 jan 2023     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /**   NOTES      : # Several algorithms, such as the       **/
+ /**                  active graph building routine of      **/
+@@ -133,6 +133,13 @@ Graph * restrict const          indgrafptr)
+     Gnum                orgvertnum;
+ 
+     orgvertnum = indvnumtax[indvertnum];
++    if ((orgvertnum < orggrafptr->baseval) ||     /* If vertex number out of range */
++        (orgvertnum >= orggrafptr->vertnnd)   ||
++        (orgindxtax[orgvertnum] != ~0)) {         /* Or vertex already selected    */
++      errorPrint ("graphInduceList: invalid vertex list");
++      graphExit  (indgrafptr);
++      return (1);
++    }
+ 
+     orgindxtax[orgvertnum] = indvertnum;          /* Mark selected vertices */
+     indedgenbr += orgvendtax[orgvertnum] - orgverttax[orgvertnum];
+-- 
+2.43.0
