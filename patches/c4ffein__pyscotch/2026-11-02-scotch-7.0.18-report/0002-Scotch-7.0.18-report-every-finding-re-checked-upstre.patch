+ 					$(EXECS) $(SCOTCHBINDIR)/gmk_m2 -b1 -e -t 5 1 | $(SCOTCHBINDIR)/gtst
++					$(EXECS) $(SCOTCHBINDIR)/gmk_m2 -e -t 2 2 | $(SCOTCHBINDIR)/gtst
