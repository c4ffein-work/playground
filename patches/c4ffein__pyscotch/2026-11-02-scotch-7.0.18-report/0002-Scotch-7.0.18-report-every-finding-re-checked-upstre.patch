+
+Refs: PS2-G04-strategy-parser-3
+---
+ src/libscotch/bdgraph_bipart_st.c | 4 ++--
+ src/libscotch/bgraph_bipart_st.c  | 4 ++--
+ src/libscotch/hdgraph_order_st.c  | 4 ++--
+ 3 files changed, 6 insertions(+), 6 deletions(-)
+
+diff --git a/src/libscotch/bdgraph_bipart_st.c b/src/libscotch/bdgraph_bipart_st.c
+index 3cbbdf8f..fde8604f 100644
+--- a/src/libscotch/bdgraph_bipart_st.c
++++ b/src/libscotch/bdgraph_bipart_st.c
+@@ -45,7 +45,7 @@
+ /**                # Version 6.0  : from : 11 sep 2011     **/
+ /**                                 to   : 28 sep 2014     **/
+ /**                # Version 7.0  : from : 17 jan 2023     **/
+-/**                                 to   : 08 oct 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -81,7 +81,7 @@ static Bdgraph              bdgraphdummy;     /* Dummy distributed bipartitioned
+ static union {
+   BdgraphBipartBdParam      param;
+   StratNodeMethodData       padding;
+-} bdgraphbipartstdefaultbd = { { 3, &stratdummy } };
++} bdgraphbipartstdefaultbd = { { 3, &stratdummy, &stratdummy } };
+ 
+ static union {
+   BdgraphBipartDfParam      param;
+diff --git a/src/libscotch/bgraph_bipart_st.c b/src/libscotch/bgraph_bipart_st.c
+index b83b7c45..20b4f24a 100644
+--- a/src/libscotch/bgraph_bipart_st.c
++++ b/src/libscotch/bgraph_bipart_st.c
+@@ -55,7 +55,7 @@
+ /**                # Version 6.0  : from : 23 feb 2011     **/
+ /**                                 to   : 02 jan 2017     **/
+ /**                # Version 7.0  : from : 17 jan 2023     **/
+-/**                                 to   : 08 oct 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -93,7 +93,7 @@ static Bgraph               bgraphdummy;      /*+ Dummy active graph for offset
+ static union {
+   BgraphBipartBdParam       param;
+   StratNodeMethodData       padding;
+-} bgraphbipartstdefaultbd = { { 3, &stratdummy } };
++} bgraphbipartstdefaultbd = { { 3, &stratdummy, &stratdummy } };
+ 
