diff --git a/upstream/reports/7.0.18/series/0078-Remove-dead-isolated-anchor-handling-in-kgraphCost-r.patch b/upstream/reports/7.0.18/series/0078-Remove-dead-isolated-anchor-handling-in-kgraphCost-r.patch
new file mode 100644
index 0000000..082bba9
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0078-Remove-dead-isolated-anchor-handling-in-kgraphCost-r.patch
@@ -0,0 +1,99 @@
+From 5199d4cac799bf8db332f4cdb69bc46bb10ce24d Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 09:34:29 +0000
+Subject: [PATCH 078/232] Remove dead isolated-anchor handling in
+ `kgraphCost()` [report R. Perry]
+
+The block meant to freeze the load of isolated anchors was unreachable: the
+search loop did `if (degree != 0) continue;` on both branches, so it always ran
+to its end and `domnnbr != domnnbr` guarded the block out. The code was therefore
+inert and misleading.
+
+It cannot simply be turned on. The test it uses -- an anchor with no band edge --
+is not a correct predicate for "empty part": once the band strategy has
+repartitioned, regular vertices can be assigned to a part whose anchor has no
+band edge, so the part load is not equal to the anchor load. Activating the block
+then subtracts a wrong load and trips the `kgraphCost: invalid load difference`
+assertion under SCOTCH_DEBUG_KGRAPH2 (observed with a default-style band mapping).
+
+Since the block never ran, `fdomwgt` and `fvelsum` were always zero; removing it
+and them leaves the computed load targets unchanged. A correct freeze of truly
+empty parts would need a proper empty-part test and is left to a separate change.
+
+Refs: GRA-19
+---
+ src/libscotch/kgraph_cost.c | 38 +++----------------------------------
+ 1 file changed, 3 insertions(+), 35 deletions(-)
+
+diff --git a/src/libscotch/kgraph_cost.c b/src/libscotch/kgraph_cost.c
+index add77ad3..2ecd550e 100644
+--- a/src/libscotch/kgraph_cost.c
++++ b/src/libscotch/kgraph_cost.c
+@@ -1,4 +1,4 @@
+-/* Copyright 2023 IPB, Universite de Bordeaux, INRIA & CNRS
++/* Copyright 2023,2026 IPB, Universite de Bordeaux, INRIA & CNRS
+ **
+ ** This file is part of the Scotch software package for static mapping,
+ ** graph partitioning and sparse matrix ordering.
+@@ -39,7 +39,7 @@
+ /**                partitions.                             **/
+ /**                                                        **/
+ /**   DATES      : # Version 7.0  : from : 16 jun 2023     **/
+-/**                                 to   : 16 jun 2023     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -73,8 +73,6 @@ Kgraph * restrict const     grafptr)
+   Gnum                      vertnum;
+   Gnum * restrict           compload;
+   Gnum                      commload;
+-  double                    fdomwgt;
+-  Gnum                      fvelsum;
+   Gnum                      velosum;
+   Anum                      domnnum;
+   ArchDom                   domndat;
+@@ -141,39 +139,9 @@ Kgraph * restrict const     grafptr)
+   }
+   grafptr->commload = commload;
+ 
+-  fdomwgt = 0;
+-  fvelsum = 0;
+-  if ((grafptr->s.flagval & KGRAPHHASANCHORS) != 0) {
+-    const Gnum                  vertancnnd = grafptr->s.vertnnd - domnnbr;
+-    Gnum                        veloval;
+-
+-    for (domnnum = 0; domnnum < domnnbr; domnnum ++)
+-      if ((grafptr->s.verttax[vertancnnd + domnnum + 1] - grafptr->s.verttax[vertancnnd + domnnum]) != 0)
+-        continue;
+-
+-    if (domnnum != domnnbr) {
+-      for (domnnum = 0; domnnum < domnnbr; domnnum ++) {
+-        if ((grafptr->s.verttax[vertancnnd + domnnum + 1] - grafptr->s.verttax[vertancnnd + domnnum]) == 0) {
+-          veloval = grafptr->s.velotax[vertancnnd + domnnum];
+-
+-          fdomwgt += (double) archDomWght (archptr, &domntab[domnnum]);
+-          fvelsum += veloval;
+-          compload[domnnum] -=
+-          grafptr->comploadavg[domnnum] = veloval;
+-#ifdef SCOTCH_DEBUG_KGRAPH2
+-          if (compload[domnnum] != 0) {
+-            errorPrint ("kgraphCost: invalid load difference");
+-            return;
+-          }
+-#endif /* SCOTCH_DEBUG_KGRAPH2 */
+-        }
+-      }
+-    }
+-  }
+   archDomFrst (archptr, &domndat);
+   domnrat = (double) archDomWght (archptr, &domndat);
+-  domnrat -= fdomwgt;
+-  velosum = grafptr->s.velosum - fvelsum;
++  velosum = grafptr->s.velosum;
+   for (domnnum = 0; domnnum < domnnbr; domnnum ++) {
+     compload[domnnum]            -=
+     grafptr->comploadavg[domnnum] = (Gnum) ((double) velosum * ((double) archDomWght (archptr, &domntab[domnnum]) / domnrat));
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0079-Bugfix-detect-a-band-graph-part-count-change-in-kgra.patch b/upstream/reports/7.0.18/series/0079-Bugfix-detect-a-band-graph-part-count-change-in-kgra.patch
new file mode 100644
index 0000000..56376f0
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0079-Bugfix-detect-a-band-graph-part-count-change-in-kgra.patch
@@ -0,0 +1,65 @@
+From 4bd0fcead8bd5b0f8ecae9bc472d26d3052fa33e Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 09:09:39 +0000
+Subject: [PATCH 079/232] Bugfix: detect a band-graph part-count change in
+ `kgraphMapBd()` [report R. Perry]
+
+`kgraphMapBd()` wrote the band graph`s part count into the original graph before
+testing whether it had changed, so the test `bndgrafdat.m.domnnbr !=
+orggrafptr->m.domnnbr` compared a value with its own copy and never fired; a band
+strategy that changes the number of parts left the original graph with an
+inconsistent part count and load arrays instead of being rejected. The count is
+now compared against the `domnnbr` captured at routine entry, and
+orggrafptr->m.domnnbr is left untouched until the test has passed.
+
+The `orgflagtab` allocation-failure path also returned without freeing bndvnumtax
+or exiting the band graph, unlike the other failure paths of the routine; it now
+frees both.
+
+Refs: GRA-20
+---
+ src/libscotch/kgraph_map_bd.c | 7 ++++---
+ 1 file changed, 4 insertions(+), 3 deletions(-)
+
+diff --git a/src/libscotch/kgraph_map_bd.c b/src/libscotch/kgraph_map_bd.c
+index 245f1f13..b2ee9cbe 100644
+--- a/src/libscotch/kgraph_map_bd.c
++++ b/src/libscotch/kgraph_map_bd.c
+@@ -50,7 +50,7 @@
+ /**                # Version 6.1  : from : 30 jun 2021     **/
+ /**                                 to   : 16 jul 2021     **/
+ /**                # Version 7.0  : from : 20 jan 2023     **/
+-/**                                 to   : 07 oct 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /**   NOTES      : # Since only edges from local vertices  **/
+ /**                  to local anchors are created in       **/
+@@ -178,7 +178,6 @@ const KgraphMapBdParam * const      paraptr)      /*+ Method parameters +*/
+   o = kgraphMapSt (&bndgrafdat, paraptr->stratbnd); /* Partition band graph */
+ 
+   orggrafptr->m.domntab = bndgrafdat.m.domntab;   /* Transfer (potentially updated) mapping domain array back to original graph */
+-  orggrafptr->m.domnnbr = bndgrafdat.m.domnnbr;
+   orggrafptr->m.domnmax = bndgrafdat.m.domnmax;
+   bndgrafdat.m.domntab  = NULL;
+ 
+@@ -188,7 +187,7 @@ const KgraphMapBdParam * const      paraptr)      /*+ Method parameters +*/
+     kgraphExit  (&bndgrafdat);
+     return (1);
+   }
+-  if (bndgrafdat.m.domnnbr != orggrafptr->m.domnnbr) {
++  if (bndgrafdat.m.domnnbr != domnnbr) {          /* Compare with the untouched number of parts of the original graph */
+     errorPrint  ("kgraphMapBd: change in band graph number of parts not supported");
+     memFree     (bndvnumtax + bndgrafdat.s.baseval);
+     kgraphExit  (&bndgrafdat);
+@@ -267,6 +266,8 @@ const KgraphMapBdParam * const      paraptr)      /*+ Method parameters +*/
+ 
+   if ((orgflagtab = memAlloc (kgraphMapBdFlagSize (orggrafptr->s.vertnnd) * sizeof (unsigned int))) == NULL) {
+     errorPrint ("kgraphMapBd: out of memory (2)");
++    memFree    (bndvnumtax + bndgrafdat.s.baseval);
++    kgraphExit (&bndgrafdat);
+     return (1);
+   }
+ 
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0080-Bugfix-read-the-up-to-date-diffusion-array-in-kgraph.patch b/upstream/reports/7.0.18/series/0080-Bugfix-read-the-up-to-date-diffusion-array-in-kgraph.patch
new file mode 100644
index 0000000..69175da
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0080-Bugfix-read-the-up-to-date-diffusion-array-in-kgraph.patch
@@ -0,0 +1,49 @@
+From 674aa05704031f2448c86fcaa3bf748e9f06c8e7 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 09:10:44 +0000
+Subject: [PATCH 080/232] Bugfix: read the up-to-date diffusion array in
+ `kgraphMapDfLoop()` [report R. Perry]
+
+After each diffusion pass the `difntax` and `difotax` arrays are swapped, so on
+exit the freshest part values are in `difotax`. The final loop that writes them
+back to the part array read `difntax`, i.e. the values from the pass before last,
+so the diffusion result was always one pass behind (and a single-pass run never
+changed the mapping at all). It now reads `difotax`, as `bgraphBipartDfLoop()`
+does.
+
+Refs: GRA-18
+---
+ src/libscotch/kgraph_map_df.c | 6 +++---
+ 1 file changed, 3 insertions(+), 3 deletions(-)
+
+diff --git a/src/libscotch/kgraph_map_df.c b/src/libscotch/kgraph_map_df.c
+index eae149c3..fd54f434 100644
+--- a/src/libscotch/kgraph_map_df.c
++++ b/src/libscotch/kgraph_map_df.c
+@@ -1,4 +1,4 @@
+-/* Copyright 2010-2012,2018,2021,2023 IPB, Universite de Bordeaux, INRIA & CNRS
++/* Copyright 2010-2012,2018,2021,2023,2026 IPB, Universite de Bordeaux, INRIA & CNRS
+ **
+ ** This file is part of the Scotch software package for static mapping,
+ ** graph partitioning and sparse matrix ordering.
+@@ -44,7 +44,7 @@
+ /**   DATES      : # Version 6.0  : from : 05 jan 2010     **/
+ /**                                 to   : 04 nov 2012     **/
+ /**                # Version 7.0  : from : 03 aug 2018     **/
+-/**                                 to   : 20 jan 2023     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -536,7 +536,7 @@ fail: ;                                           /* If overflow occured, resume
+ 
+   if (loopptr->abrtval == 0) {
+     for (vertnum = vertbas; vertnum < vertnnd; vertnum ++) /* Set new part distribution of local vertices */
+-      parttax[vertnum] = difntax[vertnum].partval;
++      parttax[vertnum] = difotax[vertnum].partval; /* TRICK: freshest values are in difotax after the last swap */
+   }
+ 
+   if (sorttab != NULL)
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0081-Bugfix-do-not-skip-the-setup-barriers-in-kgraphMapDf.patch b/upstream/reports/7.0.18/series/0081-Bugfix-do-not-skip-the-setup-barriers-in-kgraphMapDf.patch
new file mode 100644
index 0000000..0572e36
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0081-Bugfix-do-not-skip-the-setup-barriers-in-kgraphMapDf.patch
@@ -0,0 +1,84 @@
+From 0b3f737232d78fb6922a7d31c3c1b3d0b5bafc02 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 09:16:42 +0000
+Subject: [PATCH 081/232] Bugfix: do not skip the setup barriers in
+ `kgraphMapDfLoop()` [report R. Perry]
+
+A thread that detected an isolated anchor (zero-degree, i.e. an empty part of
+the band graph) or failed to allocate its sort array set abrtval and jumped to
+the `fail:` label, which lies inside the pass loop, past the two setup barriers.
+The aborting thread thus skipped both barriers while the other threads waited at
+the first one forever, hanging the diffusion; a slipped pairing could also let
+the master free the shared loop data while a slave was still running it
+(heap-use-after-free). This loop is on the default mapping strategy.
+
+Setup failures now set abrtval and fall through to the barriers, so every thread
+leaves together at the existing `abrtval == 1` test after the second barrier, as
+`bgraphBipartDfLoop()` does through its `skip:` label. The free on that path is
+guarded, since a thread that aborts before allocating has a NULL sort array. The
+two debug-only internal-error checks that jumped to `fail:` before the barriers
+now break and abort after them as well.
+
+Refs: GRA-12
+---
+ src/libscotch/kgraph_map_df.c | 21 +++++++++------------
+ 1 file changed, 9 insertions(+), 12 deletions(-)
+
+diff --git a/src/libscotch/kgraph_map_df.c b/src/libscotch/kgraph_map_df.c
+index fd54f434..edb743bd 100644
+--- a/src/libscotch/kgraph_map_df.c
++++ b/src/libscotch/kgraph_map_df.c
+@@ -176,8 +176,8 @@ KgraphMapDfData * restrict const  loopptr)
+ #ifdef SCOTCH_DEBUG_KGRAPH2
+       if ((vendtax[vertnum] - verttax[vertnum]) == 0) { /* Non-anchor vertices should not be isolated */
+         errorPrint ("kgraphMapDfLoop: internal error (1)");
+-        loopptr->abrtval = 1;
+-        goto fail;
++        loopptr->abrtval = 1;                     /* Leave after the setup barriers, not before */
++        break;
+       }
+ #endif /* SCOTCH_DEBUG_KGRAPH2 */
+ 
+@@ -204,8 +204,8 @@ KgraphMapDfData * restrict const  loopptr)
+ #ifdef SCOTCH_DEBUG_KGRAPH2
+       if ((vendtax[vertnum] - verttax[vertnum]) == 0) { /* Non-anchor vertices should not be isolated */
+         errorPrint ("kgraphMapDfLoop: internal error (2)");
+-        loopptr->abrtval = 1;
+-        goto fail;
++        loopptr->abrtval = 1;                     /* Leave after the setup barriers, not before */
++        break;
+       }
+ #endif /* SCOTCH_DEBUG_KGRAPH2 */
+ 
+@@ -219,15 +219,11 @@ KgraphMapDfData * restrict const  loopptr)
+       velsmsk &= (velssum != 0);
+     }
+   }
+-  if (velsmsk == 0) {                             /* If graph is too small to have any usable anchors */
+-    loopptr->abrtval = 1;                         /* We will leave during the first iteration         */
+-    goto fail;
+-  }
+-
+-  if ((sorttab = memAlloc (domnnbr * sizeof (KgraphMapDfSort))) == NULL) { /* Allocate here for memory affinity as it is a private array */
++  if (velsmsk == 0)                               /* If graph is too small to have any usable anchors    */
++    loopptr->abrtval = 1;                         /* We will leave after the setup barriers, not before  */
++  else if ((sorttab = memAlloc (domnnbr * sizeof (KgraphMapDfSort))) == NULL) { /* Allocate here for memory affinity as it is a private array */
+     errorPrint ("kgraphMapDfLoop: out of memory");
+     loopptr->abrtval = 1;
+-    goto fail;
+   }
+ 
+   if (velotax == NULL) {
+@@ -289,7 +285,8 @@ KgraphMapDfData * restrict const  loopptr)
+ #endif /* KGRAPHMAPDFNOTHREAD */
+ 
+   if (loopptr->abrtval == 1) {                    /* If process alone or some decided to quit */
+-    memFree (sorttab);                            /* Free local array                         */
++    if (sorttab != NULL)                          /* Free local array if it was allocated     */
++      memFree (sorttab);
+     return;
+   }
+ 
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0082-Bugfix-refresh-the-domain-count-after-the-fallback-i.patch b/upstream/reports/7.0.18/series/0082-Bugfix-refresh-the-domain-count-after-the-fallback-i.patch
new file mode 100644
index 0000000..88230c3
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0082-Bugfix-refresh-the-domain-count-after-the-fallback-i.patch
@@ -0,0 +1,98 @@
+From 71b889bbbbc040ce98f77b9beb4789d91109d3b6 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 08:48:24 +0000
+Subject: [PATCH 082/232] Bugfix: refresh the domain count after the fallback
+ in `kgraphMapFm()` [report R. Perry]
+
+When the mapping had no frontier but was imbalanced, `kgraphMapFm()` ran a
+fallback strategy that can increase the number of domains, yet it kept reusing
+the count cached at routine entry in a `const` local. The imbalance arrays were
+reallocated and indexed with the stale, smaller count, so the following FM pass
+read and wrote past them (heap-buffer-overflow in `kgraphMapFmTablGet()`); the
+same stale count also undersized the backtrack-array growth test and truncated
+the write-back of the domain load deltas.
+
+The count is now a mutable local, re-read from the mapping after the fallback,
+and the imbalance arrays are reallocated and refilled with it. The domain array
+pointer is re-read too, as the fallback reallocates the domain array when it
+creates more domains than planned for a variable-sized target architecture. The
+fallback strategy, which was previously leaked and whose result was ignored, is
+now checked and freed, and the error paths free the imbalance arrays.
+
+Refs: GRA-02, PS3-G13-1
+---
+ src/libscotch/kgraph_map_fm.c | 30 ++++++++++++++++++++++++------
+ 1 file changed, 24 insertions(+), 6 deletions(-)
+
+diff --git a/src/libscotch/kgraph_map_fm.c b/src/libscotch/kgraph_map_fm.c
+index dde5e7a3..25170be1 100644
+--- a/src/libscotch/kgraph_map_fm.c
++++ b/src/libscotch/kgraph_map_fm.c
+@@ -961,6 +961,8 @@ const KgraphMapFmParam * const    paraptr)        /*+ Method parameters +*/
+   KgraphMapFmEdge   *             edxxtab;        /* Edge extended array                            */
+   Gnum                            edxxnbr;        /* Current number of links in link array          */
+   Gnum                            edxxsiz;
++  Gnum                            domnnbr;        /* Current number of domains                      */
++  const ArchDom * restrict        domntab;        /* Current domain array                           */
+   Gnum                            edxxnum;
+   Gnum                            edxxcdx;        /* Index for extended edge copy                   */
+   Gnum                            edcunbr;        /* Current number of unused extended edge slots   */
+@@ -1002,12 +1004,13 @@ const KgraphMapFmParam * const    paraptr)        /*+ Method parameters +*/
+   const Gnum * restrict const     edgetax = grafptr->s.edgetax;
+   const Gnum * restrict const     edlotax = grafptr->s.edlotax;
+   const Arch * restrict const     archptr = grafptr->m.archptr;
+-  const Gnum                      domnnbr = grafptr->m.domnnbr;
+-  const ArchDom * restrict const  domntab = grafptr->m.domntab;
+   Anum * restrict const           parttax = grafptr->m.parttax;
+   Anum * restrict const           parotax = grafptr->r.m.parttax;
+   const Gnum * restrict const     pfixtax = grafptr->pfixtax;
+ 
++  domnnbr = grafptr->m.domnnbr;                   /* Get current number of domains */
++  domntab = grafptr->m.domntab;                   /* And current domain array      */
++
+ #ifdef SCOTCH_DEBUG_KGRAPH3                       /* Allocation of extra memory needed for the check routine */
+   if ((chektab = memAlloc (domnnbr * 3 * sizeof(Gnum))) == NULL) {
+     errorPrint ("kgraphMapFm: out of memory (1)");
+@@ -1042,20 +1045,35 @@ const KgraphMapFmParam * const    paraptr)        /*+ Method parameters +*/
+       return  (0);
+     }
+     else {                                        /* Imbalance must be fought */
+-      const Strat *         strat;
++      Strat *               strat;
++      int                   o;
+ 
+-      strat = stratInit (&kgraphmapststratab, "r{sep=h{pass=10}}"); /* Use a standard algorithm */
+-      kgraphMapSt (grafptr, strat);               /* Perform mapping */
++      if ((strat = stratInit (&kgraphmapststratab, "r{sep=h{pass=10}}")) == NULL) { /* Use a standard algorithm */
++        errorPrint ("kgraphMapFm: cannot initialize fallback strategy");
++        memFree    (comploadmax);                 /* Free group leader */
++        return (1);
++      }
++      o = kgraphMapSt (grafptr, strat);           /* Perform mapping */
++      stratExit (strat);
++      if (o != 0) {
++        errorPrint ("kgraphMapFm: cannot compute fallback mapping");
++        memFree    (comploadmax);                 /* Free group leader */
++        return (1);
++      }
+ 
+       if (grafptr->fronnbr == 0) {                /* If new partition has no frontier */
+         memFree (comploadmax);
+         return  (0);                              /* This algorithm is still useless  */
+       }
+ 
+-      if (memReallocGroup ((void *) comploadmax,  /* domnnbr has changed after mapping */
++      domnnbr = grafptr->m.domnnbr;               /* Number of domains may have changed after the fallback mapping */
++      domntab = grafptr->m.domntab;               /* And domain array may have been reallocated                    */
++
++      if (memReallocGroup ((void *) comploadmax,
+                            &comploadmax, (size_t) (domnnbr * sizeof (Gnum)),
+                            &comploaddlt, (size_t) (domnnbr * sizeof (Gnum)), NULL) == NULL) {
+         errorPrint ("kgraphMapFm: out of memory (3)");
++        memFree    (comploadmax);                 /* Free group leader */
+         return (1);
+       }
+ 
