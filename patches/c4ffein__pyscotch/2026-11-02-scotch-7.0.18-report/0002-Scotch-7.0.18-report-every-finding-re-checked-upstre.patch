diff --git a/upstream/reports/7.0.18/series/0107-Bugfix-count-edges-not-arcs-in-communication-delta-o.patch b/upstream/reports/7.0.18/series/0107-Bugfix-count-edges-not-arcs-in-communication-delta-o.patch
