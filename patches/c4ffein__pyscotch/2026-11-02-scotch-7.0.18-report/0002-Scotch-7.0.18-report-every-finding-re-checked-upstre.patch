diff --git a/upstream/reports/7.0.18/series/0041-Bugfix-free-data-buffer-of-forked-de-compression-tas.patch b/upstream/reports/7.0.18/series/0041-Bugfix-free-data-buffer-of-forked-de-compression-tas.patch
new file mode 100644
index 0000000..363fa68
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0041-Bugfix-free-data-buffer-of-forked-de-compression-tas.patch
@@ -0,0 +1,49 @@
+From 37d782758383d5af592ead640555eb7f8819e153 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 13:17:46 +0000
+Subject: [PATCH 041/232] Bugfix: free data buffer of forked (de)compression
+ tasks in father process [report PyScotch]
+
+In fork mode, the data buffer allocated in the (de)compression
+structure is only used by the son process, which frees its own copy
+in `fileCompress2()` / `fileDecompress2()`. The copy of the father was
+never freed, which LeakSanitizer reports on every program that reads
+or writes a compressed file.
+
+Free the buffer in the father process right after forking.
+---
+ src/libscotch/common_file_compress.c   | 3 ++-
+ src/libscotch/common_file_decompress.c | 3 ++-
+ 2 files changed, 4 insertions(+), 2 deletions(-)
+
+diff --git a/src/libscotch/common_file_compress.c b/src/libscotch/common_file_compress.c
+index df469fc2..1bb5e2e6 100644
+--- a/src/libscotch/common_file_compress.c
++++ b/src/libscotch/common_file_compress.c
+@@ -271,7 +271,8 @@ const FileCompressType      typeval)              /*+ Compression algorithm
+       fileCompress2 (compptr);                    /* Perform compression                                   */
+       _exit (EXIT_SUCCESS);                       /* Exit without flushing stdio buffers inherited from father */
+     default :                                     /* We are the father process                             */
+-      close (pipetab[0]);                         /* Close the reader pipe end                             */
++      close   (pipetab[0]);                       /* Close the reader pipe end                             */
++      memFree (compptr->bufftab);                 /* Data buffer is only used by the son process           */
+   }
+ #endif /* COMMON_PTHREAD_FILE */
+ 
+diff --git a/src/libscotch/common_file_decompress.c b/src/libscotch/common_file_decompress.c
+index 87a2a133..e8b5e65a 100644
+--- a/src/libscotch/common_file_decompress.c
++++ b/src/libscotch/common_file_decompress.c
+@@ -244,7 +244,8 @@ const FileCompressType      typeval)              /*+ (De)compression algorithm
+       fileDecompress2 (compptr);                  /* Perform decompression                                 */
+       _exit (EXIT_SUCCESS);                       /* Exit without flushing stdio buffers inherited from father */
+     default :                                     /* We are the father process                             */
+-      close (pipetab[1]);                         /* Close the writer pipe end                             */
++      close   (pipetab[1]);                       /* Close the writer pipe end                             */
++      memFree (compptr->bufftab);                 /* Data buffer is only used by the son process           */
+   }
+ #endif /* COMMON_PTHREAD_FILE */
+ 
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0042-Bugfix-agree-on-errors-before-entering-collectives-i.patch b/upstream/reports/7.0.18/series/0042-Bugfix-agree-on-errors-before-entering-collectives-i.patch
new file mode 100644
index 0000000..82c727f
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0042-Bugfix-agree-on-errors-before-entering-collectives-i.patch
@@ -0,0 +1,266 @@
+From 23318f5defe67c07515fd84b3b0949b1cda38b82 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 13:23:51 +0000
+Subject: [PATCH 042/232] Bugfix: agree on errors before entering collectives
+ in large-count communication wrappers [report R. Perry]
+
+In `commAllgatherv()`, `commGatherv()` and `commScatterv()`, which are
+used when Gnum is wider than int, a process that found a count or
+displacement that does not fit in an int, or that could not allocate
+its conversion arrays, returned before entering the collective
+communication, while the other processes entered it and waited
+forever. The check on the local send count that was added to
+`commGatherv()` in 73229e6 is also local to each process. Moreover,
+the local count passed to `commAllgatherv()` and `commScatterv()` was
+converted to int without any check, so that a count that does not fit
+was silently truncated and the communication yielded wrong results
+without any error.
+
