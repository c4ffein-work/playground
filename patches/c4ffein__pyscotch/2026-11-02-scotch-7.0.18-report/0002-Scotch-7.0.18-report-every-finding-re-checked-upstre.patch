index 0000000..d732475
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G26-metis-dual-esmumps/0001-Bugfix-apply-the-Fortran-null-array-convention-to-al.patch
@@ -0,0 +1,273 @@
+From b892ab5cfa561e970c5a7f9065c6e5ef0af7be1a Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 08:57:24 +0000
+Subject: [PATCH] Bugfix: apply the Fortran null array convention to all arrays
+ of `METIS_PartMeshDual()` [report R. Perry]
+
+In `METIS_PartMeshDual()`, the Fortran convention according to which
+null arrays are those equal to `ne` was applied to `options`, `tpwgts`
+and `vsize`, but not to `vwgt`, which was passed as is to
+`SCOTCH_graphBuild()`: the scalar `*ne` was read as a vertex weight
+array, overflowing the caller's stack. Also, when the communication
+volume was requested through `options[METIS_OPTION_OBJTYPE]` without
+any `vsize` array, the null pointer was rebased and passed to
+`_SCOTCH_METIS_OutputVol()`, which crashed for base value 1. Finally,
+the return value of `SCOTCH_graphBuild()` was ignored.
+
+The null array convention is now applied once, at the beginning of the
+routine, and the local `velotab` and `vsiztab` pointers are used
+throughout. A null `vsiztab` is passed as such to
+`_SCOTCH_METIS_OutputVol()`, which then assumes unit sizes. The graph
+is mapped only if it could be built, as `_SCOTCH_METIS_PartGraph2()`
+already does.
+
+The C and Fortran test programs now exercise the null array convention
+and the computation of the communication volume without vertex sizes.
+The Fortran test checks the element partition of the new call only,
+the checks of the first call being added by the `METIS_PartMeshDual()`
+result checking commit.
+
+Refs: CLI-05
+---
+ src/check/test_libmetis_dual.c             | 71 +++++++++++++++++-----
+ src/check/test_libmetis_dual_f.f90.in      | 18 ++++++
+ src/libscotchmetis/metis_graph_part_dual.c | 54 ++++++++--------
+ 3 files changed, 104 insertions(+), 39 deletions(-)
+
+diff --git a/src/check/test_libmetis_dual.c b/src/check/test_libmetis_dual.c
+index 6bebf845..94e11f2b 100644
+--- a/src/check/test_libmetis_dual.c
++++ b/src/check/test_libmetis_dual.c
+@@ -43,7 +43,7 @@
+ /**   DATES      : # Version 6.1  : from : 10 feb 2021     **/
+ /**                                 to   : 17 jul 2021     **/
+ /**                # Version 7.0  : from : 08 aug 2024     **/
+-/**                                 to   : 12 apr 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -65,6 +65,45 @@
+ #include "scotch.h"
+ #include "metis.h"                                /* Our "metis.h" file */
+ 
++/**********************************/
++/*                                */
++/* Consistency checking routines. */
++/*                                */
++/**********************************/
++
++/* checkPart checks that element and node
++** partition values are in the proper range.
++** It exits on error.
++*/
++
++static
++void
++checkPart (
++const SCOTCH_Num            baseval,
++const SCOTCH_Num            velmnbr,
++const SCOTCH_Num            vnodnbr,
++const SCOTCH_Num            partnbr,
++const SCOTCH_Num * const    epart,
++const SCOTCH_Num * const    npart)
++{
++  SCOTCH_Num          vertnum;
++
++  for (vertnum = 0; vertnum < velmnbr; vertnum ++) { /* Verify element partition range */
++    if ((epart[vertnum] <   baseval) ||
++        (epart[vertnum] >= (baseval + partnbr))) {
++      SCOTCH_errorPrint ("checkPart: invalid partition (1)");
++      exit (EXIT_FAILURE);
++    }
++  }
++  for (vertnum = 0; vertnum < vnodnbr; vertnum ++) { /* Verify node partition range */
++    if ((npart[vertnum] <   baseval) ||
++        (npart[vertnum] >= (baseval + partnbr))) {
++      SCOTCH_errorPrint ("checkPart: invalid partition (2)");
++      exit (EXIT_FAILURE);
++    }
++  }
++}
++
+ /*********************/
+ /*                   */
+ /* The main routine. */
+@@ -155,25 +194,29 @@ char *              argv[])
+ 
+   SCOTCHMETISNAMEC (METIS_PartMeshDual) (&ne, &nn, eptr, eind, vgwt, NULL, &ncommon, &nparts, tpwgt, options, &objval, epart, npart);
+   if (objval < 0) {
+-    SCOTCH_errorPrint ("main: error in METIS_PartMeshDual");
++    SCOTCH_errorPrint ("main: error in METIS_PartMeshDual (1)");
