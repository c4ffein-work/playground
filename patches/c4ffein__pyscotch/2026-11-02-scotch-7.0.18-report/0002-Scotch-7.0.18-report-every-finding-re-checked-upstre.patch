++++ b/doc/src/ptscotch/p_l.tex
+@@ -5331,8 +5331,11 @@ parts to which every vertex belongs, from $0$ to $(\mbox{\tt nparts} -
+ 1)$.
+ 
+ Since \scotch\ does not handle multiple constraints, only the first
+-constraint is taken into account to define the respective weights of
+-the parts. Consequently, only the first {\tt nparts} cells of the
+-{\tt tpwgts} array are considered. The {\tt ncon}, {\tt ubvec}
+-and {\tt options} parameters are not used.
++constraint is taken into account to define the vertex weights, the
++respective weights of the parts, and the load imbalance tolerance.
++Consequently, only cells {\tt vwgt[i * ncon]} and {\tt tpwgts[i *
++ncon]} of the {\tt vwgt} and {\tt tpwgts} arrays, and the first cell
++of the {\tt ubvec} array, are considered. As in \parmetis, the
++{\tt ubvec} values are ratios greater than one, e.g. $1.05$ for a
++five percent tolerance. The {\tt options} parameter is not used.
+ \end{itemize}
+diff --git a/src/check/test_libmetis.c b/src/check/test_libmetis.c
+index 8739d508..dcbc0fd4 100644
+--- a/src/check/test_libmetis.c
++++ b/src/check/test_libmetis.c
+@@ -142,6 +142,53 @@ const SCOTCH_Num            partnbr)
+   }
+ }
+ 
++/* This routine checks that the produced
++** partition respects the target weights
++** of the first vertex constraint, within
++** a loose tolerance.
++** It exits on error.
++*/
++
++static
++void
++checkLoad (
++const SCOTCH_Num            baseval,
++const SCOTCH_Num            vertnbr,
++const SCOTCH_Num * const    velotab,              /* Interleaved vertex loads   */
++const SCOTCH_Num            nconval,
++const SCOTCH_Num * const    parttab,
++const SCOTCH_Num            partnbr,
++const double * const        twgttab)              /* Interleaved target weights */
++{
++  double *            loadtab;
++  double              loadsum;
++  SCOTCH_Num          vertnum;
++  SCOTCH_Num          partnum;
++
++  if ((loadtab = malloc (partnbr * sizeof (double))) == NULL) {
++    SCOTCH_errorPrint ("checkLoad: out of memory");
++    exit (EXIT_FAILURE);
++  }
++  memset (loadtab, 0, partnbr * sizeof (double));
++
++  for (vertnum = 0, loadsum = 0.0; vertnum < vertnbr; vertnum ++) { /* Un-based traversal */
++    double              veloval;
++
++    veloval  = (double) velotab[vertnum * nconval]; /* Only first constraint is considered */
++    loadsum += veloval;
++    loadtab[parttab[vertnum] - baseval] += veloval;
++  }
++
++  for (partnum = 0; partnum < partnbr; partnum ++) {
++    if (loadtab[partnum] > (1.5 * loadsum * twgttab[partnum * nconval])) {
++      SCOTCH_errorPrint ("checkLoad: invalid part load");
++      exit (EXIT_FAILURE);
++    }
++  }
++
++  free (loadtab);
++}
++
+ /*********************/
+ /*                   */
+ /* The main routine. */
+@@ -174,7 +221,13 @@ char *              argv[])
+   const double        awgttab[9] = { 0.10, 0.10, 0.05, 0.10, 0.20, 0.30, 0.05, 0.05, 0.05 };
+   const double        bwgttab[9] = { 0.123457, 0.098765, 0.111111, 0.087654, 0.145678, 0.133333, 0.100001, 0.099999, 0.100002 }; /* Part weights without a small common denominator */
+   const SCOTCH_Num    nconval = 1;
+-  const double        kbaltab[1] = { 0.05 };
++  const double        kbaltab[1] = { 1.05 };      /* MeTiS imbalance ratios are greater than 1.0 */
++  const SCOTCH_Num    ncontwo = 2;
++  const double        kbaltwo[2] = { 1.05, 1.05 };
++  double              awgttwo[18];
++  SCOTCH_Num *        velotwo;
++  SCOTCH_Num          partnum;
++  SCOTCH_Num          vertnum;
+   SCOTCH_Num          options[METIS_NOPTIONS];
+ #endif /* (SCOTCH_METIS_VERSION == 5) */
+ 
+@@ -289,6 +342,38 @@ char *              argv[])
+ 
+   checkPart (baseval, vertnbr, parttab, partnbr);
+ 
++  if (SCOTCHMETISNAMEC (METIS_PartGraphRecursive) (&vertnbr, &nconval, verttab, edgetab, velotab, NULL, edlotab,
++                                                   &partnbr, NULL, NULL, options, &edgecut, parttab) != METIS_OK) { /* No part weights nor imbalance ratio */
++    SCOTCH_errorPrint ("main: error in METIS_V5_PartGraphRecursive (2)");
++    exit (EXIT_FAILURE);
++  }
++
++  checkPart (baseval, vertnbr, parttab, partnbr);
++
++  if ((velotwo = malloc (vertnbr * 2 * sizeof (SCOTCH_Num))) == NULL) { /* Two interleaved vertex constraints */
++    SCOTCH_errorPrint ("main: out of memory (2)");
++    exit (EXIT_FAILURE);
++  }
++  for (vertnum = 0; vertnum < vertnbr; vertnum ++) {
++    velotwo[2 * vertnum]     = (velotab != NULL) ? velotab[vertnum] : 1; /* First constraint is the vertex load */
++    velotwo[2 * vertnum + 1] = vertnum + 1;       /* Second constraint should be ignored */
