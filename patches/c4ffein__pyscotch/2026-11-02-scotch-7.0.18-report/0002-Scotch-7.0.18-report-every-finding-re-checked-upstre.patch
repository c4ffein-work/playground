diff --git a/upstream/reports/7.0.18/series/0102-Bugfix-compute-pseudo-diameters-of-single-vertex-com.patch b/upstream/reports/7.0.18/series/0102-Bugfix-compute-pseudo-diameters-of-single-vertex-com.patch
