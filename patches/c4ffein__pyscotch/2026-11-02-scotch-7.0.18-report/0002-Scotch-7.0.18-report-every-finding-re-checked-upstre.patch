diff --git a/upstream/reports/7.0.18/patches/G06-threads-context/0002-Bugfix-make-master-thread-join-start-up-barrier-when.patch b/upstream/reports/7.0.18/patches/G06-threads-context/0002-Bugfix-make-master-thread-join-start-up-barrier-when.patch
new file mode 100644
index 0000000..b41bf05
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G06-threads-context/0002-Bugfix-make-master-thread-join-start-up-barrier-when.patch
@@ -0,0 +1,55 @@
+From 2aa9e6743b7f8405ff73aeaff9b3243b560430e3 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 08:15:50 +0000
+Subject: [PATCH 2/5] Bugfix: make master thread join start-up barrier when
+ thread creation fails [report R. Perry]
+
+When a thread could not be created, the thread number was reduced to
+the number of threads launched to date, master included, but the
+master thread did not take part in the start-up barrier. Hence, the
+launched slave threads could never complete it, and
+`threadContextExit3()`, which counts the slave threads having entered
+the barrier as terminated ones, destroyed the lock features while the
+slave threads were still waiting on them, after which the context was
+freed. With the GNU libc, `pthread_cond_destroy()` waited forever for
+these threads.
+The master thread now joins the start-up barrier after having reduced
+the thread number, under the protection of the lock, so that launched
+threads reach their wait loop and terminate before the lock features
+are destroyed.
+
+Refs: COR-09
+---
+ src/libscotch/common_thread.c | 9 ++++++---
+ 1 file changed, 6 insertions(+), 3 deletions(-)
+
+diff --git a/src/libscotch/common_thread.c b/src/libscotch/common_thread.c
+index 6a394728..4ba29298 100644
+--- a/src/libscotch/common_thread.c
++++ b/src/libscotch/common_thread.c
+@@ -41,7 +41,7 @@
+ /**   DATES      : # Version 6.0  : from : 04 jul 2012     **/
+ /**                                 to   : 27 apr 2015     **/
+ /**                # Version 7.0  : from : 03 jun 2018     **/
+-/**                                 to   : 24 oct 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -142,8 +142,11 @@ const int * const           coretab)
+ 
+     if (threadCreate (&desctab[thrdnum], thrdnum, corenum) != 0) {
+       errorPrint ("threadContextInit: cannot create thread (%d)", thrdnum);
+-      contptr->thrdnbr = thrdnum;                 /* Terminate all threads that have been launched to date */
+-      threadContextExit3 (contptr);               /* Wait for already launched threads to terminate        */
++      pthread_mutex_lock   (&contptr->lockdat);
++      contptr->thrdnbr = thrdnum;                 /* Only threads launched to date take part in start-up barrier */
++      pthread_mutex_unlock (&contptr->lockdat);
++      threadContextBarrier (contptr);             /* Let launched threads complete their start-up barrier        */
++      threadContextExit3 (contptr);               /* Wait for already launched threads to terminate              */
+       memFree (desctab);
+       return  (1);
+     }
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G06-threads-context/0003-Bugfix-do-not-bind-threads-with-negative-core-number.patch b/upstream/reports/7.0.18/patches/G06-threads-context/0003-Bugfix-do-not-bind-threads-with-negative-core-number.patch
new file mode 100644
index 0000000..dd33b4a
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G06-threads-context/0003-Bugfix-do-not-bind-threads-with-negative-core-number.patch
@@ -0,0 +1,51 @@
+From c9612f5419e691ac2b268ad198ad80aff4067b7b Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 08:16:43 +0000
+Subject: [PATCH 3/5] Bugfix: do not bind threads with negative core numbers
+ [report R. Perry]
+
+Since commit 52dcf602, explicit core numbers are mapped onto the
+process affinity mask by `threadProcessCoreNum()`. However, for the
+documented core number of -1, which means that the thread must not be
+bound, the modulus reduction kept a negative value, the mask lookup
+loop was not entered, and the thread was bound to core 0, even when
+the latter did not belong to the process affinity mask.
+`threadProcessCoreNum()` now returns -1 for negative core numbers,
+so that the thread is left unbound, as before.
+
+Refs: COR-24
+---
+ src/libscotch/common_thread.c | 9 +++++++--
+ 1 file changed, 7 insertions(+), 2 deletions(-)
+
+diff --git a/src/libscotch/common_thread.c b/src/libscotch/common_thread.c
+index 4ba29298..20e6936a 100644
+--- a/src/libscotch/common_thread.c
++++ b/src/libscotch/common_thread.c
+@@ -912,9 +912,11 @@ ThreadContext * const       contptr)
+ }
+ 
+ /* This routine returns the number of the core to be
+-** associated with the given thread number.
++** associated with the given logical core number,
++** which is subject to modulus reduction.
+ ** It returns:
+-** - x  : number of the core associated with the thread.
++** - >= 0  : number of the core associated with the thread.
++** - -1    : if the thread is not to be bound to a core.
+ */
+ 
+ static
+@@ -926,6 +928,9 @@ int                         thrdnum)
+   int                 corenum;
+   int                 corenbr;
+ 
++  if (thrdnum < 0)                                /* If thread is not to be bound to a core */
++    return (-1);
++
+   corenbr  = threadProcessCoreNbr (contptr);
+   thrdnum %= corenbr;                             /* Round-robin on thread allocation */
+ 
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G06-threads-context/0004-Add-check-of-leader-thread-affinity-mask-to-context-.patch b/upstream/reports/7.0.18/patches/G06-threads-context/0004-Add-check-of-leader-thread-affinity-mask-to-context-.patch
new file mode 100644
index 0000000..fa925ed
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G06-threads-context/0004-Add-check-of-leader-thread-affinity-mask-to-context-.patch
@@ -0,0 +1,70 @@
+From b0a210a4af19982818769047d9a9ffca23819ca3 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 08:17:02 +0000
+Subject: [PATCH 4/5] Add check of leader thread affinity mask to context
+ import test
+
+Since commit 6eb0aca3, the state of the master thread is saved when a
+thread context is imported, so that the affinity mask of the leader
+thread is properly restored when the context is destroyed. The context
+test now checks that this mask is preserved across the life of an
+imported context.
+
+Refs: COR-11
+---
+ src/check/test_scotch_context.c | 18 ++++++++++++++++++
+ 1 file changed, 18 insertions(+)
+
+diff --git a/src/check/test_scotch_context.c b/src/check/test_scotch_context.c
+index f401575d..fdc1c80b 100644
+--- a/src/check/test_scotch_context.c
++++ b/src/check/test_scotch_context.c
+@@ -48,6 +48,9 @@
+ **  The defines and includes.
+ */
+ 
++#ifndef _GNU_SOURCE
++#define _GNU_SOURCE                               /* For sched_getaffinity() */
++#endif /* _GNU_SOURCE */
+ #ifndef _XOPEN_SOURCE
+ #define _XOPEN_SOURCE               600
+ #endif /* _XOPEN_SOURCE */
+@@ -198,6 +201,9 @@ char *              argv[])
+   int                 thrdnum;
+   SCOTCH_Graph        graftab[2];                 /* Original graph and context container */
+   int *               coretab;
++#ifdef COMMON_PTHREAD_AFFINITY_LINUX
++  cpu_set_t           cpustab[2];                 /* Affinity masks before and after import */
++#endif /* COMMON_PTHREAD_AFFINITY_LINUX */
+ 
+   SCOTCH_errorProg (argv[0]);
+ 
+@@ -320,6 +326,10 @@ char *              argv[])
+     thrdtab[thrdnum].thrdnum = thrdnum;           /* All threads know their index in their thread group */
+   }
+ 
++#ifdef COMMON_PTHREAD_AFFINITY_LINUX
++  sched_getaffinity (0, sizeof (cpu_set_t), &cpustab[0]); /* Record affinity mask of leader thread */
++#endif /* COMMON_PTHREAD_AFFINITY_LINUX */
++
+   SCOTCH_contextInit          (&contdat);         /* Leader thread creates the context                */
+   SCOTCH_contextThreadImport1 (&contdat, thrdnbr); /* Leader thread calls "Import1" before any others */
+ 
+@@ -347,6 +357,14 @@ char *              argv[])
+   SCOTCH_graphExit   (&graftab[1]);
+   SCOTCH_contextExit (&contdat);                  /* Worker threads are released when the context is destroyed */
+ 
++#ifdef COMMON_PTHREAD_AFFINITY_LINUX
++  sched_getaffinity (0, sizeof (cpu_set_t), &cpustab[1]); /* Affinity mask of leader thread must not have changed */
++  if (! CPU_EQUAL (&cpustab[0], &cpustab[1])) {
++    SCOTCH_errorPrint ("main: affinity mask of imported leader thread changed");
++    exit (EXIT_FAILURE);
++  }
++#endif /* COMMON_PTHREAD_AFFINITY_LINUX */
++
+   free (thrdtab);
+ 
+   SCOTCH_graphExit (&graftab[0]);
+-- 
+2.43.0
+
