index 0000000..e3881cb
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G15-order-io-seq-misc/0007-Bugfix-split-column-blocks-according-to-the-computed.patch
@@ -0,0 +1,554 @@
+From d950e0aac6dbcacef96b98403f32506f008bd6ef Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 13:58:52 +0000
+Subject: [PATCH 7/9] Bugfix: split column blocks according to the computed
+ ordering in `hgraphOrderBl()` and `hmeshOrderBl()` [report R. Perry]
+
+The blocking method did not do what its documentation says, that is,
+traverse the column block tree produced by its strategy and split the
+leaves "without changing the ordering that has been computed":
+
+ - when the strategy produced a tree, the recursion on the sub-blocks
+   called `hgraphOrderBl()` itself, which ran the strategy again on
+   the whole graph for every sub-block, and did not terminate for
+   tree-producing strategies such as "b{strat=n{...}}";
+ - for vertex-weighted graphs, loads were summed in local vertex
+   order (since a90b1cb, through the inverse permutation before, which
+   indexed the local load array with original vertex indices for
+   induced subgraphs), while block boundaries apply to ordering
+   positions; blocks were therefore unbalanced as soon as the ordering
+   was not the identity (e.g., "b{cmin=1200,strat=g}": block weights
+   from 24 to 16930 instead of 954 to 1577);
+ - trailing zero-weight columns were left out of all blocks, yielding
+   an inconsistent column block tree.
+
+Run the strategy once, compute the column loads in ordering order
+(directly through the inverse permutation for original graphs, by
+matching original vertex indices for induced subgraphs), and split
+the leaves of the tree recursively in a separate routine, keeping
+track of the ordering number of each sub-block. The last block of a
+weighted split receives any remaining zero-weight columns. Blocks
+that cannot be split into at least two sub-blocks are kept as leaves.
+
+Refs: GRA-22, PS2-G15-2, PS2-G15-3
+---
+ src/libscotch/hgraph_order_bl.c | 276 ++++++++++++++++++++++----------
+ src/libscotch/hgraph_order_bl.h |   8 +-
+ src/libscotch/hmesh_order_bl.c  |  82 ++++++----
+ src/libscotch/hmesh_order_bl.h  |   8 +-
+ 4 files changed, 258 insertions(+), 116 deletions(-)
+
+diff --git a/src/libscotch/hgraph_order_bl.c b/src/libscotch/hgraph_order_bl.c
+index 7311baeb..320adb81 100644
+--- a/src/libscotch/hgraph_order_bl.c
++++ b/src/libscotch/hgraph_order_bl.c
+@@ -1,4 +1,4 @@
+-/* Copyright 2004,2007,2020,2021,2023-2025 IPB, Universite de Bordeaux, INRIA & CNRS
++/* Copyright 2004,2007,2020,2021,2023-2026 IPB, Universite de Bordeaux, INRIA & CNRS
+ **
+ ** This file is part of the Scotch software package for static mapping,
+ ** graph partitioning and sparse matrix ordering.
+@@ -48,7 +48,7 @@
+ /**                # Version 6.1  : from : 18 jan 2020     **/
+ /**                                 to   : 18 jan 2020     **/
+ /**                # Version 7.0  : from : 26 apr 2021     **/
+-/**                                 to   : 10 oct 2025     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -56,6 +56,8 @@
+ **  The defines and includes.
+ */
+ 
++#define SCOTCH_HGRAPH_ORDER_BL
++
+ #include "module.h"
+ #include "common.h"
+ #include "parser.h"
+@@ -85,8 +87,9 @@ const Gnum                                ordenum, /*+ Zero-based ordering numbe
+ OrderCblk * restrict const                cblkptr, /*+ Single column-block        +*/
+ const HgraphOrderBlParam * restrict const paraptr)
+ {
+-  Gnum                cblknbr;                    /* Number of column blocks for splitting */
+-  Gnum                cblksiz;                    /* Number of allocated column blocks     */
++  Gnum * restrict     vnlotab;                    /* Array of column loads, indexed by ordering number */
++  Gnum * restrict     vnlotax;                    /* Based access to column load array, or NULL        */
++  int                 o;
+ 
+   if (paraptr->cblkmin <= 0) {
+     errorPrint ("hgraphOrderBl: invalid minimum block size");
+@@ -96,103 +99,212 @@ const HgraphOrderBlParam * restrict const paraptr)
+   if (hgraphOrderSt (grafptr, ordeptr, ordenum, cblkptr, paraptr->straptr) != 0) /* Perform ordering strategy */
+     return (1);
+ 
+-  if (cblkptr->cblktab == NULL) {                 /* If single column block */
+-#ifdef SCOTCH_DEBUG_HGRAPH2
+-    if (cblkptr->vnodnbr != grafptr->vnohnbr) {
+-      errorPrint ("hgraphOrderBl: invalid column block");
++  vnlotab =
++  vnlotax = NULL;                                 /* Assume columns have no loads */
++  if (grafptr->s.velotax != NULL) {               /* If vertex loads, get column loads in ordering order */
++    Gnum                ordetmp;
++    Gnum                ordennd;
++
++    const Gnum * restrict const peritab = ordeptr->peritab;
++    const Gnum * restrict const velotax = grafptr->s.velotax;
++    const Gnum * restrict const vnumtax = grafptr->s.vnumtax;
++
++    if ((vnlotab = (Gnum *) memAlloc (grafptr->vnohnbr * sizeof (Gnum))) == NULL) {
++      errorPrint ("hgraphOrderBl: out of memory (1)");
+       return (1);
+     }
++    vnlotax = vnlotab - ordenum;
++    ordennd = ordenum + grafptr->vnohnbr;
++
++    if (vnumtax == NULL) {                        /* If graph is original graph, ordering holds vertex indices */
++      for (ordetmp = ordenum; ordetmp < ordennd; ordetmp ++)
++        vnlotax[ordetmp] = velotax[peritab[ordetmp]];
++    }
++    else {                                        /* Ordering holds original vertex indices */
++      Gnum * restrict     sorttab;                /* Pairs of original vertex indices and local vertex loads or ordering numbers */
++      Gnum * restrict     sorttmp;
++      Gnum                vertnum;
++      Gnum                sortnum;
++
++      if ((sorttab = (Gnum *) memAlloc (grafptr->vnohnbr * 4 * sizeof (Gnum))) == NULL) {
++        errorPrint ("hgraphOrderBl: out of memory (2)");
++        memFree    (vnlotab);
++        return (1);
++      }
++      sorttmp = sorttab + 2 * grafptr->vnohnbr;
++
++      for (vertnum = grafptr->s.baseval, sortnum = 0; vertnum < grafptr->vnohnnd; vertnum ++, sortnum += 2) {
++        sorttab[sortnum]     = vnumtax[vertnum];  /* Record load of each local vertex */
++        sorttab[sortnum + 1] = velotax[vertnum];
++      }
++      for (ordetmp = ordenum, sortnum = 0; ordetmp < ordennd; ordetmp ++, sortnum += 2) {
++        sorttmp[sortnum]     = peritab[ordetmp];  /* Record ordering number of each original vertex */
++        sorttmp[sortnum + 1] = ordetmp;
++      }
++      intSort2asc1 (sorttab, grafptr->vnohnbr);   /* Sort both arrays by original vertex index */
++      intSort2asc1 (sorttmp, grafptr->vnohnbr);
++
++      for (sortnum = 0; sortnum < (2 * grafptr->vnohnbr); sortnum += 2) { /* Both arrays hold the same original vertex indices */
++#ifdef SCOTCH_DEBUG_HGRAPH2
++        if (sorttab[sortnum] != sorttmp[sortnum]) {
++          errorPrint ("hgraphOrderBl: internal error");
++          memFree    (sorttab);
++          memFree    (vnlotab);
++          return (1);
++        }
+ #endif /* SCOTCH_DEBUG_HGRAPH2 */
++        vnlotax[sorttmp[sortnum + 1]] = sorttab[sortnum + 1]; /* Set load of column */
++      }
+ 
+-    if ((cblkptr->vnodnbr <= 1) ||                /* Il block has only one column    */
+-        (grafptr->vnlosum < (2 * paraptr->cblkmin))) /* Or does not need to be split */
+-      return (0);
++      memFree (sorttab);
++    }
++  }
+ 
+-    cblknbr = grafptr->vnlosum / paraptr->cblkmin; /* Get new (maximum) number of blocks */
+-    cblksiz = MIN (cblknbr, grafptr->vnohnbr);    /* No more column blocks than columns  */
++  o = hgraphOrderBl2 (ordeptr, ordenum, cblkptr, vnlotax, paraptr->cblkmin); /* Split leaves of column block tree */
+ 
+-    if ((cblkptr->cblktab = (OrderCblk *) memAlloc (cblksiz * sizeof (OrderCblk))) == NULL) {
+-      errorPrint ("hgraphOrderBl: out of memory");
+-      return (1);
++  if (vnlotab != NULL)
++    memFree (vnlotab);
++
++  return (o);
++}
++
++/* This routine splits the leaves of the
++** given column block tree into sub-blocks
++** of the wanted minimum weight, without
