diff --git a/upstream/reports/7.0.18/patches/G05-strategy-tables-api/0002-Bugfix-maintain-a-consistent-ordering-for-else-less-.patch b/upstream/reports/7.0.18/patches/G05-strategy-tables-api/0002-Bugfix-maintain-a-consistent-ordering-for-else-less-.patch
