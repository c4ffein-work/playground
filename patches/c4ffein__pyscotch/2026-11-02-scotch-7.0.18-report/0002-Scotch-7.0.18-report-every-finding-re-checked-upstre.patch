++/* This routine splits the leaves of the
++** given column block tree into sub-blocks
++** of the wanted minimum weight, without
++** changing the ordering.
++** It returns:
++** - 0   : if the blocks could be split.
++** - !0  : on error.
++*/
++
++static
++int
++hgraphOrderBl2 (
++Order * restrict const      ordeptr,
++const Gnum                  ordenum,              /*+ Zero-based ordering number of first column of block +*/
++OrderCblk * restrict const  cblkptr,              /*+ Column block to split                               +*/
++const Gnum * restrict const vnlotax,              /*+ Column loads, indexed by ordering number, or NULL   +*/
++const Gnum                  cblkmin)              /*+ Minimum block weight                                +*/
++{
++  Gnum                cblknbr;                    /* Number of column blocks for splitting */
++  Gnum                cblksiz;                    /* Number of allocated column blocks     */
++  Gnum                vnlosum;                    /* Weight of column block                */
++
++  if (cblkptr->cblktab != NULL) {                 /* If block already partitioned, split its sub-blocks */
++    Gnum                cblknum;
++    Gnum                ordetmp;
++
++    for (cblknum = 0, ordetmp = ordenum; cblknum < cblkptr->cblknbr; cblknum ++) { /* Sub-blocks follow each other in ordering */
++      if (hgraphOrderBl2 (ordeptr, ordetmp, cblkptr->cblktab + cblknum, vnlotax, cblkmin) != 0)
++        return (1);
++      ordetmp += cblkptr->cblktab[cblknum].vnodnbr;
+     }
+ 
+-    if (grafptr->s.velotax == NULL) {             /* For unweighted graphs, split blocks evenly */
+-      Gnum                cblknum;
++    return (0);
++  }
+ 
+-      for (cblknum = 0; cblknum < cblksiz; cblknum ++) { /* No more column blocks than those allocated */
+-        cblkptr->cblktab[cblknum].typeval = ORDERCBLKLEAF;
+-        cblkptr->cblktab[cblknum].vnodnbr = DATASIZE (grafptr->vnlosum, cblknbr, cblknum);
+-        cblkptr->cblktab[cblknum].cblknbr = 0;
+-        cblkptr->cblktab[cblknum].cblktab = NULL;
+-      }
++  if (cblkptr->vnodnbr <= 1)                      /* If block has only one column */
++    return (0);
++
++  if (vnlotax == NULL)                            /* If columns have no loads */
++    vnlosum = cblkptr->vnodnbr;
++  else {
++    Gnum                ordetmp;
++    Gnum                ordennd;
++
++    for (ordetmp = ordenum, ordennd = ordenum + cblkptr->vnodnbr, vnlosum = 0; /* Compute weight of block */
++         ordetmp < ordennd; ordetmp ++)
++      vnlosum += vnlotax[ordetmp];
++  }
++  if (vnlosum < (2 * cblkmin))                    /* If block does not need to be split */
++    return (0);
++
++  cblknbr = vnlosum / cblkmin;                    /* Get new (maximum) number of blocks */
++  cblksiz = MIN (cblknbr, cblkptr->vnodnbr);      /* No more column blocks than columns */
++
++  if ((cblkptr->cblktab = (OrderCblk *) memAlloc (cblksiz * sizeof (OrderCblk))) == NULL) {
