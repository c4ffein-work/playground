+From 2a965c7ca8614da21337c3f03739733f8c047ba8 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 16:08:12 +0000
+Subject: [PATCH 187/232] Bugfix: compute torus arc count from the neighbor
+ mask in `gmk_m2` [report R. Perry]
+
+The closed-form arc count of 8-neighbor tori subtracted the arcs
+removed along each dimension independently, so that arcs removed
+for both dimensions were subtracted twice when both dimensions are
+smaller than 3. The header of tori of sizes 1x1, 1x2, 2x1 and 2x2
+did not match the arcs written, and the files could not be loaded.
+Since all vertices of a torus have the same neighbor mask, compute
+it once and derive the arc count from it, as the arcs are written.
+
+Refs: CLI-18
+---
+ src/check/CMakeLists.txt |  8 +++++
+ src/check/Makefile       |  4 +++
+ src/scotch/gmk_m2.c      | 70 +++++++++++++++++++++++-----------------
+ src/scotch/gmk_m2.h      |  5 +--
+ 4 files changed, 56 insertions(+), 31 deletions(-)
+
+diff --git a/src/check/CMakeLists.txt b/src/check/CMakeLists.txt
+index d46fb58e..c6b5de85 100644
+--- a/src/check/CMakeLists.txt
++++ b/src/check/CMakeLists.txt
+@@ -565,6 +565,14 @@ add_test(NAME gmk_m2_t COMMAND ${BASH} -c "'$<TARGET_FILE:gmk_m2>' -t 5 4 | '$<T
+ 
+ add_test(NAME gmk_m2_b1_t COMMAND ${BASH} -c "'$<TARGET_FILE:gmk_m2>' -b1 -t 5 1 | '$<TARGET_FILE:gtst>'")
+ 
++add_test(NAME gmk_m2_e_t_2_2 COMMAND ${BASH} -c "'$<TARGET_FILE:gmk_m2>' -e -t 2 2 | '$<TARGET_FILE:gtst>'")
++
++add_test(NAME gmk_m2_e_t_1_2 COMMAND ${BASH} -c "'$<TARGET_FILE:gmk_m2>' -e -t 1 2 | '$<TARGET_FILE:gtst>'")
++
++add_test(NAME gmk_m2_e_t_2_1 COMMAND ${BASH} -c "'$<TARGET_FILE:gmk_m2>' -e -t 2 1 | '$<TARGET_FILE:gtst>'")
++
++add_test(NAME gmk_m2_e_t_1_1 COMMAND ${BASH} -c "'$<TARGET_FILE:gmk_m2>' -e -t 1 1 | '$<TARGET_FILE:gtst>'")
++
+ add_test(NAME gmk_m3 COMMAND ${BASH} -c "'$<TARGET_FILE:gmk_m3>' -b1 5 4 3 -g${dev_null} | '$<TARGET_FILE:gtst>'")
+ 
+ add_test(NAME gmk_ub2 COMMAND ${BASH} -c "'$<TARGET_FILE:gmk_ub2>' 5 | '$<TARGET_FILE:gtst>'")
