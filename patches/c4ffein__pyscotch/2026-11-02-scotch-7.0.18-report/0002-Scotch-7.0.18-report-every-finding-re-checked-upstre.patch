+-        SCOTCH_dgraphOrderCompute (&grafdat, &ordedat, &stradat);
+-        SCOTCH_dgraphOrderPerm    (&grafdat, &ordedat, order);
++        if ((SCOTCH_dgraphOrderCompute (&grafdat, &ordedat, &stradat) == 0) && /* Status depends on the ordering only; separator sizes are best effort */
++            (SCOTCH_dgraphOrderPerm    (&grafdat, &ordedat, order) == 0))
++          o = METIS_OK;
+ 
