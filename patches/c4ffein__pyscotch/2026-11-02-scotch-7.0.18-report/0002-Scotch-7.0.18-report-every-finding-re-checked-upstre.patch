+#!/bin/bash
+# Run all G11 kits against pristine 7.0.18 (INFRA/asan) and the patched tree (WORK/build), 32-bit.
+# Usage: ./runall.sh [pristine|patched] ; output goes to stdout
+INFRA=/tmp/claude-0/-home-user-playground/925301e5-494b-5a33-b598-8eaa63dd5c1d/scratchpad/infra18
+R=$(dirname $(readlink -f $0)); W=$(dirname $R)
+case $1 in pristine) B=$INFRA/asan;; patched) B=$W/build;; pristine64) B=$INFRA/asan64;; patched64) B=$W/build64;; *) echo usage; exit 1;; esac
+O=$R/bin-$1; mkdir -p $O
+CF=$(sed -n 's/^CFLAGS[ \t]*= //p' $B/src/Makefile.inc)
+export LD_LIBRARY_PATH=$B/lib UBSAN_OPTIONS=print_stacktrace=1 ASAN_OPTIONS=detect_leaks=1
+pub () { gcc $(sed -n "s/^CFLAGS[ \t]*= //p" $B/src/Makefile.inc | grep -o "\-DINTSIZE64 -DIDXSIZE64") $1 -o $O/$2 -O0 -g -fsanitize=address,undefined -fno-omit-frame-pointer -I$B/include -L$B/lib -lscotch -lscotcherr -lz -lm -lpthread; }
+int () { gcc $1 -o $O/$2 $CF -I$B/src/libscotch -I$B/include -L$B/lib -lscotch -lscotcherr -lz -lm -lpthread; }
+pub $R/SEP-08/hbload.c hbload; pub $R/SEP-16/geoload.c geoload; pub $R/API-12/bound.c bound
+pub $R/API-08/fhabo.c fhabo; pub $R/meshLoad/loadbase.c loadbase
+int $R/SEP-23/base.c base; int $R/SEP-21/hmeshmesh.c hmeshmesh; int $R/hmeshExit/hexit.c hexit
+D=$W/scotch/src/check/data; run () { echo "--- $*"; (cd $R/$1; shift; timeout 20 "$@" 2>&1 | grep -v "^    #[1-9][0-9]" | head -8); }
+run SEP-07 $B/bin/mcv w_ef.msh /tmp/g11w_ef.out -is -os; diff -q $R/SEP-07/w_ef.msh /tmp/g11w_ef.out && echo same_ef
+run SEP-07 $B/bin/mcv w_nf.msh /tmp/g11w_nf.out -is -os; diff -q $R/SEP-07/w_nf.msh /tmp/g11w_nf.out && echo same_nf
+for f in hb_ok hb_badvar hb_badptr2 hb_badptr; do run SEP-08 $O/hbload $f.mtx; done
+run fuzz $B/bin/mcv before/crashes/c0355.rsa /dev/null -ib -os
+run SEP-16 $O/geoload m16u.msh m16u.xyz
+run SEP-21 $O/hmeshmesh
+run SEP-23 $O/base
+run API-06 $O/bound 2 $D/small2.msh
+run API-06 $O/bound 3 $D/small2.msh
+run API-08 $O/fhabo ../SEP-08/hb_ok.mtx
+run API-12 $O/bound 0 $D/small2.msh
+run API-12 $O/bound 1 $D/small2.msh
+run PS-SEP-1 $B/bin/mtst m16_lbl.msh
+run hmeshExit $O/hexit
+run meshLoad $B/bin/gmk_msh bad_edge_hi.msh /dev/null
+run meshLoad $B/bin/mord bad_edge_hi.msh /dev/null
+run meshLoad $B/bin/mord bad_edge_neg.msh /dev/null
+run meshLoad $B/bin/gmk_msh bad_edge_huge.msh /dev/null
+run meshLoad $B/bin/gmk_msh bad_degr_neg.msh /dev/null
+run meshLoad $O/loadbase $INFRA/v7.0.18/src/check/data/small2.msh 1
diff --git a/upstream/repro/G12-overlap-kgraph-rb/PS3-G12-1/README b/upstream/repro/G12-overlap-kgraph-rb/PS3-G12-1/README
new file mode 100644
index 0000000..d20a906
--- /dev/null
+++ b/upstream/repro/G12-overlap-kgraph-rb/PS3-G12-1/README
@@ -0,0 +1,5 @@
+PS3-G12-1 (new in 7.0.18, introduced by 22c9c42e): kgraphMapRbVfloMerge() hash table sized from dfixmax only,
+but it first inserts every domain of the mapping computed on the free vertices (mappptr->domnnbr of them).
+Few fixed vertices + many parts => table full => probe loop without exit (hang).
+Build: gcc -O0 -g -fsanitize=address,undefined -I$B/include fewfix.c -o fewfix -L$B/lib -lscotch -lscotcherr -lz -lm -lpthread
+  timeout 60 ./fewfix 1 64     (1 fixed vertex, 64 parts, 32x32 grid)
diff --git a/upstream/repro/G12-overlap-kgraph-rb/PS3-G12-1/fewfix.c b/upstream/repro/G12-overlap-kgraph-rb/PS3-G12-1/fewfix.c
new file mode 100644
index 0000000..69c7e27
--- /dev/null
+++ b/upstream/repro/G12-overlap-kgraph-rb/PS3-G12-1/fewfix.c
@@ -0,0 +1,35 @@
+/* PS3-G12-1: SCOTCH_graphMapFixed with few fixed vertices and many parts.
+** 7.0.18 sizes the merge hash table of kgraphMapRbVfloMerge() from the number
+** of fixed domains only, while it first inserts all domains of the mapping.
+** usage: fewfix fixnbr partnbr [gridside] */
+#include "../common/mk.h"
+
+int
+main (int argc, char * argv[])
+{
+  SCOTCH_Graph        g;
+  SCOTCH_Arch         a;
+  SCOTCH_Strat        s;
+  SCOTCH_Num          nf   = atol (argv[1]);
+  SCOTCH_Num          np   = atol (argv[2]);
+  int                 side = (argc > 3) ? atoi (argv[3]) : 32;
+  SCOTCH_Num          n    = (SCOTCH_Num) side * side;
+  SCOTCH_Num *        parttab = malloc (n * sizeof (SCOTCH_Num));
+  SCOTCH_Num          i, d;
+  int                 r;
+
+  for (i = 0; i < n; i ++)
+    parttab[i] = -1;
+  for (i = 0; i < nf; i ++)
+    parttab[i * (n / nf)] = i % np;
+  mkgrid (&g, side, side, NULL);
+  SCOTCH_archInit  (&a);
+  SCOTCH_archCmplt (&a, np);
+  SCOTCH_stratInit (&s);
+  r = SCOTCH_graphMapFixed (&g, &a, &s, parttab);
+  for (i = 0, d = 0; i < n; i ++)
+    if ((parttab[i] < 0) || (parttab[i] >= np))
+      d ++;
+  printf ("ret=%d badparts=%ld check=%d\n", r, (long) d, SCOTCH_graphCheck (&g));
+  return ((r != 0) ? 1 : 0);
+}
