++/************************************************************/
++/**                                                        **/
++/**   NAME       : test_scotch_dgraph_build.c              **/
++/**                                                        **/
++/**   AUTHOR     : Francois PELLEGRINI                     **/
++/**                                                        **/
++/**   FUNCTION   : This module tests the operation of      **/
++/**                the SCOTCH_dgraphBuild() routine when   **/
++/**                vertex labels are provided.             **/
++/**                                                        **/
++/**   DATES      : # Version 7.0  : from : 13 oct 2026     **/
++/**                                 to   : 02 nov 2026     **/
++/**                                                        **/
++/************************************************************/
++
++/*
++**  The defines and includes.
++*/
++
++#include <mpi.h>
++
++#include "../libscotch/module.h"
++#include "../libscotch/common.h"
++
++#include "ptscotch.h"
++
++/*
++**  The type and structure definitions.
++*/
++
++/*+ Test cases. +*/
++
++typedef enum C_TestCase_ {
++  C_TESTVALID = 0,                                /*+ Valid labeled graph with a non-compact edge array +*/
++  C_TESTUNKNOWN,                                  /*+ Some edge refers to a label that does not exist   +*/
++  C_TESTDUPLICATE,                                /*+ Some process has two vertices with the same label +*/
++  C_TESTNBR
++} C_TestCase;
++
++/*********************/
++/*                   */
++/* The main routine. */
++/*                   */
++/*********************/
++
++/* Each process holds two vertices, with labels 100 * (p + 1) + 1
++** and 100 * (p + 1) + 2, so that labels are not contiguous. Each
++** vertex is linked to the other vertex of the same process, and
++** the processes form a ring: the first vertex of each process is
++** linked to the second vertex of the previous process, and the
++** second vertex of each process to the first vertex of the next
++** process. The edge array is not compact: an unused slot, filled
++** with a sentinel value, follows the edges of each vertex.
++*/
++
++int
++main (
++int                 argc,
++char *              argv[])
++{
++  MPI_Comm            proccomm;
++  int                 procglbnbr;                 /* Number of processes sharing graph data */
++  int                 proclocnum;                 /* Number of this process                 */
++  SCOTCH_Dgraph       grafdat;
++  SCOTCH_Num          baseval;
++  C_TestCase          casenum;
++#ifdef SCOTCH_PTHREAD
++  int                 thrdreqlvl;
++  int                 thrdprolvl;
++#endif /* SCOTCH_PTHREAD */
++
++  SCOTCH_errorProg (argv[0]);
++
++#ifdef SCOTCH_PTHREAD
++  thrdreqlvl = MPI_THREAD_MULTIPLE;
++  if (MPI_Init_thread (&argc, &argv, thrdreqlvl, &thrdprolvl) != MPI_SUCCESS) {
++    SCOTCH_errorPrint ("main: Cannot initialize (1)");
++    exit (EXIT_FAILURE);
++  }
++#else /* SCOTCH_PTHREAD */
++  if (MPI_Init (&argc, &argv) != MPI_SUCCESS) {
++    SCOTCH_errorPrint ("main: Cannot initialize (2)");
++    exit (EXIT_FAILURE);
++  }
++#endif /* SCOTCH_PTHREAD */
++
++  if (argc != 1) {
++    SCOTCH_errorPrint ("usage: %s", argv[0]);
++    exit (EXIT_FAILURE);
++  }
++
++  proccomm = MPI_COMM_WORLD;
++  MPI_Comm_size (proccomm, &procglbnbr);          /* Get communicator data */
++  MPI_Comm_rank (proccomm, &proclocnum);
++
++  SCOTCH_randomProc (proclocnum);                 /* Record process number to initialize pseudo-random seed */
++
++#ifdef SCOTCH_CHECK_NOAUTO
++  fprintf (stderr, "Proc %2d of %2d, pid %d\n", proclocnum, procglbnbr, getpid ());
++
++  if (proclocnum == 0) {                          /* Synchronize on keybord input */
++    char           c;
++
++    printf ("Waiting for key press...\n");
++    scanf ("%c", &c);
++  }
++#endif /* SCOTCH_CHECK_NOAUTO */
++
++  if (MPI_Barrier (proccomm) != MPI_SUCCESS) {    /* Synchronize for debug */
++    SCOTCH_errorPrint ("main: cannot communicate (1)");
++    exit (EXIT_FAILURE);
++  }
++
++  for (baseval = 0; baseval <= 1; baseval ++) {
++    for (casenum = C_TESTVALID; casenum < C_TESTNBR; casenum ++) {
++      SCOTCH_Num          vertloctab[2];
++      SCOTCH_Num          vendloctab[2];
++      SCOTCH_Num          vlblloctab[2];
++      SCOTCH_Num          edgeloctab[8];
++      SCOTCH_Num          edgelocnbr;
++      SCOTCH_Num          edgelocnum;
++      SCOTCH_Num          vlblnxtval;             /* First label of next process */
++      int                 cheklocval;
++      int                 chekglbval[2];
++      int                 o;
++
++      vlblloctab[0] = 100 * (proclocnum + 1) + 1;
++      vlblloctab[1] = 100 * (proclocnum + 1) + 2;
++      if ((casenum == C_TESTDUPLICATE) && (proclocnum == 0)) /* Duplicate label on first process */
++        vlblloctab[1] = vlblloctab[0];
++      vlblnxtval = 100 * ((proclocnum + 1) % procglbnbr + 1);
++
++      edgelocnum = baseval;
++      vertloctab[0] = edgelocnum;
++      edgeloctab[edgelocnum ++ - baseval] = vlblloctab[1];
++      if (procglbnbr > 1)
++        edgeloctab[edgelocnum ++ - baseval] = 100 * ((proclocnum + procglbnbr - 1) % procglbnbr + 1) + 2;
++      if ((casenum == C_TESTUNKNOWN) && (proclocnum == (procglbnbr - 1))) /* Unknown label on last process */
++        edgeloctab[edgelocnum ++ - baseval] = 9999;
++      vendloctab[0] = edgelocnum;
++      edgeloctab[edgelocnum ++ - baseval] = -1;   /* Unused slot */
++      vertloctab[1] = edgelocnum;
++      edgeloctab[edgelocnum ++ - baseval] = vlblloctab[0];
++      if (procglbnbr > 1)
++        edgeloctab[edgelocnum ++ - baseval] = vlblnxtval + 1;
++      vendloctab[1] = edgelocnum;
++      edgeloctab[edgelocnum ++ - baseval] = -1;   /* Unused slot */
++      edgelocnbr = (vendloctab[0] - vertloctab[0]) + (vendloctab[1] - vertloctab[1]);
++
++      if (SCOTCH_dgraphInit (&grafdat, proccomm) != 0) { /* Initialize source graph */
++        SCOTCH_errorPrint ("main: cannot initialize graph");
++        exit (EXIT_FAILURE);
++      }
++
++      o = SCOTCH_dgraphBuild (&grafdat, baseval, 2, 2, vertloctab, vendloctab, NULL, vlblloctab,
++                              edgelocnbr, edgelocnum - baseval, edgeloctab, NULL, NULL);
++
++      cheklocval  = o;                            /* All processes must return the same value */
++      chekglbval[0] = chekglbval[1] = 0;
++      if ((MPI_Allreduce (&cheklocval, &chekglbval[0], 1, MPI_INT, MPI_MIN, proccomm) != MPI_SUCCESS) ||
++          (MPI_Allreduce (&cheklocval, &chekglbval[1], 1, MPI_INT, MPI_MAX, proccomm) != MPI_SUCCESS)) {
++        SCOTCH_errorPrint ("main: cannot communicate (2)");
++        exit (EXIT_FAILURE);
++      }
++      if (chekglbval[0] != chekglbval[1]) {
++        SCOTCH_errorPrint ("main: processes disagree on build result (case %d)", (int) casenum);
++        exit (EXIT_FAILURE);
++      }
++
++      if (casenum == C_TESTVALID) {
++        if (o != 0) {
++          SCOTCH_errorPrint ("main: cannot build valid graph (base %d)", (int) baseval);
++          exit (EXIT_FAILURE);
++        }
++        if (SCOTCH_dgraphCheck (&grafdat) != 0) {
++          SCOTCH_errorPrint ("main: invalid built graph (base %d)", (int) baseval);
++          exit (EXIT_FAILURE);
++        }
++        if ((edgeloctab[vendloctab[0] - baseval] != -1) || /* Unused slots must not have been translated */
++            (edgeloctab[vendloctab[1] - baseval] != -1)) {
++          SCOTCH_errorPrint ("main: unused edge slots modified (base %d)", (int) baseval);
++          exit (EXIT_FAILURE);
++        }
++      }
++      else if (o == 0) {
++        SCOTCH_errorPrint ("main: invalid graph accepted (case %d, base %d)", (int) casenum, (int) baseval);
++        exit (EXIT_FAILURE);
++      }
++
++      SCOTCH_dgraphExit (&grafdat);
++    }
++  }
++
++  MPI_Finalize ();
++  exit (EXIT_SUCCESS);
++}
+diff --git a/src/libscotch/dgraph_build.c b/src/libscotch/dgraph_build.c
+index a3ddb96f..83efd3a3 100644
+--- a/src/libscotch/dgraph_build.c
++++ b/src/libscotch/dgraph_build.c
+@@ -389,6 +389,23 @@ const Gnum                  degrlocmax)
+       }
+     }
+ 
++    for (vertlocnum = baseval, edsolocptr = edsoloctab, edsoloctnd = edsoloctab + edgelocnbr; /* Edge array may not be compact */
++         vertlocnum < grafptr->vertlocnnd; vertlocnum ++) {
++      Gnum                edgelocnnd;
++
++      edgelocnnd = vendloctax[vertlocnum];
++      if ((edgelocnnd - vertloctax[vertlocnum]) > (edsoloctnd - edsolocptr)) /* If more edges than announced */
++        break;
++      for (edgelocnum = vertloctax[vertlocnum]; edgelocnum < edgelocnnd; edgelocnum ++, edsolocptr ++) {
++        edsolocptr->vlblglbnum = edgeloctax[edgelocnum]; /* Build edge sort array */
++        edsolocptr->edgelocnum = edgelocnum;
++      }
++    }
++    if (edsolocptr != edsoloctnd) {               /* If sum of vertex degrees differs from number of edges */
++      errorPrint ("dgraphBuild3: invalid local number of edges");
++      goto fail;
++    }
++
+     cheklocval = 0;                               /* Everything went well */
+ fail:
+     if (MPI_Allreduce (&cheklocval, &chekglbval, 1, MPI_INT, MPI_MAX, grafptr->proccomm) != MPI_SUCCESS) { /* All processes must agree before exchanging label data */
+@@ -401,12 +418,7 @@ fail:
+       return (1);
+     }
+ 
+-    for (edsolocptr = edsoloctab, edsoloctnd = edsoloctab + edgelocnbr, edgelocnum = baseval;
+-         edsolocptr < edsoloctnd; edsolocptr ++, edgelocnum ++) {
+-      edsolocptr->vlblglbnum = edgeloctax[edgelocnum];
+-      edsolocptr->edgelocnum = edgelocnum;
+-    }
+-    intSort2asc2 (edsoloctab, grafptr->edgelocnbr);
++    intSort2asc2 (edsoloctab, edgelocnbr);
+ 
+     procrcvnum = (grafptr->proclocnum + 1) % procglbnbr; /* Compute indices of neighbors */
+     procsndnum = (grafptr->proclocnum - 1 + procglbnbr) % procglbnbr;
+@@ -458,6 +470,15 @@ fail:
+ 
+     if (cheklocval != 0)                          /* If some label was found on several processes */
+       errorPrint ("dgraphBuild3: duplicate vertex label (2)");
++    else {
++      for (edsolocptr = edsoloctab; edsolocptr < edsoloctnd; edsolocptr ++) {
++        if (edsolocptr->edgelocnum != -1) {       /* If some edge label was found on no process */
++          errorPrint ("dgraphBuild3: unknown vertex label");
++          cheklocval = 1;
++          break;
++        }
++      }
++    }
+ 
+     memFree (vesongbtab[0]);                      /* Free group leader */
+ 
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0128-Bugfix-check-the-result-of-edge-array-shrinking-in-d.patch b/upstream/reports/7.0.18/series/0128-Bugfix-check-the-result-of-edge-array-shrinking-in-d.patch
new file mode 100644
index 0000000..d6a4fb7
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0128-Bugfix-check-the-result-of-edge-array-shrinking-in-d.patch
@@ -0,0 +1,64 @@
+From 67a0a3a9c45db37344eb0449686aaeacddaa1e98 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 13:44:24 +0000
+Subject: [PATCH 128/232] Bugfix: check the result of edge array shrinking in
+ `dgraphInduce2()` [report PyScotch]
+
+The edge array of the induced graph is shrunk to its final size with
+`memRealloc()`, whose result was rebased without being tested. Should
+shrinking fail, the induced graph would point to a non-existent array.
+
+Keep the original array, which is valid and large enough, when
+shrinking fails.
+---
+ src/libscotch/dgraph_induce.c | 20 ++++++++------------
+ 1 file changed, 8 insertions(+), 12 deletions(-)
+
+diff --git a/src/libscotch/dgraph_induce.c b/src/libscotch/dgraph_induce.c
+index 9512629d..a9ec9b9d 100644
+--- a/src/libscotch/dgraph_induce.c
++++ b/src/libscotch/dgraph_induce.c
+@@ -46,7 +46,7 @@
+ /**                # Version 6.0  : from : 29 aug 2012     **/
+ /**                                 to   : 25 apr 2018     **/
+ /**                # Version 7.0  : from : 17 jan 2023     **/
+-/**                                 to   : 29 oct 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -83,6 +83,8 @@ Dgraph * restrict const     indgrafptr)
+   Gnum                indedgelocmax;              /* (Approximate) number of edges in induced graph */
+   Gnum                indedgelocnbr;              /* Real number of edges in induced graph          */
+   Gnum                indedgelocnum;
++  Gnum *              indedgeloctmp;              /* Pointer to shrunk edge array, if any           */
++  Gnum                indedlooftval;              /* Offset of edge load array w.r.t. edge array    */
+   Gnum * restrict     indedloloctax;
+   Gnum                inddegrlocmax;              /* Local maximum degree                           */
+   Gnum                baseval;
+@@ -232,17 +234,11 @@ fail2:
+   if (orgvlblloctax == NULL)                      /* If we didn't have vertex labels, use vertex index array as vertex label array */
+     indgrafptr->vlblloctax = indgrafptr->vnumloctax;
+ 
+-  if (indedloloctax != NULL) {                    /* Re-allocate arrays and delete orgindxtab             */
+-    size_t              indedlooftval;            /* Offset of edge load array with respect to edge array */
+-
+-    indedlooftval = indedloloctax - indgrafptr->edgeloctax;
+-    indgrafptr->edgeloctax  = memRealloc (indgrafptr->edgeloctax + baseval, (indedlooftval + indedgelocnbr) * sizeof (Gnum));
+-    indgrafptr->edgeloctax -= baseval;
+-    indedloloctax = indgrafptr->edgeloctax + indedlooftval; /* Use old index into old array as new index to avoid alignment problems */
+-  }
+-  else {
+-    indgrafptr->edgeloctax  = memRealloc (indgrafptr->edgeloctax + baseval, indedgelocnbr * sizeof (Gnum));
+-    indgrafptr->edgeloctax -= baseval;
++  indedlooftval = (indedloloctax != NULL) ? (indedloloctax - indgrafptr->edgeloctax) : 0; /* Use old index into old array as new index to avoid alignment problems */
++  if ((indedgeloctmp = memRealloc (indgrafptr->edgeloctax + baseval, (indedlooftval + indedgelocnbr) * sizeof (Gnum))) != NULL) { /* Shrink edge arrays and delete orgindxtab; keep them as is if shrinking fails */
++    indgrafptr->edgeloctax = indedgeloctmp - baseval;
++    if (indedloloctax != NULL)
++      indedloloctax = indgrafptr->edgeloctax + indedlooftval;
+   }
+ 
+   indvertlocnum = baseval;
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0129-Bugfix-stop-dgraphGhst2-after-a-local-allocation-fai.patch b/upstream/reports/7.0.18/series/0129-Bugfix-stop-dgraphGhst2-after-a-local-allocation-fai.patch
new file mode 100644
index 0000000..e15ef86
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0129-Bugfix-stop-dgraphGhst2-after-a-local-allocation-fai.patch
@@ -0,0 +1,187 @@
+From 6db0c2e72012950dec744c08fba36deb5575d4e6 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 13:50:46 +0000
+Subject: [PATCH 129/232] Bugfix: stop `dgraphGhst2()` after a local allocation
+ failure [report R. Perry]
+
+A process that could not allocate its ghost edge array or its work
+arrays performed the error agreement with the other processes, as
+intended, but then went on: it cleared arrays that did not exist and
+performed a second reduction that no other process matched.
+
+Return after the agreement. Allocate the work arrays before the ghost
+edge array, so that a graph is not modified when its edge array was to
+be replaced and the work arrays cannot be allocated. Attach the send
+index array to the graph only once all processes have agreed that the
+ghost edge array is valid, so that it is not leaked when some other
+process fails, and check the result of its shrinking.
+
+Refs: DGR-08
+---
+ src/libscotch/dgraph_ghst.c | 79 ++++++++++++++++---------------------
+ 1 file changed, 35 insertions(+), 44 deletions(-)
+
+diff --git a/src/libscotch/dgraph_ghst.c b/src/libscotch/dgraph_ghst.c
+index 7f199b10..d96ac4fc 100644
+--- a/src/libscotch/dgraph_ghst.c
++++ b/src/libscotch/dgraph_ghst.c
