diff --git a/upstream/reports/7.0.18/patches/G01-arch-sub-dist/0005-Bugfix-build-sub-architectures-made-of-a-single-term.patch b/upstream/reports/7.0.18/patches/G01-arch-sub-dist/0005-Bugfix-build-sub-architectures-made-of-a-single-term.patch
new file mode 100644
index 0000000..5320837
