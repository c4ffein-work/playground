++OrderCblk * restrict const  cblkptr,              /*+ Column block to split                               +*/
++const Gnum * restrict const vnlotax,              /*+ Column loads, indexed by ordering number, or NULL   +*/
++const Gnum                  cblkmin)              /*+ Minimum block weight                                +*/
++{
++  Gnum                cblknbr;                    /* Number of column blocks for splitting */
++  Gnum                cblksiz;                    /* Number of allocated column blocks     */
++  Gnum                vnlosum;                    /* Weight of column block                */
