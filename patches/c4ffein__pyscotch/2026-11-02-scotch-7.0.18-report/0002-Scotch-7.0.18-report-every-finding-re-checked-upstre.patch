diff --git a/upstream/reports/7.0.18/series/0001-Bugfix-clean-up-properly-on-sub-architecture-loading.patch b/upstream/reports/7.0.18/series/0001-Bugfix-clean-up-properly-on-sub-architecture-loading.patch
new file mode 100644
index 0000000..332c9a8
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0001-Bugfix-clean-up-properly-on-sub-architecture-loading.patch
@@ -0,0 +1,116 @@
+From d48f52506e58d72469454c76861877fc031e1cc1 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 08:13:42 +0000
+Subject: [PATCH 001/232] Bugfix: clean up properly on sub-architecture loading
+ and building errors [report R. Perry]
+
+Since terminal numbers are always checked, `archSubArchBuild()` frees
+its terminal array when a number is invalid or duplicate, although the
+array has already been recorded in the sub-architecture body, so that
+`archSubArchFree()`, called by `archLoad()` or `SCOTCH_archExit()`,
+freed it a second time. The other error paths of the routine did not
+free this array, and the two internal error paths kept all coarse tree
+blocks but the first one.
+
+`archSubArchBuild()` now sets the sub-architecture fields only on
+success, and frees all of its data on every error path. Also,
+`archSubArchLoad()` initializes the original architecture before
+loading it, so that, when the loading of a nested "sub" or "dist"
+architecture, or of a tree-leaf one, fails, its freeing routine is
+not called on an uninitialized body.
+
+Refs: COR-04, PS-COR-3
+---
+ src/libscotch/arch_sub.c | 35 ++++++++++++++++++++++-------------
+ 1 file changed, 22 insertions(+), 13 deletions(-)
+
+diff --git a/src/libscotch/arch_sub.c b/src/libscotch/arch_sub.c
+index f0983ff1..fa975b14 100644
+--- a/src/libscotch/arch_sub.c
++++ b/src/libscotch/arch_sub.c
+@@ -42,7 +42,7 @@
+ /**   DATES      : # Version 6.0  : from : 13 mar 2015     **/
+ /**                                 to   : 15 may 2018     **/
+ /**                # Version 7.0  : from : 18 feb 2018     **/
+-/**                                 to   : 27 oct 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -113,6 +113,7 @@ fail:
+     errorPrint ("archSubArchLoad: out of memory (2)");
+     goto fail;
+   }
++  archInit (orgarchptr);                          /* Original architecture can be freed even if not loaded */
+ 
+   if (archLoad (orgarchptr, stream) != 0) {
+     memFree (orgarchptr);
+@@ -379,6 +380,7 @@ const Anum * const          vnumtab)              /*+ Ordered list of remaining
+   Anum                    domnnbr;                /* Number of domains                     */
+   Anum                    vnumnum;
+   const char *            messptr;                /* Pointer to error message              */
++  int                     o;
+ 
+   subarchptr->archptr = orgarchptr;               /* Make sure original architecture is freed in case of error */
+ 
+@@ -421,11 +423,6 @@ const Anum * const          vnumtab)              /*+ Ordered list of remaining
+ 
+   treetab ++;                                     /* TRICK: Hide first slot */
+ 
+-  subarchptr->termnbr = vnumnbr;
+-  subarchptr->termtab = termtab;
+-  subarchptr->domnnbr = domnnbr;
+-  subarchptr->domntab = domntab;
+-
+   for (orgtermnum = 0; orgtermnum < orgtermnbr; orgtermnum ++) { /* Initialize values for all vertices of original architecture */
+     treetab[orgtermnum].domnsiz =
+     treetab[orgtermnum].domnwgt = 0;
+@@ -469,26 +466,38 @@ fail1:
+ 
+   if (rootptr == NULL) {
+     errorPrint ("archSubArchBuild: cannot create sub-architecture (1)");
+-fail2:
+-    memFree (treetab - 1);
++    memFree (treetab - 1);                        /* Coarser tree blocks have already been freed */
++    memFree (termtab);
+     return  (2);
+   }
++
++  o = 0;                                          /* Assume everything will be all right */
+   if (rootptr->domnsiz != vnumnbr) {
+     errorPrint ("archSubArchBuild: internal error (2)");
+-    goto fail2;
++    o = 2;
+   }
+-
+-  if (archSubArchBuild3 (domntab, termtab, rootptr, 1, 0) != domnnbr) {
++  else if (archSubArchBuild3 (domntab, termtab, rootptr, 1, 0) != domnnbr) {
+     errorPrint ("archSubArchBuild: cannot create sub-architecture (2)");
+-    goto fail2;
++    o = 2;
+   }
+-  domntab[0].dfatidx = -1;                        /* Set index of root father as -1 */
+ 
+   for (treetab --; treetab != NULL; treetab = treetmp) { /* Free all tree blocks    */
+     treetmp = treetab[0].sonstab[0];              /* Get pointer to next tree block */
+     memFree (treetab);
+   }
+ 
++  if (o != 0) {
++    memFree (termtab);
++    return  (o);
++  }
++
++  domntab[0].dfatidx = -1;                        /* Set index of root father as -1 */
++
++  subarchptr->termnbr = vnumnbr;                  /* Set sub-architecture fields only on success */
++  subarchptr->termtab = termtab;
++  subarchptr->domnnbr = domnnbr;
++  subarchptr->domntab = domntab;
++
+   return (0);
+ }
+ 
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0002-Bugfix-reject-sub-architectures-without-terminals-re.patch b/upstream/reports/7.0.18/series/0002-Bugfix-reject-sub-architectures-without-terminals-re.patch
new file mode 100644
index 0000000..f83cf23
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0002-Bugfix-reject-sub-architectures-without-terminals-re.patch
@@ -0,0 +1,41 @@
+From 1bf90743eb68a26e0f1c100f20f3948053ec4ed8 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 08:14:15 +0000
+Subject: [PATCH 002/232] Bugfix: reject sub-architectures without terminals
+ [report R. Perry]
+
+`archSubArchBuild()` and `archSubArchLoad()` accepted an empty list of
+terminal numbers, for which the number of domains, `2 * vnumnbr - 1`,
+is negative, and an allocation of negative size was attempted. At
+least one terminal is now required, as for all other architectures.
+
+Refs: COR-03
+---
+ src/libscotch/arch_sub.c | 4 ++--
+ 1 file changed, 2 insertions(+), 2 deletions(-)
+
+diff --git a/src/libscotch/arch_sub.c b/src/libscotch/arch_sub.c
+index fa975b14..eed284f3 100644
+--- a/src/libscotch/arch_sub.c
++++ b/src/libscotch/arch_sub.c
+@@ -89,7 +89,7 @@ FILE * restrict const       stream)
+ #endif /* SCOTCH_DEBUG_ARCH1 */
+ 
+   if ((intLoad (stream, &termnbr) != 1) ||
+-      (termnbr < 0)) {
++      (termnbr < 1)) {
+     errorPrint ("archSubArchLoad: bad input (1)");
+     return (1);
+   }
+@@ -395,7 +395,7 @@ const Anum * const          vnumtab)              /*+ Ordered list of remaining
+ 
+   archDomFrst (orgarchptr, &orgdomndat);          /* Get number of terminal domains in original architecture */
+   orgtermnbr = archDomSize (orgarchptr, &orgdomndat);
+-  if ((vnumnbr < 0) || (vnumnbr > orgtermnbr)) {
++  if ((vnumnbr < 1) || (vnumnbr > orgtermnbr)) {
+     errorPrint ("archSubArchBuild: invalid parameters");
+     return (2);
+   }
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0003-Bugfix-complete-loading-and-freeing-of-dist-architec.patch b/upstream/reports/7.0.18/series/0003-Bugfix-complete-loading-and-freeing-of-dist-architec.patch
new file mode 100644
index 0000000..af45b8e
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0003-Bugfix-complete-loading-and-freeing-of-dist-architec.patch
@@ -0,0 +1,90 @@
+From 7886f73c93c2d9dc615582626fd0d06c7d91cc93 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 08:15:07 +0000
+Subject: [PATCH 003/232] Bugfix: complete loading and freeing of "dist"
+ architectures [report R. Perry]
+
+`archDistArchFree()` freed the sub-architecture without checking that
+it had been loaded, so that any malformed "dist" target file, e.g. one
+with a missing multiplicator value or with an invalid sub-architecture,
+dereferenced a NULL pointer. Also, the sub-architecture was loaded into
+an uninitialized body, which nested "sub" and "dist" architectures
+freed on error, and a loaded "dist" architecture did not inherit the
+flags of its sub-architecture, as `archDistArchBuild()` does, so that,
+e.g., a "dist" of a variable-sized architecture was handled as a
+fixed-size one by the mapping routines.
+
+This patch fixes these issues, makes the loader reject non-positive
+multiplicator values, as `kgraphInit()` does in debug mode, and makes
+`archDistArchBuild()` clear the `ARCHFREE` flag of the original
+architecture, which it does not own.
+
+Refs: COR-05
+---
+ src/libscotch/arch_dist.c | 15 ++++++++++-----
+ 1 file changed, 10 insertions(+), 5 deletions(-)
+
+diff --git a/src/libscotch/arch_dist.c b/src/libscotch/arch_dist.c
+index d0d98a4c..bd015af7 100644
+--- a/src/libscotch/arch_dist.c
++++ b/src/libscotch/arch_dist.c
+@@ -43,7 +43,7 @@
+ /**   DATES      : # Version 6.0  : from : 14 feb 2011     **/
+ /**                                 to   : 30 jun 2014     **/
+ /**                # Version 7.0  : from : 18 feb 2018     **/
+-/**                                 to   : 13 oct 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /**   NOTES      : # This pseudo-architecture is used by   **/
+ /**                  graph repartitioning routines to      **/
+@@ -93,7 +93,8 @@ FILE * restrict const       stream)
+   }
+ #endif /* SCOTCH_DEBUG_ARCH1 */
+ 
+-  if (intLoad (stream, &archptr->crloval) != 1) {
++  if ((intLoad (stream, &archptr->crloval) != 1) ||
++      (archptr->crloval < 1)) {
+     errorPrint ("archDistArchLoad: bad input (1)");
+     return (1);
+   }
+@@ -102,6 +103,7 @@ FILE * restrict const       stream)
+     errorPrint ("archDistArchLoad: out of memory");
+     return (1);
+   }
++  archInit (dstarchptr);                          /* Sub-architecture can be freed even if not loaded */
+ 
+   if (archLoad (dstarchptr, stream) != 0) {       /* Load sub-architecture */
+     errorPrint ("archDistArchLoad: bad input (2)");
+@@ -109,6 +111,7 @@ FILE * restrict const       stream)
+     return (1);
+   }
+   archptr->archptr = dstarchptr;
++  archArch (archptr)->flagval |= dstarchptr->flagval & ~ARCHFREE; /* Inherit flags of sub-architecture, as archDistArchBuild() does */
+ 
+   return (0);
+ }
+@@ -159,8 +162,10 @@ ArchDist * const            archptr)
+ #endif /* SCOTCH_DEBUG_ARCH1 */
+ 
+   if ((archArch (archptr)->flagval & ARCHFREE) != 0) { /* If sub-architecture needs to be freed too */
+-    archFree (archptr->archptr);
+-    memFree  (archptr->archptr);
++    if (archptr->archptr != NULL) {
++      archFree (archptr->archptr);
++      memFree  (archptr->archptr);
++    }
+   }
+ 
+   return (0);
+@@ -183,7 +188,7 @@ const Anum                  crloval)
+ 
+   archInit (archptr);                             /* Initialize architecture body */
+   archptr->clasptr = archClass ("dist");          /* Set architecture class       */
+-  archptr->flagval = orgarchptr->flagval;         /* Set architecture flag        */
++  archptr->flagval = orgarchptr->flagval & ~ARCHFREE; /* Set architecture flag; original architecture is not owned */
+   archdataptr = (ArchDist *) (void *) &archptr->data;
+   archdataptr->archptr = orgarchptr;
+   archdataptr->crloval = crloval;
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0004-Add-odd-sized-complete-graph-architecture-to-test_sc.patch b/upstream/reports/7.0.18/series/0004-Add-odd-sized-complete-graph-architecture-to-test_sc.patch
