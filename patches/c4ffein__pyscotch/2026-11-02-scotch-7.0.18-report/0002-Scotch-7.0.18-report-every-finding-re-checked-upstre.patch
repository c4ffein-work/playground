+index a355e588..96d8ea7b 100644
+--- a/src/libscotch/bgraph_bipart_ga.c
++++ b/src/libscotch/bgraph_bipart_ga.c
+@@ -58,6 +58,7 @@
+ 
+ #include "module.h"
+ #include "common.h"
++#include "context.h"
+ #include "graph.h"
+ #include "arch.h"
+ #include "bgraph.h"
