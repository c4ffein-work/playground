diff --git a/upstream/reports/7.0.18/series/0060-Bugfix-fix-alias-test-of-halo-end-array-in-hmeshExit.patch b/upstream/reports/7.0.18/series/0060-Bugfix-fix-alias-test-of-halo-end-array-in-hmeshExit.patch
new file mode 100644
index 0000000..52151c7
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0060-Bugfix-fix-alias-test-of-halo-end-array-in-hmeshExit.patch
@@ -0,0 +1,35 @@
+From da1dfdddbc30e4262c10f83649a1103d2c2fc76f Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 12:59:26 +0000
+Subject: [PATCH 060/232] Bugfix: fix alias test of halo end array in
+ `hmeshExit()` [report PyScotch]
+
+`hmeshExit()` compared `vehdtax` with `m.vendtax + (baseval - velmbas)`
+to decide whether the halo end array is the mesh end array. The two
+based accesses are equal when they alias, as `hmeshCheck()` tests, so
+the offset form only matched for element-first meshes. For a node-first
+halo mesh whose `vehdtax` aliases a distinct `vendtab`, `hmeshExit()`
+freed `vendtab + velmbas`, an interior pointer, before `meshExit()`
+freed `vendtab` itself.
+
+Refs: PS2-G11-mesh-struct-io-4
+---
+ src/libscotch/hmesh.c | 2 +-
+ 1 file changed, 1 insertion(+), 1 deletion(-)
+
+diff --git a/src/libscotch/hmesh.c b/src/libscotch/hmesh.c
+index b835f1a1..45fb78b8 100644
+--- a/src/libscotch/hmesh.c
++++ b/src/libscotch/hmesh.c
+@@ -71,7 +71,7 @@ hmeshExit (
+ Hmesh * const               meshptr)
+ {
+   if ((meshptr->vehdtax != NULL) &&               /* Exit halo mesh data */
+-      (meshptr->vehdtax != (meshptr->m.vendtax + (meshptr->m.baseval - meshptr->m.velmbas))) &&
++      (meshptr->vehdtax != meshptr->m.vendtax) && /* If halo end array is distinct from mesh end array */
+       ((meshptr->m.flagval & MESHVERTGROUP) == 0))
+     memFree (meshptr->vehdtax + meshptr->m.velmbas);
+   meshExit (&meshptr->m);                         /* Exit mesh data */
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0061-Bugfix-count-fake-isolated-elements-in-hmeshMesh-rep.patch b/upstream/reports/7.0.18/series/0061-Bugfix-count-fake-isolated-elements-in-hmeshMesh-rep.patch
new file mode 100644
index 0000000..f7f6c5f
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0061-Bugfix-count-fake-isolated-elements-in-hmeshMesh-rep.patch
@@ -0,0 +1,62 @@
+From 2828faff084876b8e9467cdeeb466bbd7f12fefb Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 12:59:26 +0000
+Subject: [PATCH 061/232] Bugfix: count fake isolated elements in `hmeshMesh()`
+ [report PyScotch]
+
+When nodes are numbered before elements, `hmeshMesh()` turns halo nodes
+into empty "fake" element vertices, but neither `veisnbr` nor, for
+unweighted elements, `velosum` were increased accordingly, so the
+resulting mesh failed `meshCheck()` ("invalid number of isolated
+element vertices", then "invalid element vertex load sum"). Also name
+the routine properly in its error messages.
+
+Refs: PS2-G11-mesh-struct-io-2, SEP-21
+---
+ src/libscotch/hmesh_mesh.c | 9 ++++++---
+ 1 file changed, 6 insertions(+), 3 deletions(-)
+
+diff --git a/src/libscotch/hmesh_mesh.c b/src/libscotch/hmesh_mesh.c
+index ba4333a9..8f666b36 100644
+--- a/src/libscotch/hmesh_mesh.c
++++ b/src/libscotch/hmesh_mesh.c
+@@ -41,7 +41,7 @@
+ /**   DATES      : # Version 4.0  : from : 28 apr 2004     **/
+ /**                                 to   : 11 may 2004     **/
+ /**                # Version 7.0  : from : 20 jan 2023     **/
+-/**                                 to   : 08 oct 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /**   NOTES      : # From a given halo mesh is created a   **/
+ /**                  non-halo mesh. When nodes are         **/
+@@ -111,7 +111,7 @@ Mesh * restrict const         meshptr)            /*+ Mesh to build      +*/
+   meshptr->flagval = MESHFREEVEND;
+   if (hmshptr->m.velmbas <= hmshptr->m.vnodbas) { /* If elements numbered before nodes */
+     if ((meshptr->vendtax = memAlloc ((hmshptr->m.velmnbr + hmshptr->vnohnbr) * sizeof (Gnum))) == NULL) { /* Do not keep halo nodes at end of array */
+-      errorPrint ("hmeshHgraph: out of memory (1)");
++      errorPrint ("hmeshMesh: out of memory (1)");
+       return     (1);
+     }
+     memCpy (meshptr->vendtax, hmshptr->vehdtax + hmshptr->m.velmbas, hmshptr->m.velmnbr * sizeof (Gnum));
+@@ -123,7 +123,7 @@ Mesh * restrict const         meshptr)            /*+ Mesh to build      +*/
+   }
+   else {                                          /* If nodes numbered before elements */
+     if ((meshptr->vendtax = memAlloc ((hmshptr->m.velmnbr + hmshptr->m.vnodnbr) * sizeof (Gnum))) == NULL) { /* Turn halo nodes into empty elements */
+-      errorPrint ("hmeshHgraph: out of memory (2)");
++      errorPrint ("hmeshMesh: out of memory (2)");
+       return     (1);
+     }
+     memCpy (meshptr->vendtax, hmshptr->m.vendtax + hmshptr->m.baseval, hmshptr->vnohnbr * sizeof (Gnum)); /* Copy non-halo node part */
+@@ -131,6 +131,9 @@ Mesh * restrict const         meshptr)            /*+ Mesh to build      +*/
+     memCpy (meshptr->vendtax + hmshptr->m.vnodnbr, hmshptr->vehdtax + hmshptr->m.velmbas, hmshptr->m.velmnbr * sizeof (Gnum));
+ 
+     meshptr->velmnbr = hmshptr->m.velmnbr + hmshptr->m.vnodnbr - hmshptr->vnohnbr; /* Turn halo node vertices into element vertices */
++    meshptr->veisnbr = meshptr->veisnbr + hmshptr->m.vnodnbr - hmshptr->vnohnbr; /* Fake element vertices are isolated            */
++    if (meshptr->velotax == NULL)                 /* If elements are not weighted, fake element vertices have unit loads */
++      meshptr->velosum = meshptr->velosum + hmshptr->m.vnodnbr - hmshptr->vnohnbr;
+     meshptr->velmbas = hmshptr->vnohnnd;
+     meshptr->velmnnd = hmshptr->m.velmnnd;
+   }
+-- 
+2.43.0
+
