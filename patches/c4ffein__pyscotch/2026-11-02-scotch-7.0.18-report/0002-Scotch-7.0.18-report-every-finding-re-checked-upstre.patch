diff --git a/upstream/reports/7.0.18/series/0104-Bugfix-do-not-account-for-unmapped-vertices-in-SCOTC.patch b/upstream/reports/7.0.18/series/0104-Bugfix-do-not-account-for-unmapped-vertices-in-SCOTC.patch
new file mode 100644
index 0000000..2053c70
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0104-Bugfix-do-not-account-for-unmapped-vertices-in-SCOTC.patch
@@ -0,0 +1,64 @@
+From b3924456db63ee277593a9aef523411dc77dc6be Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 13:37:43 +0000
+Subject: [PATCH 104/232] Bugfix: do not account for unmapped vertices in
+ `SCOTCH_graphMapView()` [report PyScotch]
+
+Unmapped vertices have a part value of `-1`, which is also that of
+`ARCHDOMNOTTERM`; after sorting, they came first and ended the
+traversal of the domain label array immediately, so that the number
+of processors, target loads, neighbor counts and part diameters
+were all reported as zero whenever a single vertex was unmapped.
+Unmapped vertices now belong to no part and are not counted as
+neighbors, as in `SCOTCH_dgraphMapStat()`.
+
+Refs: PS2-G16-1
+---
+ src/libscotch/library_graph_map_view.c | 22 +++++++++++++++-------
+ 1 file changed, 15 insertions(+), 7 deletions(-)
+
+diff --git a/src/libscotch/library_graph_map_view.c b/src/libscotch/library_graph_map_view.c
+index 57549acf..0c73c088 100644
+--- a/src/libscotch/library_graph_map_view.c
++++ b/src/libscotch/library_graph_map_view.c
+@@ -300,14 +300,22 @@ FILE * const                  stream)             /*+ Output stream
+   }
+   pidxtax -= grafptr->baseval;
+ 
+-  for (vertnum = 0; vertnum < grafptr->vertnbr; vertnum ++) {
+-    domntab[vertnum].labl = parttax[vertnum];     /* Un-based array at this stage    */
+-    domntab[vertnum].peri = vertnum + grafptr->baseval; /* Build inverse permutation */
++  for (vertnum = 0, vertidx = 0; vertnum < grafptr->vertnbr; vertnum ++) {
++    Anum                partval;
++
++    partval = parttax[vertnum];                   /* Un-based array at this stage */
++    if (partval == ~0) {                          /* If vertex is not mapped      */
++      pidxtax[vertnum + grafptr->baseval] = ~0;   /* It belongs to no part        */
++      continue;
++    }
++    domntab[vertidx].labl = partval;
++    domntab[vertidx].peri = vertnum + grafptr->baseval; /* Build inverse permutation */
++    vertidx ++;
+   }
+-  domntab[grafptr->vertnbr].labl = ARCHDOMNOTTERM; /* TRICK: avoid testing (i+1)   */
+-  domntab[grafptr->vertnbr].peri = ~0;            /* Prevent Valgrind from yelling */
++  domntab[vertidx].labl = ARCHDOMNOTTERM;         /* TRICK: avoid testing (i+1)   */
++  domntab[vertidx].peri = ~0;                     /* Prevent Valgrind from yelling */
+ 
+-  intSort2asc2 (domntab, grafptr->vertnbr);       /* Sort domain label array by increasing target labels */
++  intSort2asc2 (domntab, vertidx);                /* Sort domain label array of mapped vertices by increasing target labels */
+ 
+   archDomFrst (archptr, &domnfrst);               /* Get architecture domain */
+   tgtnbr = archDomSize (archptr, &domnfrst);      /* Get architecture size   */
+@@ -381,7 +389,7 @@ FILE * const                  stream)             /*+ Output stream
+   nghbnbr = 0;
+   nghbmax = 0;
+   nghbsum = 0;
+-  nghbtab[0] = -2;
++  nghbtab[0] = ~0;                                /* TRICK: unmapped end vertices always match this sentinel */
+   if (mapnbr > 0) {
+     nghbmin = ANUMMAX;
+ 
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0105-Document-edge-load-sum-of-SCOTCH_graphStat-and-SCOTC.patch b/upstream/reports/7.0.18/series/0105-Document-edge-load-sum-of-SCOTCH_graphStat-and-SCOTC.patch
new file mode 100644
index 0000000..7cc9726
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0105-Document-edge-load-sum-of-SCOTCH_graphStat-and-SCOTC.patch
@@ -0,0 +1,47 @@
+From fa32a560f68a1a058d42fa4747c37038fb8fa283 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 13:38:50 +0000
+Subject: [PATCH 105/232] Document edge load sum of `SCOTCH_graphStat()` and
+ `SCOTCH_dgraphStat()`
+
+Since 5a711ca5, every edge is counted once in the sum of edge loads,
+whether the graph has edge loads or not. State it in the manuals,
+since edges are represented by two arcs.
+
+Refs: API-19
+---
+ doc/src/ptscotch/p_l.tex | 3 ++-
+ doc/src/scotch/s_l.tex   | 3 ++-
+ 2 files changed, 4 insertions(+), 2 deletions(-)
+
+diff --git a/doc/src/ptscotch/p_l.tex b/doc/src/ptscotch/p_l.tex
+index de5c1a03..6305b459 100644
+--- a/doc/src/ptscotch/p_l.tex
++++ b/doc/src/ptscotch/p_l.tex
+@@ -2564,7 +2564,8 @@ degree, the average vertex degree, and the variance of the vertex
+ degrees, respectively.
+ {\tt edlomin}, {\tt edlomax}, {\tt edlosum}, {\tt edloavg} and
+ {\tt edlodlt} are the minimum edge load, the maximum edge
+-load, the sum of all edge loads, the average edge load,
++load, the sum of all edge loads (every edge being counted once,
++although it is represented by two arcs), the average edge load,
+ and the variance of the edge loads, respectively.
+ 
+ \progret
+diff --git a/doc/src/scotch/s_l.tex b/doc/src/scotch/s_l.tex
+index 16cc2b01..fc6527b6 100644
+--- a/doc/src/scotch/s_l.tex
++++ b/doc/src/scotch/s_l.tex
+@@ -3771,7 +3771,8 @@ degree, the average vertex degree, and the variance of the vertex
+ degrees, respectively.
+ {\tt edlomin}, {\tt edlomax}, {\tt edlosum}, {\tt edloavg} and
+ {\tt edlodlt} are the minimum edge load, the maximum edge
+-load, the sum of all edge loads, the average edge load,
++load, the sum of all edge loads (every edge being counted once,
++although it is represented by two arcs), the average edge load,
+ and the variance of the edge loads, respectively.
+ \end{itemize}
+ 
+-- 
+2.43.0
+
