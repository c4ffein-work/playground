diff --git a/upstream/reports/7.0.18/series/0222-Bugfix-free-strategy-and-architecture-in-test_scotch.patch b/upstream/reports/7.0.18/series/0222-Bugfix-free-strategy-and-architecture-in-test_scotch.patch
