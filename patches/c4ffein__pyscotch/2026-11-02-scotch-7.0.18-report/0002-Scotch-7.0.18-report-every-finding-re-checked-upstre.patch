+-/**                                 to   : 08 feb 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -400,7 +400,11 @@ const double                balrat)               /*+ Desired imbalance ratio
+   vertnbr = MAX (2000 * procnbr, 10000);
+   vertnbr = MIN (vertnbr, 1000000);
+ 
+-  sprintf (bbaltab, "%lf", balrat);
++  if ((! isfinite (balrat)) || (balrat < 0.0) ||  /* Reject non-finite or negative ratios that would not parse or overflow */
++      (snprintf (bbaltab, sizeof (bbaltab), "%lf", balrat) >= (int) sizeof (bbaltab))) {
++    errorPrint (STRINGIFY (SCOTCH_stratDgraphOrderBuild) ": invalid imbalance ratio");
++    return (1);
++  }
+   sprintf (levltab, GNUMSTRING, levlnbr);
+   sprintf (verttab, GNUMSTRING, vertnbr);
+ 
+diff --git a/src/libscotch/library_graph_map.c b/src/libscotch/library_graph_map.c
+index 49d052c8..faf4bc2b 100644
+--- a/src/libscotch/library_graph_map.c
