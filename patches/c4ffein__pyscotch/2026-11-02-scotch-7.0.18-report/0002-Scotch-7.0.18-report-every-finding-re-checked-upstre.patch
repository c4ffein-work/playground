index 0000000..c8c55e2
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0010-Bugfix-check-permutation-sizes-of-labeled-tree-leaf-.patch
@@ -0,0 +1,65 @@
+From 54cbcfc7c0d46ef4feb12ac700d223ec025cfaa1 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 08:36:35 +0000
+Subject: [PATCH 010/232] Bugfix: check permutation sizes of labeled tree-leaf
+ architectures properly [report R. Perry]
+
+The loop of `archLtleafArchLoad()` that checks that the permutation
+size matches a level boundary read the size of level -1, before the
+array, when it did not. Also, `SCOTCH_archLtleaf()` did not perform
+this check, nor did it reject non-positive permutation sizes, so that
+permutations that did not span whole subtrees were accepted, and later
+caused out-of-bounds reads when mapping.
+
+Refs: COR-06, API-10
+---
+ src/libscotch/arch_tleaf.c   |  4 ++--
+ src/libscotch/library_arch.c | 17 +++++++++++++++++
+ 2 files changed, 19 insertions(+), 2 deletions(-)
+
+diff --git a/src/libscotch/arch_tleaf.c b/src/libscotch/arch_tleaf.c
+index 810dc72b..d9738aca 100644
+--- a/src/libscotch/arch_tleaf.c
++++ b/src/libscotch/arch_tleaf.c
+@@ -703,8 +703,8 @@ FILE * restrict const       stream)
+     Anum                sizeval;
+ 
+     for (levlnum = archptr->levlnbr - 1, sizeval = archptr->sizetab[levlnum];
+-         sizeval != archptr->permnbr; levlnum --, sizeval *= archptr->sizetab[levlnum]) {
+-      if (levlnum < 0) {
++         sizeval != archptr->permnbr; sizeval *= archptr->sizetab[levlnum]) {
++      if (-- levlnum < 0) {                       /* Check level number before using it */
+         errorPrint ("archLtleafArchLoad: permutation size does not match level boundaries");
+         return (1);
+       }
+diff --git a/src/libscotch/library_arch.c b/src/libscotch/library_arch.c
+index 01fb0364..8e780c63 100644
+--- a/src/libscotch/library_arch.c
++++ b/src/libscotch/library_arch.c
+@@ -614,6 +614,23 @@ const SCOTCH_Num * const    permtab)              /*+ Permutation array
+   tgtarchdatptr       = (ArchTleaf *) (void *) (&tgtarchptr->data);
+   tgtarchptr->clasptr = archClass ("ltleaf");     /* Override class */
+ 
++  if (permnbr < 1) {
++    errorPrint (STRINGIFY (SCOTCH_archLtleaf) ": invalid number of permutation indices");
++    goto fail;
++  }
++  if (permnbr != 1) {                             /* Valid empty permutation is of size 1 */
++    Anum                levlnum;
++    Anum                sizeval;
++
++    for (levlnum = tgtarchdatptr->levlnbr - 1, sizeval = tgtarchdatptr->sizetab[levlnum];
++         sizeval != permnbr; sizeval *= tgtarchdatptr->sizetab[levlnum]) {
++      if (-- levlnum < 0) {
++        errorPrint (STRINGIFY (SCOTCH_archLtleaf) ": permutation size does not match level boundaries");
++        goto fail;
++      }
++    }
++  }
++
+   if ((tgtarchdatptr->permtab = memAlloc (permnbr * 2 * sizeof (Anum))) == NULL) { /* TRICK: space for peritab too */
+     errorPrint (STRINGIFY (SCOTCH_archLtleaf) ": out of memory");
+ fail:
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0011-Bugfix-shift-architecture-sized-values-not-ints-by-h.patch b/upstream/reports/7.0.18/series/0011-Bugfix-shift-architecture-sized-values-not-ints-by-h.patch
new file mode 100644
index 0000000..3c3b7f4
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0011-Bugfix-shift-architecture-sized-values-not-ints-by-h.patch
@@ -0,0 +1,451 @@
+From 40c80507046ebf3a3720389a3bf208620887ce3f Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 13:09:54 +0000
+Subject: [PATCH 011/232] Bugfix: shift architecture-sized values, not ints, by
+ hypercube dimensions [report R. Perry]
+
+The number of vertices, the terminal domain bound, the domain size and
+the bipartition bit of hypercube architectures were computed as
+`1 << n`, which is undefined for n >= 31 whatever the size of `Anum`,
+so that 64-bit builds, in which `archHcubArchLoad()` and
+`SCOTCH_archHcub()` accept dimensions up to 62, produced garbage
+sizes. The same int shifts sized the multinode arrays of
+sub-architecture and decomposition-defined architecture matchings, the
+terminal hash table of `kgraphBand()`, the vertex count of
+distributed hypercube graphs, and the vertex and terminal numbers of
+the `amk_ccc`, `amk_fft2`, `amk_hy`, `gmk_hy` and `gmk_ub2`
+generators, which bounded their dimension from below only.
+
+Shift a value of the target type everywhere, make `SCOTCH_archHcub()`
+reject non-positive dimensions, as `archHcubArchLoad()` does, and bound
+the dimension of each generator so that all of the values it computes
+fit in a `SCOTCH_Num`.
+
+Refs: COR-19, PS-API-3, API-10, CLI-24
+---
