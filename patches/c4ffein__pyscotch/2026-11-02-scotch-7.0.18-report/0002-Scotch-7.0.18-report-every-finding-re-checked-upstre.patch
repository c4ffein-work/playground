diff --git a/upstream/reports/7.0.18/series/0208-Bugfix-do-not-export-internal-compile-definitions-of.patch b/upstream/reports/7.0.18/series/0208-Bugfix-do-not-export-internal-compile-definitions-of.patch
new file mode 100644
index 0000000..09f134d
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0208-Bugfix-do-not-export-internal-compile-definitions-of.patch
@@ -0,0 +1,54 @@
+From 3d9ddec58948e28ba0c2bec6a834d7b5d1e02f22 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 16:08:34 +0000
+Subject: [PATCH 208/232] Bugfix: do not export internal compile definitions of
+ libScotch to CMake users [report R. Perry]
+
+COMMON_RANDOM_FIXED_SEED, SCOTCH_DETERMINISTIC and, on FreeBSD,
+cpu_set_t=cpuset_t and __BSD_VISIBLE were PUBLIC compile definitions
+of the "scotch" target, hence were recorded in the installed
+"scotchTargets.cmake" and added to the compilation flags of every
+program using `find_package(SCOTCH)`: a type renaming macro and a
+change of header visibility for user code.
+
+These definitions are only needed within the build tree, by the
+programs and tests that include internal header files. Restrict them
+to it with the BUILD_INTERFACE generator expression, as is already
+done for the include directories.
+
+Refs: BLD-24
+---
+ src/libscotch/CMakeLists.txt | 11 +++++++----
+ 1 file changed, 7 insertions(+), 4 deletions(-)
+
+diff --git a/src/libscotch/CMakeLists.txt b/src/libscotch/CMakeLists.txt
+index 3b1162a2..a80be8fb 100644
+--- a/src/libscotch/CMakeLists.txt
++++ b/src/libscotch/CMakeLists.txt
+@@ -537,16 +537,19 @@ if(APPLE)
+   set_target_properties(scotch PROPERTIES LINK_FLAGS "-undefined dynamic_lookup")
+ endif()
+ 
++# The following definitions are needed by all the targets of the build
++# tree, which include internal header files, but must not be exported
++# to the users of the installed library.
+ if(OS_IS_FREEBSD)
+-  target_compile_definitions(scotch PUBLIC cpu_set_t=cpuset_t __BSD_VISIBLE)
++  target_compile_definitions(scotch PUBLIC $<BUILD_INTERFACE:cpu_set_t=cpuset_t> $<BUILD_INTERFACE:__BSD_VISIBLE>)
+ endif()
+ 
+ if(SCOTCH_DETERMINISTIC STREQUAL FULL)
+-  target_compile_definitions(scotch PUBLIC COMMON_RANDOM_FIXED_SEED)
+-  target_compile_definitions(scotch PUBLIC SCOTCH_DETERMINISTIC)
++  target_compile_definitions(scotch PUBLIC $<BUILD_INTERFACE:COMMON_RANDOM_FIXED_SEED>)
++  target_compile_definitions(scotch PUBLIC $<BUILD_INTERFACE:SCOTCH_DETERMINISTIC>)
+   message(STATUS "Determinism: full")
+ elseif(SCOTCH_DETERMINISTIC STREQUAL FIXED_SEED)
+-  target_compile_definitions(scotch PUBLIC COMMON_RANDOM_FIXED_SEED)
++  target_compile_definitions(scotch PUBLIC $<BUILD_INTERFACE:COMMON_RANDOM_FIXED_SEED>)
+   message(STATUS "Determinism: fixed random seed")
+ else()
+   message(STATUS "Determinism: none")
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0209-Bugfix-detect-Open-MPI-when-configuring-CMake-tests-.patch b/upstream/reports/7.0.18/series/0209-Bugfix-detect-Open-MPI-when-configuring-CMake-tests-.patch
new file mode 100644
index 0000000..c565816
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0209-Bugfix-detect-Open-MPI-when-configuring-CMake-tests-.patch
@@ -0,0 +1,48 @@
+From 6ec298a7a308d36b691f6cb78ae8bf97b9e8e145 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 16:08:34 +0000
+Subject: [PATCH 209/232] Bugfix: detect Open MPI when configuring CMake tests
+ [report R. Perry]
+
+The regular expression used to detect Open MPI required a space before
+and after "Open MPI", whereas the library version string begins with
+"Open MPI v...". Hence, Open MPI was never detected, the
+"--oversubscribe" flag was never added to MPIEXEC_PREFLAGS, and the
+MPI tests failed for lack of slots on hosts with fewer cores than
+requested processes.
+
+Also, `if(NOT ${found_suite} STREQUAL "")` was expanded with an empty,
+unquoted operand when nothing matched, and `string(REGEX MATCHALL)`
+failed with a fatal error when the version string was empty. Use
+plain `if(... MATCHES ...)` tests for Open MPI and for Intel MPI.
+
+Refs: BLD-06
+Refs: PS-BLD-2
+---
+ src/CMakeLists.txt | 8 +++-----
+ 1 file changed, 3 insertions(+), 5 deletions(-)
+
+diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
+index 323d8bf3..9f17b845 100644
+--- a/src/CMakeLists.txt
++++ b/src/CMakeLists.txt
+@@ -178,13 +178,11 @@ if(BUILD_PTSCOTCH)
+   if(NOT MPI_C_FOUND)
+     message(FATAL_ERROR "MPI required to compile PT-Scotch\n Rerun cmake with -DBUILD_PTSCOTCH=OFF")
+   else()
+-    string(REGEX MATCHALL "\( Open MPI \)+" found_suite ${MPI_C_LIBRARY_VERSION_STRING})
+-    if(NOT ${found_suite} STREQUAL "")
+-      message(STATUS "Found OpenMPI: using '--oversubscribe' policy for testing")
++    if(MPI_C_LIBRARY_VERSION_STRING MATCHES "Open MPI")
++      message(STATUS "Found Open MPI: using '--oversubscribe' policy for testing")
+       set(MPIEXEC_PREFLAGS ${MPIEXEC_PREFLAGS} --oversubscribe)
+     endif()
+-    string(REGEX MATCHALL "\(Intel\)+" found_suite ${MPI_C_LIBRARY_VERSION_STRING})
+-    if(NOT ${found_suite} STREQUAL "")
++    if(MPI_C_LIBRARY_VERSION_STRING MATCHES "Intel")
+       message(STATUS "Found Intel MPI: using '-genv=I_MPI_PIN_DOMAIN=core' for testing")
+       set(MPIEXEC_PREFLAGS ${MPIEXEC_PREFLAGS} -genv=I_MPI_PIN_DOMAIN=core)
+     endif()
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0210-Bugfix-link-all-object-files-into-libraries-in-Makef.patch b/upstream/reports/7.0.18/series/0210-Bugfix-link-all-object-files-into-libraries-in-Makef.patch
new file mode 100644
index 0000000..e7a72be
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0210-Bugfix-link-all-object-files-into-libraries-in-Makef.patch
@@ -0,0 +1,72 @@
+From 3ad5b674a2e48bcb14366f6ace246106fa01ede5 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 16:08:03 +0000
+Subject: [PATCH 210/232] Bugfix: link all object files into libraries in
+ Makefile's [report PyScotch]
+
+The library rules of "libscotch/Makefile" and "esmumps/Makefile" pass
+"$(?)" to "$(AR)", that is, only the object files that are newer than
+the library. This is the archive idiom for "ar -ru", but with the
+"*.shlib" Makefile.inc's, where "$(AR)" is "gcc" and "$(ARFLAGS)" is
+"-shared -o", an incremental build after a source change produces a
+shared library that contains only the recompiled objects, and every
+program then fails to link against it. Use "$(^)" instead, as
+"libscotchmetis/Makefile" already does, which is correct for both
+static archives and shared libraries.
+---
+ src/esmumps/Makefile   |  2 +-
+ src/libscotch/Makefile | 12 ++++++------
+ 2 files changed, 7 insertions(+), 7 deletions(-)
+
+diff --git a/src/esmumps/Makefile b/src/esmumps/Makefile
+index a4803d59..33e154d2 100644
+--- a/src/esmumps/Makefile
++++ b/src/esmumps/Makefile
+@@ -203,7 +203,7 @@ symbol_fax_graph$(OBJ)		:	symbol_fax_graph.c			\
+ 					fax.h
+ 
+ libesmumps$(LIB)		:	$(LIBESMUMPSDEPS)
+-					$(AR) $(ARFLAGS) $(@) $(?)
++					$(AR) $(ARFLAGS) $(@) $(^)
+ 					-$(RANLIB) $(@)
+ 
+ test_esmumps$(EXE)		:	test_esmumps.c				\
+diff --git a/src/libscotch/Makefile b/src/libscotch/Makefile
+index 23405700..c6d7f904 100644
+--- a/src/libscotch/Makefile
++++ b/src/libscotch/Makefile
+@@ -3581,25 +3581,25 @@ ptscotchf.h			:	ptdummysizes$(EXE)			\
+ 					./ptdummysizes$(EXE) -s$(SCOTCH_NAME_SUFFIX) library_pt_f.h ptscotchf.h
+ 
+ libscotch$(LIB)			:	$(LIBSCOTCHDEPS)
+-					$(AR) $(ARFLAGS) $(@) $(?)
++					$(AR) $(ARFLAGS) $(@) $(^)
+ 					-$(RANLIB) $(@)
+ 
+ libscotcherr$(LIB)		:	library_error$(OBJ)
+-					$(AR) $(ARFLAGS) $(@) $(?)
++					$(AR) $(ARFLAGS) $(@) $(^)
+ 					-$(RANLIB) $(@)
+ 
+ libscotcherrexit$(LIB)		:	library_error_exit$(OBJ)
+-					$(AR) $(ARFLAGS) $(@) $(?)
++					$(AR) $(ARFLAGS) $(@) $(^)
+ 					-$(RANLIB) $(@)
+ 
+ libptscotch$(LIB)		:	$(LIBPTSCOTCHDEPS)
+-					$(AR) $(ARFLAGS) $(@) $(?)
++					$(AR) $(ARFLAGS) $(@) $(^)
+ 					-$(RANLIB) $(@)
+ 
+ libptscotcherr$(LIB)		:	library_error_pt$(OBJ)
+-					$(AR) $(ARFLAGS) $(@) $(?)
++					$(AR) $(ARFLAGS) $(@) $(^)
+ 					-$(RANLIB) $(@)
+ 
+ libptscotcherrexit$(LIB)	:	library_error_exit_pt$(OBJ)
+-					$(AR) $(ARFLAGS) $(@) $(?)
++					$(AR) $(ARFLAGS) $(@) $(^)
+ 					-$(RANLIB) $(@)
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0211-Bugfix-add-missing-dependencies-in-Makefile-s-report.patch b/upstream/reports/7.0.18/series/0211-Bugfix-add-missing-dependencies-in-Makefile-s-report.patch
