+ 
+   if (SCOTCH_archCmplt (&archtab[archnbr ++], 8) != 0) {
+-    SCOTCH_errorPrint ("main: cannot create cmplt architecture");
++    SCOTCH_errorPrint ("main: cannot create cmplt architecture (1)");
++    exit (EXIT_FAILURE);
++  }
++
++  if (SCOTCH_archCmplt (&archtab[archnbr ++], 9) != 0) { /* Odd number of vertices to exercise alternate matching passes */
++    SCOTCH_errorPrint ("main: cannot create cmplt architecture (2)");
+     exit (EXIT_FAILURE);
+   }
+ 
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0005-Bugfix-build-sub-architectures-made-of-a-single-term.patch b/upstream/reports/7.0.18/series/0005-Bugfix-build-sub-architectures-made-of-a-single-term.patch
new file mode 100644
index 0000000..5f24eca
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0005-Bugfix-build-sub-architectures-made-of-a-single-term.patch
@@ -0,0 +1,99 @@
+From 491a2a116c800fa03aa66971aac1cd58fbb2c7ea Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 09:37:38 +0000
+Subject: [PATCH 005/232] Bugfix: build sub-architectures made of a single
+ terminal vertex [report PyScotch]
+
+`archSubArchBuild2()` stops coarsening when it is given a single fine
+vertex, and returns the first slot of the array as the root of the
+coarsening tree. Its callers passed it the number of kept terminal
+vertices, so that, at the finest level, where arrays are indexed by
+original vertex numbers, a sub-architecture made of a single terminal
+vertex other than vertex 0 was rooted at an empty slot. Hence,
+`archSubArchBuild()` failed with an internal error on such "sub"
+target files and `SCOTCH_archSub()` calls, and `archDeco2BuildBuild3()`
+wrote out of bounds on such `SCOTCH_archBuild2()` calls.
+
+Pass the number of original vertices instead, in `archSubArchBuild()`
+and in `archDeco2ArchBuild()`, and add a single-vertex sub-architecture
+to `test_scotch_arch`.
+
+Refs: PS2-G01-arch-sub-dist-1
+---
+ src/check/test_scotch_arch.c     | 9 +++++++--
+ src/libscotch/arch_deco2_build.c | 4 ++--
+ src/libscotch/arch_sub.c         | 2 +-
+ 3 files changed, 10 insertions(+), 5 deletions(-)
+
+diff --git a/src/check/test_scotch_arch.c b/src/check/test_scotch_arch.c
+index df351900..937c4ccf 100644
+--- a/src/check/test_scotch_arch.c
++++ b/src/check/test_scotch_arch.c
+@@ -61,7 +61,7 @@
+ 
+ #include "scotch.h"
+ 
+-#define ARCHNBR                     26
++#define ARCHNBR                     27
+ 
+ /*********************/
+ /*                   */
+@@ -156,7 +156,7 @@ char *              argv[])
+     exit (EXIT_FAILURE);
+   }
+ 
+-  if ((archnbr * 2) > ARCHNBR) {
++  if (((archnbr * 2) + 1) > ARCHNBR) {
+     SCOTCH_errorPrint ("main: internal error");
+     exit (EXIT_FAILURE);
+   }
+@@ -169,6 +169,11 @@ char *              argv[])
+   }
