+ src/check/test_common_file_compress.c  | 25 ++++++++-----
+ src/libscotch/common_file.c            |  6 ++--
+ src/libscotch/common_file_compress.c   | 50 ++++++++++++++++----------
+ src/libscotch/common_file_compress.h   |  6 ++--
+ src/libscotch/common_file_decompress.c | 46 ++++++++++++++----------
+ 7 files changed, 94 insertions(+), 51 deletions(-)
+
+diff --git a/src/check/CMakeLists.txt b/src/check/CMakeLists.txt
+index dba3d930..c9d6ae5a 100644
+--- a/src/check/CMakeLists.txt
++++ b/src/check/CMakeLists.txt
+@@ -123,6 +123,9 @@ foreach(ext "bz2" "gz" "lzma")
