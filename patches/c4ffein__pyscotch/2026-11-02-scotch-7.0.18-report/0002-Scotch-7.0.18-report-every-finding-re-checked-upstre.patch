+-	if (d[0] <= 2) {                          /* Remove ascending arcs if duplicates */
+-          cbitval &= ~(4 + 32 + 256);
+-          if (d[0] <= 1)                          /* Remove descending arcs if no width */
+-            cbitval &= ~(1 + 8 + 64);
+-        }
+-        if (d[1] <= 2) {
+-          cbitval &= ~(64 + 128 + 256);
+-          if (d[1] <= 1)
