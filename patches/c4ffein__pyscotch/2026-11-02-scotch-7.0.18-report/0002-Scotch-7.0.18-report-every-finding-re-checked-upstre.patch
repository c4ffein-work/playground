diff --git a/upstream/reports/7.0.18/series/0017-Bugfix-reject-strategy-values-for-non-strategy-param.patch b/upstream/reports/7.0.18/series/0017-Bugfix-reject-strategy-values-for-non-strategy-param.patch
new file mode 100644
index 0000000..5ad6df4
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0017-Bugfix-reject-strategy-values-for-non-strategy-param.patch
@@ -0,0 +1,47 @@
+From 0716c9a8a7bba0b504e8abd678e0b0df724f48ee Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 09:19:59 +0000
+Subject: [PATCH 017/232] Bugfix: reject strategy values for non-strategy
+ parameters [report R. Perry]
+
+The grammar accepted a (possibly empty) strategy as the value of any
+method parameter, and stored the `Strat` pointer over the parameter
+slot whatever its type: `m{vert=}` or `m{vert=/(vert>1)?f;g}` silently
+corrupted the method data (8-byte store over an `INT` slot) and leaked
+the sub-strategy. Check the parameter type before parsing the
+sub-strategy, and report an invalid parameter value through the
+existing error rule.
+
+Refs: COR-22
+---
+ src/libscotch/parser_yy.y | 7 +++++--
+ 1 file changed, 5 insertions(+), 2 deletions(-)
+
+diff --git a/src/libscotch/parser_yy.y b/src/libscotch/parser_yy.y
+index 37994f87..0b3833c7 100644
+--- a/src/libscotch/parser_yy.y
++++ b/src/libscotch/parser_yy.y
+@@ -52,7 +52,7 @@
+ /**                # Version 6.0  : from : 30 sep 2014     **/
+ /**                                 to   : 27 apr 2018     **/
+ /**                # Version 7.0  : from : 02 mar 2018     **/
+-/**                                 to   : 25 sep 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -457,7 +457,10 @@ PARAMVAL      : VALCASE
+               }
+               |
+               {
+-                ($<SAVE>$).strat = penvptr->straptr;
++                if (penvptr->paraptr->typeval != STRATPARAMSTRAT) /* If parameter cannot hold a strategy */
++                  YYERROR;                        /* Report invalid parameter value         */
++
++                ($<SAVE>$).strat = penvptr->straptr; /* Save current method and parameter */
+                 ($<SAVE>$).param = penvptr->paraptr;
+                 penvptr->straptr = NULL;
+                 penvptr->paraptr = NULL;
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0018-Bugfix-restore-parser-context-before-reporting-a-syn.patch b/upstream/reports/7.0.18/series/0018-Bugfix-restore-parser-context-before-reporting-a-syn.patch
new file mode 100644
index 0000000..fae89bb
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0018-Bugfix-restore-parser-context-before-reporting-a-syn.patch
@@ -0,0 +1,68 @@
+From d82dfb40d441cdabc9c977cc623860f366313430 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 09:24:35 +0000
+Subject: [PATCH 018/232] Bugfix: restore parser context before reporting a
+ syntax error within a nested strategy [report R. Perry]
+
+A syntax error inside a strategy-valued parameter is caught by the
+`error` alternative of `PARAMVAL` after the mid-rule action that
+introduces the sub-strategy has cleared `penvptr->straptr` and
+`penvptr->paraptr`; the error message dereferences both, which crashes
+on strings such as `r{sep=m{asc=b{:width=3}}}`. The saved context
+cannot be restored by the final action, because Bison discards the
+mid-rule value when it pops the stack during error recovery.
+
+Type the mid-rule value and attach a `%destructor` to it, so that the
+saved method and parameter are restored whenever the sub-strategy is
+discarded, and the error rule always reports the right parameter.
+
+Refs: COR-01
+---
+ src/libscotch/parser_yy.y | 15 ++++++++++-----
+ 1 file changed, 10 insertions(+), 5 deletions(-)
+
+diff --git a/src/libscotch/parser_yy.y b/src/libscotch/parser_yy.y
+index 0b3833c7..fde00aa2 100644
+--- a/src/libscotch/parser_yy.y
++++ b/src/libscotch/parser_yy.y
+@@ -137,6 +137,11 @@ YY_DECL;                                          /* Definition of yylex(); Flex
+ %type <STRAT>        STRATCONCAT   STRATTEST     STRATTESTELSE STRATEMPTY
+ %type <STRAT>        STRATGROUP    STRATMETHOD   STRATSELECT
+ 
++%destructor {                                     /* Restore parser context when sub-strategy is discarded by error recovery */
++  penvptr->straptr = ($$).strat;
++  penvptr->paraptr = ($$).param;
++} <SAVE>
++
+ %start STRAT
+ 
+ %%
+@@ -455,20 +460,20 @@ PARAMVAL      : VALCASE
+                           ($1));
+                 }
+               }
+-              |
++              | <SAVE>
+               {
+                 if (penvptr->paraptr->typeval != STRATPARAMSTRAT) /* If parameter cannot hold a strategy */
+                   YYERROR;                        /* Report invalid parameter value         */
+ 
+-                ($<SAVE>$).strat = penvptr->straptr; /* Save current method and parameter */
+-                ($<SAVE>$).param = penvptr->paraptr;
++                ($$).strat = penvptr->straptr;    /* Save current method and parameter; typed value is restored by destructor on error */
++                ($$).param = penvptr->paraptr;
+                 penvptr->straptr = NULL;
+                 penvptr->paraptr = NULL;
+               }
+                 STRATSELECT
+               {
+-                penvptr->straptr = ($<SAVE>1).strat; /* Restore current method    */
+-                penvptr->paraptr = ($<SAVE>1).param; /* Restore current parameter */
++                penvptr->straptr = ($1).strat;    /* Restore current method    */
++                penvptr->paraptr = ($1).param;    /* Restore current parameter */
+ 
+                 if ((penvptr->paraptr->typeval & STRATPARAMDEPRECATED) == 0) { /* If parameter is not deprecated */
+ #ifdef SCOTCH_DEBUG_PARSER2
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0019-Bugfix-free-partially-built-strategy-trees-on-parsin.patch b/upstream/reports/7.0.18/series/0019-Bugfix-free-partially-built-strategy-trees-on-parsin.patch
new file mode 100644
index 0000000..2f2d22d
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0019-Bugfix-free-partially-built-strategy-trees-on-parsin.patch
@@ -0,0 +1,69 @@
+From eef646ab9f2b8ab4f9b9add14d7fe33cdb7eee60 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 09:27:54 +0000
+Subject: [PATCH 019/232] Bugfix: free partially built strategy trees on
+ parsing error [report R. Perry]
+
+Bison discards the semantic values of the symbols it pops during error
+recovery and on `YYABORT`, but the grammar had no `%destructor`, so the
+strategy and test sub-trees held by these values leaked. Method nodes
+being built were only freed at the outermost level: the ones of
+enclosing methods, saved by the mid-rule action of strategy-valued
+parameters, were lost as well.
+
+Add destructors for `<STRAT>` and `<TEST>` values, and make the
+`<SAVE>` destructor free the method node being built before restoring
+the enclosing one, so that `stratParserParse()` only has to free the
+outermost node (or the completed tree). The manual frees that precede
+`YYABORT` within actions remain necessary, as Bison does not destroy
+the right-hand side of the rule being reduced; add the missing one to
+the debug-mode internal error path.
+
+Refs: COR-23
+---
+ src/libscotch/parser_yy.y | 12 ++++++++++--
+ 1 file changed, 10 insertions(+), 2 deletions(-)
+
+diff --git a/src/libscotch/parser_yy.y b/src/libscotch/parser_yy.y
+index fde00aa2..dd838945 100644
+--- a/src/libscotch/parser_yy.y
++++ b/src/libscotch/parser_yy.y
+@@ -138,9 +138,16 @@ YY_DECL;                                          /* Definition of yylex(); Flex
+ %type <STRAT>        STRATGROUP    STRATMETHOD   STRATSELECT
+ 
+ %destructor {                                     /* Restore parser context when sub-strategy is discarded by error recovery */
++  stratExit (penvptr->straptr);                   /* Free discarded method node being built, if any                          */
+   penvptr->straptr = ($$).strat;
+   penvptr->paraptr = ($$).param;
+ } <SAVE>
++%destructor {                                     /* Free partial strategy trees discarded by error recovery or abort */
++  stratExit ($$);
++} <STRAT>
++%destructor {
++  stratTestExit ($$);
++} <TEST>
+ 
+ %start STRAT
+ 
+@@ -479,6 +486,7 @@ PARAMVAL      : VALCASE
+ #ifdef SCOTCH_DEBUG_PARSER2
+                   if (((penvptr->paraptr->doffptr - penvptr->paraptr->dbasptr) + sizeof (Strat *)) > sizeof (StratNodeMethodData)) {
+                     errorPrint ("stratParserParse: internal error (5)");
++                    stratExit  ($2);
+                     YYABORT;
+                   }
+ #endif /* SCOTCH_DEBUG_PARSER2 */
+@@ -829,8 +837,8 @@ const char * const          textptr)              /*+ Strategy string to parse
+   stratParserLexBufDelete (buffdat, scandat);
+   stratParserLexDestroy   (scandat);
+ 
+-  if (o != 0) {
+-    if (penvdat.straptr != NULL)
++  if (o != 0) {                                   /* On error, free method node being built or completed strategy tree */
++    if (penvdat.straptr != NULL)                  /* Partial trees held by the parser stack have already been freed    */
+       stratExit (penvdat.straptr);
+     return (NULL);
+   }
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0020-Bugfix-free-previous-value-of-a-strategy-parameter-t.patch b/upstream/reports/7.0.18/series/0020-Bugfix-free-previous-value-of-a-strategy-parameter-t.patch
new file mode 100644
index 0000000..1314d25
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0020-Bugfix-free-previous-value-of-a-strategy-parameter-t.patch
@@ -0,0 +1,44 @@
+From 494838ec8f68807140c55d1ed12b759c849e01e9 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 09:29:10 +0000
+Subject: [PATCH 020/232] Bugfix: free previous value of a strategy parameter
+ that is set twice [report PyScotch]
+
+When a strategy-valued parameter was given several times in a method,
+as in `m{asc=b,asc=b}`, the second sub-strategy overwrote the pointer
+to the first one, which leaked.
+
+Refs: PS2-G04-strategy-parser-1
+---
+ src/libscotch/parser_yy.y | 8 ++++++--
+ 1 file changed, 6 insertions(+), 2 deletions(-)
+
+diff --git a/src/libscotch/parser_yy.y b/src/libscotch/parser_yy.y
+index dd838945..d7ed1631 100644
+--- a/src/libscotch/parser_yy.y
++++ b/src/libscotch/parser_yy.y
+@@ -483,6 +483,8 @@ PARAMVAL      : VALCASE
+                 penvptr->paraptr = ($1).param;    /* Restore current parameter */
+ 
+                 if ((penvptr->paraptr->typeval & STRATPARAMDEPRECATED) == 0) { /* If parameter is not deprecated */
++                  Strat **            slotptr;    /* Pointer to strategy parameter slot */
++
+ #ifdef SCOTCH_DEBUG_PARSER2
+                   if (((penvptr->paraptr->doffptr - penvptr->paraptr->dbasptr) + sizeof (Strat *)) > sizeof (StratNodeMethodData)) {
+                     errorPrint ("stratParserParse: internal error (5)");
+@@ -491,8 +493,10 @@ PARAMVAL      : VALCASE
+                   }
+ #endif /* SCOTCH_DEBUG_PARSER2 */
+ 
+-                  *((Strat **) ((byte *) &penvptr->straptr->data.methdat.datadat +
+-                                (penvptr->paraptr->doffptr - penvptr->paraptr->dbasptr))) = ($2);
++                  slotptr = (Strat **) ((byte *) &penvptr->straptr->data.methdat.datadat +
++                                        (penvptr->paraptr->doffptr - penvptr->paraptr->dbasptr));
++                  stratExit (*slotptr);           /* Free previous value of parameter, if any */
++                  *slotptr = ($2);
+                 }
+               }
+               | error
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0021-Bugfix-parenthesize-operands-of-saved-strategy-test-.patch b/upstream/reports/7.0.18/series/0021-Bugfix-parenthesize-operands-of-saved-strategy-test-.patch
new file mode 100644
index 0000000..57204b0
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0021-Bugfix-parenthesize-operands-of-saved-strategy-test-.patch
@@ -0,0 +1,94 @@
+From dab09b46070e8ee7b8128cee7a99921bb8734784 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 08:10:01 +0000
+Subject: [PATCH 021/232] Bugfix: parenthesize operands of saved strategy test
+ expressions [report R. Perry]
+
+Since 088a1279, `stratTestSave()` parenthesizes operands of lower
+priority than their operator, but it compared the positions of the
+operators in the `StratTestType` enumeration, which are not the
+priorities of the grammar: '+' and '-' have the same priority, and
+'%' binds tighter than '*'. Also, a right operand of the same priority
+must be parenthesized, since all operators are left-associative. Hence,
+`a-(b-c)` or `a%(b%c)` were saved as `a-b-c` and `a%b%c`, which
+re-parse with another meaning. Use a priority table that follows the
+grammar, and parenthesize right operands of the same priority.
+
+Refs: COR-13
+---
+ src/libscotch/parser.c |  7 ++++---
+ src/libscotch/parser.h | 10 +++++-----
+ 2 files changed, 9 insertions(+), 8 deletions(-)
+
+diff --git a/src/libscotch/parser.c b/src/libscotch/parser.c
+index 15bf0035..e09e98fb 100644
+--- a/src/libscotch/parser.c
++++ b/src/libscotch/parser.c
+@@ -54,7 +54,7 @@
+ /**                # Version 6.0  : from : 01 jun 2012     **/
+ /**                                 to   : 30 dec 2016     **/
+ /**                # Version 7.0  : from : 02 mar 2018     **/
+-/**                                 to   : 24 oct 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -562,6 +562,7 @@ StratTest * const           testptr)
+ 
+ static char                 strattestsaveop[STRATTESTNBR] = "|&!=><+-*%##";
+ static char *               strattestsavepa[2][2] = { { "", "" }, { "(", ")" } };
++static int                  strattestsavepr[STRATTESTNBR] = { 0, 1, 2, 3, 3, 3, 4, 4, 5, 6, 7, 7 }; /* Operator priorities, as in grammar */
+ 
+ int
+ stratTestSave (
+@@ -595,13 +596,13 @@ FILE * const                stream)
+     case STRATTESTSUB :                           /* Subtraction operator    */
+     case STRATTESTMUL :                           /* Multiplication operator */
+     case STRATTESTMOD :                           /* Modulus operator        */
+-      i  = (testptr->data.testtab[0]->testval < testptr->testval) ? 1 : 0;
++      i  = (strattestsavepr[testptr->data.testtab[0]->testval] < strattestsavepr[testptr->testval]) ? 1 : 0;
+       o  = (fprintf (stream, "%s", strattestsavepa[i][0]) == EOF);
+       o |= stratTestSave (testptr->data.testtab[0], stream);
+       o |= (fprintf (stream, "%s", strattestsavepa[i][1]) == EOF);
+       if (o == 0) {
+         o  = (fprintf (stream, "%c", strattestsaveop[testptr->testval]) == EOF);
+-        i  = (testptr->data.testtab[1]->testval < testptr->testval) ? 1 : 0;
++        i  = (strattestsavepr[testptr->data.testtab[1]->testval] <= strattestsavepr[testptr->testval]) ? 1 : 0; /* Operators are left-associative */
+         o |= (fprintf (stream, "%s", strattestsavepa[i][0]) == EOF);
+         o |= stratTestSave (testptr->data.testtab[1], stream);
+         o |= (fprintf (stream, "%s", strattestsavepa[i][1]) == EOF);
+diff --git a/src/libscotch/parser.h b/src/libscotch/parser.h
+index 2d1a747d..815fee36 100644
+--- a/src/libscotch/parser.h
++++ b/src/libscotch/parser.h
+@@ -1,4 +1,4 @@
+-/* Copyright 2004,2007,2008,2014,2018,2021,2023,2024 IPB, Universite de Bordeaux, INRIA & CNRS
++/* Copyright 2004,2007,2008,2014,2018,2021,2023,2024,2026 IPB, Universite de Bordeaux, INRIA & CNRS
+ **
+ ** This file is part of the Scotch software package for static mapping,
+ ** graph partitioning and sparse matrix ordering.
+@@ -52,7 +52,7 @@
+ /**                # Version 6.0  : from : 30 sep 2014     **/
+ /**                                 to   : 30 sep 2014     **/
+ /**                # Version 7.0  : from : 02 mar 2018     **/
+-/**                                 to   : 07 nov 2024     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -84,9 +84,9 @@ typedef int StratParamType;                       /*+ Same type as enum +*/
+ 
+ #define STRATPARAMDEPRECATED        8             /*+ Indicates deprecated parameter; can be merged with the above +*/
+ 
+-/*+ Test types, ordered by ascending priority,
+-    for proper writing of parentheses. Initial
+-    value should be zero for proper indexing.  +*/
++/*+ Test types, ordered by ascending priority.
++    Initial value should be zero for proper
++    indexing of operator and priority arrays.  +*/
+ 
+ typedef enum StratTestType_ {
+   STRATTESTOR = 0,                                /*+ Or operator             +*/
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0022-Bugfix-do-not-trap-when-evaluating-a-modulus-by-1-in.patch b/upstream/reports/7.0.18/series/0022-Bugfix-do-not-trap-when-evaluating-a-modulus-by-1-in.patch
new file mode 100644
index 0000000..3bb2aa2
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0022-Bugfix-do-not-trap-when-evaluating-a-modulus-by-1-in.patch
@@ -0,0 +1,35 @@
+From 7e0a995c147b660199e65ef08cc3e7f5c2114eb1 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 08:10:09 +0000
+Subject: [PATCH 022/232] Bugfix: do not trap when evaluating a modulus by -1
+ in strategy conditions [report R. Perry]
+
+Since 13e4dee6, a modulus by zero in a strategy condition is reported
+as an error, but `INTVALMIN % -1` still overflows and raises SIGFPE on
+most architectures, e.g. with `/((0-2147483647-1)%(0-1)=0)?...` when
+`INT` is 32-bit. Since any integer modulo -1 is zero, do not perform
+the division in this case.
+
+Refs: COR-26
+---
+ src/libscotch/parser.c | 4 +++-
+ 1 file changed, 3 insertions(+), 1 deletion(-)
+
+diff --git a/src/libscotch/parser.c b/src/libscotch/parser.c
+index e09e98fb..86251bf2 100644
+--- a/src/libscotch/parser.c
++++ b/src/libscotch/parser.c
+@@ -436,7 +436,9 @@ const void * restrict const       dataptr)        /*+ Pointer to data structure
+           o = 1;
+           break;
+         }
+-        evalptr->data.val.valint = testtab[0].data.val.valint % testtab[1].data.val.valint;
++        evalptr->data.val.valint = (testtab[1].data.val.valint == -1) /* Avoid overflow trap for INTVALMIN % -1 */
++                                   ? 0
++                                   : (testtab[0].data.val.valint % testtab[1].data.val.valint);
+       }
+       evalptr->nodeval = testtab[0].nodeval;
+       break;
