diff --git a/upstream/reports/7.0.18/series/0007-Bugfix-do-not-free-tree-leaf-arrays-twice-on-loading.patch b/upstream/reports/7.0.18/series/0007-Bugfix-do-not-free-tree-leaf-arrays-twice-on-loading.patch
new file mode 100644
index 0000000..615e573
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0007-Bugfix-do-not-free-tree-leaf-arrays-twice-on-loading.patch
@@ -0,0 +1,105 @@
+From d129198676bad6d61251ad69d1be6fa1c3d7a02b Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 08:33:10 +0000
+Subject: [PATCH 007/232] Bugfix: do not free tree-leaf arrays twice on loading
+ errors [report R. Perry]
+
+Since `archLoad()` cleans up through `archTleafArchFree()` when the
+loading routine of a tree-leaf or labeled tree-leaf architecture fails,
+the arrays freed by `archTleafArchLoad()` and `archLtleafArchLoad()` on
+error were freed a second time, e.g. on a malformed level line or
+permutation. The loading routines now leave the freeing of the arrays
+they have allocated to `archTleafArchFree()`, which no longer assumes
+that the tree part has been allocated.
+
+Refs: COR-07, PS3-G02-1
+---
+ src/libscotch/arch_tleaf.c | 21 +++++++++------------
+ 1 file changed, 9 insertions(+), 12 deletions(-)
+
+diff --git a/src/libscotch/arch_tleaf.c b/src/libscotch/arch_tleaf.c
+index 094b0857..188cef7a 100644
+--- a/src/libscotch/arch_tleaf.c
++++ b/src/libscotch/arch_tleaf.c
+@@ -66,7 +66,7 @@
+ /**                # Version 6.0  : from : 14 feb 2011     **/
+ /**                                 to   : 03 may 2019     **/
+ /**                # Version 7.0  : from : 19 feb 2018     **/
+-/**                                 to   : 25 oct 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /**   NOTES      : # The ltleaf architecture was proposed  **/
+ /**                  by Emmanuel Jeannot and Francois      **/
+@@ -132,15 +132,13 @@ FILE * restrict const       stream)
+         (archptr->sizetab[levlnum] < 2)                     ||
+         (archptr->linktab[levlnum] < 1)) {
+       errorPrint ("archTleafArchLoad: bad input (2)");
+-      memFree    (archptr->sizetab);
+-      return (1);
++      return (1);                                 /* Tree part will be freed by archTleafArchFree() */
+     }
+   }
+ 
+   for (levlnum = 0, archsiz = 1; levlnum < archptr->levlnbr; levlnum ++) {
+     if ((archsiz * archptr->sizetab[levlnum]) < archsiz) {
+       errorPrint ("archTleafArchLoad: invalid architecture size");
+-      memFree    (archptr->sizetab);
+       return (1);
+     }
+     archsiz *= archptr->sizetab[levlnum];
+@@ -169,7 +167,8 @@ ArchTleaf * const           archptr)
+   }
+ #endif /* SCOTCH_DEBUG_ARCH1 */
+ 
+-  memFree (archptr->sizetab);                     /* Free group leader */
++  if (archptr->sizetab != NULL)                   /* If tree part has been allocated */
++    memFree (archptr->sizetab);                   /* Free group leader               */
+   if (archptr->permtab != NULL)
+     memFree (archptr->permtab);                   /* Free group leader */
+ 
+@@ -696,9 +695,7 @@ FILE * restrict const       stream)
+   if ((intLoad (stream, &archptr->permnbr) != 1) ||
+       (archptr->permnbr < 1)) {
+     errorPrint ("archLtleafArchLoad: bad input (1)");
+-fail:
+-    memFree (archptr->sizetab);
+-    return  (1);
++    return (1);                                   /* Arrays will be freed by archTleafArchFree() */
+   }
+ 
+   if (archptr->permnbr != 1) {                    /* Valid empty permutation is of size 1 */
+@@ -709,14 +706,14 @@ fail:
+          sizeval != archptr->permnbr; levlnum --, sizeval *= archptr->sizetab[levlnum]) {
+       if (levlnum < 0) {
+         errorPrint ("archLtleafArchLoad: permutation size does not match level boundaries");
+-        goto fail;
++        return (1);
+       }
+     }
+   }
+ 
+   if ((archptr->permtab = memAlloc (archptr->permnbr * 2 * sizeof (Anum))) == NULL) { /* TRICK: space for peritab too */
+     errorPrint ("archLtleafArchLoad: out of memory");
+-    goto fail;
++    return (1);
+   }
+   archptr->peritab = archptr->permtab + archptr->permnbr;
+ 
+@@ -726,12 +723,12 @@ fail:
+         (archptr->permtab[permnum] < 0)                     ||
+         (archptr->permtab[permnum] >= archptr->permnbr)) {
+       errorPrint ("archLtleafArchLoad: bad input (2)");
+-      goto fail;
++      return (1);
+     }
+ 
+     if (archptr->peritab[archptr->permtab[permnum]] != ~0) { /* Check and build inverse permutation */
+       errorPrint ("archLtleafArchLoad: duplicate permutation index");
+-      goto fail;
++      return (1);
+     }
+     archptr->peritab[archptr->permtab[permnum]] = permnum;
+   }
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0008-Bugfix-check-tree-leaf-architecture-size-without-ove.patch b/upstream/reports/7.0.18/series/0008-Bugfix-check-tree-leaf-architecture-size-without-ove.patch
new file mode 100644
index 0000000..96c97ea
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0008-Bugfix-check-tree-leaf-architecture-size-without-ove.patch
@@ -0,0 +1,57 @@
+From 75b88e7f5316676e604391981de112918c26c5da Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 08:33:36 +0000
+Subject: [PATCH 008/232] Bugfix: check tree-leaf architecture size without
+ overflowing [report R. Perry]
+
+The size overflow checks of `archTleafArchLoad()` and
+`SCOTCH_archTleaf()` computed the product they were meant to guard,
+which is undefined behavior for signed integers, and which, when it
+wraps around, does not always yield a value smaller than the former
+one: e.g. "tleaf 2 100000 1 50000 1" was accepted with 705032704
+terminals on 32-bit builds. The product is now checked beforehand.
+
+Refs: COR-07, API-10, PS3-G02-2
+---
+ src/libscotch/arch_tleaf.c   | 2 +-
+ src/libscotch/library_arch.c | 4 ++--
+ 2 files changed, 3 insertions(+), 3 deletions(-)
+
+diff --git a/src/libscotch/arch_tleaf.c b/src/libscotch/arch_tleaf.c
+index 188cef7a..810dc72b 100644
+--- a/src/libscotch/arch_tleaf.c
++++ b/src/libscotch/arch_tleaf.c
+@@ -137,7 +137,7 @@ FILE * restrict const       stream)
+   }
+ 
+   for (levlnum = 0, archsiz = 1; levlnum < archptr->levlnbr; levlnum ++) {
+-    if ((archsiz * archptr->sizetab[levlnum]) < archsiz) {
++    if (archsiz > (ANUMMAX / archptr->sizetab[levlnum])) { /* If product would overflow */
+       errorPrint ("archTleafArchLoad: invalid architecture size");
+       return (1);
+     }
+diff --git a/src/libscotch/library_arch.c b/src/libscotch/library_arch.c
+index f915773d..1efd6b4c 100644
+--- a/src/libscotch/library_arch.c
++++ b/src/libscotch/library_arch.c
+@@ -57,7 +57,7 @@
+ /**                # Version 6.1  : from : 15 mar 2021     **/
+ /**                                 to   : 15 mar 2021     **/
+ /**                # Version 7.0  : from : 21 jan 2023     **/
+-/**                                 to   : 25 oct 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -578,7 +578,7 @@ const SCOTCH_Num * const    linktab)              /*+ Link cost array, by increa
+       memFree    (tgtarchdatptr->sizetab);
+       return (1);
+     }
+-    if ((archsiz * tgtarchdatptr->sizetab[levlnum]) < archsiz) {
++    if (archsiz > (ANUMMAX / tgtarchdatptr->sizetab[levlnum])) { /* If product would overflow */
+       errorPrint (STRINGIFY (SCOTCH_archTleaf) ": invalid architecture size");
+       memFree    (tgtarchdatptr->sizetab);
+       return (1);
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0009-Bugfix-leave-tree-leaf-architectures-freeable-when-b.patch b/upstream/reports/7.0.18/series/0009-Bugfix-leave-tree-leaf-architectures-freeable-when-b.patch
new file mode 100644
index 0000000..a3dded9
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0009-Bugfix-leave-tree-leaf-architectures-freeable-when-b.patch
@@ -0,0 +1,79 @@
+From 03db9f888e7f33be66b72bd2700439d7b1e6f6fb Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 08:35:45 +0000
+Subject: [PATCH 009/232] Bugfix: leave tree-leaf architectures freeable when
+ building them fails [report R. Perry]
+
+When `SCOTCH_archTleaf()` and `SCOTCH_archLtleaf()` rejected their
+parameters, they freed the arrays they had allocated but left them in
+the architecture, the class of which was already set, so that the
+`SCOTCH_archExit()` call of the caller freed them a second time.
+
+`SCOTCH_archTleaf()` now sets the architecture class only on success,
+and `SCOTCH_archLtleaf()` frees the tree part too and resets the class
+on error, so that a failed architecture is empty.
+
+Refs: API-10, PS-API-4, PS3-G02-3
+---
+ src/libscotch/library_arch.c | 18 +++++++++++-------
+ 1 file changed, 11 insertions(+), 7 deletions(-)
+
+diff --git a/src/libscotch/library_arch.c b/src/libscotch/library_arch.c
+index 1efd6b4c..01fb0364 100644
+--- a/src/libscotch/library_arch.c
++++ b/src/libscotch/library_arch.c
+@@ -554,10 +554,8 @@ const SCOTCH_Num * const    linktab)              /*+ Link cost array, by increa
+     return (1);
+   }
+ 
+-  tgtarchptr          = (Arch *) archptr;
+-  tgtarchdatptr       = (ArchTleaf *) (void *) (&tgtarchptr->data);
+-  tgtarchptr->clasptr = archClass ("tleaf");
+-  tgtarchptr->flagval = tgtarchptr->clasptr->flagval; /* Copy architecture flag */
++  tgtarchptr    = (Arch *) archptr;
++  tgtarchdatptr = (ArchTleaf *) (void *) (&tgtarchptr->data);
+ 
+   if ((tgtarchdatptr->sizetab = memAlloc ((levlnbr * 2 + 1) * sizeof (Anum))) == NULL) { /* TRICK: One more slot for linktab[-1] */
+     errorPrint (STRINGIFY (SCOTCH_archTleaf) ": out of memory");
+@@ -587,6 +585,9 @@ const SCOTCH_Num * const    linktab)              /*+ Link cost array, by increa
+   }
+   tgtarchdatptr->termnbr = archsiz;
+ 
++  tgtarchptr->clasptr = archClass ("tleaf");      /* Set class only on success  */
++  tgtarchptr->flagval = tgtarchptr->clasptr->flagval; /* Copy architecture flag */
++
+   return (0);
+ }
+ 
+@@ -615,7 +616,10 @@ const SCOTCH_Num * const    permtab)              /*+ Permutation array
+ 
+   if ((tgtarchdatptr->permtab = memAlloc (permnbr * 2 * sizeof (Anum))) == NULL) { /* TRICK: space for peritab too */
+     errorPrint (STRINGIFY (SCOTCH_archLtleaf) ": out of memory");
+-    return (1);
++fail:
++    memFree (tgtarchdatptr->sizetab);             /* Free tree part                  */
++    tgtarchptr->clasptr = NULL;                   /* Architecture is no longer valid */
++    return  (1);
+   }
+   tgtarchdatptr->permnbr = (Anum) permnbr;
+   tgtarchdatptr->peritab = tgtarchdatptr->permtab + permnbr;
+@@ -628,14 +632,14 @@ const SCOTCH_Num * const    permtab)              /*+ Permutation array
+         (tgtarchdatptr->permtab[permnum] >= tgtarchdatptr->permnbr)) {
+       errorPrint (STRINGIFY (SCOTCH_archLtleaf) ": invalid permutation index");
+       memFree    (tgtarchdatptr->permtab);
+-      return (1);
++      goto fail;
+     }
+   }
+   for (permnum = 0; permnum < tgtarchdatptr->permnbr; permnum ++) { /* Build inverse permutation      */
+     if (tgtarchdatptr->peritab[tgtarchdatptr->permtab[permnum]] != ~0) { /* Check inverse permutation */
+       errorPrint (STRINGIFY (SCOTCH_archLtleaf) ": duplicate permutation index");
+       memFree    (tgtarchdatptr->permtab);
+-      return (1);
++      goto fail;
+     }
+     tgtarchdatptr->peritab[tgtarchdatptr->permtab[permnum]] = permnum;
+   }
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0010-Bugfix-check-permutation-sizes-of-labeled-tree-leaf-.patch b/upstream/reports/7.0.18/series/0010-Bugfix-check-permutation-sizes-of-labeled-tree-leaf-.patch
