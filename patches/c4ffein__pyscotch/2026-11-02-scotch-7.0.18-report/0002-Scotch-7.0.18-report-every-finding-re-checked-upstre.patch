diff --git a/upstream/reports/7.0.18/series/0114-Add-the-Fortran-wrapper-of-SCOTCH_archLtleaf-report-.patch b/upstream/reports/7.0.18/series/0114-Add-the-Fortran-wrapper-of-SCOTCH_archLtleaf-report-.patch
new file mode 100644
index 0000000..5830991
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0114-Add-the-Fortran-wrapper-of-SCOTCH_archLtleaf-report-.patch
@@ -0,0 +1,59 @@
+From a1930f4a9da963513cd589679c6202e47fef6ceb Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 13:44:13 +0000
+Subject: [PATCH 114/232] Add the Fortran wrapper of `SCOTCH_archLtleaf()`
+ [report PyScotch]
+
+The Scotch user's manual documents "scotchfarchltleaf", which was never
+defined in "library_arch_f.c". The wrapper mirrors that of
+`SCOTCH_archTleaf()`, with the permutation count and array added.
+
+This commit requires `SCOTCH_archLtleaf()` to be declared in "library.h"
+(see the commit "Declare `SCOTCH_archLtleaf()` in the library header").
+
+Refs: API-24, PS2-G02-2
+---
+ src/libscotch/library_arch_f.c | 20 +++++++++++++++++++-
+ 1 file changed, 19 insertions(+), 1 deletion(-)
+
+diff --git a/src/libscotch/library_arch_f.c b/src/libscotch/library_arch_f.c
+index 66d82b9b..7743a40e 100644
+--- a/src/libscotch/library_arch_f.c
++++ b/src/libscotch/library_arch_f.c
+@@ -50,7 +50,7 @@
+ /**                # Version 6.1  : from : 15 mar 2021     **/
+ /**                                 to   : 15 mar 2021     **/
+ /**                # Version 7.0  : from : 21 jan 2023     **/
+-/**                                 to   : 31 oct 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -298,6 +298,24 @@ int * const                 revaptr), \
+ **
+ */
+ 
++SCOTCH_FORTRAN (                      \
++ARCHLTLEAF, archltleaf, (             \
++SCOTCH_Arch * const         archptr,  \
++const SCOTCH_Num * const    levlnbr,  \
++const SCOTCH_Num * const    sizetab,  \
++const SCOTCH_Num * const    linktab,  \
++const SCOTCH_Num * const    permnbr,  \
++const SCOTCH_Num * const    permtab,  \
++int * const                 revaptr), \
++(archptr, levlnbr, sizetab, linktab, permnbr, permtab, revaptr))
++{
++  *revaptr = SCOTCH_archLtleaf (archptr, *levlnbr, sizetab, linktab, *permnbr, permtab);
++}
++
++/*
++**
++*/
++
+ SCOTCH_FORTRAN (                      \
+ ARCHMESH2, archmesh2, (               \
+ SCOTCH_Arch * const         archptr,  \
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/series/0115-Bugfix-release-the-mesh-and-its-arrays-in-the-Fortra.patch b/upstream/reports/7.0.18/series/0115-Bugfix-release-the-mesh-and-its-arrays-in-the-Fortra.patch
new file mode 100644
index 0000000..3ee9064
--- /dev/null
+++ b/upstream/reports/7.0.18/series/0115-Bugfix-release-the-mesh-and-its-arrays-in-the-Fortra.patch
@@ -0,0 +1,43 @@
+From 2ec541459c9b2df160e117163a4e4727ee3afd08 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 08:23:37 +0000
+Subject: [PATCH 115/232] Bugfix: release the mesh and its arrays in the
+ Fortran mesh build test program [report PyScotch]
+
+"test_scotch_mesh_build_f.f90" built a mesh but never called
+scotchfmeshexit, and never deallocated the "verttab" and "edgetab"
+arrays it allocated, unlike "test_libmetis_dual_f.f90". The program
+therefore fails as soon as it is run under LeakSanitizer. Release
+the mesh and the arrays before the end of the program.
+
+Refs: PS2-G17-7
+---
+ src/check/test_scotch_mesh_build_f.f90.in | 7 ++++++-
+ 1 file changed, 6 insertions(+), 1 deletion(-)
+
+diff --git a/src/check/test_scotch_mesh_build_f.f90.in b/src/check/test_scotch_mesh_build_f.f90.in
+index 757a5211..f8df62eb 100644
+--- a/src/check/test_scotch_mesh_build_f.f90.in
++++ b/src/check/test_scotch_mesh_build_f.f90.in
+@@ -39,7 +39,7 @@
+ !*                the mesh building routine.              **
+ !*                                                        **
+ !*   DATES      : # Version 7.0  : from : 24 jan 2026     **
+-!*                                 to     24 jan 2026     **
++!*                                 to     02 nov 2026     **
+ !*                                                        **
+ !234567*****************************************************
+ 
+@@ -99,4 +99,9 @@ program test_scotch_mesh_build
+     call exit_c (1)
+   end if
+ 
++  call scotchfmeshexit(meshdat)
++
++  deallocate (edgetab)
++  deallocate (verttab)
++
+ end program test_scotch_mesh_build
+-- 
+2.43.0
+
