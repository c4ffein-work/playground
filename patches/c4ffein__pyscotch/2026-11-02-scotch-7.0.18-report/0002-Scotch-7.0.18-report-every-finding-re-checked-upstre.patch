+From 7460dbc3f4790708de287ce4a90840bc8feffc34 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Mon, 2 Nov 2026 08:15:09 +0000
+Subject: [PATCH 4/6] Bugfix: always compile the invalid folding parameter case
+ of `bdgraphBipartMlCoarsen()` [report R. Perry]
+
+The `default` case of the switch on the folding parameter was only
+compiled in debug mode, so that `foldval` was reported as possibly
+uninitialized by the compiler at -O2 in non-debug builds. Make the
+case unconditional, as in `vdgraphSeparateMlCoarsen()`.
+
+Refs: DMO-18
+---
+ src/libscotch/bdgraph_bipart_ml.c | 4 +---
+ 1 file changed, 1 insertion(+), 3 deletions(-)
+
+diff --git a/src/libscotch/bdgraph_bipart_ml.c b/src/libscotch/bdgraph_bipart_ml.c
+index 1c4195b6..0385ccc4 100644
+--- a/src/libscotch/bdgraph_bipart_ml.c
++++ b/src/libscotch/bdgraph_bipart_ml.c
+@@ -44,7 +44,7 @@
+ /**              : # Version 6.0  : from : 11 sep 2011     **/
+ /**                                 to   : 31 aug 2019     **/
+ /**              : # Version 7.0  : from : 27 aug 2019     **/
+-/**                                 to   : 31 oct 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -100,11 +100,9 @@ const BdgraphBipartMlParam * const    paraptr)    /*+ Method parameters
+     case 2 :
+       foldval = DGRAPHCOARSENFOLDDUP;
+       break;
+-#ifdef SCOTCH_DEBUG_BDGRAPH2
+     default :
+       errorPrint ("bdgraphBipartMlCoarsen: invalid parameter");
+       return (1);
+-#endif /* SCOTCH_DEBUG_BDGRAPH2 */
+   }
+   if ((finegrafptr->s.vertglbnbr / finegrafptr->s.procglbnbr) > paraptr->foldmax) /* If no need to fold */
+     foldval = DGRAPHCOARSENNONE;
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G22-bdgraph/0005-Bugfix-fix-external-gain-accounting-in-bdgraphBipart.patch b/upstream/reports/7.0.18/patches/G22-bdgraph/0005-Bugfix-fix-external-gain-accounting-in-bdgraphBipart.patch
new file mode 100644
index 0000000..5e64b34
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G22-bdgraph/0005-Bugfix-fix-external-gain-accounting-in-bdgraphBipart.patch
@@ -0,0 +1,100 @@
+From 03db069a143087e9fcb6816a635e428b0a61e0dc Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 16:17:45 +0000
+Subject: [PATCH] Bugfix: fix external gain accounting in `bdgraphBipartEx()`
+ and gather external gains in `bdgraphGatherAll()` [report R. Perry and
+ PyScotch]
+
+External gains are not computed yet for distributed active graphs
+(`veexloctax` is always NULL), but the code that handles them must be
+right for when they are. In `bdgraphBipartEx()`, the local sum of
+external load differences was sent twice and then added in full to the
+global communication load, which thus received twice the external load
+change; send it once, add it once to the communication load, and
+subtract it twice from the external gain. In `bdgraphGatherAll()`, the
+external gain array of the centralized graph was allocated but not
+gathered when the distributed graph had no part array yet, so that the
+sequential methods read uninitialized data; gather it before testing
+for the part array.
+
+Refs: DMO-19, PS2-G22-2
+---
+ src/libscotch/bdgraph_bipart_ex.c  |  8 ++++----
+ src/libscotch/bdgraph_gather_all.c | 18 +++++++++---------
+ 2 files changed, 13 insertions(+), 13 deletions(-)
+
+diff --git a/src/libscotch/bdgraph_bipart_ex.c b/src/libscotch/bdgraph_bipart_ex.c
+index 5f6229d0..e55df032 100644
+--- a/src/libscotch/bdgraph_bipart_ex.c
++++ b/src/libscotch/bdgraph_bipart_ex.c
+@@ -462,7 +462,7 @@ loop_exit : ;
+     }
+ 
+     if (veexloctax != NULL)
+-      commlocgainextn += (partval - (partval ^ flagval)) * veexloctax[vertlocnum]; /* Compute half of difference in external load */
++      commlocgainextn += (partval - (partval ^ flagval)) * veexloctax[vertlocnum]; /* Compute difference in external load */
+ 
+     if (commcut == 0) {                           /* If vertex no longer belongs to frontier */
+       fronloctab[fronlocnum] = fronloctab[-- fronlocnbr]; /* Replace it by another one       */
+@@ -478,8 +478,8 @@ loop_exit : ;
+   reduloctab[0] = grafptr->fronlocnbr;
+   reduloctab[1] = grafptr->complocload0;
+   reduloctab[2] = grafptr->complocsize0;
+-  reduloctab[3] = commlocgain * domndist;         /* Send internal gain */
+-  reduloctab[4] = commlocgainextn * 2;            /* Send external gain */
++  reduloctab[3] = commlocgain * domndist;         /* Send internal gain                  */
++  reduloctab[4] = commlocgainextn;                /* Send difference in external load    */
+   if (MPI_Allreduce (reduloctab, reduglbtab, 5, GNUM_MPI, MPI_SUM, grafptr->s.proccomm) != MPI_SUCCESS) {
+     errorPrint ("bdgraphBipartEx: communication error (5)");
+     return     (1);
+@@ -489,7 +489,7 @@ loop_exit : ;
+   grafptr->compglbload0dlt  = reduglbtab[1] - grafptr->compglbload0avg;
+   grafptr->compglbsize0     = reduglbtab[2];
+   grafptr->commglbload     += reduglbtab[3] / 2 + reduglbtab[4]; /* Add modifications, counted twice for internal gain */
+-  grafptr->commglbgainextn -= reduglbtab[4];      /* Account for modifications in external gain                        */
++  grafptr->commglbgainextn -= 2 * reduglbtab[4];  /* Account for modifications in external gain                        */
+   grafptr->bbalglbval       = (double) ((grafptr->compglbload0dlt < 0) ? (- grafptr->compglbload0dlt) : grafptr->compglbload0dlt) / (double) grafptr->compglbload0avg;
+ 
+ #ifdef SCOTCH_DEBUG_BDGRAPH2
+diff --git a/src/libscotch/bdgraph_gather_all.c b/src/libscotch/bdgraph_gather_all.c
+index 3cd69568..c1802d75 100644
+--- a/src/libscotch/bdgraph_gather_all.c
++++ b/src/libscotch/bdgraph_gather_all.c
+@@ -167,6 +167,14 @@ fail:
+   cgrfptr->levlnum       = dgrfptr->levlnum;
+   cgrfptr->contptr       = dgrfptr->contptr;
+ 
++  if (dgrfptr->veexloctax != NULL) {
++    if (commAllgatherv (dgrfptr->veexloctax + dgrfptr->s.baseval, dgrfptr->s.vertlocnbr, GNUM_MPI, /* Get veextax of distributed graph */
++                        cgrfptr->veextax, dgrfptr->s.proccnttab, dgrfptr->s.procdsptab, GNUM_MPI, dgrfptr->s.proccomm) != MPI_SUCCESS) {
++      errorPrint ("bdgraphGatherAll: communication error (4)");
++      return     (1);
++    }
++  }
++
+   if (dgrfptr->partgsttax == NULL) {              /* If distributed graph does not have a part array yet */
+     bgraphZero (cgrfptr);
+     memFree    (froncnttab);                      /* Free group leader */
+@@ -175,18 +183,10 @@ fail:
+ 
+   if (commAllgatherv (dgrfptr->partgsttax + dgrfptr->s.baseval, dgrfptr->s.vertlocnbr, GRAPHPART_MPI, /* Get parttax of distributed graph */
+                       cgrfptr->parttax, dgrfptr->s.proccnttab, dgrfptr->s.procdsptab, GRAPHPART_MPI, dgrfptr->s.proccomm) != MPI_SUCCESS) {
+-    errorPrint ("bdgraphGatherAll: communication error (4)");
++    errorPrint ("bdgraphGatherAll: communication error (5)");
+     return     (1);
+   }
+ 
+-  if (dgrfptr->veexloctax != NULL) {
+-    if (commAllgatherv (dgrfptr->veexloctax + dgrfptr->s.baseval, dgrfptr->s.vertlocnbr, GNUM_MPI, /* Get veextax of distributed graph */
+-                        cgrfptr->veextax, dgrfptr->s.proccnttab, dgrfptr->s.procdsptab, GNUM_MPI, dgrfptr->s.proccomm) != MPI_SUCCESS) {
+-      errorPrint ("bdgraphGatherAll: communication error (5)");
+-      return     (1);
+-    }
+-  }
+-
+   fronlocnbr = (int) dgrfptr->fronlocnbr;
+   if (MPI_Allgather (&fronlocnbr, 1, MPI_INT,     /* Compute how frontiers are distributed */
+                      froncnttab, 1, MPI_INT, dgrfptr->s.proccomm) != MPI_SUCCESS) {
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G22-bdgraph/0006-Bugfix-compute-the-external-gains-of-coarse-and-unco.patch b/upstream/reports/7.0.18/patches/G22-bdgraph/0006-Bugfix-compute-the-external-gains-of-coarse-and-unco.patch
new file mode 100644
index 0000000..aed25fa
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G22-bdgraph/0006-Bugfix-compute-the-external-gains-of-coarse-and-unco.patch
@@ -0,0 +1,339 @@
+From 9ce3a6c03003f4d4b009cca9f1e2d435c8333bc2 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 20:06:44 +0000
+Subject: [PATCH 6/6] Bugfix: compute the external gains of coarse and
+ uncoarsened vertices in `bdgraphBipartMl()` [report R. Perry and PyScotch]
+
+External gains are not computed yet for distributed active graphs, but
+the multilevel code that handles them was wrong. `bdgraphBipartMlCoarsen()`
+indexed the local external gain array of the fine graph with the global
+vertex numbers of the multinode array, which are only valid local
+indices on a single process; moreover, since the multinode array is
+redistributed along with the coarse graph when it is folded, the fine
+vertices of a multinode may be owned by any process. Compute the coarse
+external gains in a dedicated routine, called by all processes of the
+fine graph, which sums the gains of local fine vertices and requests
+those of remote fine vertices from their owner processes.
+
+`bdgraphBipartMlUncoarsen()` did not account for the external gain of
+the fine vertices assigned to part 0 that it received from other
+processes, so that the global external gain of the fine graph was
+wrong whenever a multinode spanned two processes.
+
+Refs: DMO-19, PS2-G22-3
+---
+ src/libscotch/bdgraph_bipart_ml.c | 273 ++++++++++++++++++++++++++----
+ 1 file changed, 243 insertions(+), 30 deletions(-)
+
+diff --git a/src/libscotch/bdgraph_bipart_ml.c b/src/libscotch/bdgraph_bipart_ml.c
+index 0385ccc4..76927598 100644
+--- a/src/libscotch/bdgraph_bipart_ml.c
++++ b/src/libscotch/bdgraph_bipart_ml.c
+@@ -70,6 +70,235 @@
+ /*                                           */
+ /*********************************************/
+ 
++/* This routine returns the number of the process
++** which owns the given global vertex number of the
++** fine graph, by dichotomy on the vertex range array.
++** It returns:
++** - the process number, in all cases.
++*/
++
++static
++int
++bdgraphBipartMlProcNum (
++const Gnum * restrict const procvrttab,           /*+ Vertex range array of fine graph +*/
++const int                   procglbnbr,           /*+ Number of processes              +*/
++const Gnum                  vertglbnum)           /*+ Global vertex number             +*/
++{
++  int                 procngbnum;
++  int                 procngbmax;
++
++  procngbnum = 0;
++  procngbmax = procglbnbr;
++  while ((procngbmax - procngbnum) > 1) {         /* Find owner process by dichotomy on procvrttab */
++    int                 procngbmed;
++
++    procngbmed = (procngbmax + procngbnum) / 2;
++    if (procvrttab[procngbmed] > vertglbnum)
++      procngbmax = procngbmed;
++    else
++      procngbnum = procngbmed;
++  }
++
++  return (procngbnum);
++}
++
++/* This routine computes the external gains of the
++** vertices of the coarser graph, as the sums of the
++** external gains of the fine vertices of their
++** multinodes. Since the multinode array is
++** redistributed along with the coarse graph when it
++** is folded, the fine vertices of a multinode may be
++** owned by any process; their external gains are
++** requested from their owner processes. All processes
++** of the fine graph must call this routine, even when
++** they do not own a copy of the coarse graph.
++** It returns:
++** - 0   : if the coarse external gain array has been built.
++** - !0  : on error.
++*/
++
++static
++int
++bdgraphBipartMlCoarsenVeex (
++const Bdgraph * restrict const            finegrafptr, /*+ Finer graph                               +*/
++Bdgraph * restrict const                  coargrafptr, /*+ Coarser graph, empty if not owned         +*/
++const DgraphCoarsenMulti * restrict const coarmulttax) /*+ Based multinode array, NULL if not owned +*/
++{
++  Gnum * restrict     coarveexloctax;
++  Gnum                coarvertlocnum;
++  Gnum                finevertlocadj;             /* Global vertex adjustment                                            */
++  int * restrict      vsndcnttab;
++  int * restrict      vsnddsptab;
++  int * restrict      vsndidxtab;
++  int * restrict      vrcvcnttab;
++  int * restrict      vrcvdsptab;
++  Gnum * restrict     vsnddattab;                 /* Global numbers of requested fine vertices, then their external gains */
++  Gnum * restrict     vsndvrttab;                 /* Coarse vertices to which requested fine vertices belong              */
++  Gnum * restrict     vrcvdattab;                 /* Global numbers of fine vertices requested by other processes         */
++  int                 vsnddspnbr;
++  int                 vrcvdspnbr;
++  int                 vsndlocnum;
++  int                 vrcvlocnum;
++  int                 procnum;
++  int                 cheklocval;
++  int                 chekglbval;
++
++  const int                   fineprocglbnbr = finegrafptr->s.procglbnbr;
++  const Gnum * restrict const fineprocvrttab = finegrafptr->s.procvrttab;
++  const Gnum * restrict const fineveexloctax = finegrafptr->veexloctax;
++  const Gnum                  finebaseval    = finegrafptr->s.baseval;
++  const Gnum                  finevertlocnnd = finegrafptr->s.vertlocnnd;
++  const Gnum                  coarbaseval    = coargrafptr->s.baseval;
++  const Gnum                  coarvertlocnbr = coargrafptr->s.vertlocnbr; /* Zero if coarse graph is not owned */
++  const Gnum                  coarvertlocnnd = coargrafptr->s.vertlocnnd;
++
++  cheklocval     = 0;
++  coarveexloctax = NULL;
++  if (memAllocGroup ((void **) (void *)
++                     &vsndcnttab, (size_t) (fineprocglbnbr * sizeof (int)),
++                     &vsnddsptab, (size_t) (fineprocglbnbr * sizeof (int)),
++                     &vsndidxtab, (size_t) (fineprocglbnbr * sizeof (int)),
++                     &vrcvcnttab, (size_t) (fineprocglbnbr * sizeof (int)),
++                     &vrcvdsptab, (size_t) (fineprocglbnbr * sizeof (int)),
++                     &vsnddattab, (size_t) (coarvertlocnbr * 2 * sizeof (Gnum)), /* At most two remote fine vertices per multinode */
++                     &vsndvrttab, (size_t) (coarvertlocnbr * 2 * sizeof (Gnum)), NULL) == NULL) {
++    errorPrint ("bdgraphBipartMlCoarsenVeex: out of memory (1)");
++    cheklocval = 1;
++  }
++  else if ((coarveexloctax = (Gnum *) memAlloc (coarvertlocnbr * sizeof (Gnum))) == NULL) {
++    errorPrint ("bdgraphBipartMlCoarsenVeex: out of memory (2)");
++    cheklocval = 1;
++  }
++  if (MPI_Allreduce (&cheklocval, &chekglbval, 1, MPI_INT, MPI_MAX, finegrafptr->s.proccomm) != MPI_SUCCESS) { /* All processes must agree before exchanging data */
++    errorPrint ("bdgraphBipartMlCoarsenVeex: communication error (1)");
++    chekglbval = 1;
++  }
++  if (chekglbval != 0) {
++    if (coarveexloctax != NULL)
++      memFree (coarveexloctax);
++    if (vsndcnttab != NULL)
++      memFree (vsndcnttab);                       /* Free group leader */
++    return (1);
++  }
++  coarveexloctax -= coarbaseval;
++
++  memSet (vsndcnttab, 0, fineprocglbnbr * sizeof (int));
++  finevertlocadj = fineprocvrttab[finegrafptr->s.proclocnum] - finebaseval;
++
++  for (coarvertlocnum = coarbaseval; coarvertlocnum < coarvertlocnnd; coarvertlocnum ++) { /* Sum local gains and count remote fine vertices per owner */
++    Gnum                finevertglbnum;
++    Gnum                coarveexval;
++    int                 i;
++
++    coarveexval = 0;
++    i = 0;
++    do {                                          /* For the two vertices of the multinode */
++      Gnum                finevertlocnum;
++
++      finevertglbnum = coarmulttax[coarvertlocnum].vertglbnum[i];
++      finevertlocnum = finevertglbnum - finevertlocadj;
++      if ((finevertlocnum >= finebaseval) &&      /* If fine multinode vertex is local */
++          (finevertlocnum <  finevertlocnnd))
++        coarveexval += fineveexloctax[finevertlocnum];
++      else                                        /* Multinode fine vertex is remote */
++        vsndcnttab[bdgraphBipartMlProcNum (fineprocvrttab, fineprocglbnbr, finevertglbnum)] ++;
++
++      i ++;                                       /* Process next multinode vertex */
++    } while (finevertglbnum != coarmulttax[coarvertlocnum].vertglbnum[1]); /* If not single node */
++
++    coarveexloctax[coarvertlocnum] = coarveexval; /* Record local part of external gain */
++  }
++
++  if (MPI_Alltoall (vsndcnttab, 1, MPI_INT, vrcvcnttab, 1, MPI_INT, finegrafptr->s.proccomm) != MPI_SUCCESS) {
++    errorPrint ("bdgraphBipartMlCoarsenVeex: communication error (2)");
++    return (1);
++  }
++
++  for (procnum = 0, vsnddspnbr = vrcvdspnbr = 0;  /* Build communication index arrays */
++       procnum < fineprocglbnbr; procnum ++) {
++    vsnddsptab[procnum] =
++    vsndidxtab[procnum] = vsnddspnbr;
++    vrcvdsptab[procnum] = vrcvdspnbr;
++    vsnddspnbr += vsndcnttab[procnum];
++    vrcvdspnbr += vrcvcnttab[procnum];
++  }
++
++  cheklocval = 0;
++  if ((vrcvdattab = (Gnum *) memAlloc (vrcvdspnbr * sizeof (Gnum))) == NULL) {
++    errorPrint ("bdgraphBipartMlCoarsenVeex: out of memory (3)");
++    cheklocval = 1;
++  }
++  if (MPI_Allreduce (&cheklocval, &chekglbval, 1, MPI_INT, MPI_MAX, finegrafptr->s.proccomm) != MPI_SUCCESS) { /* All processes must agree before exchanging data */
++    errorPrint ("bdgraphBipartMlCoarsenVeex: communication error (3)");
++    chekglbval = 1;
++  }
++  if (chekglbval != 0) {
++    if (vrcvdattab != NULL)
++      memFree (vrcvdattab);
++    memFree (coarveexloctax + coarbaseval);
++    memFree (vsndcnttab);                         /* Free group leader */
++    return (1);
++  }
++
++  for (coarvertlocnum = coarbaseval; coarvertlocnum < coarvertlocnnd; coarvertlocnum ++) { /* Pack requests for remote fine vertices */
++    Gnum                finevertglbnum;
++    int                 i;
++
++    i = 0;
++    do {                                          /* For the two vertices of the multinode */
++      Gnum                finevertlocnum;
++
++      finevertglbnum = coarmulttax[coarvertlocnum].vertglbnum[i];
++      finevertlocnum = finevertglbnum - finevertlocadj;
++      if ((finevertlocnum <  finebaseval) ||      /* If fine multinode vertex is remote */
++          (finevertlocnum >= finevertlocnnd)) {
++        int                 vsndidxnum;
++
++        vsndidxnum = vsndidxtab[bdgraphBipartMlProcNum (fineprocvrttab, fineprocglbnbr, finevertglbnum)] ++;
++        vsnddattab[vsndidxnum] = finevertglbnum;
++        vsndvrttab[vsndidxnum] = coarvertlocnum;
++      }
++
++      i ++;                                       /* Process next multinode vertex */
++    } while (finevertglbnum != coarmulttax[coarvertlocnum].vertglbnum[1]); /* If not single node */
++  }
++
++  if (MPI_Alltoallv (vsnddattab, vsndcnttab, vsnddsptab, GNUM_MPI, /* Send requests to owner processes */
++                     vrcvdattab, vrcvcnttab, vrcvdsptab, GNUM_MPI, finegrafptr->s.proccomm) != MPI_SUCCESS) {
++    errorPrint ("bdgraphBipartMlCoarsenVeex: communication error (4)");
++    return (1);
++  }
++
++  for (vrcvlocnum = 0; vrcvlocnum < vrcvdspnbr; vrcvlocnum ++) { /* Replace requested vertex numbers by their external gains */
++    Gnum                finevertlocnum;
++
++    finevertlocnum = vrcvdattab[vrcvlocnum] - finevertlocadj;
++#ifdef SCOTCH_DEBUG_BDGRAPH2
++    if ((finevertlocnum < finebaseval) || (finevertlocnum >= finevertlocnnd)) {
++      errorPrint ("bdgraphBipartMlCoarsenVeex: internal error");
++      return (1);
++    }
++#endif /* SCOTCH_DEBUG_BDGRAPH2 */
++    vrcvdattab[vrcvlocnum] = fineveexloctax[finevertlocnum];
++  }
++
++  if (MPI_Alltoallv (vrcvdattab, vrcvcnttab, vrcvdsptab, GNUM_MPI, /* Send back external gains to requesting processes */
++                     vsnddattab, vsndcnttab, vsnddsptab, GNUM_MPI, finegrafptr->s.proccomm) != MPI_SUCCESS) {
++    errorPrint ("bdgraphBipartMlCoarsenVeex: communication error (5)");
++    return (1);
++  }
++
++  for (vsndlocnum = 0; vsndlocnum < vsnddspnbr; vsndlocnum ++) /* Add external gains of remote fine vertices */
++    coarveexloctax[vsndvrttab[vsndlocnum]] += vsnddattab[vsndlocnum];
++
++  memFree (vrcvdattab);
++  memFree (vsndcnttab);                           /* Free group leader */
++
++  coargrafptr->veexloctax = coarveexloctax;
++
++  return (0);
++}
++
+ /* This routine builds a coarser graph from the
+ ** Dgraph that is given on input. The coarser
+ ** Dgraphs differ at this stage from classical
+@@ -117,40 +346,20 @@ const BdgraphBipartMlParam * const    paraptr)    /*+ Method parameters
+   coargrafptr->partgsttax = NULL;                 /* Do not allocate partition data yet */
+   coargrafptr->fronloctab = NULL;
+   coargrafptr->fronglbnbr = 0;
++  coargrafptr->veexloctax = NULL;                 /* Assume no external gains */
+ 
+-  if (coargrafptr->s.procglbnbr == 0) {           /* Not owner of graph */
+-    coargrafptr->veexloctax = NULL;
+-    return (0);
+-  }
+-
+-  if (finegrafptr->veexloctax != NULL) {          /* Merge external gains for coarsened vertices */
+-    DgraphCoarsenMulti * restrict coarmulttax;
+-    Gnum * restrict               coarveexloctax;
+-    Gnum                          coarvertlocnum;
+-
+-    if ((coarveexloctax = (Gnum *) memAlloc (coargrafptr->s.vertlocnbr * sizeof (Gnum))) == NULL) {
+-      errorPrint ("bdgraphBipartMlCoarsen: out of memory");
+-      dgraphExit (&coargrafptr->s);               /* Only free Dgraph since veexloctax not allocated */
++  if ((finegrafptr->veexloctax != NULL) &&        /* Merge external gains for coarsened vertices; all processes take part */
++      (bdgraphBipartMlCoarsenVeex (finegrafptr, coargrafptr, *coarmultptr) != 0)) {
++    errorPrint ("bdgraphBipartMlCoarsen: cannot compute external gains");
++    if (coargrafptr->s.procglbnbr != 0) {         /* Free coarse graph data if owner of graph */
++      dgraphExit (&coargrafptr->s);
+       memFree    (*coarmultptr + coargrafptr->s.baseval);
+-      return (1);
+-    }
+-    coarveexloctax -= coargrafptr->s.baseval;
+-    coargrafptr->veexloctax = coarveexloctax;
+-    coarmulttax = *coarmultptr;
+-
+-    for (coarvertlocnum = coargrafptr->s.baseval; coarvertlocnum < coargrafptr->s.vertlocnnd; coarvertlocnum++) {
+-      Gnum		finevertnum0;             /* First multinode vertex  */
+-      Gnum              finevertnum1;             /* Second multinode vertex */
+-
+-      finevertnum0 = coarmulttax[coarvertlocnum].vertglbnum[0];
+-      finevertnum1 = coarmulttax[coarvertlocnum].vertglbnum[1];
+-      coarveexloctax[coarvertlocnum] = (finevertnum0 != finevertnum1)
+-                                       ? finegrafptr->veexloctax[finevertnum0] + finegrafptr->veexloctax[finevertnum1]
+-                                       : finegrafptr->veexloctax[finevertnum0];
+     }
++    return (1);
+   }
+-  else                                            /* If fine graph does not have external gains */
+-    coargrafptr->veexloctax = NULL;               /* Coarse graph does not have external gains  */
++
++  if (coargrafptr->s.procglbnbr == 0)             /* Not owner of graph */
++    return (0);
+ 
+   coargrafptr->veexglbsum       = finegrafptr->veexglbsum;
+   coargrafptr->compglbload0min  = finegrafptr->compglbload0min; /* Only set constant partition parameters as others will be set on uncoarsening */
+@@ -610,6 +819,8 @@ const DgraphCoarsenMulti * restrict const coarmulttax) /*+ Multinode array +*/
+       }
+ #endif /* SCOTCH_DEBUG_BDGRAPH2 */
+       finepartgsttax[finevertlocnum] = 0;
++      if (fineveexloctax != NULL)
++        finecommlocgainextn += fineveexloctax[finevertlocnum];
+     }
+ 
+     for (vrcvidxnnd = vrcvidxnum + vrcvdattab[vrcvdsptab[procnum] + 1]; /* Vertices in sub-array 1 */
+@@ -656,6 +867,8 @@ const DgraphCoarsenMulti * restrict const coarmulttax) /*+ Multinode array +*/
+ #endif /* SCOTCH_DEBUG_BDGRAPH2 */
+       finepartgsttax[finevertlocnum] = 0;
+       finefronloctab[finefronlocnbr ++] = finevertlocnum;
++      if (fineveexloctax != NULL)
++        finecommlocgainextn += fineveexloctax[finevertlocnum];
+     }
+ 
+     for (vrcvidxnnd = vrcvdsptab[procnum] + vrcvcnttab[procnum]; /* Vertices in sub-array 3 */
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G23-vdgraph-dorder/0001-Bugfix-free-the-exchange-buffers-of-vdgraphSeparateM.patch b/upstream/reports/7.0.18/patches/G23-vdgraph-dorder/0001-Bugfix-free-the-exchange-buffers-of-vdgraphSeparateM.patch
new file mode 100644
index 0000000..6d2974f
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G23-vdgraph-dorder/0001-Bugfix-free-the-exchange-buffers-of-vdgraphSeparateM.patch
@@ -0,0 +1,52 @@
+From ed5b8ded7d0e0d6c5bcca608ae6a6cab1bfef782 Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 16:11:24 +0000
+Subject: [PATCH 1/7] Bugfix: free the exchange buffers of
+ `vdgraphSeparateMlUncoarsen()` when all coarse separators are invalid [report
+ R. Perry]
+
+The buffer group used to exchange fine part data was allocated before
+the reduction that selects the best coarse separator, and the routine
+returned without freeing it when every coarse separator had an empty
+part. This is a normal fallback path, after which the low strategy is
+applied at the upper level, so the leak repeated at every level of
+nested dissection where it occurred.
+
+Also compile the warning of this path under the Vdgraph debug flag
+rather than the Bdgraph one, which had been copied from the twin
+routine.
+
+Refs: DMO-05
+---
+ src/libscotch/vdgraph_separate_ml.c | 7 ++++---
+ 1 file changed, 4 insertions(+), 3 deletions(-)
+
+diff --git a/src/libscotch/vdgraph_separate_ml.c b/src/libscotch/vdgraph_separate_ml.c
+index e11c8eb5..2e85ad48 100644
+--- a/src/libscotch/vdgraph_separate_ml.c
++++ b/src/libscotch/vdgraph_separate_ml.c
+@@ -46,7 +46,7 @@
+ /**                # Version 6.0  : from : 11 sep 2012     **/
+ /**                                 to   : 28 sep 2014     **/
+ /**                # Version 7.0  : from : 27 aug 2019     **/
+-/**                                 to   : 31 oct 2026     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -447,9 +447,10 @@ const DgraphCoarsenMulti * restrict const coarmulttax) /*+ Based multinode array
+   }
+ 
+   if (reduglbtab[0] == 1) {                       /* If all possible partitions are invalid */
+-#ifdef SCOTCH_DEBUG_BDGRAPH2
++#ifdef SCOTCH_DEBUG_VDGRAPH2
+     errorPrintW ("vdgraphSeparateMlUncoarsen: no valid partition");
+-#endif /* SCOTCH_DEBUG_BDGRAPH2 */
++#endif /* SCOTCH_DEBUG_VDGRAPH2 */
++    memFree (vsndcnttab);                         /* Free group leader                                                        */
+     return (1);                                   /* All invalid partitions will lead to low method be applied at upper level */
+   }
+ 
+-- 
+2.43.0
+
diff --git a/upstream/reports/7.0.18/patches/G23-vdgraph-dorder/0002-Bugfix-agree-on-allocation-failures-in-vdgraphSepara.patch b/upstream/reports/7.0.18/patches/G23-vdgraph-dorder/0002-Bugfix-agree-on-allocation-failures-in-vdgraphSepara.patch
new file mode 100644
index 0000000..5c1e0d4
--- /dev/null
+++ b/upstream/reports/7.0.18/patches/G23-vdgraph-dorder/0002-Bugfix-agree-on-allocation-failures-in-vdgraphSepara.patch
@@ -0,0 +1,82 @@
+From 68ca16a93abdf38aac64f771a0e67b4deffb86ee Mon Sep 17 00:00:00 2001
+From: PyScotch <pyscotch@noreply.invalid>
+Date: Tue, 13 Oct 2026 16:13:34 +0000
+Subject: [PATCH 2/7] Bugfix: agree on allocation failures in
+ `vdgraphSeparateDf()` before using the diffusion arrays [report R. Perry]
+
+An allocation failure was flagged as a -1 in the slot of the summed
+reduction that holds the global degree of the first anchor vertex, so
+that it was masked by the positive degrees of the other processes, and
+the failing process then wrote through null pointers. When the sum did
+happen to be negative, the error branch freed the arrays but fell
+through into the diffusion loops instead of returning.
+
+Reduce a dedicated error flag along with the anchor data, and free the
+arrays and return on all processes when any of them failed.
+
+Refs: DMO-04
+---
+ src/libscotch/vdgraph_separate_df.c | 16 +++++++++-------
+ 1 file changed, 9 insertions(+), 7 deletions(-)
+
+diff --git a/src/libscotch/vdgraph_separate_df.c b/src/libscotch/vdgraph_separate_df.c
+index b96166b0..df10f2c0 100644
+--- a/src/libscotch/vdgraph_separate_df.c
++++ b/src/libscotch/vdgraph_separate_df.c
+@@ -1,4 +1,4 @@
+-/* Copyright 2007,2008,2023,2024 IPB, Universite de Bordeaux, INRIA & CNRS
++/* Copyright 2007,2008,2023,2024,2026 IPB, Universite de Bordeaux, INRIA & CNRS
+ **
+ ** This file is part of the Scotch software package for static mapping,
+ ** graph partitioning and sparse matrix ordering.
+@@ -43,7 +43,7 @@
+ /**   DATES      : # Version 5.1  : from : 05 nov 2007     **/
+ /**                                 to   : 09 nov 2008     **/
+ /**                # Version 7.0  : from : 20 jan 2023     **/
+-/**                                 to   : 09 aug 2024     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /************************************************************/
+ 
+@@ -97,8 +97,8 @@ const VdgraphSeparateDfParam * const  paraptr)    /*+ Method parameters +*/
+   float                           valolocval[2];  /* Fraction of load to remove from anchor vertices at each step */
+   Gnum                            vanclocnnd;
+   Gnum                            vertlocnum;
+-  Gnum                            reduloctab[4];  /* Local degree of both anchor vertices, minus edges to other anchors, and their loads */
+-  Gnum                            reduglbtab[4];
++  Gnum                            reduloctab[5];  /* Local degree of both anchor vertices, minus edges to other anchors, their loads, and error flag */
++  Gnum                            reduglbtab[5];
+   Gnum                            passnum;
+   float                           cdifval;
+   float                           cremval;
+@@ -125,22 +125,24 @@ const VdgraphSeparateDfParam * const  paraptr)    /*+ Method parameters +*/
+                      &difogsttax, (size_t) (grafptr->s.vertgstnbr * sizeof (float)),
+                      &difngsttax, (size_t) (grafptr->s.vertgstnbr * sizeof (float)), NULL) == NULL) {
+     errorPrint ("vdgraphSeparateDf: out of memory");
+-    reduloctab[0] = -1;
++    reduloctab[4] = 1;                            /* Flag allocation failure for all processes */
+   }
+   else {
+     ielsloctax -= grafptr->s.baseval;
+     difogsttax -= grafptr->s.baseval;
+     difngsttax -= grafptr->s.baseval;
++    reduloctab[4] = 0;
+   }
