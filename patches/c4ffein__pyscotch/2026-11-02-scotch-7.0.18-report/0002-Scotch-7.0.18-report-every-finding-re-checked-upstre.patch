+ 					$(EXECS) $(SCOTCHBINDIR)/mord $(TMPDIR)/m2_5_4_3.msh | $(SCOTCHBINDIR)/gotst $(TMPDIR)/m2_5_4_3.grf
++					$(EXECS) $(SCOTCHBINDIR)/mord $(TMPDIR)/m2_32_32.msh | $(SCOTCHBINDIR)/gotst $(TMPDIR)/m2_32_32.grf
