diff --git a/upstream/reports/7.0.18/patches/G22-bdgraph/0001-Bugfix-do-not-base-the-part-array-of-bdgraphBipartSq.patch b/upstream/reports/7.0.18/patches/G22-bdgraph/0001-Bugfix-do-not-base-the-part-array-of-bdgraphBipartSq.patch
