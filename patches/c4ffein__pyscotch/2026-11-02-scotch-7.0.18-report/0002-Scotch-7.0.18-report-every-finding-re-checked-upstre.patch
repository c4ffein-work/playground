diff --git a/upstream/repro/G25-metis-graph-part/CLI-03/cli03e.c b/upstream/repro/G25-metis-graph-part/CLI-03/cli03e.c
new file mode 100644
index 0000000..c3113bb
--- /dev/null
+++ b/upstream/repro/G25-metis-graph-part/CLI-03/cli03e.c
@@ -0,0 +1,33 @@
+/* CLI-03 edge cases (ubvec = 1.0, 1.001, 1.05, 0.05 legacy Scotch-style, -0.5): ubvec[0] (a METIS ratio such as 1.05) handed to Scotch as a deviation. */
+#include <stdio.h>
+#include <stdlib.h>
+#include "scotch.h"
+#include "metis.h"
+#include "../common/grid.h"
+#include "../common/metrics.h"
+int main (int argc, char * argv[])
+{
+  setvbuf (stdout, NULL, _IONBF, 0);
+  SCOTCH_Num n = 40 * 40, ncon = 1, nparts = 4, objval = -1, options[METIS_NOPTIONS];
+  SCOTCH_Num * xadj, * adjncy, * part = malloc (n * sizeof (SCOTCH_Num)), * vwgt = malloc (n * sizeof (SCOTCH_Num));
+  const double ubtab[] = { 1.0, 1.001, 1.05, 0.05, -0.5 };
+  int u, k, v;
+  srand (1);
+  for (v = 0; v < n; v ++) vwgt[v] = 1 + rand () % 10;
+  gridBuild (40, 40, 0, &xadj, &adjncy);
+  METIS_SetDefaultOptions (options);
+  for (k = 0; k < 2; k ++) {
+    for (u = 0; u < 6; u ++) {
+      double ub = (u == 5) ? 0.0 : ubtab[u];
+      const double * ubvec = (u == 5) ? NULL : &ub;
+      int r;
+      SCOTCH_randomReset ();
+      r = (k == 0) ? METIS_PartGraphKway      (&n, &ncon, xadj, adjncy, vwgt, NULL, NULL, &nparts, NULL, ubvec, options, &objval, part)
+                   : METIS_PartGraphRecursive (&n, &ncon, xadj, adjncy, vwgt, NULL, NULL, &nparts, NULL, ubvec, options, &objval, part);
+      if (r != METIS_OK) { printf ("%s ubvec=%s: ret=%d\n", k ? "Recursive" : "Kway", ubvec ? "set" : "NULL", r); continue; }
+      printf ("%-9s ubvec=%-5g ret=%d cut=%4ld imbalance=%.4f (max part load / ideal)\n", k ? "Recursive" : "Kway", ub, r, (long) objval,
+              imbalCompute (n, 0, vwgt, 1, 0, nparts, NULL, part));
+    }
+  }
+  return 0;
+}
diff --git a/upstream/repro/G25-metis-graph-part/PS3-G25-1/fixmerge.c b/upstream/repro/G25-metis-graph-part/PS3-G25-1/fixmerge.c
new file mode 100644
index 0000000..dcd63fd
--- /dev/null
+++ b/upstream/repro/G25-metis-graph-part/PS3-G25-1/fixmerge.c
@@ -0,0 +1,25 @@
+/* PS3-G25-1: SCOTCH_graphMapFixed with one fixed vertex onto a 32-part complete graph.
+** Since 22c9c42e, kgraphMapRbVfloMerge() sizes its hash table from the number of fixed
+** domains only (8 slots here), but first inserts all the domains of the computed mapping. */
+#include <stdio.h>
+#include <stdlib.h>
+#include "scotch.h"
+#define N 64
+int main (int argc, char ** argv)
+{
+  SCOTCH_Graph g; SCOTCH_Arch a; SCOTCH_Strat s;
+  SCOTCH_Num v[N + 1], e[2 * N], p[N], n = 0, i, k = (argc > 1) ? atoi (argv[1]) : 32, used[64] = { 0 }, cnt = 0;
+  for (i = 0; i < N; i ++) {                      /* Ring of N vertices */
+    v[i] = n; e[n ++] = (i + N - 1) % N; e[n ++] = (i + 1) % N; p[i] = -1;
+  }
+  v[N] = n;
+  p[0] = 0;                                       /* One fixed vertex */
+  SCOTCH_graphInit (&g); SCOTCH_graphBuild (&g, 0, N, v, NULL, NULL, NULL, n, e, NULL);
+  SCOTCH_archInit (&a); SCOTCH_archCmplt (&a, k); SCOTCH_stratInit (&s);
+  printf ("calling SCOTCH_graphMapFixed onto K%ld\n", (long) k); fflush (stdout);
+  i = SCOTCH_graphMapFixed (&g, &a, &s, p);
+  for (n = 0; n < N; n ++) if (! used[p[n]]) { used[p[n]] = 1; cnt ++; }
+  printf ("returned %ld, %ld distinct parts, p[0]=%ld\n", (long) i, (long) cnt, (long) p[0]);
+  SCOTCH_stratExit (&s); SCOTCH_archExit (&a); SCOTCH_graphExit (&g);
+  return (0);
+}
