+     bandvnumgsttax -= grafptr->baseval;
+   }
+@@ -179,83 +177,78 @@ Context *                           contptr)      /*+ Execution context
+   bandgrafptr->flagval = (DGRAPHFREEALL ^ DGRAPHFREECOMM) | DGRAPHVERTGROUP | DGRAPHEDGEGROUP; /* Arrays created by the routine itself */
