++  bandvnumgstsiz = MAX (grafptr->vertgstnbr, grafptr->procglbnbr) * sizeof (Gnum); /* TRICK: re-use array for further error collective communications */
++  if ((bandvnumgsttax = memAlloc (bandvnumgstsiz)) == NULL) /* Error will be propagated by dgraphBand2*() */
