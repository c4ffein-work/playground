+ int                         meshGraphDual       (const Mesh * restrict const, Graph * restrict const, const Gnum);
+ int                         meshInduceList      (const Mesh *, Mesh *, const VertList *);
+--- a/src/libscotch/hmesh.c	2026-10-13 08:40:02.895403980 +0000
++++ b/src/libscotch/hmesh.c	2026-10-13 13:24:28.301914523 +0000
+@@ -81,35 +81,3 @@
