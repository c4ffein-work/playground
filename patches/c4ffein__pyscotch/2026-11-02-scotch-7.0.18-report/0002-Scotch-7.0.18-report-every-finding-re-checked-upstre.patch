+@@ -43,7 +43,7 @@
+ /**                # Version 6.0  : from : 03 apr 2012     **/
+ /**                                 to   : 22 may 2018     **/
+ /**                # Version 7.0  : from : 08 oct 2021     **/
+-/**                                 to   : 17 jan 2023     **/
++/**                                 to   : 02 nov 2026     **/
+ /**                                                        **/
+ /**   NOTES      : # This code derives from the code of    **/
+ /**                  vdgraph_separate_bd.c in version      **/
+@@ -144,7 +144,6 @@ Context *                           contptr)      /*+ Execution context
+   Gnum                    veloval;
+   const Gnum * restrict   edgegsttax;
+   Gnum                    fronlocnum;
+-  int                     cheklocval;
+   int                     procngbnum;
+ 
+   if (dgraphGhst (grafptr) != 0) {                /* Compute ghost edge array if not already present */
+@@ -152,11 +151,10 @@ Context *                           contptr)      /*+ Execution context
