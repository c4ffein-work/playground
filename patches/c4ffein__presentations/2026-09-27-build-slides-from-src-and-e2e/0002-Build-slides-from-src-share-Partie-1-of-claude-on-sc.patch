+# {'aa': 6, 'bb': 8}</code></pre>
+        </section>
+
+      <section>
+        <h2>Conditional</h2>
+        <pre><code class="python"># Creating lists with loop logic
+squares = [x * x for x in range(10)]
+# With conditions
