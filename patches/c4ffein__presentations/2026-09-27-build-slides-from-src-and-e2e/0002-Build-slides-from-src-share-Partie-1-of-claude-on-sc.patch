+      </section>
+
+      <!-- Exception Handling -->
+      <section>
+        <section>
+          <h2>Exception Handling</h2>
+          <pre><code class="python small-code">class SpecificKindOfValueError(ValueError):
+      """Defines an Exception inheriting from ValueError"""
+      pass
+</code></pre>
+        </section>
+        <section>
+          <h2>Exception Handling</h2>
+          <pre><code class="python small-code">try:
