+    def make_sound(self):
+        """This method must be implemented by subclasses"""
+        pass
+
+    def eat(self):
+        print("Eating...")
+
+class Dog(Animal):
+    def make_sound(self):
+        return "Woof!"
+</code></pre>
+      </section>
+        <section>
+          <h2>Abstract Classes</h2>
+          <pre><code class="python"># This works
+dog = Dog()
+print(dog.make_sound())  # Woof!
+
+# This would raise TypeError
