+++ b/resources/include.js
@@ -0,0 +1,52 @@
+/* include.js — share a set of slides between decks, with no build step.
+ *
+ * In a deck (slides live in slides/, shared parts in parts/):
+ *   <section data-include="../parts/mental-model-llm.html"></section>
+ *   ...
+ *   <script src="../resources/include.js"></script>
+ *   <script src="../engine/dist/reveal.js"></script>
+ *   ...
+ *   <script>window.slideIncludes.then(function () { Reveal.initialize({...}); });</script>
+ *
+ * Each placeholder is replaced, in place, by the top-level <section>s of the
+ * fetched file, so the deck decides the order and what surrounds the part.
+ * Reveal must be initialized AFTER window.slideIncludes resolves (it always
+ * resolves: a part that fails to load becomes one red error slide, so the
+ * deck still runs and the e2e tests see the 404). Scripts inside a part are
+ * not executed; URLs in a part resolve relative to the including deck.
+ * Terminal recordings inside a part are mounted once everything is in.
+ *
+ * Like the recordings and transcripts, this needs HTTP: fetch() is blocked
+ * on file:// (python3 -m http.server).
+ */
+(function () {
+  var nodes = Array.prototype.slice.call(document.querySelectorAll("section[data-include]"));
+
+  function fail(node, url, err) {
+    node.innerHTML = "";
+    var h = document.createElement("h3");
+    h.textContent = "Part not loaded";
+    var p = document.createElement("p");
+    p.setAttribute("style", "font-size:0.5em;color:#c00;");
+    p.textContent = url + " — " + (err && err.message || err) +
+      (location.protocol === "file:" ? " — fetch() is blocked on file://, serve over http (python3 -m http.server)" : "");
+    node.appendChild(h);
+    node.appendChild(p);
+  }
+
+  function include(node) {
+    var url = node.getAttribute("data-include");
+    return fetch(url, { cache: "no-store" }).then(function (r) {
+      if (!r.ok) throw new Error("HTTP " + r.status + " " + r.statusText);
+      return r.text();
+    }).then(function (html) {
+      var tpl = document.createElement("template");
+      tpl.innerHTML = html;
+      node.replaceWith(tpl.content);
+    }).catch(function (err) { fail(node, url, err); });
+  }
+
+  window.slideIncludes = Promise.all(nodes.map(include)).then(function () {
+    if (window.TermPlayer) window.TermPlayer.init();
+  });
+})();
