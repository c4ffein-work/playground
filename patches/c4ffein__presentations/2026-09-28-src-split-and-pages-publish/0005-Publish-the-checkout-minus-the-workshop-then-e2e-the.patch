+      - uses: ./.github/actions/chromium
       - run: make verify
+
+  # GitHub Pages gets the checkout minus the workshop, from master, once
+  # verify passed (so the decks online are the ones `make check` proved built
+  # from src/). One-time setup on the repo: Settings → Pages → Build and
+  # deployment → Source: GitHub Actions.
+  pages:
+    if: github.event_name == 'push' && github.ref == 'refs/heads/master'
+    needs: verify
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    permissions:
+      contents: read
+      pages: write
+      id-token: write
+    environment:
+      name: github-pages
+      url: ${{ steps.deploy.outputs.page_url }}
+    concurrency:
+      group: pages
+      cancel-in-progress: false
+    outputs:
+      page_url: ${{ steps.deploy.outputs.page_url }}
+    steps:
+      - uses: actions/checkout@v4
+      # upload-pages-artifact leaves out .git and .github by itself.
+      - run: rm -rf src Makefile README.md TODO.md LICENSE .gitignore .nojekyll
+      - uses: actions/configure-pages@v5
+      - uses: actions/upload-pages-artifact@v3
+        with:
+          path: .
+      - id: deploy
+        uses: actions/deploy-pages@v4
+
+  # The deck e2e tests once more, against the site just deployed: first every
+  # live deck must be byte-for-byte the built one, then each is opened from
+  # the live URL with the same checks as locally.
+  pages-check:
+    needs: pages
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    steps:
+      - uses: actions/checkout@v4
+      - uses: oven-sh/setup-bun@v2
+      - run: make install
+      - uses: ./.github/actions/chromium
+      - run: make test-live
+        env:
+          E2E_BASE: ${{ needs.pages.outputs.page_url }}
