-import { readdirSync, readFileSync, writeFileSync, existsSync, mkdirSync } from "node:fs";
+import { readdirSync, readFileSync, writeFileSync, existsSync, mkdirSync, rmSync, cpSync } from "node:fs";
 import path from "node:path";
 
 export const DIRECTIVE = /^([ \t]*)<!--\s*@include\s+(\S+)\s*-->[ \t]*$/;
@@ -73,9 +74,31 @@ export function build(root, { check = false } = {}) {
   return { problems, written, names };
 }
 
+// What GitHub Pages publishes — the index pages, the built decks and everything
+// they load at runtime — and nothing else (not src/, not the notes). The deploy
+// job copies exactly this list to _site/, and the e2e server serves only it, so
+// a deck reaching for anything else fails the tests before it 404s online. A
+// new top-level directory the decks refer to (audio/, say) goes here.
+export const SITE = ["index.html", "404.html", "slides", "engine", "resources", "transcripts"];
+
+// site(root, dir): copy the published set into `dir`, emptied first.
+export function site(root, dir) {
+  rmSync(dir, { recursive: true, force: true });
+  mkdirSync(dir, { recursive: true });
+  for (const entry of SITE) cpSync(path.join(root, entry), path.join(dir, entry), { recursive: true });
+  return SITE;
+}
+
 if (import.meta.main) {
   const args = process.argv.slice(2);
   const root = path.resolve(import.meta.dir, "..");
+  const siteAt = args.indexOf("--site");
+  if (siteAt >= 0) {
+    const dir = path.resolve(root, args[siteAt + 1] || "_site");
+    site(root, dir);
+    console.log(`copied ${SITE.join(", ")} to ${path.relative(root, dir)}/`);
+    process.exit(0);
+  }
   const check = args.includes("--check");
   const { problems, written, names } = build(root, { check });
   for (const p of problems) console.error("error: " + p);
