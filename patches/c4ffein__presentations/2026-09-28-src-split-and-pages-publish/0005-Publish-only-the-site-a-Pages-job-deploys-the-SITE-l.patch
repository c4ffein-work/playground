 export function startServer(extra) {
   return Bun.serve({
@@ -12,6 +16,7 @@ export function startServer(extra) {
       if (extra) { const r = await extra(url, req); if (r) return r; }
       let p = decodeURIComponent(url.pathname);
       if (p.endsWith("/")) p += "index.html";
+      if (!SITE.includes(p.split("/")[1]) && !p.startsWith(FIXTURES)) return new Response("not published: " + p, { status: 404 });
       const file = path.resolve(ROOT, "." + p);
       if (!file.startsWith(ROOT + path.sep)) return new Response("forbidden", { status: 403 });
       const f = Bun.file(file);
