diff --git a/.github/workflows/verify.yml b/.github/workflows/verify.yml
index 3ebf2ab..e131a0b 100644
--- a/.github/workflows/verify.yml
+++ b/.github/workflows/verify.yml
@@ -24,3 +24,32 @@ jobs:
       - if: steps.browsers.outputs.cache-hit == 'true'
         run: make browsers-deps
       - run: make verify
+
+  # GitHub Pages gets only the site — `make site` = the SITE list in
+  # src/build.js — from master, once verify passed. One-time setup: the repo's
+  # Settings → Pages → Build and deployment → Source: GitHub Actions.
+  pages:
+    if: github.event_name == 'push' && github.ref == 'refs/heads/master'
+    needs: verify
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    permissions:
+      contents: read
+      pages: write
+      id-token: write
+    environment:
+      name: github-pages
+      url: ${{ steps.deploy.outputs.page_url }}
+    concurrency:
+      group: pages
+      cancel-in-progress: false
+    steps:
+      - uses: actions/checkout@v4
+      - uses: oven-sh/setup-bun@v2
+      - run: make site
+      - uses: actions/configure-pages@v5
+      - uses: actions/upload-pages-artifact@v3
+        with:
+          path: _site
+      - id: deploy
+        uses: actions/deploy-pages@v4
