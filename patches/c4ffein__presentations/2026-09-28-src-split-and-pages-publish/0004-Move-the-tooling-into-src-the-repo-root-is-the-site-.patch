+            "new": "<!DOCTYPE html>\n<!--\n  DRAFT — talk at Inria, 2026. Structure v1, iterating with Claude.\n  Arc: Partie 1 la courbe (pas de plafond) / Partie 2 l'arc Scotch /\n  Partie 3 trois idées / Closer: Claude Science.\n  TODO() markers = waiting on material from c4ffein.\n-->\n<html>\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n    <title>Toujours pas de plafond</title>\n    <link rel=\"stylesheet\" href=\"../engine/dist/reset.css\">\n    <link rel=\"stylesheet\" href=\"../engine/dist/reveal.css\">\n    <link rel=\"stylesheet\" href=\"../engine/dist/theme/c4ffein.css\">\n    <!-- Theme used for syntax highlighted code -->\n    <link rel=\"stylesheet\" href=\"../engine/dist/plugin/highlight/c4ffein-light.css\">\n    <link rel=\"stylesheet\" href=\"../resources/claude-terminal.css\">\n    <link rel=\"stylesheet\" href=\"../engine/runcss/runcss.min.css\">\n    <script src=\"../engine/runcss/runcss.min.js\" defer watch></script>\n</head>\n<body>\n  <div class=\"reveal\">\n    <div class=\"slides\">\n\n    <!-- ===== Titre ===== -->\n    <section>\n      <h1 style=\"margin-bottom:0.3em;\">Toujours pas de plafond</h1>\n      <p style=\"font-size:0.6em;\">Coder — et chercher — avec Claude en 2026</p>\n    </section>\n\n    <!-- ===== Cold open : le graphe à 3 sommets ===== -->\n    <section>\n      <!-- TODO(scotch): replace with the actual 3-vertex minimal counterexample\n           from hegel-c tests/irl/scotch/test_graph_order_shrink.c -->\n      <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 380\" width=\"760\" height=\"380\" style=\"width:70%;max-width:760px;height:auto;display:block;margin:0 auto;\">\n        <line x1=\"180\" y1=\"280\" x2=\"380\" y2=\"100\" stroke=\"#1a1a1a\" stroke-width=\"3\"/>\n        <line x1=\"380\" y1=\"100\" x2=\"580\" y2=\"280\" stroke=\"#1a1a1a\" stroke-width=\"3\"/>\n        <circle cx=\"180\" cy=\"280\