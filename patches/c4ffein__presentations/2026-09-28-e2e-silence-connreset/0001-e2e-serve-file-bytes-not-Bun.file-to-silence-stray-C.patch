From 06180262380f9daf452b578f2946bf1b079dc944 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 28 Sep 2026 08:41:29 +0000
Subject: [PATCH] e2e: serve file bytes, not Bun.file, to silence stray
 CONNRESET
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

`bun test tests/e2e` passed but occasionally printed a bare
`Error: CONNRESET` line. It is not the afterAll teardown: strace shows
every client socket already closed by Chromium before `server.stop(true)`
runs, and the route.abort() in the narration test never reaches TCP.

The reset happens mid-test, in the first deck (claude-on-scotch): Reveal
lazy-loads its `<iframe data-src="perf-trace.html">` and unloads it a few
ms later, so Chromium cancels the request (the net::ERR_ABORTED the test
already tolerates) and closes the keep-alive connection with the response
still unread, which the kernel turns into a TCP RST. A `Bun.file` response
body is sent with sendfile(), and Bun's sendfile loop prints
`Error: <errno>` straight to stderr when the call fails with anything but
EAGAIN/EPIPE/ENOTCONN — here CONNRESET, when the RST lands between the
request being read and the next sendfile() call. That window depends on
event-loop timing, hence the flakiness (4800 forced aborts against the
server: 19 lines before, 0 after).

Return the file's bytes instead: a buffered body goes through plain
socket writes, which fail silently. Content-Type is set from
`Bun.file().type`, which is exactly what the file body used to set
(checked for every extension in the repo); Content-Length and no-store
are unchanged. The files are at most ~1 MB, so buffering is fine for a
test server.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01J3xZETYoDeigjFh8AAp1sy
---
 tests/e2e/server.js | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/tests/e2e/server.js b/tests/e2e/server.js
index 6cbfaea..7e76e13 100644
--- a/tests/e2e/server.js
+++ b/tests/e2e/server.js
@@ -16,7 +16,11 @@ export function startServer(extra) {
       if (!file.startsWith(ROOT + path.sep)) return new Response("forbidden", { status: 403 });
       const f = Bun.file(file);
       if (!(await f.exists())) return new Response("not found: " + p, { status: 404 });
-      return new Response(f, { headers: { "Cache-Control": "no-store" } });
+      // The bytes, not the Bun.file: a file body goes out through sendfile(),
+      // and when Chromium drops the connection mid-transfer (it cancels the
+      // lazy iframe it just started loading) that path prints a stray
+      // `Error: CONNRESET` on stderr. A buffered body fails silently.
+      return new Response(await f.arrayBuffer(), { headers: { "Content-Type": f.type, "Cache-Control": "no-store" } });
     },
   });
 }
