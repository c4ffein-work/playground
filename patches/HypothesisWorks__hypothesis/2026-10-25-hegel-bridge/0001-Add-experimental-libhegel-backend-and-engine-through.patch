+# This Source Code Form is subject to the terms of the Mozilla Public License,
+# v. 2.0. If a copy of the MPL was not distributed with this file, You can
+# obtain one at https://mozilla.org/MPL/2.0/.
+
+"""
+EXPERIMENT: libhegel, the native Rust engine behind the Hegel property-based
+testing libraries, as a Hypothesis backend.
+
+``settings(backend="hegel")`` routes every ``draw_*`` of the generate phase to
+libhegel, through the ``hegel._native`` extension of the ``hegeltest``
+package (Hegel's own Python frontend), and keeps everything else in Python: Hypothesis still owns the run loop, the database, health checks and
+shrinking (it shrinks by replaying the recorded choices through its own
+provider, as for any alternative backend). libhegel therefore runs with only
+its generate phase enabled, with a large ``test_cases`` budget, no database and
+all health checks suppressed.
+
+Draws map one-to-one onto libhegel primitives except where the two engines'
+vocabularies differ; those cases are documented on the methods below.
+"""
+
+import base64
+import contextlib
+import math
+import random
+import struct
+import zlib
+from collections.abc import Callable, Iterator
+from functools import cached_property
+from typing import Any, TypeVar
+
+from hypothesis.errors import (
+    BackendCannotProceed,
+    InvalidArgument,
+    StopTest,
+    UnsatisfiedAssumption,
+)
+from hypothesis.internal.conjecture.choice import ChoiceT
+from hypothesis.internal.conjecture.providers import (
+    COLLECTION_DEFAULT_MAX_SIZE,
+    HypothesisProvider,
+    PrimitiveProvider,
+    _get_local_constants,
+)
+from hypothesis.internal.conjecture.utils import LABEL_MASK
+from hypothesis.internal.intervalsets import IntervalSet
+
+try:
+    from hegel import _native
+except ImportError:  # pragma: no cover
+    _native = None
+
+T = TypeVar("T")
+
+INT64_MIN = -(2**63)
+INT64_MAX = 2**63 - 1
+# HypothesisProvider bounds unbounded integer draws at [-2**128, 2**128].
+UNBOUNDED_MAGNITUDE = 2**128
+# libhegel's generate-phase budget per run. Hypothesis decides when a test
+# function is done; when libhegel's budget runs out we simply start a new run.
+RUN_TEST_CASES = 10**9
+SURROGATES = (0xD800, 0xDFFF)
+
+
+class HegelOverrun(BackendCannotProceed):
+    """libhegel ran out of choice budget for the current test case."""
+
+    def __init__(self) -> None:
+        super().__init__("discard_test_case")
+
+
+def _signed_bytes(n: int) -> bytes:
+    return n.to_bytes(n.bit_length() // 8 + 1, "little", signed=True)
+
+
+def _is_surrogate_range(lo: int, hi: int) -> bool:
+    return SURROGATES[0] <= lo and hi <= SURROGATES[1]
+
+
+def native() -> Any:
+    """The ``hegel._native`` module, or an error naming the dependency."""
+    if _native is None:  # pragma: no cover
+        raise InvalidArgument(
+            "The libhegel engine needs the hegeltest package (pip install hegeltest)"
+        )
+    return _native
+
+
+def all_health_checks() -> int:
+    n = native()
+    return (
+        n.HC_FILTER_TOO_MUCH
+        | n.HC_TOO_SLOW
+        | n.HC_TEST_CASES_TOO_LARGE
+        | n.HC_LARGE_INITIAL_TEST_CASE
+    )
+
+
+def engine_settings(
+    test_cases: int,
+    *,
+    seed: int | None = None,
+    phases: int | None = None,
+    suppress_health_check: int | None = None,
+    report_multiple_failures: bool = False,
+    nondeterminism_strictness: int | None = None,
+) -> Any:
+    """libhegel settings for a run Hypothesis drives: no database, quiet."""
+    n = native()
+    s = n.Settings.new()
+    s.set_test_cases(test_cases)
+    s.set_phases(n.PHASE_GENERATE if phases is None else phases)
+    s.set_suppress_health_check(
+        all_health_checks() if suppress_health_check is None else suppress_health_check
+    )
+    s.set_seed(seed)
+    s.set_report_multiple_failures(report_multiple_failures)
+    s.set_nondeterminism_strictness(
+        n.NONDETERMINISM_QUIET
+        if nondeterminism_strictness is None
+        else nondeterminism_strictness
+    )
+    s.set_database("")
+    s.set_verbosity(n.VERBOSITY_QUIET)
+    s.set_print_blob(False)
+    return s
+
+
+class HegelProvider(PrimitiveProvider):
+    lifetime = "test_function"
+
+    def __init__(self, conjecturedata: Any, /) -> None:
+        super().__init__(conjecturedata)
+        self._settings = engine_settings(RUN_TEST_CASES)
+        self._run: Any = None
+        self._tc: Any = None
+        self._tc_done = False
+        self._span_depth = 0
+        self._drew = False
+        self._in_context = False
+        self._generators: dict[tuple[IntervalSet, int, int], Any] = {}
+        self.runs_started = 0
+        # Constant injection (HypothesisProvider._maybe_draw_constant) is a
+        # frontend feature, not an engine one: the pool is mined from the
+        # user's Python source. It uses the global PRNG, which Hypothesis
+        # seeds deterministically around every test case. Set to None to
+        # turn it off (the replay tests do).
+        self._random: Any = random.Random(0)
+
+    # -- run / test-case lifecycle ---------------------------------------
+
+    def _test_case(self) -> Any:
+        """The current libhegel test case, opening a run and a case lazily
+        so that draws outside |per_test_case_context_manager| (direct
+        |ConjectureData| use) work too."""
+        if self._tc is not None:
+            return self._tc
+        for _ in range(2):
+            if self._run is None:
+                self._run = native().Run.start(self._settings)
+                self.runs_started += 1
+            self._tc = self._run.next_test_case()
+            self._tc_done = False
+            if self._tc is not None:
+                return self._tc
+            # The run ended (its budget, or a failure closed it): start afresh.
+            self._run = None
+        raise BackendCannotProceed("exhausted")
+
+    def _complete(self, status: int, origin: str | None = None) -> None:
+        tc, self._tc = self._tc, None
+        self._span_depth = 0
+        self._drew = False
+        if tc is not None and not self._tc_done:
+            self._tc_done = True
+            tc.mark_complete(status, origin)
+
+    @contextlib.contextmanager
+    def per_test_case_context_manager(self) -> Iterator[None]:
+        self._complete(native().STATUS_VALID)
+        self._test_case()
+        self._in_context = True
+        try:
+            yield
+        except HegelOverrun:
+            self._complete(native().STATUS_OVERRUN)
+            raise
+        except (StopTest, UnsatisfiedAssumption, BackendCannotProceed):
+            self._complete(native().STATUS_INVALID)
+            raise
+        except Exception as e:
+            tb = e.__traceback__
+            while tb is not None and tb.tb_next is not None:
+                tb = tb.tb_next
+            where = (
+                ""
+                if tb is None
+                else f"@{tb.tb_frame.f_code.co_filename}:{tb.tb_lineno}"
+            )
+            self._complete(
+                native().STATUS_INTERESTING, f"{type(e).__qualname__}{where}"
+            )
+            raise
+        except BaseException:
+            self._complete(native().STATUS_INVALID)
+            raise
+        else:
+            self._complete(native().STATUS_VALID)
+        finally:
+            self._in_context = False
+
+    @cached_property
+    def _local_constants(self) -> Any:
+        return _get_local_constants()
+
+    def _constant(
+        self, choice_type: str, constraints: dict[str, Any], **kw: Any
+    ) -> Any:
+        if self._random is None:
+            return None
+        return HypothesisProvider._maybe_draw_constant(self, choice_type, constraints, **kw)  # type: ignore
+
+    def _draw(self, f: Callable[[Any], T]) -> T:
+        self._drew = True
+        try:
+            return f(self._test_case())
+        except native().StopTest:
+            raise HegelOverrun from None
+        except native().AssumeFailed:
+            raise BackendCannotProceed("discard_test_case") from None
+
+    # -- draws -------------------------------------------------------------
+
+    def draw_boolean(self, p: float = 0.5) -> bool:
+        return self._draw(lambda tc: tc.generate_boolean(p))
+
+    def draw_forced(
+        self, choice_type: str, constraints: dict[str, Any], value: Any
+    ) -> None:
+        """A draw whose value Hypothesis decided itself (``forced=``):
+        record it in libhegel's choice sequence so the two stay aligned.
+        Hypothesis forces only booleans and integers; an integer past int64
+        cannot be recorded yet and is skipped."""
+        if choice_type == "boolean":
+            self._draw(lambda tc: tc.generate_boolean(constraints["p"], forced=value))
+        elif choice_type == "integer":
+            lo, hi = self._integer_bounds(
+                constraints["min_value"],
+                constraints["max_value"],
+                constraints["shrink_towards"],
+            )
+            if INT64_MIN <= lo and hi <= INT64_MAX:
+                self._draw(lambda tc: tc.generate_integer(lo, hi, forced=value))
+
+    @staticmethod
+    def _integer_bounds(
+        min_value: int | None, max_value: int | None, shrink_towards: int
+    ) -> tuple[int, int]:
+        if min_value is None and max_value is None:
+            return (
+                shrink_towards - UNBOUNDED_MAGNITUDE,
+                shrink_towards + UNBOUNDED_MAGNITUDE,
+            )
+        if min_value is None:
+            assert max_value is not None
+            return -max(UNBOUNDED_MAGNITUDE, 2 * abs(max_value)), max_value
+        if max_value is None:
+            return min_value, max(UNBOUNDED_MAGNITUDE, 2 * abs(min_value))
+        return min_value, max_value
+
+    def _draw_bounded_integer(self, lo: int, hi: int) -> int:
+        return self._draw(lambda tc: tc.generate_integer(lo, hi))
+
+    def draw_integer(
+        self,
+        min_value: int | None = None,
+        max_value: int | None = None,
+        *,
+        weights: dict[int, float] | None = None,
+        shrink_towards: int = 0,
+    ) -> int:
+        """libhegel has no unbounded integer draw: unbounded and half-bounded
+        ranges are clamped the way HypothesisProvider clamps them (2**128
+        around the bound / origin). Weights go to libhegel's weighted draw
+        when the bounds fit int64; past that they are emulated as
+        HypothesisProvider does, with the keys picked uniformly.
+        """
+        constraints = {
+            "min_value": min_value,
+            "max_value": max_value,
+            "weights": weights,
+            "shrink_towards": shrink_towards,
+        }
+        if (constant := self._constant("integer", constraints)) is not None:
+            return constant
+        if weights is not None:
+            assert min_value is not None
+            assert max_value is not None
+            if INT64_MIN <= min_value and max_value <= INT64_MAX:
+                keys, ws = list(weights), list(weights.values())
+                st = min(max(shrink_towards, min_value), max_value)
+                return self._draw(
+                    lambda tc: tc.generate_integer_weighted(
+                        min_value, max_value, keys, ws, st
+                    )
+                )
+            if self.draw_boolean(sum(weights.values())):
+                keys = list(weights)
+                return keys[self._draw_bounded_integer(0, len(keys) - 1)]
+            return self._draw_bounded_integer(min_value, max_value)
+        lo, hi = self._integer_bounds(min_value, max_value, shrink_towards)
+        if shrink_towards and INT64_MIN <= lo and hi <= INT64_MAX:
+            # the weighted entry point is the one that carries shrink_towards
+            st = min(max(shrink_towards, lo), hi)
+            return self._draw(
+                lambda tc: tc.generate_integer_weighted(lo, hi, [], [], st)
+            )
+        return self._draw_bounded_integer(lo, hi)
+
+    def draw_float(
+        self,
+        *,
+        min_value: float = -math.inf,
+        max_value: float = math.inf,
+        allow_nan: bool = True,
+        smallest_nonzero_magnitude: float,
+    ) -> float:
+        constraints = {
+            "min_value": min_value,
+            "max_value": max_value,
+            "allow_nan": allow_nan,
+            "smallest_nonzero_magnitude": smallest_nonzero_magnitude,
+        }
+        if (constant := self._constant("float", constraints, p=0.15)) is not None:
+            return constant
+        return self._draw(
+            lambda tc: tc.generate_float(
+                64,
+                min_value,
+                max_value,
+                allow_nan,
+                # Hypothesis says "infinity allowed" through an infinite bound;
+                # libhegel wants the flag too, and rejects it with finite bounds.
+                math.isinf(min_value) or math.isinf(max_value),
+                False,
+                False,
+                smallest_nonzero_magnitude,
+            )
+        )
+
+    def _text_generator(
+        self, intervals: IntervalSet, min_size: int, max_size: int
+    ) -> Any:
+        """A libhegel text generator over exactly ``intervals`` (libhegel
+        drops surrogates), or None when the alphabet is nothing but
+        surrogates, which only the per-character fallback can draw."""
+        key = (intervals, min_size, max_size)
+        if key in self._generators:
+            return self._generators[key]
+        gen = None
+        if any(not _is_surrogate_range(lo, hi) for lo, hi in intervals.intervals):
+            gen = native().StringGenerator.text_ranges(
+                min_size, max_size, list(intervals.intervals)
+            )
+        self._generators[key] = gen
+        return gen
+
+    def draw_string(
+        self,
+        intervals: IntervalSet,
+        *,
+        min_size: int = 0,
+        max_size: int = COLLECTION_DEFAULT_MAX_SIZE,
+    ) -> str:
+        """One libhegel string choice over the exact alphabet. An alphabet of
+        nothing but surrogates (which libhegel cannot hold in a string) falls
+        back to libhegel's collection sizing plus one character index per
+        element, picked as HypothesisProvider picks them."""
+        if len(intervals) == 0:
+            return ""
+        constraints = {
+            "intervals": intervals,
+            "min_size": min_size,
+            "max_size": max_size,
+        }
+        if (constant := self._constant("string", constraints)) is not None:
+            return constant
+        gen = self._text_generator(intervals, min_size, max_size)
+        if gen is not None:
+            return self._draw(lambda tc: tc.generate_string(gen)).decode(
+                "utf-8", "surrogatepass"
+            )
+        collection = self._draw(lambda tc: tc.new_collection(min_size, max_size))
+        chars = []
+        while self._draw(lambda tc: collection.more(tc)):
+            if self._random is None:
+                i = self._draw_bounded_integer(0, len(intervals) - 1)
+            elif len(intervals) > 256 and self._random.random() >= 0.2:
+                # HypothesisProvider's index distribution: the first 256
+                # characters in shrink order most of the time.
+                i = self._random.randint(0, 255)
+            else:
+                i = self._random.randint(0, len(intervals) - 1)
+            chars.append(intervals.char_in_shrink_order(i))
+        return "".join(chars)
+
+    def draw_bytes(
+        self,
+        min_size: int = 0,
+        max_size: int = COLLECTION_DEFAULT_MAX_SIZE,
+    ) -> bytes:
+        constraints = {"min_size": min_size, "max_size": max_size}
+        if (constant := self._constant("bytes", constraints)) is not None:
+            return constant
+        return self._draw(lambda tc: tc.generate_bytes(min_size, max_size))
+
+    # -- spans -------------------------------------------------------------
+
+    def span_start(self, label: int, /) -> None:
+        if self._span_depth == 0 and self._drew and not self._in_context:
+            # Outside per_test_case_context_manager (a ConjectureRunner used
+            # directly, as in tests/quality) a top-level span opening after
+            # draws means the runner moved on to its next test case. Its
+            # outcome is unknown here. Inside the context manager every
+            # @given argument is its own top-level span, so this must not
+            # apply there.
+            self._complete(native().STATUS_VALID)
+        if self._tc is None:
+            # A case opens at its first draw. Forwarding a span before that
+            # would give libhegel a choice-less case, which it (correctly)
+            # takes as an exhausted search space and ends the run on.
+            return
+        self._span_depth += 1
+        with contextlib.suppress(BackendCannotProceed):
+            self._draw(lambda tc: tc.start_span(label & LABEL_MASK))
+
+    def span_end(self, discard: bool, /) -> None:
+        # A span call on a case whose budget is spent (a discarded span's
+        # retry, or spans closed while freezing an overrun case) reports
+        # the exhaustion too; the next draw raises it, a span never does.
+        if self._span_depth > 0:
+            self._span_depth -= 1
+            with contextlib.suppress(BackendCannotProceed):
+                self._draw(lambda tc: tc.stop_span(discard))
+
+
+def decode_choices(blob: str) -> list[ChoiceT]:
+    """Inverse of |encode_choices| for the raw and zlib blob forms."""
+    payload = base64.b64decode(blob)
+    body = payload[1:]
+    if payload[:1] == b"\x01":
+        body = zlib.decompress(body)
+    elif payload[:1] != b"\x00":
+        raise ValueError(f"unsupported blob prefix {payload[:1]!r}")
+    pos = 4
+    (count,) = struct.unpack_from("<I", body, 0)
+    out: list[ChoiceT] = []
+    for _ in range(count):
+        tag = body[pos]
+        pos += 1
+        if tag == 0:
+            sub = body[pos]
+            pos += 1
+            assert sub == 10, sub
+            (n,) = struct.unpack_from("<I", body, pos)
+            pos += 4
+            out.append(int.from_bytes(body[pos : pos + n], "little", signed=True))
+            pos += n
+        elif tag == 1:
+            out.append(bool(body[pos]))
+            pos += 1
+        elif tag == 2:
+            (f,) = struct.unpack_from("<d", body, pos)
+            pos += 8
+            out.append(f)
+        elif tag == 3:
+            (n,) = struct.unpack_from("<I", body, pos)
+            pos += 4
+            out.append(bytes(body[pos : pos + n]))
+            pos += n
+        elif tag == 4:
+            (n,) = struct.unpack_from("<I", body, pos)
+            pos += 4
+            cps = struct.unpack_from(f"<{n}I", body, pos)
+            pos += 4 * n
+            out.append("".join(map(chr, cps)))
+        else:  # pragma: no cover
+            raise ValueError(f"unsupported choice tag {tag}")
+    return out
+
+
+def encode_choices(choices: list[ChoiceT]) -> str:
+    """Encode a Hypothesis choice sequence as a libhegel reproduce blob
+    (``base64(0x00 ++ serialize_choices)``, libhegel's raw blob form), so a
+    Hypothesis-recorded sequence can be replayed by libhegel."""
+    buf = bytearray(struct.pack("<I", len(choices)))
+    for c in choices:
+        if isinstance(c, bool):
+            buf += b"\x01" + bytes([c])
+        elif isinstance(c, int):
+            m = _signed_bytes(c)
+            buf += b"\x00\x0a" + struct.pack("<I", len(m)) + m
+        elif isinstance(c, float):
+            buf += b"\x02" + struct.pack("<d", c)
+        elif isinstance(c, bytes):
+            buf += b"\x03" + struct.pack("<I", len(c)) + c
+        elif isinstance(c, str):
+            buf += b"\x04" + struct.pack("<I", len(c))
+            buf += b"".join(struct.pack("<I", ord(ch)) for ch in c)
+        else:  # pragma: no cover
+            raise TypeError(f"unsupported choice {c!r}")
+    return base64.b64encode(b"\x00" + bytes(buf)).decode("ascii")
