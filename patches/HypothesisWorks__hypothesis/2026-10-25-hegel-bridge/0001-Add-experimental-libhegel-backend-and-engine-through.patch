+# v. 2.0. If a copy of the MPL was not distributed with this file, You can
+# obtain one at https://mozilla.org/MPL/2.0/.
+
+"""
+EXPERIMENT: the libhegel backend (``settings(backend="hegel")``), and the
+engine-equivalence checks it makes possible.
+"""
+
+import math
+import re
+
+import pytest
+
+from hypothesis import HealthCheck, given, settings, strategies as st
+from hypothesis.errors import BackendCannotProceed
+from hypothesis.internal.conjecture.choice import choice_equal, choice_permitted
+from hypothesis.internal.conjecture.data import ConjectureData
+from hypothesis.internal.conjecture.hegel_provider import (
+    HegelProvider,
+    encode_choices,
+    native,
+)
+from hypothesis.internal.intervalsets import IntervalSet
+
+from tests.common.debug import minimal
+from tests.conjecture.common import (
+    draw_value,
+    float_constr,
+    integer_constr,
+    nodes,
+    string_constr,
+)
+
+HEGEL = settings(backend="hegel", database=None)
+
+
+def test_libhegel_is_linked_in():
+    assert re.fullmatch(r"\d+\.\d+\.\d+", native().version())
+
+
+# -- the provider contract: every draw is permitted by its constraints -------
+
+
+@given(st.lists(nodes()), st.randoms())
+def test_provider_contract_hegel(nodes, random):
+    data = ConjectureData(random=random, provider=HegelProvider)
+    for node in nodes:
+        try:
+            value = getattr(data, f"draw_{node.type}")(**node.constraints)
+        except BackendCannotProceed:
+            return
+        assert choice_permitted(value, node.constraints)
+
+
+# -- through the whole pipeline -----------------------------------------------
+
+
+@HEGEL
+@given(
+    st.integers(),
+    st.text(),
+    st.floats(),
+    st.binary(),
+    st.lists(st.integers()),
+    st.booleans(),
+    st.text(alphabet=st.characters(exclude_characters="\n"), min_size=1),
+)
+def test_generates_every_kind_of_value(n, s, f, b, xs, flag, line):
+    assert isinstance(n, int)
+    assert isinstance(s, str)
+    assert isinstance(f, float)
+    assert isinstance(b, bytes)
+    assert all(isinstance(x, int) for x in xs)
+    assert isinstance(flag, bool)
+    assert line
+    assert "\n" not in line
+
+
+def test_uses_libhegel_for_generation():
+    seen = []
+
+    @HEGEL
+    @given(st.integers(0, 10**6))
+    def f(n):
+        seen.append(n)
+
+    f()
+    assert len(set(seen)) > 10
+
+
+@pytest.mark.parametrize(
+    "strategy, condition, expected",
+    [
+        (st.lists(st.integers()), lambda x: sum(x) > 10, [11]),
+        (st.integers(), lambda x: x > 100, 101),
+        (st.text(), lambda s: len(s) >= 3, "000"),
+        (st.floats(), lambda x: x > 1.5, 2.0),
+        (st.binary(), lambda b: len(b) >= 2, b"\x00\x00"),
+    ],
+)
+def test_minimal_matches_python_engine(strategy, condition, expected):
+    # libhegel generates, Hypothesis shrinks by replaying the recorded
+    # choices: the pipeline must end at the same minimal example as the
+    # all-Python engine.
+    assert minimal(strategy, condition, settings=HEGEL) == expected
+    assert minimal(strategy, condition) == expected
+
+
+@HEGEL
+@given(st.data())
+def test_assume_and_filter_are_reported_as_invalid(data):
+    # exercises the INVALID / OVERRUN completion paths
+    data.draw(st.integers().filter(lambda x: x % 2 == 0))
+
+
+# -- replay semantics: a Hypothesis choice sequence means the same to libhegel
+
+
+@st.composite
+def integer_weights(draw, lo, hi):
+    """A Hypothesis ``weights`` mapping over ``[lo, hi]``: a few keys whose
+    probabilities sum to strictly less than one."""
+    keys = draw(st.lists(st.integers(lo, hi), min_size=1, max_size=4, unique=True))
+    raw = draw(st.lists(st.floats(0.01, 1), min_size=len(keys), max_size=len(keys)))
+    total = draw(st.floats(0.05, 0.9))
+    return {k: w / sum(raw) * total for k, w in zip(keys, raw, strict=True)}
+
+
+@st.composite
+def direct_nodes(draw):
+    """Choice nodes whose draw maps one-to-one onto a libhegel primitive:
+    every kind of choice, with weights (within int64 bounds, where
+    libhegel's weighted draw applies), NaN alongside finite bounds, and
+    multi-range alphabets (any character that is not a surrogate, which a
+    libhegel string cannot hold)."""
+    kind = draw(st.sampled_from(["integer", "boolean", "float", "bytes", "string"]))
+    if kind == "integer":
+        lo = draw(st.none() | st.integers(-(2**70), 2**70))
+        hi = draw(st.none() | st.integers(lo if lo is not None else -(2**70), 2**70))
+        weights = None
+        if lo is not None and hi is not None and -(2**63) <= lo and hi < 2**63:
+            weights = draw(st.none() | integer_weights(lo, hi))
+        constraints = integer_constr(lo, hi, weights=weights)
+    elif kind == "boolean":
+        constraints = {"p": draw(st.floats(0, 1))}
+    elif kind == "float":
+        lo = draw(st.floats(allow_nan=False))
+        hi = draw(st.floats(min_value=lo, allow_nan=False))
+        constraints = float_constr(lo, hi, allow_nan=draw(st.booleans()))
+    elif kind == "bytes":
+        lo = draw(st.integers(0, 10))
+        constraints = {"min_size": lo, "max_size": draw(st.integers(lo, 20))}
+    else:
+        # Ranges never straddle the surrogate block: a lone surrogate is a
+        # valid Hypothesis string character but libhegel drops it.
+        low = sorted(draw(st.sets(st.integers(0, 0xD7FF), max_size=6)))
+        high = sorted(draw(st.sets(st.integers(0xE000, 0x10FFFF), max_size=6)))
+        ranges = [
+            (a, b)
+            for side in (low, high)
+            for a, b in zip(side[::2], side[1::2], strict=False)
+        ]
+        if not ranges:
+            ranges = [(97, 122)]
+        size = draw(st.integers(0, 10))
+        constraints = string_constr(
+            IntervalSet(ranges),
+            min_size=size,
+            max_size=draw(st.integers(size, 20)),
+        )
+    return kind, constraints, draw_value(kind, constraints)
+
+
+@given(st.lists(direct_nodes(), max_size=20))
+@settings(suppress_health_check=[HealthCheck.too_slow])
+def test_libhegel_replays_hypothesis_choices(sequence):
+    # A choice sequence recorded by Hypothesis, encoded as a libhegel reproduce
+    # blob and replayed through libhegel for the same draw calls, must come
+    # back value for value. This is the contract that makes databases and
+    # reproduce blobs portable between the two engines.
+    provider = HegelProvider(None)
+    provider._random = None  # no constant injection: pure replay
+    blob = encode_choices([value for _, _, value in sequence])
+    provider._tc = native().TestCase.from_blob(provider._settings, blob)
+    for kind, constraints, value in sequence:
+        replayed = getattr(provider, f"draw_{kind}")(**constraints)
+        assert choice_equal(replayed, value), (kind, constraints, value, replayed)
+    provider._tc.mark_complete(native().STATUS_VALID, None)
+
+
+def test_nan_and_negative_zero_round_trip_through_a_blob():
+    for value in [math.nan, -0.0, -math.nan, math.inf]:
+        provider = HegelProvider(None)
+        provider._random = None
+        provider._tc = native().TestCase.from_blob(
+            provider._settings, encode_choices([value])
+        )
+        assert choice_equal(
+            provider.draw_float(smallest_nonzero_magnitude=5e-324), value
+        )
