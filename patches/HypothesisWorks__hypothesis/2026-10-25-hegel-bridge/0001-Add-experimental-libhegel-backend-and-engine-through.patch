+# obtain one at https://mozilla.org/MPL/2.0/.
+
+"""
+EXPERIMENT: whole strategies generated natively. ``hegel_ir`` compiles the
+declarative part of a strategy into a tree the libhegel interpreter walks;
+the check that matters is that a value generated that way is exactly what
+the Python engine draws from the same choice sequence.
+"""
+
+import math
+
+import pytest
+
+from hypothesis import Phase, given, settings, strategies as st
+from hypothesis.control import BuildContext
+from hypothesis.internal.conjecture.data import ConjectureData
+from hypothesis.internal.conjecture.hegel_ir import NOT_BATCHABLE, compile_strategy
+from hypothesis.internal.conjecture.hegel_runner import HegelCaseProvider, HegelRunner
+
+
+@pytest.fixture(autouse=True)
+def hegel_engine(monkeypatch):
+    monkeypatch.setenv("HYPOTHESIS_ENGINE", "hegel")
+    monkeypatch.delenv("HYPOTHESIS_HEGEL_BATCH", raising=False)
+
+
+@st.composite
+def pairs(draw):
+    n = draw(st.integers(0, 10))
+    return (n, draw(st.text(max_size=n)))
+
+
+JUST = st.just(7)
+DATA = st.data()
+BATCHABLE = [
+    st.integers(),
+    st.integers(0, 100),
+    st.integers(min_value=5),
+    st.integers(max_value=-(2**70)),
+    st.booleans(),
+    st.floats(),
+    st.floats(0, 1),
+    st.binary(max_size=5),
+    st.text(),
+    st.text(alphabet="ab", min_size=1, max_size=4),
+    st.characters(categories=["Lu"]),
+    st.lists(st.integers()),
+    st.lists(st.text(), min_size=2, max_size=5),
+    st.lists(st.lists(st.integers(0, 3)), max_size=4),
+    st.tuples(st.booleans(), st.binary(max_size=3)),
+    st.fixed_dictionaries({"a": st.integers(), "b": st.floats(allow_nan=False)}),
+    st.one_of(st.integers(), st.text(), st.none()),
+    st.sampled_from([1, 2, 3]),
+    st.sampled_from([1, 2, 3]).map(str),
+    JUST,
+    st.integers().map(str),
+    st.builds(dict, a=st.booleans(), b=st.lists(st.integers(), max_size=3)),
+    st.tuples(st.shared(st.integers(), key="k"), st.shared(st.integers(), key="k")),
+    st.integers().filter(lambda x: x % 2 == 0),
+    st.lists(st.integers().filter(lambda x: x > 3), max_size=3),
+    st.text().filter(lambda s: "a" not in s),
+]
+OPAQUE_ROOTS = [
+    pairs(),
+    DATA,
+    st.lists(st.integers(), unique=True),
+    st.datetimes(),
+    st.sampled_from([1, 2, 3]).filter(lambda x: x > 1),
+    st.fixed_dictionaries({}, optional={"a": st.integers()}),
+    st.recursive(st.integers(), st.lists),
+]
+MIXED = [
+    st.lists(pairs(), max_size=3),
+    st.lists(pairs(), min_size=2, max_size=3),
+    st.sampled_from(range(10)).filter(lambda x: x > 5),
+    st.fixed_dictionaries({"a": st.integers()}, optional={"b": st.booleans()}),
+    st.tuples(st.datetimes(), st.integers()),
+    st.dictionaries(st.text(), st.integers()),
+]
+
+
+@pytest.mark.parametrize("strategy", BATCHABLE, ids=repr)
+def test_declarative_strategies_compile(strategy):
+    assert compile_strategy(strategy) is not NOT_BATCHABLE
+
+
+@pytest.mark.parametrize("strategy", OPAQUE_ROOTS, ids=repr)
+def test_strategies_that_run_python_code_do_not(strategy):
+    assert compile_strategy(strategy) is NOT_BATCHABLE
+
+
+def _same(a, b):
+    if isinstance(a, float) and isinstance(b, float):
+        return (math.isnan(a) and math.isnan(b)) or (
+            a == b and math.copysign(1, a) == math.copysign(1, b)
+        )
+    if isinstance(a, (list, tuple)) and isinstance(b, (list, tuple)):
+        return (
+            type(a) is type(b)
+            and len(a) == len(b)
+            and all(_same(x, y) for x, y in zip(a, b, strict=True))
+        )
+    if isinstance(a, dict) and isinstance(b, dict):
+        return list(a) == list(b) and all(_same(a[k], b[k]) for k in a)
+    return type(a) is type(b) and a == b
+
+
+@pytest.mark.parametrize(
+    "strategy",
+    BATCHABLE + [s for s in OPAQUE_ROOTS if s is not DATA] + MIXED,
+    ids=repr,
+)
+def test_a_batched_value_is_what_the_python_engine_draws_from_its_choices(strategy):
+    # libhegel generates the value and records the choice sequence; the Python
+    # engine, replaying that sequence through its own do_draw code, has to
+    # arrive at the same value
+    seen = []
+
+    def test_function(data):
+        with BuildContext(data, wrapped_test=lambda: None):
+            value = data.draw(strategy)
+        seen.append((data, value))
+
+    runner = HegelRunner(
+        test_function,
+        settings=settings(database=None, max_examples=60, phases=[Phase.generate]),
+    )
+    runner.run()
+    # a case without choices ends libhegel's run as exhausted
+    assert len(seen) >= (1 if strategy is JUST else 30)
+    for data, value in seen:
+        replay = ConjectureData.for_choices([n.value for n in data.nodes])
+        with BuildContext(replay, wrapped_test=lambda: None):
+            replayed = replay.draw(strategy)
+        assert _same(replayed, value), (value, replayed, data.nodes)
+        assert not replay.misaligned_at
+
+
+def test_most_draws_are_batched_and_the_switch_turns_it_off(monkeypatch):
+    @settings(database=None, max_examples=20, phases=[Phase.generate])
+    @given(st.lists(st.integers()), st.text(), st.datetimes())
+    def f(xs, s, d):
+        pass
+
+    before = (HegelCaseProvider.batched_draws, HegelCaseProvider.interactive_draws)
+    f()
+    assert HegelCaseProvider.batched_draws > before[0]
+    assert HegelCaseProvider.interactive_draws > before[1]
+
+    monkeypatch.setenv("HYPOTHESIS_HEGEL_BATCH", "0")
+    before = HegelCaseProvider.batched_draws
+    f()
+    assert HegelCaseProvider.batched_draws == before
