+"""
+EXPERIMENT: libhegel as the engine. ``HYPOTHESIS_ENGINE=hegel`` makes
+``core.py`` drive tests with |HegelRunner| instead of |ConjectureRunner|:
+libhegel owns the run loop, generation, targeting, shrinking and the choice
+budget, while Python keeps |ConjectureData| as the shim strategies draw from,
+the test execution, interesting-origin bookkeeping and the final report.
+
+Not covered yet: the example database (libhegel's store is disabled and
+Hypothesis's reuse phase is skipped), the explain phase, and Hypothesis's own
+runner-level health checks (libhegel's equivalents run instead, mapped from
+``settings.suppress_health_check``).
+"""
+
+import math
+import os
+import time
+from collections.abc import Callable, Sequence
+from contextlib import nullcontext
+from random import Random
+from typing import Any
+
+from hypothesis._settings import (
+    HealthCheck,
+    Phase,
+    Verbosity,
+    local_settings,
+    settings as Settings,
+)
+from hypothesis.errors import (
+    BackendCannotProceed,
+    FlakyFailure,
+    HypothesisException,
+    StopTest,
+)
+from hypothesis.internal.conjecture.choice import ChoiceNode, ChoiceT, ChoiceTemplate
+from hypothesis.internal.conjecture.data import (
+    _NOT_BATCHED,
+    _PERMISSIVE_CONSTRAINTS,
+    ConjectureData,
+    ConjectureResult,
+    DataObserver,
+    Status,
+)
+from hypothesis.internal.conjecture.engine import (
+    CallStats,
+    ExitReason,
+    StatisticsDict,
+)
+from hypothesis.internal.conjecture.floats import float_to_int
+from hypothesis.internal.conjecture.hegel_ir import NOT_BATCHABLE, compile_strategy
+from hypothesis.internal.conjecture.hegel_provider import (
+    HegelOverrun,
+    HegelProvider,
+    decode_choices,
+    encode_choices,
+    engine_settings,
+    native,
+)
+from hypothesis.internal.conjecture.junkdrawer import ensure_free_stackframes
+from hypothesis.internal.conjecture.providers import HypothesisProvider
+from hypothesis.internal.conjecture.shrinker import sort_key
+from hypothesis.internal.escalation import InterestingOrigin
+from hypothesis.internal.healthcheck import fail_health_check
+from hypothesis.reporting import base_report
+
+
+def hegel_engine_enabled() -> bool:
+    return os.environ.get("HYPOTHESIS_ENGINE") == "hegel"
+
+
+def hegel_batching_enabled() -> bool:
+    # HYPOTHESIS_HEGEL_BATCH=0 keeps every draw interactive (for comparison)
+    return os.environ.get("HYPOTHESIS_HEGEL_BATCH", "1") != "0"
+
+
+class HegelCaseProvider(HegelProvider):
+    """The draw-level provider bound to one libhegel test case the runner
+    already holds: no run of its own, no lifecycle, draws only. Whole
+    strategies that compile to the native interpreter are generated in one
+    call (``draw_strategy``, consulted by ``ConjectureData.draw``)."""
+
+    batched_draws = 0
+    interactive_draws = 0
+
+    def __init__(self, tc: Any, generators: dict) -> None:
+        self._cd = None
+        self._run = None
+        self._tc = tc
+        self._tc_done = False
+        self._span_depth = 0
+        self._drew = False
+        self._in_context = True
+        self._generators = generators
+        # No constant injection here: libhegel replays and shrinks by its own
+        # choice sequence, so every value the test sees has to be a function
+        # of libhegel's draws. (A real integration would pass constants down
+        # as forced draws instead.)
+        self._random = None
+        self.runs_started = 0
+
+    def _test_case(self) -> Any:
+        return self._tc
+
+    def draw_strategy(self, strategy: Any, data: Any) -> Any:
+        if not hegel_batching_enabled():
+            return _NOT_BATCHED
+        compiled = compile_strategy(strategy)
+        if compiled is NOT_BATCHABLE:
+            HegelCaseProvider.interactive_draws += 1
+            return _NOT_BATCHED
+        HegelCaseProvider.batched_draws += 1
+        try:
+            return self._tc.generate(
+                compiled,
+                data.draw,
+                data._hegel_record_many,
+                lambda reason: data.mark_invalid(
+                    f"Aborted test because unable to satisfy {reason}"
+                ),
+            )
+        except native().StopTest:
+            raise HegelOverrun from None
+        except native().AssumeFailed:
+            raise BackendCannotProceed("discard_test_case") from None
+
+    def choices_blob(self) -> str | None:
+        """libhegel's record of the case so far, or None once libhegel has
+        concluded the case itself (its budget ran out mid-draw)."""
+        try:
+            return self._tc.choices_blob()
+        except native().StopTest:
+            return None
+
+    def _complete(self, status: int, origin: str | None = None) -> None:
+        pass
+
+    def per_test_case_context_manager(self) -> Any:
+        return nullcontext()
+
+
+def _phase_bits(settings: Settings) -> int:
+    n = native()
+    bits = {
+        Phase.reuse: n.PHASE_REUSE,
+        Phase.generate: n.PHASE_GENERATE,
+        Phase.target: n.PHASE_TARGET,
+        Phase.shrink: n.PHASE_SHRINK,
+    }
+    return sum(bit for phase, bit in bits.items() if phase in settings.phases)
+
+
+def _health_checks() -> dict[HealthCheck, int]:
+    n = native()
+    return {
+        HealthCheck.filter_too_much: n.HC_FILTER_TOO_MUCH,
+        HealthCheck.too_slow: n.HC_TOO_SLOW,
+        HealthCheck.data_too_large: n.HC_TEST_CASES_TOO_LARGE,
+        HealthCheck.large_base_example: n.HC_LARGE_INITIAL_TEST_CASE,
+    }
+
+
+def _health_check_bits(settings: Settings) -> int:
+    return sum(
+        bit
+        for check, bit in _health_checks().items()
+        if check in settings.suppress_health_check
+    )
+
+
+def _status(status: Status) -> int:
+    n = native()
+    return {
+        Status.VALID: n.STATUS_VALID,
+        Status.INVALID: n.STATUS_INVALID,
+        Status.OVERRUN: n.STATUS_OVERRUN,
+        Status.INTERESTING: n.STATUS_INTERESTING,
+    }[status]
+
+
+def _nodes_from_choices(choices: list) -> tuple[ChoiceNode, ...]:
+    nodes = []
+    for value in choices:
+        kind = (
+            "boolean"
+            if isinstance(value, bool)
+            else (
+                "integer"
+                if isinstance(value, int)
+                else (
+                    "float"
+                    if isinstance(value, float)
+                    else "bytes" if isinstance(value, bytes) else "string"
+                )
+            )
+        )
+        nodes.append(
+            ChoiceNode(
+                type=kind,
+                value=value,
+                constraints=_PERMISSIVE_CONSTRAINTS[kind],
+                was_forced=False,
+                index=len(nodes),
+            )
+        )
+    return tuple(nodes)
+
+
+def _choices_key(choices: list) -> tuple:
+    """A hashable identity for a decoded choice sequence (libhegel's failure
+    blobs are compressed, a live case's are raw: compare by content)."""
+    return tuple((float_to_int(v) if isinstance(v, float) else v) for v in choices)
+
+
+def _origin_key(origin: InterestingOrigin) -> str:
+    """A stable per-process string naming a failure for libhegel's grouping."""
+    return (
+        f"{origin.exc_type.__qualname__}@{origin.filename}:{origin.lineno}"
+        f"#{hash(origin) & 0xFFFFFFFF:08x}"
+    )
+
+
+class HegelRunner:
+    """The subset of |ConjectureRunner| that ``core.py`` drives, backed by a
+    libhegel run."""
+
+    def __init__(
+        self,
+        test_function: Callable[[ConjectureData], None],
+        *,
+        settings: Settings | None = None,
+        random: Random | None = None,
+        database_key: bytes | None = None,
+        ignore_limits: bool = False,
+        thread_overlap: dict[int, bool] | None = None,
+    ) -> None:
+        self._test_function = test_function
+        self.settings = settings or Settings()
+        self.random = random or Random()
+        self.database_key = database_key
+        self.ignore_limits = ignore_limits
+        self.thread_overlap = {} if thread_overlap is None else thread_overlap
+        self.call_count = 0
+        self.valid_test_cases = 0
+        self.invalid_test_cases = 0
+        self.overrun_test_cases = 0
+        self.shrinks = 0
+        self.interesting_test_cases: dict[InterestingOrigin, ConjectureResult] = {}
+        self.best_observed_targets: dict[str, float] = {}
+        self.statistics: StatisticsDict = {}
+        self.exit_reason: ExitReason | None = None
+        self.provider = HypothesisProvider
+        self._current_phase = "generate"
+        self._verified_by_backend = None
+        self._backend_found_failure = False
+        self._stats: list[CallStats] = []
+        self._generators: dict = {}
+        self._engine_settings: Any = None
+        self.hegel_failures: list[tuple[str, str | None]] = []
+        self._interesting_by_choices: dict[tuple, ConjectureResult] = {}
+        self._origin_by_key: dict[str, InterestingOrigin] = {}
+
+    # -- what core.py calls ------------------------------------------------
+
+    def run(self) -> None:
+        with local_settings(self.settings):
+            self._run()
+
+    def new_conjecture_data(
+        self,
+        prefix: Sequence[ChoiceT | ChoiceTemplate | Any],
+        *,
+        observer: DataObserver | None = None,
+        max_choices: int | None = None,
+    ) -> ConjectureData:
+        if self._engine_settings is not None and all(
+            isinstance(c, (bool, int, float, str, bytes)) for c in prefix
+        ):
+            # replay through libhegel, so natively generated strategies
+            # re-materialise from the same choices
+            tc = native().TestCase.from_blob(
+                self._engine_settings, encode_choices(list(prefix))
+            )
+            return ConjectureData(
+                observer=observer or DataObserver(),
+                provider=HegelCaseProvider(tc, self._generators),
+                # libhegel bounds the replay; Python's node count includes
+                # forced draws libhegel never saw
+                max_choices=None,
+                random=self.random,
+            )
+        return ConjectureData(
+            prefix=prefix,
+            observer=observer or DataObserver(),
+            provider=HypothesisProvider,
+            max_choices=max_choices,
+            random=self.random,
+        )
+
+    # -- the loop ------------------------------------------------------------
+
+    def _run(self) -> None:
+        self._engine_settings = engine_settings(
+            self.settings.max_examples,
+            seed=self.random.getrandbits(64),
+            phases=_phase_bits(self.settings),
+            report_multiple_failures=self.settings.report_multiple_bugs,
+            suppress_health_check=_health_check_bits(self.settings),
+            # a test that behaves differently on replay is flaky to
+            # Hypothesis, not something to work around
+            nondeterminism_strictness=native().NONDETERMINISM_ERROR,
+        )
+        started = time.perf_counter()
+        run = native().Run.start(self._engine_settings)
+        try:
+            while (tc := run.next_test_case()) is not None:
+                self._execute(tc)
+        finally:
+            self.statistics["generate-phase"] = {
+                "duration-seconds": time.perf_counter() - started,
+                "test-cases": self._stats,
+                "distinct-failures": len(self.interesting_test_cases),
+                "shrinks-successful": self.shrinks,
+            }
+        result = run.result()
+        self.hegel_failures = [
+            result.failure(i)[:2] for i in range(result.failure_count())
+        ]
+        # libhegel's shrinker decides which case is the minimal one for each
+        # failure (Hypothesis's sort_key over the permissive nodes above would
+        # rank e.g. a year of 1998 below the shrink target 2000)
+        for key, blob in self.hegel_failures:
+            found = None
+            if blob:
+                found = self._interesting_by_choices.get(
+                    _choices_key(decode_choices(blob))
+                )
+            origin = self._origin_by_key.get(key)
+            if found is not None and origin is not None:
+                self.interesting_test_cases[origin] = found
+        if self.interesting_test_cases or self.call_count < self.settings.max_examples:
+            self.exit_reason = ExitReason.finished
+        else:
+            self.exit_reason = ExitReason.max_examples
+        if (error := result.error()) is not None:
+            kind, check = result.error_kind()
+            self._translate_run_error(error, kind, check)
+        self.statistics["stopped-because"] = self.exit_reason.describe(self.settings)
+        if self.best_observed_targets:
+            self.statistics["targets"] = dict(self.best_observed_targets)
+        if self.settings.verbosity >= Verbosity.debug:
+            base_report(
+                f"libhegel run complete after {self.call_count} test cases "
+                f"({self.valid_test_cases} valid) and {self.shrinks} shrinks"
+            )
+
+    def _translate_run_error(self, error: str, kind: int, check: int) -> None:
+        """libhegel's run-level errors in Hypothesis's terms: an exhausted
+        search space is core.py's Unsatisfiable (exit reason ``finished``
+        with no valid case), its health checks are Hypothesis's, and a
+        nondeterministic test is a flaky one."""
+        n = native()
+        if kind == n.RUN_ERROR_UNSATISFIABLE:
+            self.exit_reason = ExitReason.finished
+            self.statistics["stopped-because"] = self.exit_reason.describe(
+                self.settings
+            )
+            return
+        if kind == n.RUN_ERROR_HEALTH_CHECK:
+            messages = {
+                HealthCheck.filter_too_much: (
+                    "It looks like this test is filtering out a lot of inputs. "
+                    f"{self.valid_test_cases} inputs were generated successfully, "
+                    f"while {self.invalid_test_cases} inputs were filtered out and "
+                    f"{self.overrun_test_cases} overran.\n\nAn input might be "
+                    "filtered out by calls to assume(), strategy.filter(...), or "
+                    "occasionally by Hypothesis internals. If you expect this many "
+                    "inputs to be filtered out during generation, you can disable "
+                    "this health check with "
+                    "@settings(suppress_health_check=[HealthCheck.filter_too_much])."
+                ),
+                HealthCheck.too_slow: (
+                    "Data generation is extremely slow: Only produced "
+                    f"{self.valid_test_cases} valid examples in the first test "
+                    "cases. If you expect input generation to take this long, you "
+                    "can disable this health check with "
+                    "@settings(suppress_health_check=[HealthCheck.too_slow])."
+                ),
+                HealthCheck.data_too_large: "Generated inputs are too large.",
+                HealthCheck.large_base_example: (
+                    "The smallest natural example for your test is extremely large."
+                ),
+            }
+            for which, bit in _health_checks().items():
+                if bit == check:
+                    fail_health_check(
+                        self.settings,
+                        f"{messages[which]} (libhegel: {error})",
+                        which,
+                    )
+        if kind in (n.RUN_ERROR_FLAKY, n.RUN_ERROR_NONDETERMINISTIC):
+            self.exit_reason = ExitReason.flaky
+            self.statistics["stopped-because"] = self.exit_reason.describe(
+                self.settings
+            )
+            raise FlakyFailure(
+                "Inconsistent results: libhegel saw this test behave differently "
+                f"when replaying the same inputs ({error})",
+                [HypothesisException(error)],
+            )
+        raise HypothesisException(f"libhegel ended the run with an error: {error}")
+
+    def _execute(self, tc: Any) -> None:
+        provider = HegelCaseProvider(tc, self._generators)
+        data = ConjectureData(random=self.random, provider=provider)
+        self.call_count += 1
+        try:
+            with ensure_free_stackframes():
+                try:
+                    self._test_function(data)
+                except StopTest as e:
+                    if e.testcounter != data.testcounter:
+                        raise
+        except BackendCannotProceed:
+            # the provider ran out of libhegel's choice budget mid-draw
+            data.freeze()
+            self.overrun_test_cases += 1
+            tc.mark_complete(native().STATUS_OVERRUN, None)
+            return
+        except BaseException:
+            # a fatal error or control exception: let libhegel release the
+            # case, then let it propagate
+            tc.mark_complete(native().STATUS_INVALID, None)
+            raise
+        # libhegel's own record of the case is the choice sequence: Python's
+        # node list misses draws Hypothesis forces without consulting the
+        # provider (the first min_size continues of `many`, for one).
+        blob = provider.choices_blob()
+        choices = None if blob is None else decode_choices(blob)
+        if choices is not None:
+            data.nodes = _nodes_from_choices(choices)
+        data.freeze()
+        self._stats.append(
+            {
+                "status": data.status.name.lower(),
+                "runtime": data.finish_time - data.start_time,
+                "drawtime": math.fsum(data.draw_times.values()),
+                "gctime": data.gc_finish_time - data.gc_start_time,
+                "events": sorted(
+                    k if v == "" else f"{k}: {v}" for k, v in data.events.items()
+                ),
+            }
+        )
+        if data.status >= Status.VALID:
+            for label, score in data.target_observations.items():
+                if math.isfinite(score):
+                    tc.target(score, str(label).replace("\0", "\\0"))
+                self.best_observed_targets[label] = max(
+                    self.best_observed_targets.get(label, -math.inf), score
+                )
+        if data.status is Status.VALID:
+            self.valid_test_cases += 1
+        elif data.status is Status.INVALID:
+            self.invalid_test_cases += 1
+        elif data.status is Status.OVERRUN:
+            self.overrun_test_cases += 1
+        origin_key = None
+        if data.status is Status.INTERESTING:
+            origin = data.interesting_origin
+            assert origin is not None
+            origin_key = _origin_key(origin)
+            result = data.as_result()
+            assert isinstance(result, ConjectureResult)
+            if choices is not None:
+                self._interesting_by_choices[_choices_key(choices)] = result
+            self._origin_by_key[origin_key] = origin
+            existing = self.interesting_test_cases.get(origin)
+            if existing is None:
+                self.interesting_test_cases[origin] = result
+            elif sort_key(result.nodes) < sort_key(existing.nodes):
+                self.shrinks += 1
+                self.interesting_test_cases[origin] = result
+        tc.mark_complete(_status(data.status), origin_key)
