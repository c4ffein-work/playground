+impl Drop for Engine {
+    fn drop(&mut self) {
+        // SAFETY: handles were created by this Engine and are freed exactly once.
+        unsafe {
+            let _ = sys::hegel_settings_free(self.ctx, self.settings);
+            let _ = sys::hegel_context_free(self.ctx);
+        }
+    }
+}
+
+impl Drop for StringGenerator {
+    fn drop(&mut self) {
+        Python::attach(|py| {
+            let ctx = self.engine.borrow(py).ctx;
+            // SAFETY: freed exactly once, after every draw using it completed
+            // (draws hold the GIL and a borrow of this generator).
+            unsafe {
+                let _ = sys::hegel_string_generator_free(ctx, self.gen);
+            }
+        });
+    }
+}
