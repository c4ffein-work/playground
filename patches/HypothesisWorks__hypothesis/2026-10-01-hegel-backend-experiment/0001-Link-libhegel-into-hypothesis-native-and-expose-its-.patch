new file mode 100644
index 00000000..cd7992ff
--- /dev/null
+++ b/hypothesis/rust/src/internal/hegel.rs
@@ -0,0 +1,811 @@
+// This file is part of Hypothesis, which may be found at
+// https://github.com/HypothesisWorks/hypothesis/
+//
+// Copyright the Hypothesis Authors.
+// Individual contributors are listed in AUTHORS.rst and the git log.
+//
+// This Source Code Form is subject to the terms of the Mozilla Public License,
+// v. 2.0. If a copy of the MPL was not distributed with this file, You can
+// obtain one at https://mozilla.org/MPL/2.0/.
+
+//! A thin, safe-ish Python surface over libhegel's C ABI (the `hegel_*`
+//! functions of the `hegeltest-c` crate, linked statically into this
+//! extension). This is an EXPERIMENT: enough of the ABI to drive libhegel's
+//! generation phase as a Hypothesis backend (`settings(backend="hegel")`)
+//! and to replay reproduce blobs for engine-equivalence tests. Nothing here
+//! is public API.
+//!
+//! Every object wraps raw libhegel handles. libhegel guards each handle with
+//! its own locks (a call racing another on the same handle waits or returns
+//! `HEGEL_E_CONCURRENT_USE`), and the GIL serialises everything this module
+//! does, so the wrappers are marked `Send + Sync`: a Python thread other than
+//! the creating one may use or drop them (Hypothesis's test suite does both).
+
+use std::ffi::{c_char, CStr, CString};
+
+use hegel_c as sys;
+use pyo3::exceptions::PyRuntimeError;
+use pyo3::prelude::*;
+use pyo3::types::{PyBytes, PyString};
+
+pyo3::create_exception!(hegel, HegelError, PyRuntimeError);
+// libhegel ran out of choice budget for this test case (`HEGEL_E_STOP_TEST`).
+pyo3::create_exception!(hegel, StopTestError, HegelError);
+// A draw rejected itself (`HEGEL_E_ASSUME`); the test case should be discarded.
+pyo3::create_exception!(hegel, AssumeError, HegelError);
+
+/// Owns a libhegel context plus one settings handle. Runs, test cases and
+/// string generators keep a reference to their `Engine` so its context
+/// outlives every handle created from it.
+#[pyclass(module = "hypothesis._native.internal.hegel")]
+pub(crate) struct Engine {
+    ctx: *mut sys::HegelContext,
+    settings: *mut sys::HegelSettings,
+}
+
+// SAFETY: see the module docs. libhegel handles are internally locked and
+// every use goes through the GIL.
+unsafe impl Send for Engine {}
+unsafe impl Sync for Engine {}
+unsafe impl Send for Run {}
+unsafe impl Sync for Run {}
+unsafe impl Send for TestCase {}
+unsafe impl Sync for TestCase {}
+unsafe impl Send for StringGenerator {}
+unsafe impl Sync for StringGenerator {}
+unsafe impl Send for Collection {}
+unsafe impl Sync for Collection {}
+
+#[pyclass(module = "hypothesis._native.internal.hegel")]
+pub(crate) struct Run {
+    engine: Py<Engine>,
+    run: *mut sys::HegelRun,
+}
+
+#[pyclass(module = "hypothesis._native.internal.hegel")]
+pub(crate) struct TestCase {
+    engine: Py<Engine>,
+    tc: *mut sys::HegelTestCase,
+    complete: bool,
+}
+
+#[pyclass(module = "hypothesis._native.internal.hegel")]
+pub(crate) struct StringGenerator {
+    engine: Py<Engine>,
+    gen: *mut sys::HegelStringGenerator,
+}
+
+#[pyclass(module = "hypothesis._native.internal.hegel")]
+pub(crate) struct Collection {
+    engine: Py<Engine>,
+    tc: Py<TestCase>,
+    collection: *mut sys::HegelCollection,
+}
+
+/// One distinct failure of a finished run: its origin string and reproduce
+/// blob (None when libhegel produced none).
+#[pyclass(module = "hypothesis._native.internal.hegel", get_all)]
+pub(crate) struct Failure {
+    origin: String,
+    blob: Option<String>,
+}
+
+/// The result of a finished run.
+#[pyclass(module = "hypothesis._native.internal.hegel", get_all)]
+pub(crate) struct RunResult {
+    /// 0 passed, 1 failed, 2 error (`hegel_run_status_t`).
+    status: u32,
+    error: Option<String>,
+    failures: Vec<Py<Failure>>,
+}
+
+pub(crate) const STATUS_VALID: u32 = sys::hegel_status_t::HEGEL_STATUS_VALID as u32;
+pub(crate) const STATUS_INVALID: u32 = sys::hegel_status_t::HEGEL_STATUS_INVALID as u32;
+pub(crate) const STATUS_OVERRUN: u32 = sys::hegel_status_t::HEGEL_STATUS_OVERRUN as u32;
+pub(crate) const STATUS_INTERESTING: u32 = sys::hegel_status_t::HEGEL_STATUS_INTERESTING as u32;
+
+pub(crate) const PHASE_EXPLICIT: u32 = sys::hegel_phase_t::HEGEL_PHASE_EXPLICIT as u32;
+pub(crate) const PHASE_REUSE: u32 = sys::hegel_phase_t::HEGEL_PHASE_REUSE as u32;
+pub(crate) const PHASE_GENERATE: u32 = sys::hegel_phase_t::HEGEL_PHASE_GENERATE as u32;
+pub(crate) const PHASE_TARGET: u32 = sys::hegel_phase_t::HEGEL_PHASE_TARGET as u32;
+pub(crate) const PHASE_SHRINK: u32 = sys::hegel_phase_t::HEGEL_PHASE_SHRINK as u32;
+
+pub(crate) const HC_FILTER_TOO_MUCH: u32 =
+    sys::hegel_health_check_t::HEGEL_HC_FILTER_TOO_MUCH as u32;
+pub(crate) const HC_TOO_SLOW: u32 = sys::hegel_health_check_t::HEGEL_HC_TOO_SLOW as u32;
+pub(crate) const HC_TEST_CASES_TOO_LARGE: u32 =
+    sys::hegel_health_check_t::HEGEL_HC_TEST_CASES_TOO_LARGE as u32;
+pub(crate) const HC_LARGE_INITIAL_TEST_CASE: u32 =
+    sys::hegel_health_check_t::HEGEL_HC_LARGE_INITIAL_TEST_CASE as u32;
+const ALL_HEALTH_CHECKS: u32 =
+    HC_FILTER_TOO_MUCH | HC_TOO_SLOW | HC_TEST_CASES_TOO_LARGE | HC_LARGE_INITIAL_TEST_CASE;
+
+/// Turn a `hegel_result_t` into a Python exception, reading the context's
+/// last error message for the detail.
+fn check(ctx: *mut sys::HegelContext, r: sys::hegel_result_t, what: &str) -> PyResult<()> {
+    use sys::hegel_result_t as R;
+    if r == R::HEGEL_OK {
+        return Ok(());
+    }
+    // SAFETY: ctx is a live context owned by an Engine; the message pointer
+    // is valid until the next call on the context, and we copy it here.
+    let msg = unsafe {
+        let p = sys::hegel_context_last_error(ctx);
+        if p.is_null() {
+            String::new()
+        } else {
+            CStr::from_ptr(p).to_string_lossy().into_owned()
+        }
+    };
+    let text = format!("{what}: {r:?} {msg}");
+    Err(match r {
+        R::HEGEL_E_STOP_TEST => StopTestError::new_err(text),
+        R::HEGEL_E_ASSUME => AssumeError::new_err(text),
+        _ => HegelError::new_err(text),
+    })
+}
+
+fn cstr_opt(p: *const c_char) -> Option<String> {
+    if p.is_null() {
+        None
+    } else {
+        // SAFETY: libhegel hands out NUL-terminated strings valid until the
+        // owning handle is freed; we copy immediately.
+        Some(unsafe { CStr::from_ptr(p) }.to_string_lossy().into_owned())
+    }
+}
+
+#[pymethods]
+impl Engine {
+    /// `max_examples` bounds libhegel's generate phase (`test_cases`).
+    /// `phases` is a bitwise OR of the `PHASE_*` constants and
+    /// `suppress_health_check` of the `HC_*` constants (all by default: a
+    /// draw-level backend leaves health checks to Hypothesis). The example
+    /// database is always disabled.
+    #[new]
+    #[pyo3(signature = (max_examples, *, seed=None, phases=PHASE_GENERATE, unbounded_choices=false, report_multiple_failures=false, suppress_health_check=ALL_HEALTH_CHECKS))]
+    fn new(
+        max_examples: u64,
+        seed: Option<u64>,
+        phases: u32,
+        unbounded_choices: bool,
+        report_multiple_failures: bool,
+        suppress_health_check: u32,
+    ) -> PyResult<Self> {
+        // SAFETY: plain constructor calls; every handle is checked below and
+        // freed in Drop.
+        unsafe {
+            let ctx = sys::hegel_context_new();
+            if ctx.is_null() {
+                return Err(HegelError::new_err("hegel_context_new returned NULL"));
+            }
+            let mut settings: *mut sys::HegelSettings = std::ptr::null_mut();
+            if let Err(e) = check(
+                ctx,
+                sys::hegel_settings_new(ctx, &mut settings),
+                "settings_new",
+            ) {
+                let _ = sys::hegel_context_free(ctx);
+                return Err(e);
+            }
+            let engine = Engine { ctx, settings };
+            check(
+                ctx,
