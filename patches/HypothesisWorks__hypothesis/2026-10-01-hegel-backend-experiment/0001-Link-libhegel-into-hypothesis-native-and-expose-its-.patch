+                sys::hegel_settings_set_database(ctx, settings, disabled.as_ptr()),
+                "set_database",
+            )?;
+            check(
+                ctx,
+                sys::hegel_settings_set_seed(ctx, settings, seed.unwrap_or(0), seed.is_some()),
+                "set_seed",
+            )?;
