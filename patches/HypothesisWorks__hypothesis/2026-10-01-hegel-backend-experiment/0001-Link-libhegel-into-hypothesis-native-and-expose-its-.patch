+
+    /// libhegel's own version string.
+    #[staticmethod]
+    fn version() -> PyResult<String> {
+        // SAFETY: hegel_version accepts a NULL context and returns a static string.
+        unsafe {
+            let mut p: *const c_char = std::ptr::null();
+            let r = sys::hegel_version(std::ptr::null_mut(), &mut p);
+            if r != sys::hegel_result_t::HEGEL_OK {
+                return Err(HegelError::new_err(format!("hegel_version: {r:?}")));
+            }
+            Ok(cstr_opt(p).unwrap_or_default())
+        }
+    }
+
+    /// Start a run. Drive it with `Run.next_test_case()` until it returns
+    /// None, then read `Run.result()`.
+    fn start_run(slf: Py<Engine>, py: Python<'_>) -> PyResult<Run> {
+        let (ctx, settings) = {
+            let e = slf.borrow(py);
+            (e.ctx, e.settings)
+        };
+        let mut run: *mut sys::HegelRun = std::ptr::null_mut();
+        // SAFETY: settings is copied by libhegel; the run is freed in Drop.
+        let r =
+            unsafe { sys::hegel_run_start(ctx, settings, None, std::ptr::null_mut(), &mut run) };
+        check(ctx, r, "run_start")?;
+        Ok(Run { engine: slf, run })
+    }
+
+    /// Replay a reproduce blob as a standalone test case (no run loop):
+    /// drive it with the usual draws, then `mark_complete`.
+    fn test_case_from_blob(slf: Py<Engine>, py: Python<'_>, blob: &str) -> PyResult<TestCase> {
+        let (ctx, settings) = {
+            let e = slf.borrow(py);
+            (e.ctx, e.settings)
+        };
+        let blob = CString::new(blob).map_err(|_| HegelError::new_err("blob contains NUL"))?;
+        let mut tc: *mut sys::HegelTestCase = std::ptr::null_mut();
+        // SAFETY: blob is a valid C string for the duration of the call.
+        let r = unsafe {
+            sys::hegel_test_case_from_blob(
+                ctx,
+                settings,
+                blob.as_ptr(),
+                None,
+                std::ptr::null_mut(),
+                &mut tc,
+            )
+        };
+        check(ctx, r, "test_case_from_blob")?;
+        Ok(TestCase {
+            engine: slf,
+            tc,
+            complete: false,
+        })
+    }
+
+    /// A text generator over an explicit alphabet: sorted, disjoint,
+    /// inclusive codepoint ranges, exactly as Hypothesis's `IntervalSet`
+    /// holds them (surrogates removed by libhegel).
+    fn text_generator_ranges(
+        slf: Py<Engine>,
+        py: Python<'_>,
+        min_size: u64,
+        max_size: u64,
+        ranges: Vec<(u32, u32)>,
+    ) -> PyResult<StringGenerator> {
+        let ctx = slf.borrow(py).ctx;
+        let flat: Vec<u32> = ranges.iter().flat_map(|&(lo, hi)| [lo, hi]).collect();
+        let mut gen: *mut sys::HegelStringGenerator = std::ptr::null_mut();
+        // SAFETY: flat outlives the call; libhegel copies the ranges.
+        let r = unsafe {
+            sys::hegel_string_generator_text_ranges(
+                ctx,
+                min_size,
+                max_size,
+                flat.as_ptr(),
+                ranges.len(),
+                &mut gen,
+            )
+        };
+        check(ctx, r, "string_generator_text_ranges")?;
+        Ok(StringGenerator { engine: slf, gen })
+    }
+
+    /// A text generator over the codepoint range `[min_codepoint, max_codepoint]`
+    /// (surrogates always removed by libhegel), optionally restricted to an
+    /// explicit character set: `empty_alphabet=True` starts from nothing and
+    /// `include` adds characters; `exclude` removes characters.
+    #[pyo3(signature = (min_size, max_size, *, min_codepoint=0, max_codepoint=u32::MAX, include="", exclude="", empty_alphabet=false))]
+    #[allow(clippy::too_many_arguments)]
+    fn text_generator(
+        slf: Py<Engine>,
+        py: Python<'_>,
+        min_size: u64,
+        max_size: u64,
+        min_codepoint: u32,
+        max_codepoint: u32,
+        include: &str,
+        exclude: &str,
+        empty_alphabet: bool,
+    ) -> PyResult<StringGenerator> {
+        let ctx = slf.borrow(py).ctx;
+        let mut gen: *mut sys::HegelStringGenerator = std::ptr::null_mut();
+        let (categories, categories_len): (*const *const c_char, usize) = if empty_alphabet {
+            // A non-NULL, empty category list means an empty alphabet.
+            (std::ptr::NonNull::<*const c_char>::dangling().as_ptr(), 0)
+        } else {
+            (std::ptr::null(), 0)
+        };
+        // SAFETY: all buffers outlive the call; libhegel copies what it keeps.
+        let r = unsafe {
+            sys::hegel_string_generator_text(
+                ctx,
+                min_size,
+                max_size,
+                std::ptr::null(),
+                min_codepoint,
+                max_codepoint,
+                categories,
+                categories_len,
+                std::ptr::null(),
+                0,
+                include.as_ptr(),
+                include.len(),
+                exclude.as_ptr(),
+                exclude.len(),
+                &mut gen,
+            )
+        };
+        check(ctx, r, "string_generator_text")?;
+        Ok(StringGenerator { engine: slf, gen })
+    }
+}
