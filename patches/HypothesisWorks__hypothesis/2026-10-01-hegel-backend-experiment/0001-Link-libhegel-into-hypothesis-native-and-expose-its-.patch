+#[pymethods]
+impl Run {
+    /// The next test case, or None once the run is finished.
+    fn next_test_case(&self, py: Python<'_>) -> PyResult<Option<TestCase>> {
+        let ctx = self.engine.borrow(py).ctx;
+        let mut tc: *mut sys::HegelTestCase = std::ptr::null_mut();
+        // SAFETY: run is live until Drop.
+        let r = unsafe { sys::hegel_next_test_case(ctx, self.run, &mut tc) };
+        check(ctx, r, "next_test_case")?;
+        if tc.is_null() {
+            return Ok(None);
+        }
+        Ok(Some(TestCase {
+            engine: self.engine.clone_ref(py),
+            tc,
+            complete: false,
+        }))
+    }
+
+    /// The finished run's result (raises if the run is not complete).
+    fn result(&self, py: Python<'_>) -> PyResult<RunResult> {
+        let ctx = self.engine.borrow(py).ctx;
+        let mut res: *mut sys::HegelRunResult = std::ptr::null_mut();
+        // SAFETY: the result is a caller-owned copy, freed below.
+        unsafe {
+            check(
+                ctx,
+                sys::hegel_run_result(ctx, self.run, &mut res),
+                "run_result",
+            )?;
+            let mut status = sys::hegel_run_status_t::HEGEL_RUN_STATUS_PASSED;
+            check(
+                ctx,
+                sys::hegel_run_result_status(ctx, res, &mut status),
+                "run_result_status",
+            )?;
+            let mut err: *const c_char = std::ptr::null();
+            check(
+                ctx,
+                sys::hegel_run_result_error(ctx, res, &mut err),
+                "run_result_error",
+            )?;
+            let error = cstr_opt(err);
+            let mut count: usize = 0;
+            check(
+                ctx,
+                sys::hegel_run_result_failure_count(ctx, res, &mut count),
+                "failure_count",
+            )?;
+            let mut failures = Vec::with_capacity(count);
+            for i in 0..count {
+                let mut f: *mut sys::HegelFailure = std::ptr::null_mut();
+                check(
+                    ctx,
+                    sys::hegel_run_result_failure(ctx, res, i, &mut f),
+                    "run_result_failure",
+                )?;
+                let mut origin: *const c_char = std::ptr::null();
+                let mut blob: *const c_char = std::ptr::null();
+                let _ = sys::hegel_failure_origin(ctx, f, &mut origin);
+                let _ = sys::hegel_failure_reproduction_blob(ctx, f, &mut blob);
+                let failure = Failure {
+                    origin: cstr_opt(origin).unwrap_or_default(),
+                    blob: cstr_opt(blob),
+                };
+                let _ = sys::hegel_failure_free(ctx, f);
+                failures.push(Py::new(py, failure)?);
+            }
+            let _ = sys::hegel_run_result_free(ctx, res);
+            Ok(RunResult {
+                status: status as u32,
+                error,
+                failures,
+            })
+        }
+    }
+}
+
+impl Drop for Run {
+    fn drop(&mut self) {
+        Python::attach(|py| {
+            let ctx = self.engine.borrow(py).ctx;
+            // SAFETY: freed exactly once; an in-flight case is completed by libhegel.
+            unsafe {
+                let _ = sys::hegel_run_free(ctx, self.run);
+            }
+        });
+    }
+}
+
+impl TestCase {
+    fn ctx(&self, py: Python<'_>) -> *mut sys::HegelContext {
+        self.engine.borrow(py).ctx
+    }
+}
+
+#[pymethods]
+impl TestCase {
+    #[pyo3(signature = (p, forced=None))]
+    fn draw_boolean(&self, py: Python<'_>, p: f64, forced: Option<bool>) -> PyResult<bool> {
+        let ctx = self.ctx(py);
+        let mut out = false;
+        // SAFETY: tc is live until Drop.
+        let r = unsafe {
+            sys::hegel_generate_boolean(
+                ctx,
+                self.tc,
+                p,
+                forced.unwrap_or(false),
+                forced.is_some(),
+                &mut out,
+            )
+        };
+        check(ctx, r, "generate_boolean")?;
+        Ok(out)
+    }
+
+    /// Inclusive bounds; both required (libhegel has no unbounded draw).
+    fn draw_integer(&self, py: Python<'_>, min_value: i64, max_value: i64) -> PyResult<i64> {
+        let ctx = self.ctx(py);
+        let mut out: i64 = 0;
+        // SAFETY: tc is live until Drop.
+        let r =
+            unsafe { sys::hegel_generate_integer(ctx, self.tc, min_value, max_value, &mut out) };
+        check(ctx, r, "generate_integer")?;
+        Ok(out)
+    }
+
+    /// `keys[i]` is drawn with probability `weights[i]`; the remaining mass
+    /// is drawn like `draw_integer`. One integer choice either way.
+    fn draw_integer_weighted(
+        &self,
+        py: Python<'_>,
+        min_value: i64,
+        max_value: i64,
+        keys: Vec<i64>,
+        weights: Vec<f64>,
+    ) -> PyResult<i64> {
+        let ctx = self.ctx(py);
+        if keys.len() != weights.len() {
+            return Err(HegelError::new_err("keys and weights differ in length"));
+        }
+        let mut out: i64 = 0;
+        // SAFETY: tc is live until Drop; the slices outlive the call.
+        let r = unsafe {
+            sys::hegel_generate_integer_weighted(
+                ctx,
+                self.tc,
+                min_value,
+                max_value,
+                keys.as_ptr(),
+                weights.as_ptr(),
+                keys.len(),
+                &mut out,
+            )
+        };
+        check(ctx, r, "generate_integer_weighted")?;
+        Ok(out)
+    }
+
+    /// Bounds and result as two's-complement little-endian bytes, for
+    /// values outside the `int64` range (`int.to_bytes(..., "little", signed=True)`).
+    fn draw_integer_big<'py>(
+        &self,
+        py: Python<'py>,
+        min_value: &[u8],
+        max_value: &[u8],
+    ) -> PyResult<Bound<'py, PyBytes>> {
+        let ctx = self.ctx(py);
+        let cap = min_value.len().max(max_value.len()).max(1);
+        let mut out = vec![0u8; cap];
+        let mut out_len: usize = 0;
+        // SAFETY: buffers are sized per the ABI contract (cap >= max(len, len)).
+        let r = unsafe {
+            sys::hegel_generate_integer_big(
+                ctx,
+                self.tc,
+                min_value.as_ptr(),
+                min_value.len(),
+                max_value.as_ptr(),
+                max_value.len(),
+                out.as_mut_ptr(),
+                cap,
+                &mut out_len,
+            )
+        };
+        check(ctx, r, "generate_integer_big")?;
+        // libhegel sign-fills the whole buffer, so the full `cap` bytes read
+        // back as the value with no sign extension needed.
+        Ok(PyBytes::new(py, &out))
+    }
+
+    #[pyo3(signature = (*, min_value, max_value, allow_nan, allow_infinity, smallest_nonzero_magnitude, width=64))]
+    #[allow(clippy::too_many_arguments)]
+    fn draw_float(
+        &self,
+        py: Python<'_>,
+        min_value: f64,
+        max_value: f64,
+        allow_nan: bool,
+        allow_infinity: bool,
+        smallest_nonzero_magnitude: f64,
+        width: u32,
+    ) -> PyResult<f64> {
+        let ctx = self.ctx(py);
+        let mut out = 0.0f64;
+        // SAFETY: tc is live until Drop.
+        let r = unsafe {
+            sys::hegel_generate_float(
+                ctx,
+                self.tc,
+                width,
+                min_value,
+                max_value,
+                allow_nan,
+                allow_infinity,
+                false,
+                false,
+                smallest_nonzero_magnitude,
+                &mut out,
+            )
+        };
+        check(ctx, r, "generate_float")?;
+        Ok(out)
+    }
+
+    fn draw_bytes<'py>(
+        &self,
+        py: Python<'py>,
+        min_size: u64,
+        max_size: u64,
+    ) -> PyResult<Bound<'py, PyBytes>> {
+        let ctx = self.ctx(py);
+        let mut res = sys::hegel_generate_bytes_result_t {
+            data: std::ptr::null_mut(),
+            len: 0,
+        };
+        // SAFETY: the result buffer is libhegel-allocated and freed right after copying.
+        unsafe {
+            let r = sys::hegel_generate_bytes(ctx, self.tc, min_size, max_size, &mut res);
+            check(ctx, r, "generate_bytes")?;
+            let slice: &[u8] = if res.data.is_null() {
+                &[]
+            } else {
+                std::slice::from_raw_parts(res.data, res.len)
+            };
+            let out = PyBytes::new(py, slice);
+            let _ = sys::hegel_generate_bytes_result_free(ctx, &mut res);
+            Ok(out)
+        }
+    }
+
+    fn draw_string<'py>(
+        &self,
+        py: Python<'py>,
+        generator: &StringGenerator,
+    ) -> PyResult<Bound<'py, PyString>> {
+        let ctx = self.ctx(py);
+        let mut res = sys::hegel_generate_string_result_t {
+            data: std::ptr::null_mut(),
+            len: 0,
+        };
+        // SAFETY: the result buffer is libhegel-allocated UTF-8 and freed right after copying.
+        unsafe {
+            let r = sys::hegel_generate_string(ctx, self.tc, generator.gen, &mut res);
+            check(ctx, r, "generate_string")?;
+            let slice: &[u8] = if res.data.is_null() {
+                &[]
+            } else {
+                std::slice::from_raw_parts(res.data as *const u8, res.len)
+            };
+            let out = String::from_utf8_lossy(slice).into_owned();
+            let _ = sys::hegel_generate_string_result_free(ctx, &mut res);
+            Ok(PyString::new(py, &out))
+        }
+    }
+
+    /// libhegel's collection sizing: call `Collection.more()` until it is
+    /// False, drawing one element per True.
+    fn new_collection(
+        slf: Py<TestCase>,
+        py: Python<'_>,
+        min_size: u64,
+        max_size: u64,
+    ) -> PyResult<Collection> {
+        let (engine, tc) = {
+            let s = slf.borrow(py);
+            (s.engine.clone_ref(py), s.tc)
+        };
+        let ctx = engine.borrow(py).ctx;
+        let mut c: *mut sys::HegelCollection = std::ptr::null_mut();
+        // SAFETY: tc is live; the collection is freed in Drop.
+        let r = unsafe { sys::hegel_new_collection(ctx, tc, min_size, max_size, &mut c) };
+        check(ctx, r, "new_collection")?;
+        Ok(Collection {
+            engine,
+            tc: slf,
+            collection: c,
+        })
+    }
+
+    /// A targeting observation: libhegel steers later cases toward higher
+    /// values of `label` (needs `PHASE_TARGET`). Finite `value` only.
+    fn target(&self, py: Python<'_>, label: &str, value: f64) -> PyResult<()> {
+        let ctx = self.ctx(py);
+        let label = CString::new(label).map_err(|_| HegelError::new_err("label contains NUL"))?;
+        // SAFETY: tc is live until Drop; label outlives the call.
+        let r = unsafe { sys::hegel_target(ctx, self.tc, value, label.as_ptr()) };
+        check(ctx, r, "target")
+    }
+
+    fn start_span(&self, py: Python<'_>, label: u64) -> PyResult<()> {
+        let ctx = self.ctx(py);
+        // SAFETY: tc is live until Drop.
+        let r = unsafe { sys::hegel_start_span(ctx, self.tc, label) };
+        check(ctx, r, "start_span")
+    }
+
+    fn stop_span(&self, py: Python<'_>, discard: bool) -> PyResult<()> {
+        let ctx = self.ctx(py);
+        // SAFETY: tc is live until Drop.
+        let r = unsafe { sys::hegel_stop_span(ctx, self.tc, discard) };
+        check(ctx, r, "stop_span")
+    }
+
+    /// `status` is one of the `STATUS_*` constants; `origin` identifies the
+    /// failure (only read for `STATUS_INTERESTING`).
+    #[pyo3(signature = (status, origin=None))]
+    fn mark_complete(&mut self, py: Python<'_>, status: u32, origin: Option<&str>) -> PyResult<()> {
+        let ctx = self.ctx(py);
+        let origin_c = match origin {
+            Some(s) => {
+                Some(CString::new(s).map_err(|_| HegelError::new_err("origin contains NUL"))?)
+            }
+            None => None,
+        };
+        let origin_p = origin_c.as_ref().map_or(std::ptr::null(), |c| c.as_ptr());
+        // SAFETY: origin_c outlives the call.
+        let r = unsafe { sys::hegel_mark_complete(ctx, self.tc, status, origin_p) };
+        self.complete = true;
+        check(ctx, r, "mark_complete")
+    }
+
+    #[getter]
+    fn complete(&self) -> bool {
+        self.complete
+    }
