+                sys::hegel_settings_set_phases(ctx, settings, phases),
+                "set_phases",
+            )?;
+            check(
+                ctx,
+                sys::hegel_settings_set_suppress_health_check(ctx, settings, suppress_health_check),
+                "set_suppress_health_check",
+            )?;
+            check(
