+    fn init(m: &Bound<'_, PyModule>) -> PyResult<()> {
+        let py = m.py();
+        m.add("HegelError", py.get_type::<super::HegelError>())?;
+        m.add("StopTestError", py.get_type::<super::StopTestError>())?;
+        m.add("AssumeError", py.get_type::<super::AssumeError>())?;
+        m.add("STATUS_VALID", super::STATUS_VALID)?;
+        m.add("STATUS_INVALID", super::STATUS_INVALID)?;
+        m.add("STATUS_OVERRUN", super::STATUS_OVERRUN)?;
+        m.add("STATUS_INTERESTING", super::STATUS_INTERESTING)?;
+        m.add("PHASE_EXPLICIT", super::PHASE_EXPLICIT)?;
+        m.add("PHASE_REUSE", super::PHASE_REUSE)?;
+        m.add("PHASE_GENERATE", super::PHASE_GENERATE)?;
+        m.add("PHASE_TARGET", super::PHASE_TARGET)?;
+        m.add("PHASE_SHRINK", super::PHASE_SHRINK)?;
+        m.add("HC_FILTER_TOO_MUCH", super::HC_FILTER_TOO_MUCH)?;
+        m.add("HC_TOO_SLOW", super::HC_TOO_SLOW)?;
+        m.add("HC_TEST_CASES_TOO_LARGE", super::HC_TEST_CASES_TOO_LARGE)?;
+        m.add(
+            "HC_LARGE_INITIAL_TEST_CASE",
+            super::HC_LARGE_INITIAL_TEST_CASE,
+        )?;
+        Ok(())
