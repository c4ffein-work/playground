+"""
+EXPERIMENT: libhegel as the engine (``HYPOTHESIS_ENGINE=hegel``): the run
+loop, generation, shrinking and targeting are libhegel's, Hypothesis keeps
+``ConjectureData``, test execution and reporting.
+"""
+
+import pytest
+
+from hypothesis import (
+    HealthCheck,
+    Phase,
+    example,
+    given,
+    settings,
+    strategies as st,
+    target,
+)
+from hypothesis.errors import FailedHealthCheck
+from hypothesis.internal.compat import ExceptionGroup
+from hypothesis.internal.conjecture.hegel_runner import (
+    HegelRunner,
+    hegel_engine_enabled,
+)
+
+from tests.common.debug import minimal
+
+
+@pytest.fixture(autouse=True)
+def hegel_engine(monkeypatch):
+    monkeypatch.setenv("HYPOTHESIS_ENGINE", "hegel")
+    assert hegel_engine_enabled()
+
+
+def test_runner_is_selected(monkeypatch):
+    seen = []
+    original = HegelRunner.run
+
+    def spy(self):
+        seen.append(self)
+        return original(self)
+
+    monkeypatch.setattr(HegelRunner, "run", spy)
+
+    @settings(database=None, max_examples=5)
+    @given(st.integers())
+    def f(x):
+        pass
+
+    f()
+    assert len(seen) == 1
+    assert seen[0].call_count >= 1
+
+
+@pytest.mark.parametrize(
+    "strategy, condition, expected",
+    [
+        (st.lists(st.integers()), lambda x: sum(x) > 10, [11]),
+        (st.integers(), lambda x: x > 100, 101),
+        (st.text(), lambda s: len(s) >= 3, "000"),
+        (st.floats(), lambda x: x > 1.5, 2.0),
+        (st.binary(), lambda b: len(b) >= 2, b"\x00\x00"),
+        (st.lists(st.integers(), min_size=2, unique=True), lambda x: True, [0, 1]),
+    ],
+)
+def test_libhegel_shrinks_to_the_python_engines_minimum(strategy, condition, expected):
+    assert minimal(strategy, condition) == expected
+
+
+def test_reports_every_bug_when_asked():
+    @settings(database=None, report_multiple_bugs=True)
+    @given(st.integers())
+    def f(x):
+        if x > 100:
+            raise ValueError
+        if x < -100:
+            raise KeyError
+
+    with pytest.raises(ExceptionGroup) as err:
+        f()
+    assert {type(e) for e in err.value.exceptions} == {ValueError, KeyError}
+
+
+def test_filtering_everything_fails_libhegels_health_check():
+    @settings(database=None)
+    @given(st.integers().filter(lambda x: False))
+    def f(x):
+        pass
+
+    with pytest.raises(FailedHealthCheck):
+        f()
+
+
+def test_suppressed_health_check_is_passed_to_libhegel():
+    @settings(
+        database=None,
+        suppress_health_check=[HealthCheck.filter_too_much],
+        max_examples=20,
+    )
+    @given(st.integers().filter(lambda x: x % 7 == 0))
+    def f(x):
+        assert x % 7 == 0
+
+    f()
+
+
+def test_targeting_climbs():
+    best = 0
+
+    @settings(database=None, max_examples=200, deadline=None)
+    @given(st.integers(0, 10**6), st.integers(0, 10**6))
+    def f(a, b):
+        nonlocal best
+        target(float(a + b))
+        best = max(best, a + b)
+
+    f()
+    assert best > 10**6
+
+
+def test_explicit_examples_still_run_before_the_engine():
+    seen = []
+
+    @settings(database=None, phases=[Phase.explicit], max_examples=5)
+    @example(42)
+    @given(st.integers())
+    def f(x):
+        seen.append(x)
+
+    f()
+    assert seen == [42]
+
+
+def test_other_backends_keep_the_python_runner():
+    # the runner flag only applies to the default backend
+    @settings(database=None, backend="hegel", max_examples=5)
+    @given(st.integers())
+    def f(x):
+        pass
+
+    f()
