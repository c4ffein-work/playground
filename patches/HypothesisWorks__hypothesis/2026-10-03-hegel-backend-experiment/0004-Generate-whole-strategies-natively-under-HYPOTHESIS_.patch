+def _same(a, b):
+    if isinstance(a, float) and isinstance(b, float):
+        return (math.isnan(a) and math.isnan(b)) or (
+            a == b and math.copysign(1, a) == math.copysign(1, b)
+        )
+    if isinstance(a, (list, tuple)) and isinstance(b, (list, tuple)):
+        return (
+            type(a) is type(b)
+            and len(a) == len(b)
+            and all(_same(x, y) for x, y in zip(a, b, strict=True))
+        )
+    if isinstance(a, dict) and isinstance(b, dict):
+        return list(a) == list(b) and all(_same(a[k], b[k]) for k in a)
+    return type(a) is type(b) and a == b
+
+
+@pytest.mark.parametrize(
+    "strategy",
+    BATCHABLE + [s for s in OPAQUE_ROOTS if s is not DATA] + MIXED,
+    ids=repr,
+)
+def test_a_batched_value_is_what_the_python_engine_draws_from_its_choices(strategy):
+    # libhegel generates the value and records the choice sequence; the Python
+    # engine, replaying that sequence through its own do_draw code, has to
+    # arrive at the same value
+    seen = []
+
+    def test_function(data):
+        with BuildContext(data, wrapped_test=lambda: None):
+            value = data.draw(strategy)
+        seen.append((data, value))
+
+    runner = HegelRunner(
+        test_function,
+        settings=settings(database=None, max_examples=60, phases=[Phase.generate]),
+    )
+    runner.run()
+    # a case without choices ends libhegel's run as exhausted
+    assert len(seen) >= (1 if strategy is JUST else 30)
+    for data, value in seen:
+        replay = ConjectureData.for_choices([n.value for n in data.nodes])
+        with BuildContext(replay, wrapped_test=lambda: None):
+            replayed = replay.draw(strategy)
+        assert _same(replayed, value), (value, replayed, data.nodes)
+        assert not replay.misaligned_at
+
