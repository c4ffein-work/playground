+def decode_choices(blob: str) -> list[ChoiceT]:
+    """Inverse of |encode_choices| for the raw and zlib blob forms."""
+    payload = base64.b64decode(blob)
+    body = payload[1:]
+    if payload[:1] == b"\x01":
+        body = zlib.decompress(body)
+    elif payload[:1] != b"\x00":
+        raise ValueError(f"unsupported blob prefix {payload[:1]!r}")
+    pos = 4
+    (count,) = struct.unpack_from("<I", body, 0)
+    out: list[ChoiceT] = []
+    for _ in range(count):
+        tag = body[pos]
+        pos += 1
+        if tag == 0:
+            sub = body[pos]
+            pos += 1
+            assert sub == 10, sub
+            (n,) = struct.unpack_from("<I", body, pos)
+            pos += 4
+            out.append(int.from_bytes(body[pos : pos + n], "little", signed=True))
+            pos += n
+        elif tag == 1:
+            out.append(bool(body[pos]))
+            pos += 1
+        elif tag == 2:
+            (f,) = struct.unpack_from("<d", body, pos)
+            pos += 8
+            out.append(f)
+        elif tag == 3:
+            (n,) = struct.unpack_from("<I", body, pos)
+            pos += 4
+            out.append(bytes(body[pos : pos + n]))
+            pos += n
+        elif tag == 4:
+            (n,) = struct.unpack_from("<I", body, pos)
+            pos += 4
+            cps = struct.unpack_from(f"<{n}I", body, pos)
+            pos += 4 * n
+            out.append("".join(map(chr, cps)))
+        else:  # pragma: no cover
+            raise ValueError(f"unsupported choice tag {tag}")
+    return out
+
