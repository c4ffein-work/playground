+"""
+EXPERIMENT: compile the declarative part of a strategy object graph into the
+tree the libhegel interpreter (``hegel_gen.rs``) walks.
+
+Most strategies are data, not code: a strategy's draw is a function of its
+attributes and of the values drawn so far, and for the built-in ones that
+function is known here. Those become IR nodes mirroring each ``do_draw``.
+Anything else (composite, flatmap, data, recursion, stateful, filters on
+sampled_from, optional fixed-dictionary keys, strategies drawing from Python
+state) becomes an ``opaque`` leaf: the interpreter hands it back to
+``ConjectureData.draw`` to run interactively against the same libhegel case.
+A compiled root that is itself opaque is reported as not batchable.
+"""
+
+import math
+from typing import Any
+
+from hypothesis._native.internal import hegel as _hegel
+from hypothesis.internal.conjecture.hegel_provider import (
+    INT64_MAX,
+    INT64_MIN,
+    SURROGATES,
+    UNBOUNDED_MAGNITUDE,
+    _signed_bytes,
+)
+from hypothesis.internal.conjecture.providers import COLLECTION_DEFAULT_MAX_SIZE
+from hypothesis.internal.conjecture.utils import ONE_FROM_MANY_LABEL, _calc_p_continue
+from hypothesis.strategies._internal.collections import (
+    FixedDictStrategy,
+    ListStrategy,
+    TupleStrategy,
+)
+from hypothesis.strategies._internal.core import BuildsStrategy
+from hypothesis.strategies._internal.lazy import unwrap_strategies
+from hypothesis.strategies._internal.misc import BooleansStrategy, JustStrategy
+from hypothesis.strategies._internal.numbers import FloatStrategy, IntegersStrategy
+from hypothesis.strategies._internal.shared import SharedStrategy
+from hypothesis.strategies._internal.strategies import (
+    FILTERED_SEARCH_STRATEGY_DO_DRAW_LABEL,
+    MAPPED_SEARCH_STRATEGY_DO_DRAW_LABEL,
+    FilteredStrategy,
+    MappedStrategy,
+    OneOfStrategy,
+    SampledFromStrategy,
+    SearchStrategy,
+)
+from hypothesis.strategies._internal.strings import (
+    BytesStrategy,
+    OneCharStringStrategy,
+    TextStrategy,
+)
+
+NOT_BATCHABLE = object()
+_CACHE_ATTR = "_hegel_compiled"
+MAX_COMPILE_DEPTH = 32
+
+
+def _size(n: Any) -> int:
+    if n is None or n == math.inf:
+        return COLLECTION_DEFAULT_MAX_SIZE
+    return int(n)
+
+
+def _int_node(start: int | None, end: int | None, label: int) -> tuple:
+    """Mirror IntegersStrategy.do_draw plus the provider's bound clamping."""
+    weights: dict[int, float] | None = None
+    if start is not None and end is not None and end - start > 127:
+        weights = {start: 2 / 128, start + 1: 1 / 128, end - 1: 1 / 128, end: 2 / 128}
+    if start is None and end is None:
+        lo, hi = -UNBOUNDED_MAGNITUDE, UNBOUNDED_MAGNITUDE
+    elif start is None:
+        assert end is not None
+        lo, hi = -max(UNBOUNDED_MAGNITUDE, 2 * abs(end)), end
+    elif end is None:
+        lo, hi = start, max(UNBOUNDED_MAGNITUDE, 2 * abs(start))
+    else:
+        lo, hi = start, end
+    fits = INT64_MIN <= lo and hi <= INT64_MAX
+    keys = list(weights) if (weights and fits) else []
+    ws = list(weights.values()) if (weights and fits) else []
+    return (
+        "int",
+        _signed_bytes(lo),
+        _signed_bytes(hi),
+        lo if fits else None,
+        hi if fits else None,
+        0,
+        keys,
+        ws,
+        label,
+    )
+
+
+def _compile(s: SearchStrategy, stack: set[int], depth: int) -> tuple:
+    s = unwrap_strategies(s)
+    label = s.label
+    if id(s) in stack or depth > MAX_COMPILE_DEPTH:
+        return ("opaque", s)
+    stack = stack | {id(s)}
+
+    def child(c: SearchStrategy) -> tuple:
+        return _compile(c, stack, depth + 1)
+
+    if isinstance(s, IntegersStrategy):
+        return _int_node(s.start, s.end, label)
+    if isinstance(s, FloatStrategy):
+        return (
+            "float",
+            float(s.min_value),
+            float(s.max_value),
+            s.allow_nan,
+            s.smallest_nonzero_magnitude,
+            label,
+        )
+    if isinstance(s, BooleansStrategy):
+        return ("bool", 0.5, label)
+    if isinstance(s, BytesStrategy):
+        return ("bytes", s.min_size, _size(s.max_size), label)
+    if isinstance(s, OneCharStringStrategy):
+        return _text_node(s.intervals, 1, 1, label)
+    if isinstance(s, TextStrategy):
+        elems = unwrap_strategies(s.element_strategy)
+        if isinstance(elems, OneCharStringStrategy):
+            return _text_node(elems.intervals, s.min_size, _size(s.max_size), label)
+        if elems.is_empty:
+            return ("just", "", [], label)
+        return (
+            "text_list",
+            child(s.element_strategy),
+            s.min_size,
+            _size(s.max_size),
+            _calc_p_continue(s.average_size - s.min_size, s.max_size - s.min_size),
+            label,
+        )
+    if type(s) is ListStrategy:
+        if s.element_strategy.is_empty:
+            return ("empty_list", label)
+        return (
+            "list",
+            child(s.element_strategy),
+            s.min_size,
+            _size(s.max_size),
+            _calc_p_continue(s.average_size - s.min_size, s.max_size - s.min_size),
+            label,
+        )
+    if type(s) is TupleStrategy:
+        return ("tuple", [child(c) for c in s.element_strategies], label)
+    if type(s) is FixedDictStrategy and s.optional is None:
+        keys = list(s.mapping)
+        return (
+            "fixeddict",
+            keys,
+            [child(s.mapping[k]) for k in keys],
+            type(s.mapping),
+            label,
+        )
+    if type(s) is OneOfStrategy:
+        branches = s.element_strategies
+        if not branches:
+            return ("opaque", s)
+        inner = FilteredStrategy(SampledFromStrategy(branches), conditions=()).label
+        return ("one_of", [child(c) for c in branches], inner, label)
+    if type(s) is JustStrategy:
+        if any(kind == "filter" for kind, _, _ in s._transformations):
+            return ("opaque", s)
+        return ("just", s.value, [f for _, f, _ in s._transformations], label)
+    if type(s) is SampledFromStrategy:
+        if any(kind == "filter" for kind, _, _ in s._transformations):
+            return ("opaque", s)
+        return (
+            "sampled",
+            list(s.elements),
+            [f for _, f, _ in s._transformations],
+            label,
+        )
+    if type(s) is MappedStrategy:
+        return ("map", child(s.mapped_strategy), s.pack, label)
+    if type(s) is BuildsStrategy:
+        return (
+            "builds",
+            s.target,
+            [child(c) for c in s.args],
+            list(s.kwargs),
+            [child(s.kwargs[k]) for k in s.kwargs],
+            label,
+        )
+    if type(s) is SharedStrategy:
+        # SharedStrategy.do_draw also warns about incompatible bases under one
+        # key; left to Python (its base is batched underneath)
+        return ("opaque", s)
+    if type(s) is FilteredStrategy:
+        return (
+            "filter",
+            child(s.filtered_strategy),
+            list(s.flat_conditions),
+            repr(s),
+            label,
+        )
+    return ("opaque", s)
+
+
+def _text_node(intervals: Any, min_size: int, max_size: int, label: int) -> tuple:
+    ranges = list(intervals.intervals)
+    if not ranges:
+        return ("just", "", [], label)
+    if all(SURROGATES[0] <= lo and hi <= SURROGATES[1] for lo, hi in ranges):
+        # libhegel cannot hold lone surrogates in a string
+        return ("opaque", _ONE_CHAR_FALLBACK(intervals, min_size, max_size))
+    return ("text", ranges, min_size, max_size, label)
+
+
+def _ONE_CHAR_FALLBACK(intervals: Any, min_size: int, max_size: int) -> SearchStrategy:
+    from hypothesis.strategies._internal.strings import TextStrategy
+
+    return TextStrategy(OneCharStringStrategy(intervals), min_size, max_size)
+
+
+def compile_strategy(strategy: SearchStrategy) -> Any:
+    """The compiled form of ``strategy`` (cached on it), or NOT_BATCHABLE
+    when its root is opaque."""
+    try:
+        cached = strategy.__dict__.get(_CACHE_ATTR)
+    except AttributeError:
+        return NOT_BATCHABLE
+    if cached is not None:
+        return cached
+    desc = _compile(strategy, set(), 0)
+    if desc[0] == "opaque":
+        compiled: Any = NOT_BATCHABLE
+    else:
+        compiled = _hegel.CompiledStrategy(
+            desc,
+            ONE_FROM_MANY_LABEL,
+            FILTERED_SEARCH_STRATEGY_DO_DRAW_LABEL,
+            MAPPED_SEARCH_STRATEGY_DO_DRAW_LABEL,
+        )
+    try:
+        strategy.__dict__[_CACHE_ATTR] = compiled
+    except AttributeError:
+        pass
+    return compiled
