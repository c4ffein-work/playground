+//! EXPERIMENT: a strategy interpreter over libhegel's primitives.
+//!
+//! `hegel_ir.py` compiles the declarative part of a strategy object graph
+//! (integers, floats, booleans, text, bytes, lists, tuples, one_of,
+//! sampled_from, just, map, builds, shared, filter, fixed dictionaries) into
+//! a small tree; [`generate`] walks that tree against one libhegel test
+//! case, mirroring each Hypothesis strategy's `do_draw` draw for draw, and
+//! builds the Python value on this side of the boundary. Strategies it
+//! cannot express stay Python: an `Opaque` node hands the strategy back to
+//! `ConjectureData.draw`, which runs it interactively against the same
+//! libhegel case, so a declarative tree may contain opaque leaves and an
+//! opaque strategy may draw declarative subtrees.
+//!
+//! The interpreter records every primitive draw it makes as `(kind, value)`
+//! pairs and flushes them into the `ConjectureData` around each opaque
+//! call-back and at the end, so the Python side keeps a value-faithful node
+//! list in draw order.
+
+use std::collections::HashMap;
+use std::ffi::{c_char, CString};
+use std::sync::Mutex;
+
+use hegel_c as sys;
+use pyo3::prelude::*;
+use pyo3::types::{PyBytes, PyDict, PyList, PyString, PyTuple, PyType};
+
+use super::hegel::{check, Engine, HegelError, TestCase};
+
+pub(crate) struct IntNode {
+    /// bounds as two's-complement little-endian bytes (the big path)
+    lo: Vec<u8>,
+    hi: Vec<u8>,
+    /// the same bounds when they fit int64 (the fast path, with weights)
+    lo64: Option<i64>,
+    hi64: Option<i64>,
+    shrink_towards: i64,
+    keys: Vec<i64>,
+    weights: Vec<f64>,
+}
+
+pub(crate) enum Node {
+    Int(IntNode, u64),
+    Float {
+        min: f64,
+        max: f64,
+        allow_nan: bool,
+        snm: f64,
+        label: u64,
+    },
+    Bool {
+        p: f64,
+        label: u64,
+    },
+    Bytes {
+        min: u64,
+        max: u64,
+        label: u64,
+    },
+    Text {
+        ranges: Vec<(u32, u32)>,
+        min: u64,
+        max: u64,
+        label: u64,
+    },
+    /// a string built from a non-character element strategy: a list, joined
+    TextList {
+        elem: Box<Node>,
+        min: u64,
+        max: u64,
+        p_continue: f64,
+        label: u64,
+    },
+    EmptyList {
+        label: u64,
+    },
+    List {
+        elem: Box<Node>,
+        min: u64,
+        max: u64,
+        p_continue: f64,
+        label: u64,
+    },
+    Tuple {
+        children: Vec<Node>,
+        label: u64,
+    },
+    FixedDict {
+        keys: Vec<Py<PyAny>>,
+        children: Vec<Node>,
+        dict_type: Py<PyAny>,
+        label: u64,
+    },
+    OneOf {
+        children: Vec<Node>,
+        inner_label: u64,
+        label: u64,
+    },
+    Sampled {
+        elements: Py<PyAny>,
+        n: i64,
+        maps: Vec<Py<PyAny>>,
+        label: u64,
+    },
+    Just {
+        value: Py<PyAny>,
+        maps: Vec<Py<PyAny>>,
+        label: u64,
+    },
+    Map {
+        inner: Box<Node>,
+        pack: Py<PyAny>,
+        label: u64,
+    },
+    Builds {
+        target: Py<PyAny>,
+        args: Vec<Node>,
+        names: Vec<Py<PyAny>>,
+        kwargs: Vec<Node>,
+        label: u64,
+    },
+    Shared {
+        key: Py<PyAny>,
+        strategy: Py<PyAny>,
+        inner: Box<Node>,
+        label: u64,
+    },
+    Filter {
+        inner: Box<Node>,
+        conditions: Vec<Py<PyAny>>,
+        repr: String,
+        label: u64,
+    },
+    /// a strategy the compiler could not express: `data.draw(strategy)`
+    Opaque(Py<PyAny>),
+}
+
+fn item<'py>(t: &Bound<'py, PyTuple>, i: usize) -> PyResult<Bound<'py, PyAny>> {
+    t.get_item(i)
+}
+
+fn parse_children(obj: &Bound<'_, PyAny>) -> PyResult<Vec<Node>> {
+    obj.try_iter()?.map(|c| Node::from_py(&c?)).collect()
+}
+
+impl Node {
+    pub(crate) fn from_py(obj: &Bound<'_, PyAny>) -> PyResult<Node> {
+        let t = obj.cast::<PyTuple>()?;
+        let tag: String = item(t, 0)?.extract()?;
+        Ok(match tag.as_str() {
+            "int" => Node::Int(
+                IntNode {
+                    lo: item(t, 1)?.extract()?,
+                    hi: item(t, 2)?.extract()?,
+                    lo64: item(t, 3)?.extract()?,
+                    hi64: item(t, 4)?.extract()?,
+                    shrink_towards: item(t, 5)?.extract()?,
+                    keys: item(t, 6)?.extract()?,
+                    weights: item(t, 7)?.extract()?,
+                },
+                item(t, 8)?.extract()?,
+            ),
+            "float" => Node::Float {
+                min: item(t, 1)?.extract()?,
+                max: item(t, 2)?.extract()?,
+                allow_nan: item(t, 3)?.extract()?,
+                snm: item(t, 4)?.extract()?,
+                label: item(t, 5)?.extract()?,
+            },
+            "bool" => Node::Bool {
+                p: item(t, 1)?.extract()?,
+                label: item(t, 2)?.extract()?,
+            },
+            "bytes" => Node::Bytes {
+                min: item(t, 1)?.extract()?,
+                max: item(t, 2)?.extract()?,
+                label: item(t, 3)?.extract()?,
+            },
+            "text" => Node::Text {
+                ranges: item(t, 1)?.extract()?,
+                min: item(t, 2)?.extract()?,
+                max: item(t, 3)?.extract()?,
+                label: item(t, 4)?.extract()?,
+            },
+            "text_list" => Node::TextList {
+                elem: Box::new(Node::from_py(&item(t, 1)?)?),
+                min: item(t, 2)?.extract()?,
+                max: item(t, 3)?.extract()?,
+                p_continue: item(t, 4)?.extract()?,
+                label: item(t, 5)?.extract()?,
+            },
+            "empty_list" => Node::EmptyList {
+                label: item(t, 1)?.extract()?,
+            },
+            "list" => Node::List {
+                elem: Box::new(Node::from_py(&item(t, 1)?)?),
+                min: item(t, 2)?.extract()?,
+                max: item(t, 3)?.extract()?,
+                p_continue: item(t, 4)?.extract()?,
+                label: item(t, 5)?.extract()?,
+            },
+            "tuple" => Node::Tuple {
+                children: parse_children(&item(t, 1)?)?,
+                label: item(t, 2)?.extract()?,
+            },
+            "fixeddict" => Node::FixedDict {
+                keys: item(t, 1)?
+                    .try_iter()?
+                    .map(|k| Ok(k?.unbind()))
+                    .collect::<PyResult<_>>()?,
+                children: parse_children(&item(t, 2)?)?,
+                dict_type: item(t, 3)?.unbind(),
+                label: item(t, 4)?.extract()?,
+            },
+            "one_of" => Node::OneOf {
+                children: parse_children(&item(t, 1)?)?,
+                inner_label: item(t, 2)?.extract()?,
+                label: item(t, 3)?.extract()?,
+            },
+            "sampled" => {
+                let elements = item(t, 1)?;
+                Node::Sampled {
+                    n: elements.len()? as i64,
+                    elements: elements.unbind(),
+                    maps: item(t, 2)?
+                        .try_iter()?
+                        .map(|m| Ok(m?.unbind()))
+                        .collect::<PyResult<_>>()?,
+                    label: item(t, 3)?.extract()?,
+                }
+            }
+            "just" => Node::Just {
+                value: item(t, 1)?.unbind(),
+                maps: item(t, 2)?
+                    .try_iter()?
+                    .map(|m| Ok(m?.unbind()))
+                    .collect::<PyResult<_>>()?,
+                label: item(t, 3)?.extract()?,
+            },
+            "map" => Node::Map {
+                inner: Box::new(Node::from_py(&item(t, 1)?)?),
+                pack: item(t, 2)?.unbind(),
+                label: item(t, 3)?.extract()?,
+            },
+            "builds" => Node::Builds {
+                target: item(t, 1)?.unbind(),
+                args: parse_children(&item(t, 2)?)?,
+                names: item(t, 3)?
+                    .try_iter()?
+                    .map(|k| Ok(k?.unbind()))
+                    .collect::<PyResult<_>>()?,
+                kwargs: parse_children(&item(t, 4)?)?,
+                label: item(t, 5)?.extract()?,
+            },
+            "shared" => Node::Shared {
+                key: item(t, 1)?.unbind(),
+                strategy: item(t, 2)?.unbind(),
+                inner: Box::new(Node::from_py(&item(t, 3)?)?),
+                label: item(t, 4)?.extract()?,
+            },
+            "filter" => Node::Filter {
+                inner: Box::new(Node::from_py(&item(t, 1)?)?),
+                conditions: item(t, 2)?
+                    .try_iter()?
+                    .map(|c| Ok(c?.unbind()))
+                    .collect::<PyResult<_>>()?,
+                repr: item(t, 3)?.extract()?,
+                label: item(t, 4)?.extract()?,
+            },
+            "opaque" => Node::Opaque(item(t, 1)?.unbind()),
+            other => return Err(HegelError::new_err(format!("unknown IR node {other:?}"))),
+        })
+    }
+}
+
+/// The compiled form of one strategy: the tree plus the span labels the
+/// interpreter shares with Hypothesis's own `many`, filter and map draws.
+#[pyclass(module = "hypothesis._native.internal.hegel")]
+pub(crate) struct CompiledStrategy {
+    root: Node,
+    one_from_many: u64,
+    filtered: u64,
+    mapped: u64,
+}
+
+// SAFETY: every Py<PyAny> inside is only touched with the GIL held.
+unsafe impl Send for CompiledStrategy {}
+unsafe impl Sync for CompiledStrategy {}
+
+#[pymethods]
+impl CompiledStrategy {
+    #[new]
+    fn new(
+        desc: &Bound<'_, PyAny>,
+        one_from_many: u64,
+        filtered: u64,
+        mapped: u64,
+    ) -> PyResult<Self> {
+        Ok(CompiledStrategy {
+            root: Node::from_py(desc)?,
+            one_from_many,
+            filtered,
+            mapped,
+        })
+    }
+}
+
+/// Cached per engine: libhegel text generators by alphabet and size bounds.
+type TextGenKey = (Vec<(u32, u32)>, u64, u64);
+
+#[derive(Default)]
+pub(crate) struct TextGenCache {
+    gens: Mutex<HashMap<TextGenKey, usize>>,
+}
+
+impl TextGenCache {
+    fn get(
+        &self,
+        ctx: *mut sys::HegelContext,
+        ranges: &[(u32, u32)],
+        min: u64,
+        max: u64,
+    ) -> PyResult<*mut sys::HegelStringGenerator> {
+        let key = (ranges.to_vec(), min, max);
+        let mut gens = self.gens.lock().unwrap();
+        if let Some(&p) = gens.get(&key) {
+            return Ok(p as *mut sys::HegelStringGenerator);
+        }
+        let flat: Vec<u32> = ranges.iter().flat_map(|&(lo, hi)| [lo, hi]).collect();
+        let mut gen: *mut sys::HegelStringGenerator = std::ptr::null_mut();
+        // SAFETY: flat outlives the call; libhegel copies the ranges.
+        let r = unsafe {
+            sys::hegel_string_generator_text_ranges(
+                ctx,
+                min,
+                max,
+                flat.as_ptr(),
+                ranges.len(),
+                &mut gen,
+            )
+        };
+        check(ctx, r, "string_generator_text_ranges")?;
+        gens.insert(key, gen as usize);
+        Ok(gen)
+    }
+
+    pub(crate) fn free_all(&self, ctx: *mut sys::HegelContext) {
+        let mut gens = self.gens.lock().unwrap();
+        for (_, p) in gens.drain() {
+            // SAFETY: each generator is freed exactly once, after all draws.
+            unsafe {
+                let _ = sys::hegel_string_generator_free(ctx, p as *mut sys::HegelStringGenerator);
+            }
+        }
+    }
+}
+
+struct Gen<'a, 'py> {
+    py: Python<'py>,
+    ctx: *mut sys::HegelContext,
+    tc: *mut sys::HegelTestCase,
+    engine: &'a Engine,
+    compiled: &'a CompiledStrategy,
+    data: Bound<'py, PyAny>,
+    data_draw: Bound<'py, PyAny>,
+    record_many: Bound<'py, PyAny>,
+    shared: Bound<'py, PyDict>,
+    unsatisfied: Bound<'py, PyType>,
+    int_from_bytes: Bound<'py, PyAny>,
+    recorded: Vec<(&'static str, Py<PyAny>)>,
+}
+
+impl<'a, 'py> Gen<'a, 'py> {
+    fn flush(&mut self) -> PyResult<()> {
+        if self.recorded.is_empty() {
+            return Ok(());
+        }
+        let items: Vec<Bound<'py, PyAny>> = self
+            .recorded
+            .drain(..)
+            .map(|(kind, v)| {
+                PyTuple::new(
+                    self.py,
+                    [
+                        PyString::new(self.py, kind).into_any(),
+                        v.into_bound(self.py),
+                    ],
+                )
+                .map(|t| t.into_any())
+            })
+            .collect::<PyResult<_>>()?;
+        let list = PyList::new(self.py, items)?;
+        self.record_many.call1((list,))?;
+        Ok(())
+    }
+
+    fn record(&mut self, kind: &'static str, v: &Bound<'py, PyAny>) {
+        self.recorded.push((kind, v.clone().unbind()));
+    }
+
+    fn start_span(&self, label: u64) -> PyResult<()> {
+        // SAFETY: tc is live for the whole generate call.
+        let r = unsafe { sys::hegel_start_span(self.ctx, self.tc, label) };
+        check(self.ctx, r, "start_span")
+    }
+
+    fn stop_span(&self, discard: bool) {
+        // SAFETY: as above. A failure here means the case is already over.
+        let _ = unsafe { sys::hegel_stop_span(self.ctx, self.tc, discard) };
+    }
+
+    fn spanned<T>(&mut self, label: u64, f: impl FnOnce(&mut Self) -> PyResult<T>) -> PyResult<T> {
+        self.start_span(label)?;
+        let out = f(self);
+        self.stop_span(false);
+        out
+    }
+
+    fn draw_bool(&mut self, p: f64, forced: Option<bool>) -> PyResult<bool> {
+        let mut out = false;
+        // SAFETY: tc is live.
+        let r = unsafe {
+            sys::hegel_generate_boolean(
+                self.ctx,
+                self.tc,
+                p,
+                forced.unwrap_or(false),
+                forced.is_some(),
+                &mut out,
+            )
+        };
+        check(self.ctx, r, "generate_boolean")?;
+        let v = out.into_pyobject(self.py)?.to_owned().into_any();
+        self.record("boolean", &v);
+        Ok(out)
+    }
+
+    /// A plain bounded index draw (`data.draw_integer(lo, hi)`), as the
+    /// collection strategies make them: no weights, no span of its own.
+    fn draw_index(&mut self, lo: i64, hi: i64) -> PyResult<i64> {
+        self.draw_int(&IntNode {
+            lo: vec![],
+            hi: vec![],
+            lo64: Some(lo),
+            hi64: Some(hi),
+            shrink_towards: 0,
+            keys: vec![],
+            weights: vec![],
+        })?
+        .extract()
+    }
+
+    fn draw_int(&mut self, n: &IntNode) -> PyResult<Bound<'py, PyAny>> {
+        let v = if let (Some(lo), Some(hi)) = (n.lo64, n.hi64) {
+            let mut out: i64 = 0;
+            // SAFETY: tc is live; slices outlive the call.
+            let r = unsafe {
+                sys::hegel_generate_integer_weighted(
+                    self.ctx,
+                    self.tc,
+                    lo,
+                    hi,
+                    n.shrink_towards,
+                    n.keys.as_ptr(),
+                    n.weights.as_ptr(),
+                    n.keys.len(),
+                    &mut out,
+                )
+            };
+            check(self.ctx, r, "generate_integer_weighted")?;
+            out.into_pyobject(self.py)?.into_any()
+        } else {
+            let cap = n.lo.len().max(n.hi.len()).max(1);
+            let mut out = vec![0u8; cap];
+            let mut out_len = 0usize;
+            // SAFETY: buffers sized per the ABI contract.
+            let r = unsafe {
+                sys::hegel_generate_integer_big(
+                    self.ctx,
+                    self.tc,
+                    n.lo.as_ptr(),
+                    n.lo.len(),
+                    n.hi.as_ptr(),
+                    n.hi.len(),
+                    out.as_mut_ptr(),
+                    cap,
+                    &mut out_len,
+                )
+            };
+            check(self.ctx, r, "generate_integer_big")?;
+            {
+                let kw = PyDict::new(self.py);
+                kw.set_item("signed", true)?;
+                self.int_from_bytes
+                    .call((PyBytes::new(self.py, &out), "little"), Some(&kw))?
+            }
+        };
+        self.record("integer", &v);
+        Ok(v)
+    }
+
+    fn draw_float(
+        &mut self,
+        min: f64,
+        max: f64,
+        allow_nan: bool,
+        snm: f64,
+    ) -> PyResult<Bound<'py, PyAny>> {
+        let mut out = 0.0f64;
+        // SAFETY: tc is live.
+        let r = unsafe {
+            sys::hegel_generate_float(
+                self.ctx,
+                self.tc,
+                64,
+                min,
+                max,
+                allow_nan,
+                min.is_infinite() || max.is_infinite(),
+                false,
+                false,
+                snm,
+                &mut out,
+            )
+        };
+        check(self.ctx, r, "generate_float")?;
+        let v = out.into_pyobject(self.py)?.into_any();
+        self.record("float", &v);
+        Ok(v)
+    }
+
+    fn draw_bytes(&mut self, min: u64, max: u64) -> PyResult<Bound<'py, PyAny>> {
+        let mut res = sys::hegel_generate_bytes_result_t {
+            data: std::ptr::null_mut(),
+            len: 0,
+        };
+        // SAFETY: result buffer is libhegel-allocated and freed right after copying.
+        let v = unsafe {
+            let r = sys::hegel_generate_bytes(self.ctx, self.tc, min, max, &mut res);
+            check(self.ctx, r, "generate_bytes")?;
+            let slice: &[u8] = if res.data.is_null() {
+                &[]
+            } else {
+                std::slice::from_raw_parts(res.data, res.len)
+            };
+            let v = PyBytes::new(self.py, slice).into_any();
+            let _ = sys::hegel_generate_bytes_result_free(self.ctx, &mut res);
+            v
+        };
+        self.record("bytes", &v);
+        Ok(v)
+    }
+
+    fn draw_text(
+        &mut self,
+        ranges: &[(u32, u32)],
+        min: u64,
+        max: u64,
+    ) -> PyResult<Bound<'py, PyAny>> {
+        let gen = self.engine.text_gens.get(self.ctx, ranges, min, max)?;
+        let mut res = sys::hegel_generate_string_result_t {
+            data: std::ptr::null_mut(),
+            len: 0,
+        };
+        // SAFETY: as draw_bytes; the buffer is UTF-8.
+        let v = unsafe {
+            let r = sys::hegel_generate_string(self.ctx, self.tc, gen, &mut res);
+            check(self.ctx, r, "generate_string")?;
+            let slice: &[u8] = if res.data.is_null() {
+                &[]
+            } else {
+                std::slice::from_raw_parts(res.data as *const u8, res.len)
+            };
+            let s = String::from_utf8_lossy(slice).into_owned();
+            let _ = sys::hegel_generate_string_result_free(self.ctx, &mut res);
+            PyString::new(self.py, &s).into_any()
+        };
+        self.record("string", &v);
+        Ok(v)
+    }
+
+    /// Hypothesis's `many`: the continue decisions, forced below `min` and
+    /// above `max`, each inside a `one more from many()` span.
+    fn many(
+        &mut self,
+        min: u64,
+        max: u64,
+        p_continue: f64,
+        mut body: impl FnMut(&mut Self) -> PyResult<Bound<'py, PyAny>>,
+    ) -> PyResult<Vec<Bound<'py, PyAny>>> {
+        let mut out = Vec::new();
+        let mut count: u64 = 0;
+        let label = self.compiled.one_from_many;
+        loop {
+            self.start_span(label)?;
+            let more = if min == max {
+                count < min
+            } else {
+                let forced = if count < min {
+                    Some(true)
+                } else if count >= max {
+                    Some(false)
+                } else {
+                    None
+                };
+                self.draw_bool(p_continue, forced)?
+            };
+            if !more {
+                self.stop_span(false);
+                return Ok(out);
+            }
+            count += 1;
+            let v = body(self);
+            self.stop_span(false);
+            out.push(v?);
+        }
+    }
+
+    fn apply_maps(
+        &mut self,
+        mut v: Bound<'py, PyAny>,
+        maps: &[Py<PyAny>],
+    ) -> PyResult<Bound<'py, PyAny>> {
+        for m in maps {
+            v = m.bind(self.py).call1((v,))?;
+        }
+        Ok(v)
+    }
+
+    fn gen(&mut self, node: &Node) -> PyResult<Bound<'py, PyAny>> {
+        match node {
+            Node::Int(n, label) => self.spanned(*label, |g| g.draw_int(n)),
+            Node::Float {
+                min,
+                max,
+                allow_nan,
+                snm,
+                label,
+            } => self.spanned(*label, |g| g.draw_float(*min, *max, *allow_nan, *snm)),
+            Node::Bool { p, label } => self.spanned(*label, |g| {
+                Ok(g.draw_bool(*p, None)?
+                    .into_pyobject(g.py)?
+                    .to_owned()
+                    .into_any())
+            }),
+            Node::Bytes { min, max, label } => self.spanned(*label, |g| g.draw_bytes(*min, *max)),
+            Node::Text {
+                ranges,
+                min,
+                max,
+                label,
+            } => self.spanned(*label, |g| g.draw_text(ranges, *min, *max)),
+            Node::TextList {
+                elem,
+                min,
+                max,
+                p_continue,
+                label,
+            } => self.spanned(*label, |g| {
+                let parts = g.many(*min, *max, *p_continue, |g| g.gen(elem))?;
+                let mut s = String::new();
+                for p in parts {
+                    s.push_str(&p.extract::<String>()?);
+                }
+                Ok(PyString::new(g.py, &s).into_any())
+            }),
+            Node::EmptyList { label } => {
+                self.spanned(*label, |g| Ok(PyList::empty(g.py).into_any()))
+            }
+            Node::List {
+                elem,
+                min,
+                max,
+                p_continue,
+                label,
+            } => self.spanned(*label, |g| {
+                let items = g.many(*min, *max, *p_continue, |g| g.gen(elem))?;
+                Ok(PyList::new(g.py, items)?.into_any())
+            }),
+            Node::Tuple { children, label } => self.spanned(*label, |g| {
+                let items: Vec<_> = children.iter().map(|c| g.gen(c)).collect::<PyResult<_>>()?;
+                Ok(PyTuple::new(g.py, items)?.into_any())
+            }),
+            Node::FixedDict {
+                keys,
+                children,
+                dict_type,
+                label,
+            } => self.spanned(*label, |g| {
+                let mut pairs: Vec<Bound<'py, PyAny>> = keys
+                    .iter()
+                    .zip(children)
+                    .map(|(k, c)| {
+                        let v = g.gen(c)?;
+                        Ok(PyTuple::new(g.py, [k.bind(g.py).clone(), v])?.into_any())
+                    })
+                    .collect::<PyResult<_>>()?;
+                // FixedDictStrategy varies the iteration order with a reversed
+                // Fisher-Yates shuffle (cu.fisher_yates_shuffle)
+                let n = pairs.len();
+                for i in 0..n.saturating_sub(1) {
+                    let j = g.draw_index(i as i64, (n - 1) as i64)?;
+                    pairs.swap(i, j as usize);
+                }
+                dict_type.bind(g.py).call1((PyList::new(g.py, pairs)?,))
+            }),
+            Node::OneOf {
+                children,
+                inner_label,
+                label,
+            } => self.spanned(*label, |g| {
+                if children.len() == 1 {
+                    return g.gen(&children[0]);
+                }
+                let n = children.len() as i64;
+                let i: i64 = g
+                    .spanned(*inner_label, |g| {
+                        g.draw_int(&IntNode {
+                            lo: vec![],
+                            hi: vec![],
+                            lo64: Some(0),
+                            hi64: Some(n - 1),
+                            shrink_towards: 0,
+                            keys: vec![],
+                            weights: vec![],
+                        })
+                    })?
+                    .extract()?;
+                g.gen(&children[i as usize])
+            }),
+            Node::Sampled {
+                elements,
+                n,
+                maps,
+                label,
+            } => self.spanned(*label, |g| {
+                let i: i64 = g
+                    .draw_int(&IntNode {
+                        lo: vec![],
+                        hi: vec![],
+                        lo64: Some(0),
+                        hi64: Some(n - 1),
+                        shrink_towards: 0,
+                        keys: vec![],
+                        weights: vec![],
+                    })?
+                    .extract()?;
+                let v = elements.bind(g.py).get_item(i)?;
+                g.apply_maps(v, maps)
+            }),
+            Node::Just { value, maps, label } => {
+                self.spanned(*label, |g| g.apply_maps(value.bind(g.py).clone(), maps))
+            }
+            Node::Map { inner, pack, label } => self.spanned(*label, |g| {
+                let mapped = g.compiled.mapped;
+                let mut last_err = None;
+                for _ in 0..3 {
+                    g.start_span(mapped)?;
+                    let x = g.gen(inner)?;
+                    match pack.bind(g.py).call1((x,)) {
+                        Ok(v) => {
+                            g.stop_span(false);
+                            return Ok(v);
+                        }
+                        Err(e) if e.is_instance(g.py, &g.unsatisfied) => {
+                            g.stop_span(true);
+                            last_err = Some(e);
+                        }
+                        Err(e) => {
+                            g.stop_span(false);
+                            return Err(e);
+                        }
+                    }
+                }
+                Err(last_err.unwrap())
+            }),
+            Node::Builds {
+                target,
+                args,
+                names,
+                kwargs,
+                label,
+            } => self.spanned(*label, |g| {
+                let a: Vec<_> = args.iter().map(|c| g.gen(c)).collect::<PyResult<_>>()?;
+                let kw = PyDict::new(g.py);
+                for (name, c) in names.iter().zip(kwargs) {
+                    let v = g.gen(c)?;
+                    kw.set_item(name.bind(g.py), v)?;
+                }
+                target.bind(g.py).call(PyTuple::new(g.py, a)?, Some(&kw))
+            }),
+            Node::Shared {
+                key,
+                strategy,
+                inner,
+                label,
+            } => self.spanned(*label, |g| {
+                let k = key.bind(g.py);
+                if let Some(entry) = g.shared.get_item(k)? {
+                    return entry.get_item(0);
+                }
+                let v = g.gen(inner)?;
+                g.shared.set_item(
+                    k,
+                    PyTuple::new(g.py, [v.clone(), strategy.bind(g.py).clone()])?,
+                )?;
+                Ok(v)
+            }),
+            Node::Filter {
+                inner,
+                conditions,
+                repr,
+                label,
+            } => self.spanned(*label, |g| {
+                let filtered = g.compiled.filtered;
+                for _ in 0..3 {
+                    g.start_span(filtered)?;
+                    let v = g.gen(inner)?;
+                    let mut ok = true;
+                    for cond in conditions {
+                        if !cond.bind(g.py).call1((v.clone(),))?.is_truthy()? {
+                            ok = false;
+                            break;
+                        }
+                    }
+                    if ok {
+                        g.stop_span(false);
+                        return Ok(v);
+                    }
+                    g.stop_span(true);
+                }
+                g.flush()?;
+                g.data.call_method1(
+                    "mark_invalid",
+                    (format!("Aborted test because unable to satisfy {repr}"),),
+                )?;
+                Err(HegelError::new_err("mark_invalid returned"))
+            }),
+            Node::Opaque(strategy) => {
+                self.flush()?;
+                self.data_draw.call1((strategy.bind(self.py),))
+            }
+        }
+    }
+}
+
+/// Generate one value tree for `compiled` against `tc`, recording draws
+/// into `data` (a `ConjectureData` with `_hegel_record_many`) and sharing
+/// `shared` (its `_shared_strategy_draws`).
+pub(crate) fn generate<'py>(
+    py: Python<'py>,
+    tc: &TestCase,
+    engine: &Engine,
+    compiled: &CompiledStrategy,
+    data: Bound<'py, PyAny>,
+    shared: Bound<'py, PyDict>,
+) -> PyResult<Bound<'py, PyAny>> {
+    let errors = py.import("hypothesis.errors")?;
+    let unsatisfied = errors
+        .getattr("UnsatisfiedAssumption")?
+        .cast_into::<PyType>()?;
+    let int_from_bytes = py
+        .import("builtins")?
+        .getattr("int")?
+        .getattr("from_bytes")?;
+    let mut g = Gen {
+        py,
+        ctx: engine.ctx,
+        tc: tc.tc,
+        engine,
+        compiled,
+        data_draw: data.getattr("draw")?,
+        record_many: data.getattr("_hegel_record_many")?,
+        data,
+        shared,
+        unsatisfied,
+        int_from_bytes,
+        recorded: Vec::new(),
+    };
+    let out = g.gen(&compiled.root);
+    // keep what was recorded even when the draw failed (overrun, filters)
+    let flushed = g.flush();
+    let v = out?;
+    flushed?;
+    Ok(v)
+}
+
+pub(crate) fn choices_blob<'py>(
+    py: Python<'py>,
+    engine: &Engine,
+    tc: &TestCase,
+) -> PyResult<Bound<'py, PyString>> {
+    let ctx = engine.ctx;
+    let mut res = sys::hegel_generate_string_result_t {
+        data: std::ptr::null_mut(),
+        len: 0,
+    };
+    // SAFETY: the buffer is libhegel-allocated ASCII and freed right after copying.
+    unsafe {
+        let r = sys::hegel_test_case_choices(ctx, tc.tc, &mut res);
+        check(ctx, r, "test_case_choices")?;
+        let slice: &[u8] = if res.data.is_null() {
+            &[]
+        } else {
+            std::slice::from_raw_parts(res.data as *const u8, res.len)
+        };
+        let s = String::from_utf8_lossy(slice).into_owned();
+        let _ = sys::hegel_generate_string_result_free(ctx, &mut res);
+        Ok(PyString::new(py, &s))
+    }
+}
+
+#[allow(dead_code)]
+fn _unused(_: *const c_char, _: CString) {}
