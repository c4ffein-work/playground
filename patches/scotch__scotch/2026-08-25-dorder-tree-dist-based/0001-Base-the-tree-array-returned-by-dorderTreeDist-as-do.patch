From c9a3d3041fc52a985593eb61a49353281ac50784 Mon Sep 17 00:00:00 2001
From: c4ffein <c4ffein.work@gmail.com>
Date: Tue, 25 Aug 2026 10:01:16 +0000
Subject: [PATCH] Base the tree array returned by dorderTreeDist(), as
 documented

The user manual states that, in the tree array filled by
SCOTCH_dgraphOrderTreeDist(), "all node indices start from baseval".
Yet, dorderTreeDist() numbered the permuted column block indices from
0, ignoring the base value of the distributed graph passed as
parameter, whose pointer was hitherto unused.

Father indices stored in the tree array are now based with respect to
grafptr->baseval, and the result arrays are accessed through based
pointers so that the entry for column block (baseval + i) remains at
array slot i. The father index of the root of the tree remains -1,
irrespective of the base value, as documented. Callers that already
handled based indices, such as ParMETIS_V3_NodeND(), which subtracts
the base value from tree array values, are unaffected for the 0-based
case and now behave correctly for the 1-based case.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 src/libscotch/dorder_tree_dist.c | 19 ++++++++++++++-----
 1 file changed, 14 insertions(+), 5 deletions(-)

diff --git a/src/libscotch/dorder_tree_dist.c b/src/libscotch/dorder_tree_dist.c
index c61e9b6..5ba6e4d 100644
--- a/src/libscotch/dorder_tree_dist.c
+++ b/src/libscotch/dorder_tree_dist.c
@@ -41,7 +41,7 @@
 /**   DATES      : # Version 5.1  : from : 28 nov 2007     **/
 /**                                 to   : 09 may 2008     **/
 /**                # Version 7.0  : from : 17 jan 2023     **/
-/**                                 to   : 17 jan 2023     **/
+/**                                 to   : 25 aug 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -97,7 +97,10 @@ const Dorder * restrict const ordeptr)
 ** distributed part of the distributed structure of
 ** the given distributed ordering. The two array
 ** pointers which must be passed should both point to
-** arrays of size dorderCblkDist().
+** arrays of size dorderCblkDist(). Tree node indices
+** start from the base value of the given distributed
+** graph, save for the father index of the root of the
+** tree, which is always set to -1.
 ** It returns:
 ** - 0   : if the distributed tree structure could be computed.
 ** - !0  : on error.
@@ -111,6 +114,9 @@ Gnum * restrict const         treeglbtab,
 Gnum * restrict const         sizeglbtab)
 {
   const DorderLink * restrict linklocptr;
+  Gnum * restrict             treeglbtax;         /* Based access to treeglbtab       */
+  Gnum * restrict             sizeglbtax;         /* Based access to sizeglbtab       */
+  Gnum                        baseval;            /* Base value of column block index */
   Gnum * restrict             dataloctab;
   Gnum * restrict             dataglbtab;
   Gnum                        dblklocnum;
@@ -243,9 +249,10 @@ Gnum * restrict const         sizeglbtab)
     srt1glbtab[2 * dblkglbnum + 1] = dataglbtab[4 * dblkglbnum];
   }
   intSort2asc2 (srt1glbtab, dblkglbnbr);          /* Sort nodes by ascending inverse start index to get permutation of column block indices */
+  baseval = grafptr->baseval;
   for (dblkglbnum = 0; dblkglbnum < dblkglbnbr; dblkglbnum ++) {
     srt1glbtab[2 * dblkglbnum]     = srt1glbtab[2 * dblkglbnum + 1];
-    srt1glbtab[2 * dblkglbnum + 1] = dblkglbnum;
+    srt1glbtab[2 * dblkglbnum + 1] = dblkglbnum + baseval; /* Permuted column block indices are based */
   }
   intSort2asc2 (srt1glbtab, dblkglbnbr);          /* Sort nodes by ascending column block index to match with the ones of dataglbtab */
 
@@ -287,6 +294,8 @@ Gnum * restrict const         sizeglbtab)
     srt2glbtab[2 * dblkglbnum + 1] = dblkglbnum;
   }
   intSort2asc2 (srt2glbtab, dblkglbnbr);          /* Sort father indices by ascending column block indices */
+  treeglbtax = treeglbtab - baseval;              /* TRICK: based accesses to user arrays */
+  sizeglbtax = sizeglbtab - baseval;
   for (dblkglbnum = 0; dblkglbnum < dblkglbnbr; dblkglbnum ++) {
 #ifdef SCOTCH_DEBUG_DORDER2
     if (srt1glbtab[2 * dblkglbnum] != srt2glbtab[2 * dblkglbnum]) {
@@ -295,8 +304,8 @@ Gnum * restrict const         sizeglbtab)
       return     (1);
     }
 #endif /* SCOTCH_DEBUG_DORDER2 */
-    treeglbtab[srt1glbtab[2 * dblkglbnum + 1]] = dataglbtab[4 * srt2glbtab[2 * dblkglbnum + 1] + 2];
-    sizeglbtab[srt1glbtab[2 * dblkglbnum + 1]] = dataglbtab[4 * srt2glbtab[2 * dblkglbnum + 1] + 3];
+    treeglbtax[srt1glbtab[2 * dblkglbnum + 1]] = dataglbtab[4 * srt2glbtab[2 * dblkglbnum + 1] + 2];
+    sizeglbtax[srt1glbtab[2 * dblkglbnum + 1]] = dataglbtab[4 * srt2glbtab[2 * dblkglbnum + 1] + 3];
   }
 
   memFree (dblkcnttab);                           /* Free group leader */
-- 
