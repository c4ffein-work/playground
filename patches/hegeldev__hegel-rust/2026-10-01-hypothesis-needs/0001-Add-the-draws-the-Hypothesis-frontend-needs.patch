+/// Parameters:
+/// `min_value` / `max_value`: Inclusive bounds. Both required.
+/// `shrink_towards`: The value the choice shrinks toward, clamped into the
+///   bounds (`hegel_generate_integer` shrinks toward 0).
+/// `keys` / `weights`: `len` integers in `[min_value, max_value]` and the
+///   probability of drawing each. Weights must be finite, non-negative and
+///   sum to strictly less than 1; the remaining mass is drawn the way
+///   `hegel_generate_integer` draws. The result is one ordinary integer
+///   choice: the weights steer generation only, never replay or shrinking.
+///
+/// Returns `HEGEL_OK`, `HEGEL_E_STOP_TEST`, or `HEGEL_E_INVALID_ARG`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn hegel_generate_integer_weighted(
+    ctx: *mut HegelContext,
+    tc: *mut HegelTestCase,
+    min_value: i64,
+    max_value: i64,
+    shrink_towards: i64,
+    keys: *const i64,
+    weights: *const f64,
+    len: usize,
+    out_value: *mut i64,
+) -> hegel_result_t {
+    const FN: &str = "hegel_generate_integer_weighted";
+    if len > 0 && (keys.is_null() || weights.is_null()) {
+        clear_last_error(ctx);
+        set_last_error(ctx, &format!("{FN}: keys / weights pointer is null"));
+        return HEGEL_E_INVALID_ARG;
+    }
+    let (keys, weights): (Vec<BigInt>, &[f64]) = if len == 0 {
+        (Vec::new(), &[])
+    } else {
+        // SAFETY: the caller promises `len` readable elements behind each pointer.
+        let k = unsafe { core::slice::from_raw_parts(keys, len) };
+        let w = unsafe { core::slice::from_raw_parts(weights, len) };
+        (k.iter().map(|&v| BigInt::from(v)).collect(), w)
+    };
+    unsafe {
+        typed_draw(
+            ctx,
+            tc,
+            FN,
+            out_value.is_null(),
+            |tc| {
+                let v = tc.stream.generate_integer_weighted(
+                    &BigInt::from(min_value),
+                    &BigInt::from(max_value),
+                    &BigInt::from(shrink_towards),
+                    &keys,
+                    weights,
+                )?;
+                let narrowed = i64::try_from(v).ok();
+                Ok(hegel_internal_unwrap!(
+                    narrowed,
+                    "hegel_generate_integer_weighted: drawn value does not fit the requested i64 bounds"
+                ))
+            },
+            |v| *out_value = v,
+        )
+    }
+}
