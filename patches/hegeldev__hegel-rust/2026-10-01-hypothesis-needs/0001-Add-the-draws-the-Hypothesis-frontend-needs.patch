+//! In-process exercise of the draws added for the Hypothesis frontend:
+//! weighted integers, NaN alongside finite float bounds, and text
+//! generators built from explicit codepoint ranges.
+mod common;
+
+use common::{last_error, make_settings_no_db, next_case, ok, start};
+use hegel_c::hegel_result_t::*;
+use hegel_c::{
+    HegelContext, HegelStringGenerator, HegelTestCase, hegel_context_free, hegel_context_new,
+    hegel_generate_float, hegel_generate_integer_weighted, hegel_generate_string,
+    hegel_generate_string_result_free, hegel_generate_string_result_t, hegel_mark_complete,
+    hegel_run_free, hegel_settings_free, hegel_settings_set_test_cases, hegel_status_t,
+    hegel_string_generator_free, hegel_string_generator_text_ranges,
+};
+use std::ptr;
+
+unsafe fn complete_valid(ctx: *mut HegelContext, tc: *mut HegelTestCase) {
+    unsafe {
+        ok(hegel_mark_complete(
+            ctx,
+            tc,
+            hegel_status_t::HEGEL_STATUS_VALID as u32,
+            ptr::null(),
+        ));
+        ok(hegel_c::hegel_test_case_free(ctx, tc));
+    }
+}
+
+#[test]
+fn weighted_integers_honour_keys_and_validate_arguments() {
+    let ctx = hegel_context_new();
+    unsafe {
+        let s = make_settings_no_db(ctx);
+        ok(hegel_settings_set_test_cases(ctx, s, 400));
+        let run = start(ctx, s);
+        let keys = [7i64, 42];
+        let weights = [0.3f64, 0.2];
+        let (mut sevens, mut forty_twos, mut others) = (0, 0, 0);
+        loop {
+            let tc = next_case(ctx, run);
+            if tc.is_null() {
+                break;
+            }
+            let mut out = 0i64;
+            // keys outside the bounds, weights summing to >= 1, and mismatched
+            // lengths are usage errors
+            assert_eq!(
+                hegel_generate_integer_weighted(
+                    ctx,
+                    tc,
+                    0,
+                    5,
+                    0,
+                    keys.as_ptr(),
+                    weights.as_ptr(),
+                    2,
+                    &mut out
+                ),
+                HEGEL_E_INVALID_ARG
+            );
+            assert!(last_error(ctx).contains("outside"));
+            let heavy = [0.6f64, 0.5];
+            assert_eq!(
+                hegel_generate_integer_weighted(
+                    ctx,
+                    tc,
+                    0,
+                    100,
+                    0,
+                    keys.as_ptr(),
+                    heavy.as_ptr(),
+                    2,
+                    &mut out
+                ),
+                HEGEL_E_INVALID_ARG
+            );
+            assert_eq!(
+                hegel_generate_integer_weighted(
+                    ctx,
+                    tc,
+                    0,
+                    100,
+                    0,
+                    keys.as_ptr(),
+                    weights.as_ptr(),
+                    2,
+                    ptr::null_mut()
+                ),
+                HEGEL_E_INVALID_ARG
+            );
+            ok(hegel_generate_integer_weighted(
+                ctx,
+                tc,
+                0,
+                100,
+                0,
+                keys.as_ptr(),
+                weights.as_ptr(),
+                2,
+                &mut out,
+            ));
+            assert!((0..=100).contains(&out));
+            match out {
+                7 => sevens += 1,
+                42 => forty_twos += 1,
+                _ => others += 1,
+            }
+            // no keys at all is just an ordinary draw
+            ok(hegel_generate_integer_weighted(
+                ctx,
+                tc,
+                -3,
+                3,
+                0,
+                ptr::null(),
+                ptr::null(),
+                0,
+                &mut out,
+            ));
+            assert!((-3..=3).contains(&out));
+            complete_valid(ctx, tc);
+        }
+        // The weights steer fresh draws only: a good share of a run's cases
+        // are mutations and replays of earlier ones, so over the whole run
+        // the keys show up well below 30% / 20% but far above the ~1% a
+        // plain draw over [0, 100] would give them.
+        assert!(sevens >= 40, "7 drawn {sevens} times");
+        assert!(forty_twos >= 25, "42 drawn {forty_twos} times");
+        assert!(others >= 60, "other values drawn {others} times");
+        ok(hegel_run_free(ctx, run));
+        ok(hegel_settings_free(ctx, s));
+        ok(hegel_context_free(ctx));
+    }
+}
+
+#[test]
+fn nan_is_allowed_alongside_finite_bounds() {
+    let ctx = hegel_context_new();
+    unsafe {
+        let s = make_settings_no_db(ctx);
+        ok(hegel_settings_set_test_cases(ctx, s, 600));
+        let run = start(ctx, s);
+        let mut nans = 0;
+        loop {
+            let tc = next_case(ctx, run);
+            if tc.is_null() {
+                break;
+            }
+            let mut out = 0f64;
+            ok(hegel_generate_float(
+                ctx, tc, 64, 0.0, 1.0, true, false, false, false, 5e-324, &mut out,
+            ));
+            assert!(out.is_nan() || (0.0..=1.0).contains(&out), "{out}");
+            nans += usize::from(out.is_nan());
+            ok(hegel_generate_float(
+                ctx, tc, 64, -2.0, 2.0, false, false, false, false, 5e-324, &mut out,
+            ));
+            assert!((-2.0..=2.0).contains(&out), "{out}");
+            complete_valid(ctx, tc);
+        }
+        assert!(
+            nans > 0,
+            "NaN never drawn from a bounded draw that allows it"
+        );
+        ok(hegel_run_free(ctx, run));
+        ok(hegel_settings_free(ctx, s));
+        ok(hegel_context_free(ctx));
+    }
+}
+
+#[test]
+fn text_ranges_draw_only_from_the_given_ranges() {
+    let ctx = hegel_context_new();
+    unsafe {
+        let mut generator: *mut HegelStringGenerator = ptr::null_mut();
+        // malformed: unsorted / overlapping / inverted / beyond the codespace
+        for bad in [
+            [98u32, 99, 97, 97],
+            [97, 99, 99, 100],
+            [99, 97, 0, 0],
+            [0, 0x110000, 0, 0],
+        ] {
+            assert_eq!(
+                hegel_string_generator_text_ranges(ctx, 0, 5, bad.as_ptr(), 2, &mut generator),
+                HEGEL_E_INVALID_ARG,
+                "{bad:?}"
+            );
+        }
+        // only surrogates: no characters left
+        let surr = [0xD800u32, 0xDFFF];
+        assert_eq!(
+            hegel_string_generator_text_ranges(ctx, 1, 5, surr.as_ptr(), 1, &mut generator),
+            HEGEL_E_INVALID_ARG
+        );
+        // a range straddling the surrogate block loses exactly that block
+        let ranges = [97u32, 99, 0xD7FE, 0xE001, 0x1F600, 0x1F601];
+        ok(hegel_string_generator_text_ranges(
+            ctx,
+            1,
+            4,
+            ranges.as_ptr(),
+            3,
+            &mut generator,
+        ));
+        let s = make_settings_no_db(ctx);
+        ok(hegel_settings_set_test_cases(ctx, s, 300));
+        let run = start(ctx, s);
+        let mut seen = std::collections::BTreeSet::new();
+        loop {
+            let tc = next_case(ctx, run);
+            if tc.is_null() {
+                break;
+            }
+            let mut res = hegel_generate_string_result_t {
+                data: ptr::null_mut(),
+                len: 0,
+            };
+            ok(hegel_generate_string(ctx, tc, generator, &mut res));
+            let bytes = std::slice::from_raw_parts(res.data as *const u8, res.len);
+            let text = std::str::from_utf8(bytes).unwrap().to_owned();
+            ok(hegel_generate_string_result_free(ctx, &mut res));
+            assert!((1..=4).contains(&text.chars().count()), "{text:?}");
+            for c in text.chars() {
+                let cp = c as u32;
+                assert!(
+                    (97..=99).contains(&cp)
+                        || cp == 0xD7FE
+                        || cp == 0xD7FF
+                        || cp == 0xE000
+                        || cp == 0xE001
+                        || (0x1F600..=0x1F601).contains(&cp),
+                    "{cp:#x} is outside the ranges"
+                );
+                seen.insert(cp);
+            }
+            complete_valid(ctx, tc);
+        }
+        assert!(seen.len() >= 4, "too few distinct characters: {seen:?}");
+        ok(hegel_run_free(ctx, run));
+        ok(hegel_settings_free(ctx, s));
+        ok(hegel_string_generator_free(ctx, generator));
+        ok(hegel_context_free(ctx));
+    }
+}
