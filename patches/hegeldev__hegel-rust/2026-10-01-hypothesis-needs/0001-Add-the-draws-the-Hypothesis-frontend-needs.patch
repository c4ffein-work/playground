+    /// A text generator over an explicit, sorted, disjoint list of
+    /// inclusive codepoint ranges — the alphabet exactly as a frontend
+    /// computed it (Hypothesis's `IntervalSet`), with no codec, category or
+    /// include / exclude vocabulary in between. Surrogates are removed, as
+    /// for [`StringSpec::text`]. Errors when the ranges are malformed or,
+    /// unless `max_size == 0`, leave no characters.
+    pub fn text_ranges(
+        ranges: &[(u32, u32)],
+        min_size: usize,
+        max_size: usize,
+    ) -> Result<StringSpec, EngineError> {
+        if min_size > max_size {
+            return Err(EngineError::InvalidArgument(format!(
+                "text_ranges requires min_size <= max_size, got [{min_size}, {max_size}]"
+            )));
+        }
+        let mut last_end: Option<u32> = None;
+        for &(lo, hi) in ranges {
+            if lo > hi || hi > 0x10FFFF || last_end.is_some_and(|e| lo <= e) {
+                return Err(EngineError::InvalidArgument(format!(
+                    "text_ranges: ranges must be sorted, disjoint, ascending codepoint \
+                     pairs at most 0x10FFFF, got ({lo}, {hi})"
+                )));
+            }
+            last_end = Some(hi);
+        }
+        let intervals = text::ranges_minus_surrogates(ranges)?;
+        if intervals.is_empty() && max_size > 0 {
+            return Err(EngineError::InvalidArgument(
+                "InvalidArgument: No valid characters in the specified ranges.".to_string(),
+            ));
+        }
+        Ok(StringSpec::Text {
+            intervals: Arc::new(intervals),
+            min_size,
+            max_size,
+        })
+    }
