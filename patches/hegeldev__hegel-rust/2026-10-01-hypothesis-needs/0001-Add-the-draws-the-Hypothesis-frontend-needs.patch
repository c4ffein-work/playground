+/// Draw an integer in `[min_value, max_value]` where each `keys[i]` is
+/// drawn with probability `weights[i]` and the remaining mass
+/// (`1 - sum(weights)`, which must be positive) falls to the ordinary
+/// shaped draw over the whole range, shrinking toward `shrink_towards`
+/// (clamped into the range). The result is one integer choice, shrunk and
+/// replayed like any other: the weights only steer fresh generation. Port
+/// of HypothesisProvider's `weights` and `shrink_towards` handling.
+pub fn generate_integer_weighted(
+    ntc: &mut NativeTestCase,
+    min_value: &BigInt,
+    max_value: &BigInt,
+    shrink_towards: &BigInt,
+    keys: &[BigInt],
+    weights: &[f64],
+) -> Result<BigInt, EngineError> {
+    if min_value > max_value {
+        return Err(EngineError::InvalidArgument(format!(
+            "generate_integer_weighted requires min_value <= max_value, \
+             got [{min_value}, {max_value}]"
+        )));
+    }
+    if keys.len() != weights.len() {
+        return Err(EngineError::InvalidArgument(format!(
+            "generate_integer_weighted: {} keys but {} weights",
+            keys.len(),
+            weights.len()
+        )));
+    }
+    let total: f64 = weights.iter().sum();
+    if weights.iter().any(|w| !(w.is_finite() && *w >= 0.0)) || total.is_nan() || total >= 1.0 {
+        return Err(EngineError::InvalidArgument(
+            "generate_integer_weighted: weights must be finite, non-negative and sum to \
+             strictly less than 1"
+                .to_string(),
+        ));
+    }
+    if let Some(k) = keys.iter().find(|k| *k < min_value || *k > max_value) {
+        return Err(EngineError::InvalidArgument(format!(
+            "generate_integer_weighted: key {k} outside [{min_value}, {max_value}]"
+        )));
+    }
+    spanned(ntc, LABEL_INTEGER, |ntc| {
+        ntc.draw_integer_weighted(
+            min_value.clone(),
+            max_value.clone(),
+            shrink_towards.clone(),
+            keys,
+            weights,
+        )
+    })
+}
