+/// Build an [`IntervalSet`] from sorted, disjoint inclusive ranges with the
+/// surrogate block `U+D800..=U+DFFF` cut out of any range that covers it.
+pub(crate) fn ranges_minus_surrogates(ranges: &[(u32, u32)]) -> Result<IntervalSet, InternalError> {
+    const SURR_LO: u32 = 0xD800;
+    const SURR_HI: u32 = 0xDFFF;
+    let mut out = Vec::with_capacity(ranges.len() + 1);
+    for &(lo, hi) in ranges {
+        if hi < SURR_LO || lo > SURR_HI {
+            out.push((lo, hi));
+            continue;
+        }
+        if lo < SURR_LO {
+            out.push((lo, SURR_LO - 1));
+        }
+        if hi > SURR_HI {
+            out.push((SURR_HI + 1, hi));
+        }
+    }
+    IntervalSet::new(out)
+}
