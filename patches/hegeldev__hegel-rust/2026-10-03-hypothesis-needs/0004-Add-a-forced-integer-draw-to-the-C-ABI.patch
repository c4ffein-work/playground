+/// Record `forced` as an integer choice in `[min_value, max_value]`,
+/// validating that it lies within the bounds. The choice position is
+/// consumed and the node marked forced; neither the replay prefix nor the
+/// RNG is consulted (a frontend's own forced draws, e.g. Hypothesis's
+/// filtered `sampled_from`, so its choice sequence stays aligned).
+pub fn generate_integer_forced(
+    ntc: &mut NativeTestCase,
+    min_value: &BigInt,
+    max_value: &BigInt,
+    forced: &BigInt,
+) -> Result<(), EngineError> {
+    if min_value > max_value {
+        return Err(EngineError::InvalidArgument(format!(
+            "generate_integer_forced requires min_value <= max_value, \
+             got [{min_value}, {max_value}]"
+        )));
+    }
+    if forced < min_value || forced > max_value {
+        return Err(EngineError::InvalidArgument(format!(
+            "generate_integer_forced: forced value {forced} outside [{min_value}, {max_value}]"
+        )));
+    }
+    spanned(ntc, LABEL_INTEGER, |ntc| {
+        ntc.draw_integer_forced(min_value.clone(), max_value.clone(), forced.clone())
+    })
+}
