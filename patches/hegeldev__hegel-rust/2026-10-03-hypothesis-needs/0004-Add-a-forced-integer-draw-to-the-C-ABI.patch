+/// Parameters:
+/// `min_value` / `max_value`: Inclusive bounds. Both required.
+/// `forced`: The value to record, within the bounds.
+///
+/// Records `forced` as an ordinary integer choice without consulting the
+/// choice sequence or the RNG; the node is marked forced, so replay and
+/// shrinking leave it alone, and a reproduce blob carries it. For a
+/// frontend whose own code decides a value at a choice position (e.g.
+/// Hypothesis's filtered `sampled_from`), so its sequence stays aligned
+/// with libhegel's.
+///
+/// Returns `HEGEL_OK`, `HEGEL_E_STOP_TEST`, or `HEGEL_E_INVALID_ARG`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn hegel_generate_integer_forced(
+    ctx: *mut HegelContext,
+    tc: *mut HegelTestCase,
+    min_value: i64,
+    max_value: i64,
+    forced: i64,
+) -> hegel_result_t {
+    unsafe {
+        typed_draw(
+            ctx,
+            tc,
+            "hegel_generate_integer_forced",
+            false,
+            |tc| {
+                tc.stream.generate_integer_forced(
+                    &BigInt::from(min_value),
+                    &BigInt::from(max_value),
+                    &BigInt::from(forced),
+                )
+            },
+            |()| {},
+        )
+    }
+}
