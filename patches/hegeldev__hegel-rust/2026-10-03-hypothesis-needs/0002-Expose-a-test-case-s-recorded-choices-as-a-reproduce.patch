+/// Parameters:
+/// `out_result`: Receives a libhegel-allocated `{char *data; size_t len;}`
+///   holding the base64 reproduce blob of the choices this test case has
+///   recorded so far, exactly as `hegel_failure_reproduction_blob` would
+///   encode them. Release with `hegel_generate_string_result_free`.
+///
+/// Returns `HEGEL_OK`.
+///
+/// A frontend that generates whole values natively uses this to learn,
+/// after the fact, which choices a case made, for its own bookkeeping and
+/// for replaying the case through `hegel_test_case_from_blob`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn hegel_test_case_choices(
+    ctx: *mut HegelContext,
+    tc: *mut HegelTestCase,
+    out_result: *mut hegel_generate_string_result_t,
+) -> hegel_result_t {
+    unsafe {
+        typed_draw(
+            ctx,
+            tc,
+            "hegel_test_case_choices",
+            out_result.is_null(),
+            |tc| tc.stream.choices_blob(),
+            |v| {
+                let boxed = v.into_bytes().into_boxed_slice();
+                let len = boxed.len();
+                let data = Box::into_raw(boxed) as *mut c_char;
+                *out_result = hegel_generate_string_result_t { data, len };
+            },
+        )
+    }
+}
