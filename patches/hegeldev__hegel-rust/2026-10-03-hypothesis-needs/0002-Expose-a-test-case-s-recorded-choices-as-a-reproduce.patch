+#[test]
+fn a_cases_choices_replay_through_their_blob() {
+    let ctx = hegel_context_new();
+    unsafe {
+        let s = make_settings_no_db(ctx);
+        ok(hegel_settings_set_test_cases(ctx, s, 20));
+        let run = start(ctx, s);
+        loop {
+            let tc = next_case(ctx, run);
+            if tc.is_null() {
+                break;
+            }
+            let mut drawn = Vec::new();
+            for _ in 0..3 {
+                let mut v = 0i64;
+                ok(hegel_generate_integer(ctx, tc, -1000, 1000, &mut v));
+                drawn.push(v);
+                let mut res = hegel_generate_string_result_t {
+                    data: ptr::null_mut(),
+                    len: 0,
+                };
+                ok(hegel_test_case_choices(ctx, tc, &mut res));
+                let bytes = std::slice::from_raw_parts(res.data as *const u8, res.len);
+                let blob = std::ffi::CString::new(bytes).unwrap();
+                ok(hegel_generate_string_result_free(ctx, &mut res));
+                // the blob so far replays exactly the draws so far
+                let mut replay: *mut HegelTestCase = ptr::null_mut();
+                ok(hegel_test_case_from_blob(
+                    ctx,
+                    s,
+                    blob.as_ptr(),
+                    None,
+                    ptr::null_mut(),
+                    &mut replay,
+                ));
+                for &expected in &drawn {
+                    let mut got = 0i64;
+                    ok(hegel_generate_integer(ctx, replay, -1000, 1000, &mut got));
+                    assert_eq!(got, expected);
+                }
+                complete_valid(ctx, replay);
+            }
+            assert_eq!(
+                hegel_test_case_choices(ctx, tc, ptr::null_mut()),
+                HEGEL_E_INVALID_ARG
+            );
+            complete_valid(ctx, tc);
+        }
+        ok(hegel_run_free(ctx, run));
+        ok(hegel_settings_free(ctx, s));
+        ok(hegel_context_free(ctx));
+    }
+}
