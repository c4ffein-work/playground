 /// than [`MAX_CLONE_DEPTH`](crate::native::core::MAX_CLONE_DEPTH)), which no
 /// blob could represent.
+/// Encode a live test case's recorded nodes as a raw (uncompressed) blob of
+/// their values, in the same format as [`encode_failure`]: what a frontend
+/// needs to know, mid-run, which choices a case has made so far.
+pub fn encode_nodes(nodes: &[crate::native::core::ChoiceNode]) -> Option<String> {
+    let raw = crate::native::database::serialize_nodes(nodes)?;
+    let mut payload = Vec::with_capacity(raw.len() + 1);
+    payload.push(PREFIX_RAW);
+    payload.extend_from_slice(&raw);
+    Some(base64_encode(&payload))
+}
