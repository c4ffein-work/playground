 src/keras_tinygrad/src/export.py | 6 ------
 src/keras_tinygrad/src/layer.py  | 4 ++++
 2 files changed, 4 insertions(+), 6 deletions(-)
 delete mode 100644 src/keras_tinygrad/src/export.py

diff --git a/src/keras_tinygrad/src/export.py b/src/keras_tinygrad/src/export.py
deleted file mode 100644
index ff2e66b..0000000
--- a/src/keras_tinygrad/src/export.py
+++ /dev/null
@@ -1,6 +0,0 @@
-import keras_tinygrad.src  # noqa: F401 -- registers the backend alias
-
-from keras.src.backend.tinygrad.export import (  # noqa: F401
-    ExportArchive,  # noqa: F401
-    TinygradExportArchive,
-)
diff --git a/src/keras_tinygrad/src/layer.py b/src/keras_tinygrad/src/layer.py
index e195b28..f17258e 100644
--- a/src/keras_tinygrad/src/layer.py
+++ b/src/keras_tinygrad/src/layer.py
@@ -4,3 +4,7 @@ from keras.src.backend.tinygrad.layer import (
     Layer,  # noqa: F401
     TinygradLayer,  # noqa: F401
 )
+
+# Current pluggable_backend protocol (keras/src/layers/layer.py on the branch
+# does `getattr(keras_<name>.src.layer, "BackendLayer")`).
+BackendLayer = TinygradLayer
