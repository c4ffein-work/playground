From 576c1935b3ebb1ecfe8c3c588c792da09047d74b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 24 Aug 2026 07:17:15 +0000
Subject: [PATCH 3/4] Validate client secrets at registration, widen accepted
 charset
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

_authenticate() rejected any secret containing characters outside its
allowed charset — previously hex digits only — but no registration path
checked the secret at all. Registering a client with a custom non-hex
secret (API register, server-setup/server-add-user --client-secret,
register --new-client-secret, COMPANION_BOOTSTRAP_ADMIN) silently
created a client that could never log in, with only an unexplained 401
at auth time.

Fix both sides:
- Accept letters, digits, '-', '_' and '.' in secrets (token_hex output
  still always passes), so reasonable custom secrets work.
- Enforce charset plus 8-128 length via validate_client_secret() at the
  register API endpoint, in the CLI commands that create clients, and
  for COMPANION_BOOTSTRAP_ADMIN (warn and ignore).

Tests: registration rejects bad secrets; an accepted custom secret
authenticates end-to-end.
---
 companion.py            | 47 ++++++++++++++++++++++++++++++--
 src/companion.py        | 47 ++++++++++++++++++++++++++++++--
 tests/test_companion.py | 59 +++++++++++++++++++++++++++++++++++++++++
 3 files changed, 149 insertions(+), 4 deletions(-)

diff --git a/companion.py b/companion.py
index 01f2fdb..fe9e6af 100644
--- a/companion.py
+++ b/companion.py
@@ -24425,6 +24425,10 @@ def _maybe_bootstrap_admin(server_name: str) -> None:
     if not client_id or not client_secret:
         logger.warning("COMPANION_BOOTSTRAP_ADMIN missing id or secret — ignoring")
         return
+    secret_error = validate_client_secret(client_secret)
+    if secret_error:
+        logger.warning("COMPANION_BOOTSTRAP_ADMIN rejected: %s — ignoring", secret_error)
+        return
     if any(c.get("admin") for c in load_clients(server_name).values()):
         return  # already have an admin; never override
     salt = secrets.token_hex(16)
@@ -24505,6 +24509,26 @@ def resolve_server_config(args) -> int:
     return port
 
 
+# Client secrets: accepted charset and length bounds, enforced at every
+# registration path (API and CLI) and pre-checked during authentication.
+# _authenticate() rejects secrets outside this charset, so accepting one at
+# registration would create a client that can never log in. Output of
+# secrets.token_hex always passes; custom secrets may also use letters,
+# digits, '-', '_' and '.'.
+VALID_SECRET_CHARS = frozenset("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.")
+SECRET_MIN_LEN = 8
+SECRET_MAX_LEN = 128
+
+
+def validate_client_secret(secret) -> Optional[str]:
+    """Return an error message if *secret* cannot be used to authenticate, else None."""
+    if not isinstance(secret, str) or not (SECRET_MIN_LEN <= len(secret) <= SECRET_MAX_LEN):
+        return f"client_secret must be {SECRET_MIN_LEN}-{SECRET_MAX_LEN} characters"
+    if not all(c in VALID_SECRET_CHARS for c in secret):
+        return "client_secret may only contain letters, digits, '-', '_' and '.'"
+    return None
+
+
 class Auth(enum.Enum):
     NONE = "none"
     REGULAR = "regular"
@@ -24611,8 +24635,8 @@ class FileShareHandler(http.server.BaseHTTPRequestHandler):
 
     # Allowed charset for client_id: alphanumeric + hyphens (matches registration validation).
     _VALID_ID_CHARS = frozenset("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-")
-    # Allowed charset for client_secret: hex digits (generated by secrets.token_hex).
-    _VALID_SECRET_CHARS = frozenset("0123456789abcdef")
+    # Allowed charset for client_secret (see VALID_SECRET_CHARS / validate_client_secret).
+    _VALID_SECRET_CHARS = VALID_SECRET_CHARS
     _VALID_NAME_CHARS = frozenset("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_.-")
 
     def _authenticate(self) -> Optional[dict]:
@@ -24949,6 +24973,11 @@ class FileShareHandler(http.server.BaseHTTPRequestHandler):
                     "error": "name must be 0-128 characters (letters, digits, underscores, dots, hyphens)"
                 }
 
+            # Validate client_secret: reject secrets _authenticate() could never accept
+            secret_error = validate_client_secret(client_secret)
+            if secret_error:
+                return HTTPStatus.BAD_REQUEST, {"error": secret_error}
+
             salt = secrets.token_hex(16)
             secret_hash = hashlib.sha256((salt + client_secret).encode()).hexdigest()
 
@@ -25852,6 +25881,10 @@ def server_setup_cmd(args):
         if not client_secret:
             client_secret = secrets.token_hex(32)
             print(f"  Generated client secret: {client_secret}")
+    secret_error = validate_client_secret(client_secret)
+    if secret_error:
+        print(f"Error: {secret_error}", file=sys.stderr)
+        sys.exit(1)
 
     # Resolve client name
     client_name = getattr(args, "client_name", "") or ""
@@ -25918,6 +25951,10 @@ def server_add_user_cmd(args):
         if not client_secret:
             client_secret = secrets.token_hex(32)
             print(f"  Generated client secret: {client_secret}")
+    secret_error = validate_client_secret(client_secret)
+    if secret_error:
+        print(f"Error: {secret_error}", file=sys.stderr)
+        sys.exit(1)
 
     # Resolve client name
     client_name = getattr(args, "client_name", "") or ""
@@ -26060,6 +26097,12 @@ def register_cmd(args):
         if not new_client_secret:
             new_client_secret = input("New client secret (blank to auto-generate): ").strip() or None
 
+    if new_client_secret:
+        secret_error = validate_client_secret(new_client_secret)
+        if secret_error:
+            print(f"Error: {secret_error}", file=sys.stderr)
+            sys.exit(1)
+
     new_client_id, new_client_secret = register_client(
         server_url,
         name,
