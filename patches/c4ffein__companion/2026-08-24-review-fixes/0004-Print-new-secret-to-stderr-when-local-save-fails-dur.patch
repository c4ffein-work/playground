From 6e1346e95dbabf96116aa6347dbfedf9b8f78a9d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 24 Aug 2026 07:17:55 +0000
Subject: [PATCH 4/4] Print new secret to stderr when local save fails during
 rotate
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

If _save_secrets failed after the server had already accepted the new
token, the error told the user to save the new secret manually — but
the secret was only emitted via logger.debug, and CLI commands never
configure logging, so it was never shown anywhere. Print it to stderr
alongside the recovery instructions.
---
 companion.py     | 4 +++-
 src/companion.py | 4 +++-
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/companion.py b/companion.py
index fe9e6af..050e135 100644
--- a/companion.py
+++ b/companion.py
@@ -25731,7 +25731,9 @@ def rotate_cmd(args):
             _save_secrets(server_name, [old_secret, new_secret])
         except ConfigWriteError as exc:
             print(f"❌ Failed to save new secret locally: {exc}", file=sys.stderr)
-            logger.debug("New secret: %s", new_secret)
+            # Print the secret: it exists on the server already, and CLI runs
+            # don't configure logging, so logger.debug would swallow it.
+            print(f"   New secret: {new_secret}", file=sys.stderr)
             print("   Save it manually and run 'companion complete-rotation' to finish.", file=sys.stderr)
             sys.exit(1)
 
diff --git a/src/companion.py b/src/companion.py
index 6b56445..d4d7c25 100644
--- a/src/companion.py
+++ b/src/companion.py
@@ -1981,7 +1981,9 @@ def rotate_cmd(args):
             _save_secrets(server_name, [old_secret, new_secret])
         except ConfigWriteError as exc:
             print(f"❌ Failed to save new secret locally: {exc}", file=sys.stderr)
-            logger.debug("New secret: %s", new_secret)
+            # Print the secret: it exists on the server already, and CLI runs
+            # don't configure logging, so logger.debug would swallow it.
+            print(f"   New secret: {new_secret}", file=sys.stderr)
             print("   Save it manually and run 'companion complete-rotation' to finish.", file=sys.stderr)
             sys.exit(1)
 
