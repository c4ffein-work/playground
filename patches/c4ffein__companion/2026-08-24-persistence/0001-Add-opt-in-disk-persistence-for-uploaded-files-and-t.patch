+        with patch.dict(companion.os.environ, {"X_PERSIST": "off"}):
+            self.assertFalse(resolve("X_PERSIST", {"persist-files": True}, "persist-files"))
+        with patch.dict(companion.os.environ, {"X_PERSIST": "banana"}):
+            # Invalid env value is ignored; config still applies
+            self.assertTrue(resolve("X_PERSIST", {"persist-files": True}, "persist-files"))
+
