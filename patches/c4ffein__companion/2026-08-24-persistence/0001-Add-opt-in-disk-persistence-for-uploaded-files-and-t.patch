+class TestPersistSettingResolution(unittest.TestCase):
+    """Env var overrides config key; default off."""
+
+    def test_resolution_precedence(self):
+        resolve = companion._resolve_persist_setting
+        with patch.dict(companion.os.environ, {}, clear=False):
+            companion.os.environ.pop("X_PERSIST", None)
+            self.assertFalse(resolve("X_PERSIST", None, "persist-files"))
+            self.assertFalse(resolve("X_PERSIST", {}, "persist-files"))
