+# ─────────────────────────────────────────────────────────────────────────────
+# Optional persistence (files + pad). All writes happen under WORKSPACE_LOCK
+# (single writer: the server process), so plain tempfile + os.replace atomic
+# writes are enough — no cross-process file lock like the client database.
+# ─────────────────────────────────────────────────────────────────────────────
+
+
+def _server_state_dir() -> Path:
+    """State dir for the active server (servers/<name>/)."""
+    return get_state_dir() / "servers" / (_ACTIVE_SERVER_NAME or "default")
+
+
+def _files_blobs_dir() -> Path:
+    return _server_state_dir() / "files" / "blobs"
+
+
+def _files_index_path() -> Path:
+    return _server_state_dir() / "files" / "index.json"
+
+
+def _pad_path() -> Path:
+    return _server_state_dir() / "pad.json"
+
+
+def _atomic_write_json(path: Path, data) -> None:
+    """Write JSON via tempfile + os.replace so readers never see a partial file."""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    fd, tmp_path = tempfile.mkstemp(dir=str(path.parent), prefix=path.stem + ".", suffix=".tmp")
+    try:
+        with os.fdopen(fd, "w") as f:
+            json.dump(data, f)
+        os.replace(tmp_path, str(path))
+    except OSError:
+        with contextlib.suppress(OSError):
+            os.unlink(tmp_path)
+        raise
+
+
+def _read_json_or_none(path: Path):
+    if not path.exists():
+        return None
+    try:
+        with open(path) as f:
+            return json.load(f)
+    except (json.JSONDecodeError, OSError) as e:
+        logger.warning("Failed to load %s: %s", path, e)
+        return None
+
+
+def _write_file_blob(file_id: str, content: bytes) -> None:
+    """Persist a file blob atomically as files/blobs/<file_id> (file_id is a UUID)."""
+    blobs = _files_blobs_dir()
+    blobs.mkdir(parents=True, exist_ok=True)
+    fd, tmp_path = tempfile.mkstemp(dir=str(blobs), prefix=file_id + ".", suffix=".tmp")
+    try:
+        with os.fdopen(fd, "wb") as f:
+            f.write(content)
+        os.replace(tmp_path, str(blobs / file_id))
+    except OSError:
+        with contextlib.suppress(OSError):
+            os.unlink(tmp_path)
+        raise
+
+
+def _read_file_blob(file_id: str) -> bytes:
+    with open(_files_blobs_dir() / file_id, "rb") as f:
+        return f.read()
+
+
+def _save_files_index() -> None:
+    """Write the metadata index for all persisted files. Call under WORKSPACE_LOCK."""
+    index = {
+        file_id: {
+            "filename": entry.filename,
+            "mimetype": entry.mimetype,
+            "uploaded": entry.upload_time,
+            "client_id": entry.client_id,
+            "size": entry.size,
+        }
+        for file_id, entry in FILES.items()
+    }
+    _atomic_write_json(_files_index_path(), index)
+
+
+def _save_pad() -> None:
+    """Mirror PAD_STATE to disk. Call under WORKSPACE_LOCK."""
+    _atomic_write_json(_pad_path(), {"content": PAD_STATE["content"], "timestamp": PAD_STATE["timestamp"]})
+
+
+def load_persisted_state() -> None:
+    """Reload persisted files/pad into memory at startup, per PERSIST_FILES/PERSIST_PAD.
+
+    Files: index entries whose blob is missing are dropped (with a warning);
+    blobs not in the index — including stale .tmp files from interrupted
+    writes — are deleted (orphan sweep).
+    """
+    if PERSIST_FILES:
+        index = _read_json_or_none(_files_index_path()) or {}
+        blobs_dir = _files_blobs_dir()
+        loaded = {}
+        dropped = []
+        for file_id, meta in index.items():
+            if not (blobs_dir / file_id).exists():
+                dropped.append(file_id)
+                continue
+            loaded[file_id] = FileEntry(
+                filename=meta["filename"],
+                content=None,
+                mimetype=meta["mimetype"],
+                upload_time=meta["uploaded"],
+                client_id=meta["client_id"],
+                size=meta["size"],
+                file_id=file_id,
+            )
+        with WORKSPACE_LOCK:
+            FILES.clear()
+            FILES.update(loaded)
+            if dropped:
+                logger.warning(
+                    "Dropped %d index entr%s with missing blobs", len(dropped), "y" if len(dropped) == 1 else "ies"
+                )
+                _save_files_index()
+        if blobs_dir.is_dir():
+            for stray in blobs_dir.iterdir():
+                if stray.name not in loaded:
+                    logger.warning("Removing orphan blob %s", stray)
+                    with contextlib.suppress(OSError):
+                        stray.unlink()
+        logger.info("Loaded %d persisted file(s) from %s", len(loaded), blobs_dir.parent)
+    if PERSIST_PAD:
+        pad = _read_json_or_none(_pad_path())
+        if pad is not None and isinstance(pad.get("content"), str):
+            with WORKSPACE_LOCK:
+                PAD_STATE["content"] = pad["content"]
+                PAD_STATE["timestamp"] = int(pad.get("timestamp", 0))
+            logger.info("Loaded persisted pad (%d chars)", len(pad["content"]))
+
+
 class ConfigError(Exception):
     """Base for all config-related errors."""
 
