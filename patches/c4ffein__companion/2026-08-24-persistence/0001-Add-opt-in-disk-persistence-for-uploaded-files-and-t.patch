+def _resolve_persist_setting(env_var: str, server_config: Optional[dict], key: str) -> bool:
+    """Env var overrides the server's config key; default off."""
+    env = os.environ.get(env_var)
+    if env is not None:
+        v = env.strip().lower()
+        if v in _TRUTHY_ENV:
+            return True
+        if v in _FALSY_ENV:
+            return False
+        logger.warning("%s must be one of 1/0/true/false/yes/no/on/off — ignoring %r", env_var, env)
+    if server_config and key in server_config:
+        return bool(server_config[key])
+    return False
