+#!/usr/bin/env python3
+"""
+Unit tests for optional persistence (files + pad)
+"""
+
+import hashlib
+import json
+import secrets
+import shutil
+import sys
+import tempfile
+import threading
+import time
+import unittest
+import urllib.request
+from pathlib import Path
+from unittest.mock import patch
+
+# Import the companion module
+sys.path.insert(0, "src")
+import companion
+
+
+def _make_client_entry(client_secret, admin=True, name="test"):
+    """Create a properly hashed client entry for CLIENTS."""
+    salt = secrets.token_hex(16)
+    secret_hash = hashlib.sha256((salt + client_secret).encode()).hexdigest()
+    return {
+        "tokens": [{"salt": salt, "secret_hash": secret_hash}],
+        "admin": admin,
+        "name": name,
+        "registered": "2026-01-01T00:00:00",
+    }
+
+
+class PersistenceTestBase(unittest.TestCase):
+    """Server in a background thread with a temp state dir and persistence on."""
+
+    port = 8897
+    persist_files = True
+    persist_pad = True
+
+    @classmethod
+    def setUpClass(cls):
+        cls.client_id = "test-persist-id"
+        cls.client_secret = secrets.token_hex(32)
+        cls.auth_token = f"{cls.client_id}:{cls.client_secret}"
+        cls.base_url = f"http://localhost:{cls.port}"
+
+        # Isolated state dir + active server name for persistence paths
+        cls._tmp_dir = tempfile.mkdtemp(prefix="companion-persist-test-")
+        cls._orig_state_dir = companion.STATE_DIR
+        cls._orig_server_name = companion._ACTIVE_SERVER_NAME
+        cls._orig_persist_files = companion.PERSIST_FILES
+        cls._orig_persist_pad = companion.PERSIST_PAD
+        companion.STATE_DIR = Path(cls._tmp_dir)
+        companion._ACTIVE_SERVER_NAME = "persisttest"
+        companion.PERSIST_FILES = cls.persist_files
+        companion.PERSIST_PAD = cls.persist_pad
+
+        # Reset global state
+        companion.FILES.clear()
+        companion.PREVIEW_STATE = {"file_id": None, "timestamp": 0}
+        companion.PAD_STATE = {"content": "", "timestamp": 0}
+        companion.RATE_LIMIT_STORE.clear()
+
+        companion.ACTIVE_SERVER_CLIENTS.clear()
+        companion.ACTIVE_SERVER_CLIENTS[cls.client_id] = _make_client_entry(
+            cls.client_secret, admin=True, name="test-persist"
+        )
+
+        def run_server():
+            server_address = ("127.0.0.1", cls.port)
+            httpd = companion.http.server.HTTPServer(server_address, companion.FileShareHandler)
+            httpd.allow_reuse_address = True
+            cls.httpd = httpd
+            httpd.serve_forever()
+
+        cls.server_thread = threading.Thread(target=run_server, daemon=True)
+        cls.server_thread.start()
+        time.sleep(0.5)
+
+    @classmethod
+    def tearDownClass(cls):
+        if hasattr(cls, "httpd"):
+            cls.httpd.shutdown()
+            cls.httpd.server_close()
+        companion.STATE_DIR = cls._orig_state_dir
+        companion._ACTIVE_SERVER_NAME = cls._orig_server_name
+        companion.PERSIST_FILES = cls._orig_persist_files
+        companion.PERSIST_PAD = cls._orig_persist_pad
+        companion.FILES.clear()
+        companion.PAD_STATE = {"content": "", "timestamp": 0}
+        shutil.rmtree(cls._tmp_dir, ignore_errors=True)
+
+    def setUp(self):
+        with companion.WORKSPACE_LOCK:
+            companion.FILES.clear()
+            companion.PAD_STATE["content"] = ""
+            companion.PAD_STATE["timestamp"] = 0
+        with companion.RATE_LIMIT_LOCK:
+            companion.RATE_LIMIT_STORE.clear()
+        files_dir = companion._server_state_dir() / "files"
+        shutil.rmtree(files_dir, ignore_errors=True)
+        pad_path = companion._pad_path()
+        if pad_path.exists():
+            pad_path.unlink()
+        self.request_log = []
+        patcher = patch.object(
+            companion.FileShareHandler, "log_message", lambda self_, fmt, *a: self.request_log.append(fmt % a)
+        )
+        patcher.start()
+        self.addCleanup(patcher.stop)
+
+    def _upload(self, filename, content):
+        """Helper to upload a file via multipart"""
+        boundary = "----TestBoundary123"
+        body = (
+            (
+                f"--{boundary}\r\n"
+                f'Content-Disposition: form-data; name="file"; filename="{filename}"\r\n'
+                f"Content-Type: application/octet-stream\r\n\r\n"
+            ).encode()
+            + content
+            + f"\r\n--{boundary}--\r\n".encode()
+        )
+        req = urllib.request.Request(
+            f"{self.base_url}/api/upload",
+            data=body,
+            headers={
+                "Authorization": f"Bearer {self.auth_token}",
+                "Content-Type": f"multipart/form-data; boundary={boundary}",
+            },
+        )
+        return urllib.request.urlopen(req)
+
+    def _download(self, file_id):
+        req = urllib.request.Request(
+            f"{self.base_url}/download/{file_id}",
+            headers={"Authorization": f"Bearer {self.auth_token}"},
+        )
+        with urllib.request.urlopen(req) as response:
+            return response.read()
+
+    def _set_pad(self, content):
+        data = json.dumps({"content": content}).encode()
+        req = urllib.request.Request(
+            f"{self.base_url}/api/pad",
+            data=data,
+            headers={"Authorization": f"Bearer {self.auth_token}", "Content-Type": "application/json"},
+            method="POST",
+        )
+        return urllib.request.urlopen(req)
+
+    def _simulate_restart(self):
+        """Wipe in-memory state and reload from disk, as a fresh server would."""
+        with companion.WORKSPACE_LOCK:
+            companion.FILES.clear()
+            companion.PAD_STATE["content"] = ""
+            companion.PAD_STATE["timestamp"] = 0
+        companion.load_persisted_state()
+
+
+class TestFilesPersistence(PersistenceTestBase):
+    port = 8897
+
+    def test_upload_writes_blob_and_keeps_content_out_of_memory(self):
+        content = b"persist me" * 100
+        response = self._upload("keep.bin", content)
+        result = json.loads(response.read().decode())
+        file_id = result["id"]
+
+        blob = companion._files_blobs_dir() / file_id
+        self.assertTrue(blob.exists())
+        self.assertEqual(blob.read_bytes(), content)
+        self.assertIsNone(companion.FILES[file_id].content)
+        self.assertEqual(companion.FILES[file_id].size, len(content))
+        index = json.loads(companion._files_index_path().read_text())
+        self.assertEqual(index[file_id]["size"], len(content))
+
+    def test_files_survive_restart(self):
+        content = b"still here after restart"
+        response = self._upload("survivor.bin", content)
+        file_id = json.loads(response.read().decode())["id"]
+
+        self._simulate_restart()
+
+        self.assertIn(file_id, companion.FILES)
+        entry = companion.FILES[file_id]
+        self.assertEqual(entry.filename, "survivor.bin")
+        self.assertEqual(entry.size, len(content))
+        self.assertIsNone(entry.content)
+        self.assertEqual(self._download(file_id), content)
+
+    def test_storage_limit_counts_persisted_files_after_restart(self):
+        response = self._upload("counted.bin", b"z" * 700)
+        file_id = json.loads(response.read().decode())["id"]
+        self._simulate_restart()
+        with companion.WORKSPACE_LOCK:
+            usage = sum(f.size for f in companion.FILES.values() if f.client_id == self.client_id)
+        self.assertEqual(usage, 700)
+        self.assertIn(file_id, companion.FILES)
+
+    def test_orphan_blob_swept_on_restart(self):
+        response = self._upload("real.bin", b"real")
+        file_id = json.loads(response.read().decode())["id"]
+
+        blobs_dir = companion._files_blobs_dir()
+        orphan = blobs_dir / ("0" * 32)
+        orphan.write_bytes(b"orphan")
+        stale_tmp = blobs_dir / "stale.1234.tmp"
+        stale_tmp.write_bytes(b"stale")
+
+        self._simulate_restart()
+
+        self.assertFalse(orphan.exists())
+        self.assertFalse(stale_tmp.exists())
+        self.assertTrue((blobs_dir / file_id).exists())
+
+    def test_index_entry_with_missing_blob_dropped_on_restart(self):
+        response = self._upload("gone.bin", b"gone")
+        file_id = json.loads(response.read().decode())["id"]
+        (companion._files_blobs_dir() / file_id).unlink()
+
+        self._simulate_restart()
+
+        self.assertNotIn(file_id, companion.FILES)
+        index = json.loads(companion._files_index_path().read_text())
+        self.assertNotIn(file_id, index)
+
+
+class TestPadPersistence(PersistenceTestBase):
+    port = 8898
+
+    def test_pad_written_to_disk_and_survives_restart(self):
+        content = "notes to keep 📝"
+        result = json.loads(self._set_pad(content).read().decode())
+        timestamp = result["timestamp"]
+
+        pad = json.loads(companion._pad_path().read_text())
+        self.assertEqual(pad["content"], content)
+
+        self._simulate_restart()
+
+        self.assertEqual(companion.PAD_STATE["content"], content)
+        self.assertEqual(companion.PAD_STATE["timestamp"], timestamp)
+
+
+class TestPersistenceOff(PersistenceTestBase):
