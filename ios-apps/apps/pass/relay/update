#!/bin/sh
# `update` hook of the relay repository (copy to <store>.git/hooks/update, chmod +x).
# git runs it once per branch a push wants to move, and refuses the move when it fails.
#
# A device may move one branch, its own: refs/heads/devices/<name>. Which device is
# pushing is told by PASS_DEVICE, set by the forced command of its key in
# ~/.ssh/authorized_keys (see apps/pass/README.md):
#
#   command="PASS_DEVICE=phone exec git-shell -c \"$SSH_ORIGINAL_COMMAND\"",restrict ssh-ed25519 AAAA... phone
#
# A key with no PASS_DEVICE is the owner's: it may push anything.
ref=$1 new=$3

[ -n "${PASS_DEVICE:-}" ] || exit 0

case "$PASS_DEVICE" in
    *[!a-z0-9_-]*) echo "relay: bad device name" >&2; exit 1 ;;
esac
if [ "$ref" != "refs/heads/devices/$PASS_DEVICE" ]; then
    echo "relay: the device '$PASS_DEVICE' may only push to devices/$PASS_DEVICE, not to ${ref#refs/heads/}" >&2
    exit 1
fi
case "$new" in
    *[!0]*) ;;
    *) echo "relay: a device may not delete its branch" >&2; exit 1 ;;
esac
exit 0
