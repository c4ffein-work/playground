# Copy to .env and adjust. All values have dev-safe defaults in settings.py.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# JWT lifetime (seconds); default 7 days
JWT_EXP_SECONDS=604800

# Anthropic proxy (server-side only; leave unset to make /api/assistant return 503)
ANTHROPIC_API_KEY=

# Optional: override sqlite path
# DJANGO_DB_PATH=/data/db.sqlite3
