# Copy to .env and adjust. All values have dev-safe defaults in settings.py.
# NOTE: with DEBUG=false the server REFUSES TO START unless DJANGO_SECRET_KEY
# is set to a real value (not the dev default).

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true

# Comma-separated. Defaults: "*" when DEBUG=true, empty (deny all) otherwise.
DJANGO_ALLOWED_HOSTS=*

# CORS: comma-separated exact origins (scheme://host[:port]), or "*".
# Defaults: "*" when DEBUG=true, empty (no CORS headers) otherwise.
# CORS_ALLOWED_ORIGINS=https://nnvp.example.com

# JWT lifetime (seconds); default 7 days
JWT_EXP_SECONDS=604800

# Anthropic proxy (server-side only; leave unset to make /api/assistant return 503)
ANTHROPIC_API_KEY=

# Assistant proxy hardening
# JWT Bearer is required on /api/assistant/messages by default; set to 1 for
# anonymous access (local dev ONLY — never in production).
ASSISTANT_ALLOW_ANONYMOUS=0
# Per-user rate limit, "<n>/<s|m|h|d>"; default 30/m.
ASSISTANT_THROTTLE_RATE=30/m

# Optional: override sqlite path
# DJANGO_DB_PATH=/data/db.sqlite3
