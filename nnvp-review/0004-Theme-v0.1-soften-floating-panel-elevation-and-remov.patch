Date: Mon, 6 Jul 2026 10:53:23 +0000
Subject: [PATCH 4/8] Theme v0.1: soften floating-panel elevation and remove
 dead Vite scaffold CSS

- App.vue: replace the hard pure-black 1px panel hairline with a subtle border
  (--panel-border #e5e7eb) plus a soft drop shadow (--panel-shadow), giving the
  floating panels a lighter, more modern feel. New tokens; existing --border-*
  tokens left intact for other consumers.
- Remove src/style.css (the default Vite starter: #646cff links, centered 1280px
  card, dark boilerplate button) and its import in main.js. It conflicted with the
  real design system in App.vue and shipped in the bundle unused.

Verified: lint 0/0, 28 unit tests, build ok, layout e2e (app.spec.js) 5/5 passes,
screenshot confirms panels render with the new subtle border + shadow and the
layout is unchanged.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JNQtU2ePmhzdTwymZCbh7J
---
 nnvp-client-vue/src/App.vue   |  8 +++-
 nnvp-client-vue/src/main.js   |  1 -
 nnvp-client-vue/src/style.css | 79 -----------------------------------
 3 files changed, 7 insertions(+), 81 deletions(-)
 delete mode 100644 nnvp-client-vue/src/style.css

diff --git a/nnvp-client-vue/src/App.vue b/nnvp-client-vue/src/App.vue
index 0599c1a..5862baa 100644
--- a/nnvp-client-vue/src/App.vue
+++ b/nnvp-client-vue/src/App.vue
@@ -96,6 +96,11 @@ export default {
   --border-width: 1px;
   --border-radius: 15px;
   --panel-margin: 12px;
+
+  /* Panel elevation (v0.1): a subtle border + soft shadow instead of a hard
+     pure-black hairline, for a lighter, more modern feel. */
+  --panel-border: #e5e7eb;
+  --panel-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
 }
 
 body,html {
@@ -136,8 +141,9 @@ body,html {
 .floating-panel {
   position: absolute;
   background-color: var(--bg-panel);
-  border: var(--border-width) solid var(--border-color);
+  border: var(--border-width) solid var(--panel-border);
   border-radius: var(--border-radius);
+  box-shadow: var(--panel-shadow);
   overflow: hidden;
   z-index: 10;
   pointer-events: auto;  /* Allow the panel background to receive clicks */
diff --git a/nnvp-client-vue/src/main.js b/nnvp-client-vue/src/main.js
index 0d656c8..e16febf 100644
--- a/nnvp-client-vue/src/main.js
+++ b/nnvp-client-vue/src/main.js
@@ -1,5 +1,4 @@
 import { createApp } from 'vue'
-import './style.css'
 import App from './App.vue'
 
 import KerasInterface from './lib/KerasInterface/KerasInterface';
